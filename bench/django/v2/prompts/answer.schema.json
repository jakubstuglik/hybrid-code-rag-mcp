{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["files", "symbols", "spans"],
  "properties": {
    "files": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "symbols": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "spans": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "lines"],
        "properties": {
          "file": { "type": "string", "minLength": 1 },
          "symbol": { "type": "string" },
          "lines": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "notes": { "type": "string" }
  }
}
