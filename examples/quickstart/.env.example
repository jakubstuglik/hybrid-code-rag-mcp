# Copy to `.env` in this directory (Compose loads it automatically) or
# export the same names in the shell.  You do not need to edit the
# compose files.
#
#   REPO_URL=https://github.com/org/repo.git docker compose up --build
# PowerShell:
#   $env:REPO_URL="https://github.com/org/repo.git"; docker compose up --build
# Wrappers:
#   ./start.sh --repo <path|url> [--ref X] [--repo-config F] [--gpu] [--gpu-device N]
#   .\start.ps1 -Repo <path|url> [-Ref X] [-RepoConfig F] [-Gpu] [-GpuDevice N]

# Local tree to index (absolute, or relative to this directory).
# Leave unset to use the bundled sample.  Ignored when REPO_URL is set.
# REPO_PATH=/path/to/your/repo

# Git URL to clone inside the app container.  Wins if both URL and PATH
# are set.  Needs git in the app image (installed by the Dockerfile).
# REPO_URL=https://github.com/org/repo.git

# Branch, tag or commit for REPO_URL.  Ignored for a bind-mounted path
# (check that ref out on the host first).
# REPO_REF=main

# Optional Python file with settings for the indexed tree only
# (SOURCE_DIRS, MCP tool name and description, server name).
# Path is on the host: absolute, or relative to this directory.  A start
# parameter (--repo-config / -RepoConfig) beats this value.  start.sh and
# start.ps1 add docker-compose.repo-config.yml, which mounts the file
# read-only at /config/repo_config.py.  With raw Compose, add that
# overlay yourself, e.g.:
#   REPO_CONFIG=/path/to/repo_config.py docker compose -f docker-compose.yml \
#     -f docker-compose.repo-config.yml up --build
# See repo_config.example.py.  Leave unset to keep the default scope
# and tool names.  Changing this file rebuilds the index with --clear.
# REPO_CONFIG=./repo_config.py

# Optional: pin TEI to one host GPU when you have more than one.
# 0-based index as in nvidia-smi, or a GPU-... UUID.  Leave unset on a
# single-GPU machine (the default): CUDA_VISIBLE_DEVICES is then not
# set and TEI uses the first GPU.
# start.sh --gpu-device / start.ps1 -GpuDevice set this and add
# docker-compose.gpu-device.yml.  With raw Compose, add that overlay
# yourself, e.g.:
#   GPU_DEVICE=1 docker compose -f docker-compose.yml \
#     -f docker-compose.gpu.yml -f docker-compose.gpu-device.yml up --build
# On Docker Desktop for Windows, --gpus device=N is ignored and every
# GPU is attached; GPU_DEVICE (passed as CUDA_VISIBLE_DEVICES) is the
# pin that works.  Confirm with `docker compose exec tei nvidia-smi`.
# GPU_DEVICE=1

# Required on NVIDIA driver 6xx (CUDA UMD 13.x) with TEI images older than
# 1.9.4: the image entrypoint otherwise prepends a broken cuda-compat and
# TEI silently runs on CPU.  The GPU compose file sets this by default.
# TEI_LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libcuda.so.1

# Host port for the MCP server (Qdrant and TEI stay on the Compose network
# and are not published).  Change this if 8125 is already taken.
# MCP_PORT=8125

# Optional batch overrides.  Defaults come from the CPU compose file or,
# with the GPU override, from docker-compose.gpu.yml.
# DENSE_EMBED_BATCH_SIZE=1
# TEI_MAX_BATCH_TOKENS=2048
