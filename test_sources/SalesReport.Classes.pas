  procedure TestujNumeracjeBiletow(ANrBil: Integer; ABilet: Boolean);  //E.B. 19.07.2019
  var
    s: String;
    nrostbrak, NrKBil205: Integer;
  begin
    if EMAR205 then    //E.B. 25.04.2019
    begin
//      if (NrKBil205 mod $10000) > ANrBil then
//        Inc(NrKBil205H);
//      if not bilufisk and (NrBil=0) then NrKBil205H:=0;   //E.B. 30.09.2020
      NrKBil205 := {NrKBil205H*65536+}ANrBil; // it's already recalculated in emardevs.dll
      // AT: nrpb205=nrpb, because ... it's already calculated in emardevs.dll
      if (not ABilet)
        and(
          (nrpb{nrpb205} = NrKBil205)
          or(nrpb{nrpb205} = -2)
          ) then
        Exit;
      if (ABilet and (nrpb{nrpb205} + 1 <> NrKBil205)) //E.B. 05.02.2021
        or((not ABilet)and (nrpb{nrpb205} <> NrKBil205)) then
      begin
        ciagnrb := False;
        s:=sLine; sLine:='';
        nrostbrak := NrKBil205;
        if ABilet then
          dec(nrostbrak);
//        if NrKBil205 - nrpb{nrpb205} = 2 then
        if nrostbrak - nrpb{nrpb205} = 1 then       //E.B. 05.02.2021
          AddLine(21, Format(C_FMT_MISSING_RECEIPT, [nrpb{nrpb205} + 1]))
        else
          AddLine(21, Format(C_FMT_MISSING_RECEIPTS, [nrpb + 1, nrostbrak]));
        OutputLine(re, clError, fsRegular);
        sLine := s;
        if Status = 0 then
          Status := 11;
      end;
    end
    else
    begin
      if (not ABilet) and ((nrpb = ANrBil)or(nrpb = -2)) then
        Exit;
//2020-04-22:      if nrpb=65535 then nrpb:=-1;
      if nrpb mod Succ($FFFF) = 65535 then nrpb := -1; // ze wzgłędu na starszy bajz w zdarzeniu #1
      if (nrpb > -2)and(nrpb + 1 <> ANrBil) then
      begin
        ciagnrb := False;
        s := sLine;
        sLine := '';
        nrostbrak := ANrBil;
        if ABilet then
          Dec(nrostbrak);
        if ANrBil - nrpb = 2 then
          AddLine(21, Format(C_FMT_MISSING_RECEIPT, [nrpb + 1]))
        else
          AddLine(21, Format(C_FMT_MISSING_RECEIPTS, [nrpb + 1, nrostbrak]));
        OutputLine(re, clError, fsRegular);
        sLine := s;
        if Status = 0 then
          Status := 11;
      end;
    end;
  end;

