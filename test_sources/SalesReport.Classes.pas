procedure TSalesReport.PrepareFromFile(const ADispFileType: TDispFileType);
var
  sOldFilePath, sNewFilePath: String;
begin
  if IsNew then // w prypadku edycji nie zmieniamy daty rejestracji
    RegistrationDate := Now();
  if ADispFileType in [dfSalesReportBusPC, dfDamagedReportBusPC] then begin
  end else begin
    if CFilePath <> '' then
    try
      Status := 0; // rejestracja rozpoczęta (karta pamięci nie skasowana)

      FileK.Changed := False;
      FileC.PrepareFromPath(CFilePath, LicencesCompanyID, ADispFileType, _File.Version, False);
      if FileC.FileAttachment.Subdir <> '' then // + subfolder \Year+Month\UserStaionNumber
        FileC.FileAttachment.Subdir := FileC.FileAttachment.Subdir + PathDelim +
          FormatDateTime('YYYYMM', RegistrationDate);
      ReportName := ExtractFileName(FileC.FileAttachment.Name);
    except
      KFilePath := CFilePath;
      CFilePath := '';

      PrepareFromFile(ADispFileType);
    end
    else // CFilePath = '' - uszkodzony
      if
        (ReportType in [rtEmar105, rtEmar205])
        and(AnsiUpperCase(ExtractFileName(KFilePath))[1] = 'C')
        and(AnsiUpperCase(Copy(ExtractFileName(KFilePath), 1, 2)) <> 'CE')
      then
      begin
        sOldFilePath := KFilePath;
        sNewFilePath :=
          ExtractFilePath(KFilePath) +
          'K' + Copy(ExtractFileName(KFilePath), 2, Length(ExtractFileName(KFilePath)) - 1); // zmieniamy nazwę raportu na K zamiast C
        KFilePath := sNewFilePath;
        CopyFile(PWideChar(sOldFilePath), PWideChar(sNewFilePath), False);
        KMFilesUtil.ForceDeleteFile(PWideChar(sOldFilePath));

        PrepareFromFile(ADispFileType); // prepare again
      end
      else
      begin
        Status := 1; // raport uszkodzony (zapisany do korekty)

        File_ID := 0;
        FileC.Changed := False;
        FileOryg_ID := 0;
        FileOryg.Changed := False;
        FileK.PrepareFromPath(KFilePath, LicencesCompanyID, dfSalesReportFileK, _File.Version, False);
        if FileK.FileAttachment.Subdir <> '' then // + subfolder \Year+Month\UserStationNumber
          FileK.FileAttachment.Subdir := FileK.FileAttachment.Subdir + PathDelim +
            FormatDateTime('YYYYMM', RegistrationDate);
        ReportName := ExtractFileName(FileK.FileAttachment.Name);
      end;
  end;
  if FileProcessTasksPath <> '' then
    //FileProcessTasks.PrepareFromPath(FileProcessTasksPath, LicencesCompanyID, dfSalesReportProcessTasks, 0, False);
    Self.FileProcessTasks.PrepareDISPFileFromPath(FileProcessTasksPath, LicencesCompanyID, dfSalesReportProcessTasks, 0);
end;

