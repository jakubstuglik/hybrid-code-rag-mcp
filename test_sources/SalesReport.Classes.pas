  // Oznaczenie waluty ewidencyjnej; TCurrency
  if Trim(_FileA80.Consts.CurrencyCode) <> '' then
    Currency_ID := TCurrency.IdFromSymbol(Trim(_FileA80.Consts.CurrencyCode), dmMain);
  if Currency_ID <= 0 then
    Currency_ID := DefaultCurrencyID; // waluta ewidencyjna

  if Status = 0 then // rejestracja rozpoczęta (karta pamięci nie skasowana)
    Status := 4; // rejestracja zakończona (karta skasowana)

  Calculate(); // przeliczanie

  // sprawdzamy czy pierwszy raport fiskalny jest już zarejestrowany
//  iCheckIfExistsInDBFiscalReport := CheckIfExistsInDBFiscalReport(not aFromFile);
  if Status in [Ord(TSalesReportStatus.srsCorrect), Ord(TSalesReportStatus.srsCorrectWithWarning)] then
    iCheckIfExistsInDBFiscalReport := CheckIfExistsInDBFiscalReport((AnsiUpperCase(ExtractFileName(CFilePath)[1]) = 'K')
      and(KMFilesUtil.GetFileSize(CFilePath) = 4096 * 528{FLASH_528}))
  else
    iCheckIfExistsInDBFiscalReport := 0; // tak czy inaczej nie zapisuje niczego innego niż nagłówek SalesReport
  if (iCheckIfExistsInDBFiscalReport <> 0)
    // in case sales report registers again, its ID could be found here
    and(iCheckIfExistsInDBFiscalReport <> Self.Id) then
  begin
    sFullReportNumber := TSalesReport.GetFullReportNumber(dmMain, iCheckIfExistsInDBFiscalReport);
    if IsEmar205OnlineReport() then
      AddToDesc(Format(RS_Emar205ReportOnlineIsAlreadyRegistered,
          [
            ExtractFileName(CFilePath)
            , DateToStr(Floor(TSalesReport.GetRegistrationDate(dmMain, iCheckIfExistsInDBFiscalReport)))
            , Copy(sFullReportNumber, 9, 2)
            , Copy(sFullReportNumber, 11, 5)
          ]))
    else
      AddToDesc(Format(RS_Emar105ReportIsAlreadyRegistered,
          [
            ExtractFileName(CFilePath)
            , _File.OIK.CardSerialNumber
            , DateToStr(Floor(TSalesReport.GetRegistrationDate(dmMain, iCheckIfExistsInDBFiscalReport)))
            , Copy(sFullReportNumber, 9, 2)
            , Copy(sFullReportNumber, 11, 5)
          ]));
  end
  else
    Result := True;

  _File.ReportEventList.EndUpdate;
  rel := nil;
