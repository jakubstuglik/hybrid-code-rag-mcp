var
  farePriceReductionRecord: TFarePriceReductionRecord;
  iReductionCode: Integer;
  iFarePriceReductionList, iIndexOfPriceCityFarePriceScale: Integer;
  iBusStopEndNo: Integer;
  RTicketPrice: TRTicketPrice;
  _Emar_FarePriceReduction: IEmar_FarePriceReduction;
  _Emar_CityTariffPrice: IEmar_CityTariffPrice;
  fpr: TFarePriceReduction;
begin
  Result := 0;
  iReductionCode := 0;
  case AReportEvent.Kind of
    15: // 15 - Bilet ulgowy
      begin
        iReductionCode := AReportEvent.AsEvent_15.ReduceCode;
      end;
    17: // 17 - Rejestracja przejazdu z biletem okresowym (karta MIFARE)
      begin
        iReductionCode := AReportEvent.AsEvent_17.ReduceCode;
      end;
    30: // 30 - Bilet w taryfie miejskiej
      begin
        if AReportEvent.AsEvent_30.TicketKind in [2, 6] {ulgowy or pracowniczy ulgowy} then
        begin
          if Assigned(LastEmarRide) then
          begin
            LastEmarRide.OblCenMie(
              EmarDateTimeToDateTime(AReportEvent.AsEvent_30.EventDate, AReportEvent.AsEvent_30.EventTime), //t.SaleDate,
              AReportEvent.AsEvent_30.BusStopStart,
              AReportEvent.AsEvent_30.TariffOffset,
              AReportEvent.AsEvent_30.PriceNumber,
              AReportEvent.AsEvent_30.PassangerCount,
              @iBusStopEndNo,
              @iIndexOfPriceCityFarePriceScale,
              @RTicketPrice);
            if iIndexOfPriceCityFarePriceScale > -1 then
            begin
              iReductionCode :=
                _FileA80.PriceCityFarePriceScaleList[iIndexOfPriceCityFarePriceScale].ReductionBinnaryCode;
            end;
          end;
        end;
      end;
    32: // 32 - Zakup w autobusie biletu miesięcznego / okresowego na następny okres (karta MIFARE)
      begin
        iReductionCode := AReportEvent.AsEvent_32.ReduceCode;
      end;
    33: // 33 - Rejestracja przejazdu z biletem miesięcznym (karta MIFARE) - błędy identyfikacji
      begin //Błąd identyfikacji EM-karty
        if FLPCRegistrationParamsParameters.GetEMCardWrongReads
          and(AReportEvent.AsEvent_33.CardNumber > 0) then
        begin
          iReductionCode := AReportEvent.AsEvent_33.ReduceCode;
        end;
      end;
    34: // 34 - Rejestracja przejazdu z biletem miesięcznym (karta MIFARE) - nieprawidłowe bilety
      begin //Nieprawidłowy bilet w EM-karcie
        if FLPCRegistrationParamsParameters.GetEMCardWrongReads then
        begin
          iReductionCode := AReportEvent.AsEvent_34.ReduceCode;
        end;
      end;
    35: // 35 - przedłużenie okresu ważności biletu wieloprzejazdowego
      begin
        iReductionCode := AReportEvent.AsEvent_35.ReduceCode;
      end;
  end;
  if iReductionCode > 0 then
  begin
    Result := inherited GetTempFarePriceReductionID(iReductionCode, ACompanyId);
    if (Result = 0)and(ACompanyId <> LicencesCompanyID) then
    begin
      fpr := TFarePriceReduction.Create;
      try
        case AReportEvent.Kind of
          15: // 15 - Bilet ulgowy
            begin
              iFarePriceReductionList :=
                GetFarePriceReductionIndex(
                  _FileA80,
                  LastEmarRide,
                  0,
                  AReportEvent.AsEvent_15);
              if iFarePriceReductionList > -1 then
                _Emar_FarePriceReduction :=
                  _FileA80.FarePriceReductionList[iFarePriceReductionList]
              else
                _Emar_FarePriceReduction :=
                  _FileA80.FarePriceReductionList[
                    _FileA80.RideReductionList[LastEmarRide.IndexOfPriceReduction
                    + AReportEvent.AsEvent_15.IndexOfReduce].IndexOfReduction
                  ];
              __fillFarePriceReductionObjectByEmarFarePriceReductionItem(fpr, _Emar_FarePriceReduction);
              fpr.WriteToDatabase();
            end;
          17: // 17 - Rejestracja przejazdu z biletem okresowym (karta MIFARE)
            begin
              iFarePriceReductionList :=
                GetMonthTicketReductionIndex(
                  _FileA80
                  , LastEmarRide
                  , AReportEvent.AsEvent_17);
              if iFarePriceReductionList > -1 then
              begin
                _Emar_FarePriceReduction := _FileA80.MonthTicketReductionList[iFarePriceReductionList];
                __fillFarePriceReductionObjectByEmarMonthTicketReductionItem(fpr, _Emar_FarePriceReduction);
                fpr.WriteToDatabase();
              end;
            end;
          30: // 30 - Bilet w taryfie miejskiej
            begin
              if AReportEvent.AsEvent_30.TicketKind in [2, 6] {ulgowy or pracowniczy ulgowy} then
              begin
                if Assigned(LastEmarRide) then
                begin
                  LastEmarRide.OblCenMie(
                    EmarDateTimeToDateTime(AReportEvent.AsEvent_30.EventDate, AReportEvent.AsEvent_30.EventTime), //t.SaleDate,
                    AReportEvent.AsEvent_30.BusStopStart,
                    AReportEvent.AsEvent_30.TariffOffset,
                    AReportEvent.AsEvent_30.PriceNumber,
                    AReportEvent.AsEvent_30.PassangerCount,
                    @iBusStopEndNo,
                    @iIndexOfPriceCityFarePriceScale,
                    @RTicketPrice);
                  if iIndexOfPriceCityFarePriceScale > -1 then
                  begin
                    _Emar_CityTariffPrice := _FileA80.PriceCityFarePriceScaleList[iIndexOfPriceCityFarePriceScale];
                    __fillFarePriceReductionObjectByEmarPriceCityFarePriceScaleItem(fpr, _Emar_CityTariffPrice);
                    fpr.WriteToDatabase();
                  end;
                end;
              end;
            end;
          32: // 32 - Zakup w autobusie biletu miesięcznego / okresowego na następny okres (karta MIFARE)
            begin
              // ReductionCompanyINumber
              iFarePriceReductionList :=
                GetMonthTicketReductionIndex(
                  _FileA80,
                  LastEmarRide,
                  AReportEvent.AsEvent_32);

              if iFarePriceReductionList > -1 then
              begin
                _Emar_FarePriceReduction := _FileA80.MonthTicketReductionList[iFarePriceReductionList];
                __fillFarePriceReductionObjectByEmarMonthTicketReductionItem(fpr, _Emar_FarePriceReduction);
                fpr.WriteToDatabase();
              end;
            end;
          33: // 33 - Rejestracja przejazdu z biletem miesięcznym (karta MIFARE) - błędy identyfikacji
            begin //Błąd identyfikacji EM-karty
              if FLPCRegistrationParamsParameters.GetEMCardWrongReads
                and(AReportEvent.AsEvent_33.CardNumber > 0) then
              begin
                iFarePriceReductionList :=
                  GetMonthTicketReductionIndex(
                    _FileA80,
                    LastEmarRide,
                    AReportEvent.AsEvent_33);
                if iFarePriceReductionList > -1 then
                begin
                  _Emar_FarePriceReduction := _FileA80.MonthTicketReductionList[iFarePriceReductionList];
                  __fillFarePriceReductionObjectByEmarMonthTicketReductionItem(fpr, _Emar_FarePriceReduction);
                  fpr.WriteToDatabase();
                end;
              end;
            end;
          34: // 34 - Rejestracja przejazdu z biletem miesięcznym (karta MIFARE) - nieprawidłowe bilety
            begin //Nieprawidłowy bilet w EM-karcie
              if FLPCRegistrationParamsParameters.GetEMCardWrongReads then begin
                iFarePriceReductionList :=
                  GetMonthTicketReductionIndex(
                    _FileA80,
                    LastEmarRide,
                    AReportEvent.AsEvent_34);
                if iFarePriceReductionList > -1 then
                begin
                  _Emar_FarePriceReduction := _FileA80.MonthTicketReductionList[iFarePriceReductionList];
                  __fillFarePriceReductionObjectByEmarMonthTicketReductionItem(fpr, _Emar_FarePriceReduction);
                  fpr.WriteToDatabase();
                end;
              end;
            end;
          35: // 35 - przedłużenie okresu ważności biletu wieloprzejazdowego
            begin
              iFarePriceReductionList :=
                GetMonthTicketReductionIndex(
                  _FileA80,
                  LastEmarRide,
                  AReportEvent.AsEvent_35);
              if iFarePriceReductionList > -1 then
              begin
                _Emar_FarePriceReduction := _FileA80.MonthTicketReductionList[iFarePriceReductionList];
                __fillFarePriceReductionObjectByEmarMonthTicketReductionItem(fpr, _Emar_FarePriceReduction);
                fpr.WriteToDatabase();
              end;
            end;
        end;

        if fpr.Id > 0 then
        begin
          farePriceReductionRecord.ReductionCode := fpr.ReductionCode;
          farePriceReductionRecord.CompanyId := fpr.Company_Id;
          FTempFarePriceReductionList.Add(farePriceReductionRecord, fpr.Id);
          Result := fpr.Id;
        end;
      finally
        FreeAndNil(fpr);
      end;
    end;
  end;
end;

