  Result := -1; // nie generujemy plik, gdy lista jest pusta

  if Assigned(ASourceDispFile) and Assigned(Self._File.Callback) then
  begin
    sA80FileLocalPath := TempFileName(ASourceDispFile.Name);
    if not FileExists(sA80FileLocalPath) then
      CopyFile(PWideChar(ASourceDispFile.FileAttachment.LocalFileName), PWideChar(sA80FileLocalPath), False);

