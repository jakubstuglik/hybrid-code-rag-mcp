class function TSalesReport.DeleteServerReportWithError(AdmMain: TdmMain;
  AShowConfirmationMessage: Boolean;
  AReportFileType: Byte; AReportFileSubDir, AReportFileName: String): Boolean;
var
  sFileName: String;
begin
{$IF NOT DEFINED(DSSERVER)}
  Result := False;
  if (not AShowConfirmationMessage)
    or
    AShowConfirmationMessage
    and(MessageDlg(DEL_REC, mtConfirmation, [mbYes, mbNo], 0) = ID_YES)
    and(MessageDlg(RS_SALESREPORT_IN_STACK_BEFORE_DELETE_QUESTION, mtWarning, [mbYes, mbNo], 0) = ID_YES)
  then
  begin
{$ENDIF}
    sFileName := ExtractFileName(AReportFileName);
    Result := AdmMain.DeleteIncorrectReportFile(
      AReportFileType,
      IncludeTrailingPathDelimiter(AReportFileSubDir) + sFileName);
    if Result then
    begin
      // if exists an active record in SLS_SalesReportTasksToDo table, deactivate it
      TSalesReportTasksToDo.SalesReportTasksToDoSetActive(AdmMain, 0, 4, 0, Format(', "ReportName":"%s"', [sFileName]));
    end;
{$IF NOT DEFINED(DSSERVER)}
  end;
{$ENDIF}
end;

class function TSalesReport.GetUserIDForSaveBasedOnPath(AdmMain: TdmMain; AReportFullPath: String; ADefaultUserID: Integer): Integer;
var
  iUserID, iPosStart, iPosEnd: Integer;
  sFolder: String;
  oUser: Users.TUser;
begin
  Result := ADefaultUserID;
  AReportFullPath := AReportFullPath.Trim;
  if (Result = 1{Admin})and(AReportFullPath <> '') then
  begin
    if ExtractFileExt(AReportFullPath) <> '' then
      sFolder := ExtractFileName(ExtractFileDir(AReportFullPath))
    else
      sFolder := ExtractFileName(ExcludeTrailingPathDelimiter(AReportFullPath));

    iPosStart := Pos(C_DBUSERID_FOLDER_START, sFolder);
    if iPosStart <> 0 then
    begin
      Delete(sFolder, iPosStart, Length(C_DBUSERID_FOLDER_START));
      iPosEnd := Pos(C_DBUSERID_FOLDER_END, sFolder);
      if iPosEnd <> 0 then
      begin
        Delete(sFolder, iPosEnd, Length(sFolder) - iPosEnd + 1);
        if TryStrToInt(sFolder, iUserID) then
          Result := iUserID;
      end;
    end;
  end;
  if Result <> 1 then // not Admin
  begin
    oUser := Users.TUser.Create;
    try
      if not Assigned(oUser.dmMain) then
        oUser.dmMain := AdmMain;
      if not oUser.ReadFromDatabase(Result) then // in case doesn't exists or something else
        Result := 1; // Admin
    finally
      FreeAndNil(oUser);
    end;
  end;
end;

