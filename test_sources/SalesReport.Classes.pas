function TSalesReportEmar105.getTicketRegisterFirmwareVersionStr(AEMAR205: Boolean;
  Arel_01: IEmar_ReportEvent_01; Arel_41: IEmar_ReportEvent_41): String;
var
  iLength: Byte;
  sFirmwareVersion: String;
begin
  Result := 'V';
  try
    if AEMAR205 then
      Result := Result + String(Arel_41.FirmwareVersion)
    else
    begin
      sFirmwareVersion := IntToStr(Arel_01.FirmwareVersion);
      iLength := sFirmwareVersion.Length;
      if iLength > 2 then
       iLength := 2;
      Result := Result + '1.' +
        StringOfChar('0', 2 - iLength) + sFirmwareVersion;
    end;
  except
    raise Exception.Create(Format('Brak zdarzenia "%s"', [IfThen(AEMAR205, Anag[41], Anag[1]).Trim()]));
  end;
end;

function TSalesReportEmar105.getTicketRegisterFirmwareVersionByte(AEMAR205: Boolean;
  Arel_01: IEmar_ReportEvent_01; Arel_41: IEmar_ReportEvent_41): Byte;
var
  sMinorFirmwareVersion: String;
  verArray: TStringDynArray;
begin
  try
    if AEMAR205 then
    begin
      Result := 0;
      sMinorFirmwareVersion := Arel_41.FirmwareVersion;
      verArray := SplitString(sMinorFirmwareVersion, '.');
      if Length(verArray) > 1 then
        Result := StrToIntDef(verArray[1], 0);
    end
    else
      Result := Arel_01.FirmwareVersion;
  except
    raise Exception.Create(Format('Brak zdarzenia "%s"', [IfThen(AEMAR205, Anag[41], Anag[1]).Trim()]));
  end;
end;

