function DajRFZamRF(const AEvent_05: IEmar_ReportEvent_05; const ARecordsCount: Integer): TRFZamRF;
var
  rf: TRFZamRF;
  //gok, dok: boolean;
  i: integer;
  netptu: int64;
  zlawart: boolean;
  cTicketRegister: PWideChar;
begin
  rf.Blad := False;
  cTicketRegister := AEvent_05.TicketRegister;
  rf.Logo := '';
  Move(cTicketRegister[0], rf.Logo[0], Length(cTicketRegister) * SizeOf(Char)); //Move(A[nr+11],rf.Logo[0],12);
  rf.NrRF := AEvent_05.FiscalReportNumber; //Czw(A,nr+23);
  rf.StatusRF := AEvent_05.FiscalReportState; //A[nr+25];
  //if JestZadLK(A,nr+26,5,$ff) then
  if AEvent_05.FiscalReportCode = 'FFFFFFFFFF' then
    rf.KodKRF := 'FFFFFFFFFF'
  else
    rf.KodKRF := ShortString(AEvent_05._FiscalReportCode_Decoded);
  zlawart := False;
  rf.WalEwid := '';  //E.B. 05.09.2010
  rf.DataWalEwid := '';
  rf.GodzWalEwid := '';
  rf.DataPPar := '';  //E.B. 20.06.2016
  rf.GodzPPar := '';
  rf.DataOPar := '';
  rf.GodzOPar := '';

  if not AEvent_05.IsError(reErrorPartMissing2 or reErrorCheckSum2) then
  begin
    rf.NrStawek := AEvent_05.TaxRatesIndex; //A[nr+DRe.RAP+3];
    rf.StZerRAM := AEvent_05.MemoryClearState; //A[nr+DRe.RAP+4];
    rf.NrZerRAM := AEvent_05.MemoryClearCount; //A[nr+DRe.RAP+5];
    rf.NrODok := AEvent_05.DocumentNumber mod 100000000; //Czdw(A,nr+DRe.RAP+6) mod 100000000;
    rf.NrOBil := AEvent_05._LastTicketNumberUsedHighPart; //Czw(A,nr+DRe.RAP+10);
    rf.Brutto := AEvent_05.Brutto; //Czi(A,nr+DRe.RAP+12);
    rf.LBil := AEvent_05.TicketCount; //Czw(A,nr+DRe.RAP+16);
    if (WzZb.WersjaPSB > 6) and (String(AEvent_05.FirstBillDate) <> '' {A[nr+DRe.RAP+18]<>$ff}) then  //E.B. 20.06.2016
    begin
      //rf.DataPPar := EmarDate(EmarDateToDate(String(AEvent_05.FirstBillDate))); //DateToStr(DajData(A,nr+DRe.RAP+18,dok));
      rf.DataPPar := DateToStr(EmarDateToDate(String(AEvent_05.FirstBillDate))); //DateToStr(DajData(A,nr+DRe.RAP+18,dok));
      rf.GodzPPar := EmarTime(EmarTimeToTime(String(AEvent_05.FirstBillTime))); //TimeToStr(DajGodz(A,nr+DRe.RAP+22,gok));
      //rf.DataOPar := EmarDate(EmarDateToDate(String(AEvent_05.LastBillDate))); //DateToStr(DajData(A,nr+DRe.RAP+25,dok));
      rf.DataOPar := DateToStr(EmarDateToDate(String(AEvent_05.LastBillDate), False)); //DateToStr(DajData(A,nr+DRe.RAP+25,dok));
      rf.GodzOPar := EmarTime(EmarTimeToTime(String(AEvent_05.LastBillTime), False)); //TimeToStr(DajGodz(A,nr+DRe.RAP+29,gok));
    end;
  end
  else
  begin
    rf.NrStawek := 0;
    rf.StZerRAM := $55;
    rf.NrZerRAM := 0;
    rf.NrODok := 0;
    rf.NrOBil := 0;
    rf.Brutto := 0;
    rf.LBil := 0;
  end;
  netptu := 0;

  if not AEvent_05.IsError(reErrorPartMissing3 or reErrorCheckSum3) then
  begin
    for i := 1 to 7 do
    begin
      rf.Netto[i] := AEvent_05.NettoByTaxRate[i]; //Czi(A, nr+DRe.RAP*2+3+i*4);
      if rf.Netto[i] < 0 then
        zlawart := True;
      netptu := netptu + rf.Netto[i];
    end;
    if (WzZb.WersjaPSB > 4)and(Trim(AEvent_05.CurrencyCode) <> ''{A[nr+DRe.RAP*2+31]<>$ff}) then
    begin //E.B. 05.09.2010
      rf.WalEwid := ShortString(Trim(AEvent_05.CurrencyCode)); //string(PChar(@A[nr+DRe.RAP*2+31]));
      if Trim(AEvent_05.CurrencySaveTime) <> '' then
        rf.GodzWalEwid := AEvent_05.CurrencySaveTime; //TimeToStr(DajGodz(A,nr+DRe.RAP*2+35,gok));
    end;
  end
  else
    for i := 1 to 7 do
      rf.Netto[i] := 0;

  if not AEvent_05.IsError(reErrorPartMissing4 or reErrorCheckSum4) then
  begin
    for i := 1 to 7 do
    begin
      rf.Ptu[i] := AEvent_05.TaxAmount[i]; //Czi(A,nr+DRe.RAP*3+3+i*4);
      if rf.Ptu[i] < 0 then
        zlawart := True;
      netptu := netptu + rf.Ptu[i];
    end;
    if (WzZb.WersjaPSB > 4)and(Trim(AEvent_05.CurrencyCode) <> ''{A[nr+DRe.RAP*3+31]<>$ff})
      and(Trim(AEvent_05.CurrencySaveDate) <> '')
    then //E.B. 05.09.2010
      rf.DataWalEwid := AEvent_05.CurrencySaveDate; //DateToStr(DajData(A,nr+DRe.RAP*3+31,dok));
  end
  else
    for i := 1 to 7 do
      rf.Ptu[i] := 0;
  if (rf.LBil > 9999)or(netptu <> rf.Brutto)or zlawart then
    rf.Blad := True;
  Result := rf;
end;

function ZnaNastRek(ASalesReport: TSalesReport; ARecordIndex: Integer;
  ARichEdit: TRichEdit;
  var AErrorsInProcessTasks: Boolean;
  var AlrekTotal: Integer; const Apisz: Boolean): Boolean;
const
  C_EVENTS_IGNORE_CHECKSUM_1 = [22];
  C_EVENTS_CHECKSUM_1_ONLY = [1, 5, 32, 34];
var
//  bsk: boolean;
  s: String;
  //i: integer;
  rel: IEmar_ReportEvent;
begin
  Result := True;
  if Assigned(ASalesReport) and Assigned(ASalesReport._File) then
  begin
    rel := ASalesReport._File.ReportEventList[ARecordIndex];
    Inc(AlrekTotal, rel.ReportRecordCount);
    // jeśli zdarzenie nie wpływa na końcowy wynik rejestracji raportu, to ignorujemy błąd sumy kontrolnej
    if not(rel.Kind in C_EVENTS_IGNORE_CHECKSUM_1) then
    begin
  //        Result:=SumKonOk(ir,38);                         //suma kontrolna pełnego rekordu
      // w zdarzeniach z jednym rekordem oraz w zdarzeniu #1, #5, #32 oraz #34 konieczną jest poprawność rekordu 1
      if (rel.ReportRecordCount = 1)or(rel.Kind in C_EVENTS_CHECKSUM_1_ONLY) then
        Result := not rel.IsError(reErrorCheckSum1) // jedynie suma kontrolna pełnego rekordu 1
      else
        Result := not rel.IsError(C_ERR_INCORRECT_RECORD_CHECKSUM); // suma kontrolna pełnego zdarzenia
      if not Result and (rel.ReportRecordCount{Arap[ir+2]}=1) and (rel.Kind{Arap[ir+3]}<=31) then
        //Result:=SumKonOk(ir,adlr1[Arap[ir+3]]);        //suma kontrolna z $FF zamiast pustych pól
        Result := not rel.IsError(C_ERR_INCORRECT_RECORD_1); //suma kontrolna z $FF zamiast pustych pól AT: ???

      if not Result then
      begin
        //if Arap[ir+DRe.RAP-1]=$ff then
        if rel.Bytes[38] = $FF then // the first record ends with $FF
        begin
          if Apisz and Assigned(ARichEdit) then
          begin
            s := Format(C_FMT_INCOMPLETE_RECORD_ENTRY, [AlrekTotal]); //IntToStr(ir div DRe.RAP);
            ASalesReport.OutputLine(ARichEdit, s, clError, fsRegular);
          end;
        end
        else
        begin
          if rel.Kind{Arap[ir+3]} = 23 then
          begin
            if {WyswR and} Apisz and Assigned(ARichEdit) then
            begin                //E.B. 10.06.2015
              s := 'Błędny rekord ' + IntToStr(rel.Kind); //IntToStr(ir div DRe.RAP);
              ASalesReport.OutputLine(ARichEdit, s, clError, fsRegular);
  // AT:                WysRek(Arap,ir,1,'',nrrek,RE);  //E.B. 10.06.2015
            end;
          end;
          if rel.Kind{Arap[ir+3]} = 1 then
          begin
            lrek := 4;
  //              BadajLRek(ir,lrek);
  //              i:=ir+DRe.RAP*lrek;
  //              while (i<IxA.Ixrap) and (Arap[i]<>101) do i:=i+DRe.RAP;
  //              if (i<IxA.Ixrap) and (Arap[i+3]=1) then
  //              begin
  ////AT:                if WyswR and Apisz then
  ////AT:                begin                //E.B. 10.06.2015
  ////AT:                  ALine := 'Błędny wpis identyfikacji bileterki od rekordu ' + IntToStr(rel.Kind); //IntToStr(ir div DRe.RAP);
  ////AT:                  OutputLine(re, clError, fsRegular);
  ////AT:                  WysRek(Arap,ir,lrek-1,'',nrrek,RE);  //E.B. 10.06.2015
  ////AT:                end;
  //// AT:                ir:=ir+DRe.RAP*(lrek-1);
  //// AT:                Continue;
  //              end;
  //              if (lrek = 4) and PorLogoiNrrf then
  //              begin
  ////AT:                if WyswR and Apisz then
  ////AT:                begin                //E.B. 10.06.2015
  ////AT:                  ALine := 'Błędny wpis identyfikacji bileterki od rekordu ' + IntToStr(rel.Kind); //IntToStr(ir div DRe.RAP);
  ////AT:                  OutputLine(re, clError, fsRegular);
  ////AT:                  WysRek(Arap,ir,lrek-1,'',nrrek,RE);  //E.B. 10.06.2015
  ////AT:                end;
  //// AT:                ir:=ir+DRe.RAP*3;
  //// AT:                Continue;
  //              end;
          end;
          if Apisz and(rel.Kind <> 0) and Assigned(ARichEdit) then // ignorujemy sprawdzanie sumy kontrolnej dla zdarzenia 0, ponieważ w starym programie ona błędnie liczona
          begin
            s := Format(C_FMT_RECORD_CHECKSUM_ERROR, [AlrekTotal]); //IntToStr(ir div DRe.RAP);
            ASalesReport.OutputLine(ARichEdit, s, clError, fsStrong);
            nr := rel.Kind; //Arap[ir+3];
            s := Format(C_FMT_LIKELY_RECORD_KIND, [nr]);
                       //E.B. 13.07.2010
            if nr in [0..EMAR105_MaxReportEventID] then s := s + Anag[nr];
            ASalesReport.OutputLine(ARichEdit, s, clError, fsStrong);
            AErrorsInProcessTasks := True;
          end;
        end;
      end;
    end;
  end
end; //ZnaNastRek

function SprNastRekOk(ASalesReport: TSalesReportEmar105; ARecordIndex: Integer;
  ARichEdit: TRichEdit; var AErrorsInProcessTasks: Boolean): boolean; //false: następny rekord jest powtórzeniem
var
  bErrorsInProcessTasks: Boolean;
  i,lr: integer;
  r: TRFEMKNowyBilet;
  rbi: TRFEMKBI;
  nrem: double;
  d1,d2: TDateTime;
begin
  Result := True;
  if Assigned(ASalesReport) and Assigned(ASalesReport._File)
    and(ARecordIndex > -1)and(ARecordIndex < ASalesReport._File.ReportEventList.Count)
  then
  begin
    bErrorsInProcessTasks := False;
    i := ARecordIndex;
    d1 := EmarDateTimeToDateTime(ASalesReport._File.ReportEventList.Items[ARecordIndex].EventDate, ASalesReport._File.ReportEventList.Items[ARecordIndex].EventTime); // dat;
    if i < Pred(ASalesReport._File.ReportEventList.Count) then
    begin
      repeat
        Inc(i);
        ZnaNastRek(ASalesReport, i, ARichEdit, bErrorsInProcessTasks, lr, false);
      until (not bErrorsInProcessTasks)or(i = Pred(ASalesReport._File.ReportEventList.Count));
    end
    else
      Inc(i);
    if bErrorsInProcessTasks then
      AErrorsInProcessTasks := True;
    if i >= ASalesReport._File.ReportEventList.Count {IxA.Ixrap} then
      Exit;
    if not (ASalesReport._File.ReportEventList.Items[i].Kind in[17,32,33]) then
      Exit;
    case ASalesReport._File.ReportEventList.Items[i].Kind of
      17: begin
        d2 := EmarDateTimeToDateTime(ASalesReport._File.ReportEventList.Items[i].EventDate, ASalesReport._File.ReportEventList.Items[i].EventTime);
        if d2 - d1 > 2 / (24 * 60 * 60) then exit;
        nrem := ASalesReport._File.ReportEventList.Items[i].AsEvent_17.CardNumber;
        if nrem <> EMKNowyBilet.NrEMKarty then exit;
        if i < Pred(ASalesReport._File.ReportEventList.Count) then
        begin
          repeat
            Inc(i);
            ZnaNastRek(ASalesReport, i, ARichEdit, bErrorsInProcessTasks, lr, false);
          until (not bErrorsInProcessTasks)or(i = Pred(ASalesReport._File.ReportEventList.Count));
        end
        else
          Inc(i);
        if i >= ASalesReport._File.ReportEventList.Count {IxA.Ixrap} then exit;
        if ASalesReport._File.ReportEventList.Items[i].Kind <> 33 then exit;
        d2 := EmarDateTimeToDateTime(ASalesReport._File.ReportEventList.Items[i].EventDate, ASalesReport._File.ReportEventList.Items[i].EventTime);
        if d2 - d1 > 2 / (24 * 60 * 60) then Exit;
        rbi := DajRFEMKBI(ASalesReport._File.ReportEventList.Items[i].AsEvent_33);
        if (rbi.NrEMKarty = EMKNowyBilet.NrEMKarty)and(rbi.KodBledu = 67) then
        begin //ta sama karta
          pominR17 := True;
          Result := False;
        end;
      end;
      32: begin
        r := DajRFEMKNowyBilet(ASalesReport, ASalesReport._File.ReportEventList.Items[i].AsEvent_32, i);
        if (r.NrEMKarty=EMKNowyBilet.NrEMKarty) and
           (r.NrBiletu=EMKNowyBilet.NrBiletu) and
           (r.NrBil=EMKNowyBilet.NrBil) and               //E.B. 19.03.2019
           (r.WazOd=EMKNowyBilet.WazOd) then Result:=false; //powtórzenie
      end;
      33: begin
        rbi := DajRFEMKBI(ASalesReport._File.ReportEventList.Items[i].AsEvent_33);
        if (rbi.NrEMKarty=EMKNowyBilet.NrEMKarty) and
           (rbi.KodBledu=67) then Result:=false;  //ta sama karta
      end;
    end;
  end;
end; //SprNastRekOk

