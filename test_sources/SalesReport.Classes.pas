function TSalesReportEmar105.GetReportStartDate: TDateTime;
var
  iRecord: Integer;
begin
  Result := inherited GetReportStartDate();
  if _File.ReportEventList.Count = 1 then // pusta karta
    Result := EmarDateTimeToDateTime(
        _File.ReportEventList[0].EventDate,
        _File.ReportEventList[0].EventTime) // data i godzina zdarzenia 'szyfr raportu'
  else
    if _File.ReportEventList.Count > 1 then // ignorujemy zdarzenie 'Szyfr raportu'
    begin
      iRecord := 1;
      while (iRecord < _File.ReportEventList.Count)and((_File.ReportEventList[iRecord].EventDate = '')or(_File.ReportEventList[iRecord].EventTime = '')) do
        Inc(iRecord);
      if iRecord < _File.ReportEventList.Count then
        Result := EmarDateTimeToDateTime(
          _File.ReportEventList[iRecord].EventDate,
          _File.ReportEventList[iRecord].EventTime); // data i godzina początku zadania
    end;
end;

function TSalesReportEmar105.GetReportEndDate: TDateTime;
var
  iRecord: Integer;
begin
  Result := inherited GetReportEndDate();
  if _File.ReportEventList.Count = 1 then // pusta karta
    Result := EmarDateTimeToDateTime(
        _File.ReportEventList[0].EventDate,
        _File.ReportEventList[0].EventTime) // data i godzina zdarzenia 'szyfr raportu'
  else
    if _File.ReportEventList.Count > 1 then // ignorujemy zdarzenie 'Szyfr raportu'
    begin
     iRecord := Pred(_File.ReportEventList.Count);
      while (iRecord > 0)and((_File.ReportEventList[iRecord].EventDate = '')or(_File.ReportEventList[iRecord].EventTime = '')) do
        Dec(iRecord);
      if iRecord > 0 then
        Result := EmarDateTimeToDateTime(
          _File.ReportEventList[iRecord].EventDate,
          _File.ReportEventList[iRecord].EventTime); // data i godzina końca zadania
    end;
end;

function TSalesReportEmar105.GetTempBusPCID(const ABusPCType_ID: Integer;
  const ABusPCSN, AFirmwareVersion, AStockNumber: String): Integer;
var
  iDriver_ID: Integer;
  pc: TBusPC;
begin
  // szukamy czy już dodaliśmy
  Result := 0;
  if ABusPCSN <> '' then
  begin
    TempBusPCList.TryGetValue(ABusPCSN, Result);
    if Result = 0 then
    begin
      Result := TBusPC.GetBusPCId(ABusPCSN, LicencesCompanyID, dmMain);
      if Result <= 0 then
      begin
        // parametr 'Rejestracja raportów tylko z bileterek zarejestrowanych'
        if LPCRegistrationParamsParameters.RegistrationRaportsTicketRegistered then
        begin
          Result := -2;
          AddToDesc(Format(SALES_REPORT_MSG_BUSPC_NOT_REGISTERED, [ABusPCSN]), True);
        end
        else
        begin
          if not Assigned(Licences) then
          begin
            Result := -100;
            AddToDesc(RS_LIC_ERR_READ, True);
          end
          else
            if (Licences.Value('BUSPC') <> -1) // uwzględniamy parametr licencji Komputerów Pokładowych
              and(Licences.Value('BUSPC') <= Licences.GetCurrentValue('BUSPC')) then
            begin
              Result := -1;
              AddToDesc(Format(SALES_REPORT_MSG_BUSPC_OUT_OF_MAXVALUE, [ABusPCSN]));
            end
            else
            begin
              pc := TBusPC.Create;
              try
                pc.Clear;
                pc.BusPCType_ID := ABusPCType_ID;
                pc.InService := True;
                pc.InServiceStartDate := Int(Now);
                pc.BusPCSN := ABusPCSN;
                pc.FirmwareVersion := AFirmwareVersion;
                pc.StockNumber := AStockNumber;
                pc.CompanyOwner_ID := LicencesCompanyID;

                if pc.WriteToDatabase then
                begin
                  Result := pc.Id;
                  TempBusPCList.Add(ABusPCSN, pc.Id); // add just added BusPC to the temporary list
                end
                else
                  AddToDesc(Format(SALES_REPORT_MSG_BUSPC_NOT_SAVED, [ABusPCSN]));
              finally
                FreeAndNil(pc);
              end;
            end;
        end;
      end
      else
      begin
        TempBusPCList.Add(ABusPCSN, Result);
        TBusPC.UpdateFirmwareVersion(dmMain, Result, AFirmwareVersion);
      end;

      if Result > 0 then
      begin
        iDriver_ID := FileC.GetDriverIDFromIDNumberAndNames(ptDriver{kierowcy},
              _File.OIK.DriverNumber,
              _File.OIK.DriverFirstName,
              _File.OIK.DriverLastName);
        if iDriver_ID = 0 then
        begin
          {$IF DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER)}
          iDriver_ID := C_PERSON_ID_AUTOREGISTRATION;
          {$ELSE}
          AddToDesc(Format(C_FMT_DRIVERS_NOT_EXISTS,
            [
              _File.OIK.DriverFirstName
              , _File.OIK.DriverLastName
              , _File.OIK.DriverNumber
            ]));
          {$ENDIF}
        end;
        dmMain.StoredProc('dbo', 'MAT_BusPCXDriver_KPInsert',
          '@buspc_id=' + IntToStr(Result)
          + #13#10'@driver_id=' + IntToStr(iDriver_ID));
      end;
    end
    else
      TBusPC.UpdateFirmwareVersion(dmMain, Result, AFirmwareVersion);
  end
  else
    AddToDesc(SALES_REPORT_MSG_TICKETREGISTER_IS_BLANK);
end;

