      finally
        FreeAndNil(c);
      end;
    end;
  end;

  function BladZapisuDoEMK(ARecordIndex: Integer) : Boolean;
  var
    iOldRecordIndex: Integer;
    re: IEmar_ReportEvent;
  begin
    Result := False;
    iOldRecordIndex := ARecordIndex;  //początek rekordu rejestracji przejazdu
    Inc(ARecordIndex); //ARecordIndex := ARecordIndex+DRe.RAP*3; //początek następnego rekordu
    if ARecordIndex < _File.ReportEventList.Count then
    begin
      re := _File.ReportEventList.Items[ARecordIndex];
      Result := (re.Kind = 33) //33 - Rejestracja przejazdu z biletem miesięcznym (karta MIFARE) - błędy identyfikacji
        and(re.AsEvent_33.ErrorCode = 67) // 67=bląd zapisu EM-Karty
        and(String(_File.ReportEventList.Items[iOldRecordIndex].EventDate) = String(re.EventDate))
        and(String(_File.ReportEventList.Items[iOldRecordIndex].EventTime) = String(re.EventTime));
    end;
  end;

  function PoprawneLogo(const ALogo: ShortString): Boolean;
  var
    i: Integer;
  begin
    Result := False;
    if Length(ALogo) = 14 then
    begin      //E.B. 07.01.2014
      for i := 1 to 3 do
        if not CharInSet(ALogo[i], ['A'..'Z']) then
          Exit;
      if ALogo[4] <> ' ' then
        Exit;
      for i := 5 to 14 do
        if not CharInSet(ALogo[i], ['0'..'9']) then
          Exit;
    end
    else
    begin
      if Length(ALogo) <> 12 then
        Exit;
      for i := 1 to 2 do
        if not CharInSet(ALogo[i], ['A'..'Z']) then
          Exit;
      if not CharInSet(ALogo[3], [' ','A'..'Z']) then
        Exit;
      if ALogo[4] <> ' ' then
        Exit;
      for i := 5 to 12 do
        if not CharInSet(ALogo[i], ['0'..'9']) then
          Exit;
    end;
    Result := True;
  end;

