{ TWFile }

procedure TWFile.Clear;
begin
    aCFile := '';
    aDriverNR := 0;
    aTicketCnt := 0;
    aAmount := 0;
    aCardNR := 0;
    aImie := '';
    aNazwisko := '';
    if assigned(Slist) then
      aSlist.Clear;
    aWDateTime := 0;
    aName := '';
end;

constructor TWFile.Create;
begin
  inherited;
  aSlist := TStringList.Create;
end;

destructor TWFile.Destroy;
begin
  FreeAndNil(aSlist);
  inherited;
end;

function TWFile.ReadFile(aFileName: String): integer;
  function removeExtraChars(AAmount: String; ADecimalSeparator: Char): String;
  var
    i: SmallInt;
  begin
    Result := '';
    for i := 1 to AAmount.Length do
      if CharInSet(AAmount[i], ['0'..'9', ADecimalSeparator]) then
        Result := Result + AAmount[i];
  end;
var
  TF : TextFile;
  aLine, sFloatValue: String;
  FS: TFormatSettings;
  IsCash: boolean;
  poz: integer;
  naglowek: string;
begin
  if FileExists(aFileName) then
  begin
    FS:= TFormatSettings.Create;
    FS.DateSeparator := '.';
    FS.ShortDateFormat := 'dd.mm.yyyy';
    Clear;
    aName := AnsiRightStr(ExtractFileName(aFileName), 50);
    aDIR := AnsiReplaceText(aFileName, aName, '');
    IsCash := False;

    try
      AssignFile(TF, aFileName);
      Reset(TF);
      ReadLn(TF, naglowek);

      if naglowek = C_W_FILE_SEC_ERROR then
      begin
        Result := 0;
        aName := '';
        Exit
      end;

      {
        1) pierwszy wiersz – identyfikacja zawartości
          a) RAPORT ZADANIOWY – plik zawiera kwotę utargu
          b) BRAK RAPORTU – plik zawiera identyfikację kierowcy bez kwoty utargu
          c) BŁĄD – plik zawiera informację o błędzie do wydruku – wpłata zabroniona
      }
      if (naglowek <> C_W_FILE_SEC_ERROR)and(naglowek <> C_W_FILE_SEC_BRAK)and(naglowek <> C_W_FILE_SEC_RZ) then
      begin // nieobsługiwana identyfikacja zawartości
        Result := -1;
        aName := '';
        Exit
      end;

      while not SeekEof(TF) do
      begin
        ReadLn(TF, aLine);

        if (WDateTime = 0)and(AnsiContainsText(aLine, C_W_FILE_SEC_DATA)) then
        begin
          aWDateTime := StrToDateTime(Trim(Copy(aLine, Length(C_W_FILE_SEC_DATA), 30)), FS);
          IsCash := False;
          Continue;
        end;

        if AnsiContainsText(aLine, C_W_FILE_SEC_BANKNOTY) then
        begin
          IsCash := True;
          Continue
        end;

        if IsCash then
          if AnsiContainsText(aLine, C_W_FILE_SEC_MONETY) then
            Continue
          else
          begin
            poz := AnsiPos(':', aLine);
            sFloatValue := Copy(aLine, 0, poz - 1);
            sFloatValue := FastStringReplace(sFloatValue, ',', FS.DecimalSeparator, [rfReplaceAll]);
            sFloatValue := FastStringReplace(sFloatValue, '.', FS.DecimalSeparator, [rfReplaceAll]);
            sFloatValue := removeExtraChars(sFloatValue, FS.DecimalSeparator); // thousands separator
            aSlist.AddObject(
              FloatToStr(StrToFloat(sFloatValue, FS) * 100),
                TObject(StrToIntDef(Trim(Copy(aLine, poz + 1, 30)), 0)));
            Continue;
          end;

        if (CFile = '')and(naglowek = C_W_FILE_SEC_RZ) then
          if AnsiContainsText(aLine, C_W_FILE_SEC_ZBIOR) then
          begin
            aCFile := Trim(Copy(aLine, Length(C_W_FILE_SEC_ZBIOR), 30));
            Continue;
          end;

        if DriverNR = 0 then
          if AnsiContainsText(aLine, C_W_FILE_SEC_NRKIER) then
          begin
            aDriverNR := StrToIntDef(Trim(Copy(aLine, Length(C_W_FILE_SEC_NRKIER), 30)), 0);
            Continue;
          end;

        if TicketCnt = 0 then
          if AnsiContainsText(aLine, C_W_FILE_SEC_BILETY) then
          begin
            aTicketCnt := StrToIntDef(Trim(Copy(aLine, Length(C_W_FILE_SEC_BILETY), 30)), 0);
            Continue;
          end;

        if Amount = 0 then
          if AnsiContainsText(aLine, C_W_FILE_SEC_WPLATA) then
          begin
            sFloatValue := Trim(Copy(aLine, Length(C_W_FILE_SEC_WPLATA), 30));
            sFloatValue := FastStringReplace(sFloatValue, ',', FS.DecimalSeparator, [rfReplaceAll]);
            sFloatValue := FastStringReplace(sFloatValue, '.', FS.DecimalSeparator, [rfReplaceAll]);
            sFloatValue := removeExtraChars(sFloatValue, FS.DecimalSeparator); // thousands separator
            aAmount := Round(StrToFloat(sFloatValue, FS) * 100);
            Continue;
          end;

        if CardNR = 0 then
          if AnsiContainsText(aLine, C_W_FILE_SEC_NRKARTY) then
          begin
            aCardNR := StrToIntDef(Trim(Copy(aLine, Length(C_W_FILE_SEC_NRKARTY), 30)), 0);
            Continue;
          end;

        if (aImie = '')and AnsiContainsText(aLine, C_W_FILE_SEC_IMIE) then
        begin
          aImie := Trim(Copy(aLine, Length(C_W_FILE_SEC_IMIE), 60));
          Continue;
        end;

        if (aNazwisko = '')and AnsiContainsText(aLine, C_W_FILE_SEC_NAZWISKO) then
        begin
          aNazwisko := Trim(Copy(aLine, Length(C_W_FILE_SEC_NAZWISKO), 60));
          Continue;
        end;
      end;
      Result := 1;
    finally
      CloseFile(TF);
    end;
  end
  else
    Result := 0;
end;

