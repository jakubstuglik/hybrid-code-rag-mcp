  f: TFiscalReport;
  t: TTicket;
begin
  Result := 0;
  for f in FiscalReportList do
    if Assigned(f.TicketList) then
      for t in f.TicketList do
        if t.IsEmCardDeposit then // kaucja\lub zwrot kaucji
         Inc(Result);
end;

function TSalesReport.RecogSum(APaymentType: Integer): Int64;
var
  f: TFiscalReport;
  t: TTicket;
  pt: TTicketPaymentTypeEMAR205;
begin
  Result := 0;
  for f in FiscalReportList do
    if Assigned(f.TicketList) then
      for t in f.TicketList do
        if t.IsEmCardDeposit then // kaucja\lub zwrot kaucji
        begin
          if t.PaymentType.Id = APaymentType then
            Result := Result + t.AmountToPay
          else
            if (APaymentType in [Ord(ptvCash), Ord(ptvCreditCard)])
              and(t.PaymentType.Id = Ord(ptvMixed)) then
            begin
              for pt in t.TicketPaymentTypeEMAR205List do
                if pt.PaymentType_ID = APaymentType then
                  Result := Result + pt.Amount;
            end;
        end;
end;

function TSalesReport.GetPassangerCount(aTicketType: Integer; aTicketGenreValues: integer = 0): Integer;
var
  bIgnoreTicketGenreValues: Boolean;
  f: TFiscalReport;
  t: TTicket;
begin
  Result := 0;
  bIgnoreTicketGenreValues := aTicketGenreValues = Integer(tgvNone);
  for f in FiscalReportList do
  begin
    for t in f.TicketList do
      if (t.TicketType.Id = aTicketType)
         and(bIgnoreTicketGenreValues or(t.TicketGenre.Id = aTicketGenreValues)) then
        Inc(Result, t.PassangerNumber);
  end;
end;

