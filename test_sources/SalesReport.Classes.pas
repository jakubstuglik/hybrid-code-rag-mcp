  3. najpierw rejestrują się pliki M (sprzedaż), a potem pliki Z (zwroty)
}
function ReportFilesListCompare(List: TStringList; Index1, Index2: Integer): Integer;
  function CompareEmarFileName(aFileName1, aFileName2: String): Integer;
  var
    S1, S2: String;
  begin
    {
      Csskkkkkkrrrrmmddnn.DAT (23) - nazwa zbioru z raportem
        odczytanym na stanowisku do automatycznej rejestracji
        (ss-nr stanowiska,
        kkkkkk-nr karty,
        rrrrmmdd-data,
        nn-kolejny numer odczytu danych z karty danego dnia)
    }
    if (Length(aFileName1) >= 17)
      and(Length(aFileName2) >= 17)
      and(CharInSet(aFileName1[1], ['C', 'K']))
      and(CharInSet(aFileName2[1], ['C', 'K'])) then
    begin
      S1 := Copy(aFileName1, 10, 8); // rrrrmmdd
      S2 := Copy(aFileName2, 10, 8); // rrrrmmdd
      Result := CompareText(S1, S2);
      if Result = 0 then // ten sam dzień
      begin
        S1 := Copy(aFileName1, 4, Length(aFileName1) - 3); // bez C lub K oraz numeru stanowiska ss
        S2 := Copy(aFileName2, 4, Length(aFileName2) - 3); // bez C lub K oraz numeru stanowiska ss
        Result := CompareText(S1, S2);
        if Result = 0 then
          Result := CompareText(aFileName1, aFileName2);
      end;
    end
    else
      Result := CompareText(aFileName1, aFileName2);
  end;
var
  sFirst: String;
  sSecond: String;
  fFirst, fSecond: TFilesSortTypes;
begin
  sFirst := AnsiUpperCase(ExtractFileName(List[Index1]));
  sSecond := AnsiUpperCase(ExtractFileName(List[Index2]));
  if (Length(sFirst) > 0)and(Length(sSecond) > 0) then
  begin
    case sFirst[1] of
      'M':
        begin
          if (Length(sFirst) > 1)and(CharInSet(sFirst[2], ['A'..'Z'])) then
            fFirst := fstMc
          else
            fFirst := fstMn;
        end;
      'Z': fFirst := fstZ;
      'W': fFirst := fstW;
      'C':
        if (Length(sFirst) > 2)and(Copy(sFirst, 1, 3) = 'CDS') then // CDS
          fFirst := fstCDS
        else
          fFirst := fstC;
      'K': fFirst := fstK;
      else
{$IFNDEF DSSERVER}
        raise Exception.Create(Format('Unsupported file type %s.', [sFirst]));
{$ELSE}
        fFirst := fstC;
{$ENDIF}
    end;
    case sSecond[1] of
      'M':
        begin
          if (Length(sSecond) > 1)and(CharInSet(sSecond[2], ['A'..'Z'])) then
            fSecond := fstMc
          else
            fSecond := fstMn;
        end;
      'Z': fSecond := fstZ;
      'W': fSecond := fstW;
      'C':
        if (Length(sSecond) > 2)and(Copy(sSecond, 1, 3) = 'CDS') then // CDS
          fSecond := fstCDS
        else
          fSecond := fstC;
      'K': fSecond := fstK;
      else
{$IFNDEF DSSERVER}
        raise Exception.Create(Format('Unsupported file type %s.', [sSecond]));
{$ELSE}
        fSecond := fstC;
{$ENDIF}
    end;

    case fFirst of
      fstMc:
        case fSecond of
          fstMn: Result := -1; // pierwszy PRZED
          fstZ: Result := -2; // pierwszy PRZED
          fstCDS, fstW, fstC, fstK: Result := -3; // pierwszy PRZED
          else
            Result := CompareText(sFirst, sSecond);
        end;
      fstMn:
        case fSecond of
          fstMc: Result := -1; // pierwszy PRZED
          fstZ: Result := -2; // pierwszy PRZED
          fstCDS, fstW, fstC, fstK: Result := -3; // pierwszy PRZED
          else
            Result := CompareText(sFirst, sSecond);
        end;
      fstZ:
        case fSecond of
          fstMc, fstMn: Result := 1; // pierwszy PO
          fstCDS, fstW, fstC, fstK: Result := -2; // pierwszy PRZED
          else
            Result := CompareText(sFirst, sSecond);
        end;
      fstCDS:
        case fSecond of
          fstC, fstK: Result := -1; // pierwszy PRZED
          fstW, fstZ, fstMc, fstMn: Result := 1; // pierwszy PO
          else
            Result := CompareText(sFirst, sSecond);
        end;
      fstW:
        case fSecond of
          fstC, fstK: Result := -1; // pierwszy PRZED
          fstCDS, fstZ, fstMc, fstMn: Result := 1; // pierwszy PO
          else
            Result := CompareText(sFirst, sSecond);
        end;
      fstC, fstK:
        case fSecond of
          fstCDS, fstW: Result := 2; // pierwszy PO
          fstZ, fstMc, fstMn: Result := 1; // pierwszy PO
          else
            Result := CompareEmarFileName(sFirst, sSecond);
        end;
      else
        case fSecond of
          fstMc, fstMn, fstZ, fstCDS, fstW, fstC, fstK: Result := -CompareText(sSecond, sFirst);
          else
            Result := CompareText(sFirst, sSecond);
        end;
    end;
  end
  else
    Result := CompareText(sFirst, sSecond);
end;

// Returns drive time for taken END BusStop based on the ride's Direction (tam/powrót); the Ride's start time is as a start point
function BusStopDriveTime(const AEmarFile105: IEmar_BaseFile; const ABusStopTo, ARideIndex: Integer): Integer;
var
  i, iStart, iEnd: SmallInt;
  rrl: IEmar_Ride;
begin
  Result := 0;
  if (ARideIndex > -1)and(ARideIndex < AEmarFile105.RideList.Count) then
  begin
    rrl := AEmarFile105.RideList.Items[ARideIndex];
    try
      iStart := rrl.IndexOfRoute;
      iEnd := Pred(ABusStopTo);

      for i := iStart to iEnd do
        Inc(Result, AEmarFile105.RideRouteList.Items[i].RideTime +
          AEmarFile105.RideRouteList.Items[i].StopTime);
    finally
      rrl := nil;
    end;
  end;
end;

