// szukamy stawki VAT oraz ceny
procedure TSalesReportEmar105.SetTicketPaymentType(ATicketEvent: IEmar_ReportEvent; ATicket: TTicket);
var
  iIndexOfCurrency: Integer;
  cCashInTicketPrice, cNonCashInTicketPrice: Cardinal;
begin
  iIndexOfCurrency := -1;
  cCashInTicketPrice := 0;
  cNonCashInTicketPrice := 0;
  case ATicketEvent.Kind of
    13:
      begin
        iIndexOfCurrency := ATicketEvent.AsEvent_13.IndexOfCurrency;
        cCashInTicketPrice := ATicketEvent.AsEvent_13.TicketPrice - ATicketEvent.AsEvent_13._NonCashInTicketPrice;
        cNonCashInTicketPrice := ATicketEvent.AsEvent_13._NonCashInTicketPrice;
      end;
    15:
      begin
        iIndexOfCurrency := ATicketEvent.AsEvent_15.IndexOfCurrency;
        cCashInTicketPrice := ATicketEvent.AsEvent_15.TicketPrice - ATicketEvent.AsEvent_15._NonCashInTicketPrice;
        cNonCashInTicketPrice := ATicketEvent.AsEvent_15._NonCashInTicketPrice;
      end;
    16:
      begin
        iIndexOfCurrency := ATicketEvent.AsEvent_16.IndexOfCurrency;
        cCashInTicketPrice := ATicketEvent.AsEvent_16.TicketPrice - ATicketEvent.AsEvent_16._NonCashInTicketPrice;
        cNonCashInTicketPrice := ATicketEvent.AsEvent_16._NonCashInTicketPrice;
      end;
    21:
      begin
        iIndexOfCurrency := ATicketEvent.AsEvent_21.IndexOfCurrency;
        cCashInTicketPrice := ATicketEvent.AsEvent_21.Price - ATicketEvent.AsEvent_21._NonCashInTicketPrice;
        cNonCashInTicketPrice := ATicketEvent.AsEvent_21._NonCashInTicketPrice;
      end;
    30:
      begin
        iIndexOfCurrency := ATicketEvent.AsEvent_30.IndexOfCurrency;
        cCashInTicketPrice := ATicketEvent.AsEvent_30.TicketPrice - ATicketEvent.AsEvent_30._NonCashInTicketPrice;
        cNonCashInTicketPrice := ATicketEvent.AsEvent_30._NonCashInTicketPrice;
      end;
    32:
      begin
        iIndexOfCurrency := ATicketEvent.AsEvent_32.IndexOfCurrency;
        cCashInTicketPrice := ATicketEvent.AsEvent_32.TicketPrice - ATicketEvent.AsEvent_32._NonCashInTicketPrice;
        cNonCashInTicketPrice := ATicketEvent.AsEvent_32._NonCashInTicketPrice;
      end;
  else
    Exception.Create(Format(C_FMT_NOT_SUPPORTED_EVENT, [ATicketEvent.Kind]));
  end;
  if Assigned(ATicket)and(iIndexOfCurrency > -1)and(iIndexOfCurrency < $FF) then
  begin
    if LastEmarIndexOfPaymentType in [0, 1] then // GOTÓWKA lub KARTA PŁATNICZA
    begin
      if (not EMAR205)
        and(LastEmarIndexOfPaymentType = 0) // GOTÓWKA
        and(iIndexOfCurrency < _File.CurrencyExchangeList.Count)
        and(_File.CurrencyExchangeList.Items[iIndexOfCurrency].ExchangeRate = 10000)
        and(
          (String(_File.CurrencyExchangeList.Items[iIndexOfCurrency].Currency).ToUpper() = C_CURRENCY_KAR_SYMBOL)
          or
          (String(_File.CurrencyExchangeList.Items[iIndexOfCurrency].Country).ToUpper() = C_CURRENCY_KAR_NAME)
          ) then
      begin  // switch amounts related to inverted payment type 'GOTÓWKA' => 'KARTA PŁATNICZA'
        ATicket.PaymentType.ReadFromDatabase(Ord(ptvCreditCard));
      end
      else
        if cNonCashInTicketPrice = 0 then
          ATicket.PaymentType.ReadFromDatabase(Ord(ptvCash))
        else
          if cCashInTicketPrice = 0 then
            ATicket.PaymentType.ReadFromDatabase(Ord(ptvCreditCard))
          else
          begin
            ATicket.PaymentType.ReadFromDatabase(Ord(ptvMixed));
            // podział na GOTÓWKA oraz KARTA PŁATNICZA
            ATicket.TicketPaymentTypeEMAR205List.Clear;
            ATicket.AddTicketPaymentTypeEMAR205Values(Ord(ptvCash), cCashInTicketPrice); // GOTÓWKA
            ATicket.AddTicketPaymentTypeEMAR205Values(Ord(ptvCreditCard), cNonCashInTicketPrice); // karta płatnicza
          end;
    end
    else
      ATicket.PaymentType.ReadFromDatabase(LastPaymentTypeID);
    ATicket.PaymentType.Changed := False;
    ATicket.PaymentType_Id := ATicket.PaymentType.Id; // sposób płatności – predefiniowane wartości: 1-gotówka, 2-przelew, 3-karta płatnicza, 4-czek, 5-bon
  end;
end;

procedure TSalesReportEmar105.SetTicketPriceAndVATFromRide(ATicket: TTicket;
  const ATicketPrice, ARideIndex, AVatIndex: Integer; const ATicketDate: TDateTime);
var
  ixVAT, iVATAmount: Integer;
  sVAT: String;
  EmarRide: IEmar_Ride;
begin
  if Assigned(ATicket) then
  begin
    EmarRide := _FileA80.RideList.Items[ARideIndex];
    if AVatIndex = -1 then
      ixVAT := _FileA80.TariffList.Items[
          EmarRide.GetIndexOfTariffByRideAndDate(
            ARideIndex
            , ATicketDate
          )
        ].IndexOfVAT
    else
      ixVAT := AVatIndex;
    iVATAmount := VATAmounts[ixVAT];
    sVAT := VATIndexToCode(ixVAT);

    if EmarRide.InCountry then
    begin
      ATicket.VatCode := sVAT; // numer stawki  VAT (A..G), N – nie podlega (odcinek krajowy) (dotyczy biletów)
      ATicket.VatAmount := iVATAmount; // stawka VAT (%)  (dla biletów odcinek krajowy)
      ATicket.Price := ATicketPrice; // cena brutto biletu sprzedawanego [gr] (1 bilet), NULL – nie dotyczy (np. paragony) (odcinek krajowy)=(CENABIL-KWOTABON-KWOTAUL)*LPAS+ KWOTAOM – dla odcinka krajowego
      //ATicket.NormalPrice := ; // cena taryfowa biletu normalnego [gr], NULL – nie dotyczy (np. paragony) (uwaga – jeśli bilet jest zagraniczny, to tylko cena odcinka krajowego!)
    end
    else
    begin
      ATicket.VatCodeAbroad := sVAT; // numer stawki VAT (A..G), N – nie podlega (odcinek zagraniczny) (dotyczy biletów)
      ATicket.VatAmountAbroad := iVATAmount; // stawka VAT (%)  (dla biletów odcinek zagraniczny)
      ATicket.PriceAbroad := ATicketPrice; // cena brutto biletu sprzedawanego [gr] (1 bilet), NULL – nie dotyczy (np. paragony) (odcinek zagraniczny)=(CENABIL-KWOTABON-KWOTAUL)*LPAS+ KWOTAOM – dla odcinka zagranicznego
      //ATicket.NormalPriceAbroad := ; // cena taryfowa biletu normalnego [gr], NULL – nie dotyczy (np. paragony) Odcinek zagraniczny
    end;
  end;
end;

procedure TSalesReportEmar105.SetTicketPrices(ATicket: TTicket; const ATicketPrice: TRTicketPrice);
begin
  ATicket.DiscountCharge := ATicketPrice.Bonif[0]; // kwota bonifikaty [gr] (do 1 bilet), NULL – nie dotyczy (np. paragony); UWAGA: ulga obliczana jest po bonifikacie! Dotyczy tylko biletów jednorazowych
  if ATicket.TicketType_ID = Integer(ttvBiletJednorazowyMiejski) {bilet miejski} then
    ATicket.NormalPrice := ATicketPrice.Brutto[0] div ATicket.PassangerNumber
  else
    ATicket.NormalPrice := ATicketPrice.Cena[0]; // cena taryfowa biletu normalnego [gr], NULL – nie dotyczy (np. paragony) (uwaga – jeśli bilet jest zagraniczny, to tylko cena odcinka krajowego!)
  ATicket.Price := ATicketPrice.Brutto[0] - ATicketPrice.Bonif[0] - ATicketPrice.Ulga[0] + ATicketPrice.OpMan[0]; // cena brutto biletu sprzedawanego [gr] (1 bilet), NULL – nie dotyczy (np. paragony) (odcinek krajowy)=(CENABIL-KWOTABON-KWOTAUL)*LPAS+ KWOTAOM – dla odcinka krajowego
  ATicket.ReductionValue := ATicketPrice.Ulga[0]; // kwota ulgi
  if ATicketPrice.NrSt[0] <> 0 then
  begin
    ATicket.VatCode := VATIndexToCode(ATicketPrice.NrSt[0]); // numer stawki  VAT (A..G), N – nie podlega (odcinek krajowy) (dotyczy biletów)
    if ATicketPrice.StPtu[0] > 0 then
      ATicket.VatAmount := Round(ATicketPrice.StPtu[0] * 100); // stawka VAT (%)  (dla biletów odcinek krajowy)
  end;

  ATicket.DiscountChargeAbroad := ATicketPrice.Bonif[1]; // kwota bonifikaty [gr] (do 1 bilet), NULL – nie dotyczy (np. paragony); UWAGA: ulga obliczana jest po bonifikacie! Dotyczy tylko biletów jednorazowych. Odcinek zagraniczny
  if ATicket.TicketType_ID = Integer(ttvBiletJednorazowyMiejski) {bilet miejski} then
    ATicket.NormalPriceAbroad := ATicketPrice.Brutto[1] div ATicket.PassangerNumber
  else
    ATicket.NormalPriceAbroad := ATicketPrice.Cena[1]; // cena taryfowa biletu normalnego [gr], NULL – nie dotyczy (np. paragony) Odcinek zagraniczny
  ATicket.PriceAbroad := ATicketPrice.Brutto[1] - ATicketPrice.Bonif[1] - ATicketPrice.Ulga[1] + ATicketPrice.OpMan[1]; // cena brutto biletu sprzedawanego [gr] (1 bilet), NULL – nie dotyczy (np. paragony) (odcinek zagraniczny)=(CENABIL-KWOTABON-KWOTAUL)*LPAS+ KWOTAOM – dla odcinka zagranicznego
  ATicket.ReductionValueAbroad := ATicketPrice.Ulga[1]; // kwota ulgi w odcinku zagranicznym (dla ulg handlowych)
  if ATicketPrice.NrSt[1] <> 0 then
  begin
    ATicket.VatCodeAbroad := VATIndexToCode(ATicketPrice.NrSt[1]); // numer stawki VAT (A..G), N – nie podlega (odcinek zagraniczny) (dotyczy biletów)
    if ATicketPrice.StPtu[1] > 0 then
      ATicket.VatAmountAbroad := Round(ATicketPrice.StPtu[1] * 100); // stawka VAT (%)  (dla biletów odcinek zagraniczny)
  end;
end;

procedure TSalesReportEmar105.SetTicketPricesWhenIncorrect(ATicket: TTicket;
  const ATicketPrice: TRTicketPrice; const AReportPrice, AReportPaidAmount: Cardinal);
begin
  ATicket.NormalPrice := AReportPrice; // cena taryfowa biletu normalnego [gr], NULL – nie dotyczy (np. paragony) (uwaga – jeśli bilet jest zagraniczny, to tylko cena odcinka krajowego!)
  ATicket.Price := AReportPaidAmount; // cena brutto biletu sprzedawanego [gr] (1 bilet), NULL – nie dotyczy (np. paragony) (odcinek krajowy)=(CENABIL-KWOTABON-KWOTAUL)*LPAS+ KWOTAOM – dla odcinka krajowego
  ATicket.ReductionValue := ATicketPrice.Ulga[0]; // kwota ulgi
  if ATicketPrice.NrSt[0] <> 0 then
  begin
    ATicket.VatCode := VATIndexToCode(ATicketPrice.NrSt[0]); // numer stawki  VAT (A..G), N – nie podlega (odcinek krajowy) (dotyczy biletów)
    if ATicketPrice.StPtu[0] > 0 then
      ATicket.VatAmount := Round(ATicketPrice.StPtu[0] * 100); // stawka VAT (%)  (dla biletów odcinek krajowy)
  end;
end;

procedure TSalesReportEmar105.SetTicketPricesEvent32(ATicket: TTicket; AEvent_32: IEmar_ReportEvent_32);
begin
  ATicket.AmountToPay := AEvent_32.TicketPrice;

  ATicket.NormalPrice := AEvent_32.Brutto1; // cena taryfowa biletu normalnego [gr], NULL – nie dotyczy (np. paragony) (uwaga – jeśli bilet jest zagraniczny, to tylko cena odcinka krajowego!)
  ATicket.Price := AEvent_32.Brutto1 - AEvent_32.Reduce1; // cena brutto biletu sprzedawanego [gr] (1 bilet), NULL – nie dotyczy (np. paragony) (odcinek krajowy)=(CENABIL-KWOTABON-KWOTAUL)*LPAS+ KWOTAOM – dla odcinka krajowego
  ATicket.ReductionValue := AEvent_32.Reduce1; // kwota ulgi
  if AEvent_32.PTU1 <> 0 then
  begin
    ATicket.VatCode := VATIndexToCode(AEvent_32.PTU1); // numer stawki  VAT (A..G), N – nie podlega (odcinek krajowy) (dotyczy biletów)
//    if AEvent_32.PTU1 > 0 then
//      ATicket.VatAmount := Round(ATicketPrice.StPtu[0] * 100); // stawka VAT (%)  (dla biletów odcinek krajowy)
  end;

  if AEvent_32.Brutto2 <> $FFFFFFFF then
  begin
    ATicket.NormalPriceAbroad := AEvent_32.Brutto2; // cena taryfowa biletu normalnego [gr], NULL – nie dotyczy (np. paragony) Odcinek zagraniczny
    ATicket.PriceAbroad := AEvent_32.Brutto2 - AEvent_32.Reduce1; // cena brutto biletu sprzedawanego [gr] (1 bilet), NULL – nie dotyczy (np. paragony) (odcinek zagraniczny)=(CENABIL-KWOTABON-KWOTAUL)*LPAS+ KWOTAOM – dla odcinka zagranicznego
    ATicket.ReductionValueAbroad := AEvent_32.Reduce1; // kwota ulgi w odcinku zagranicznym (dla ulg handlowych)
    if AEvent_32.PTU2 <> 0 then
    begin
      ATicket.VatCodeAbroad := VATIndexToCode(AEvent_32.PTU2); // numer stawki VAT (A..G), N – nie podlega (odcinek zagraniczny) (dotyczy biletów)
//      if ATicketPrice.StPtu[1] > 0 then
//        ATicket.VatAmountAbroad := Round(ATicketPrice.StPtu[1] * 100); // stawka VAT (%)  (dla biletów odcinek zagraniczny)
    end;
  end;

  ATicket.PriceSum := ATicket.Price + ATicket.PriceAbroad;
end;

procedure TSalesReportEmar105.AddEvent32Data(AEvent_20: IEmar_ReportEvent_20);
var
  ControlPrint: TControlPrint;
begin
  ControlPrint := AddControlPrint();
  ControlPrint.PrintDate := EmarDateTimeToDateTime(AEvent_20.EventDate, AEvent_20.EventTime); // data i godzina wydruku
  ControlPrint.RideRegistered := RideRegisteredList.GetLastRideRegistered; // just a pointer to the object
  ControlPrint.BusStopNumber := AEvent_20.BusStopStart;
  ControlPrint.BusStopCode := getIBusStopCode(LastEmarIndexOfRide, AEvent_20.BusStopStart);
  ControlPrint.BusStopShortName := getIBusStopNameFromCode(ControlPrint.BusStopCode, True);
  ControlPrint.BusStopName := getIBusStopNameFromCode(ControlPrint.BusStopCode, False);
  ControlPrint.BusStop_ID := GetBusStopID(ControlPrint.BusStopCode, Company_ID);
  ControlPrint.NrDOK := AEvent_20.DocumentNumber;
  ControlPrint.NrOBil := AEvent_20._LastTicketNumberUsedHighPart;
  ControlPrint.PassangerNoSingle := AEvent_20.PassangerCountInBus;
  ControlPrint.PassangerNoPeriodical := AEvent_20.PassangerCountWithMountTickets;
  if AEvent_20.Print then
  begin
    ControlPrintsNo := ControlPrintsNo + 1; // Liczba wydruków kontrolnych
    // fill object
    ControlPrint.PrintType := 1; // kontrolka wydrukowana
  end
  else
  begin
    // fill object
    ControlPrint.PrintType := 2; // zapis informacji o kursie do karty kontrolera bez wydruku kontrolki
  end;
  if AEvent_20.AsEvent_20.InspectorCardNumber <> $ffffffff then
  begin
    ControlPrint.CardNumber := AEvent_20.InspectorCardNumber;
    ControlPrint.CardCompany := AEvent_20.InspectorCompany;
  end;
end;

// Returns ID of the currency by its Index in the file
procedure TSalesReportEmar105.GetCurrency(const AEmarIndexOfCurrency: Integer;
  var ACurrency_ID: Integer; var AExchangeRate: Extended);
var
  sCurrencySymbol, sCurrencyName: String;
  currencyRecord: TCurrencyRecord;
  cur: TCurrency;
begin
  ACurrency_ID := 0; // waluta
  AExchangeRate := 0;
  cur := TCurrency.Create;
  try
    if (_FileA80.CurrencyExchangeList.Count > 0)
      and(AEmarIndexOfCurrency > -1)
      and(AEmarIndexOfCurrency < _FileA80.CurrencyExchangeList.Count)
    then
    begin
      sCurrencySymbol := String(_FileA80.CurrencyExchangeList.Items[AEmarIndexOfCurrency].Currency).ToUpper();
      sCurrencyName := String(_FileA80.CurrencyExchangeList.Items[AEmarIndexOfCurrency].Country).ToUpper();
    end
    else
      if _FileA80.Consts.CurrencyCode <> '' then
        sCurrencySymbol := String(_FileA80.Consts.CurrencyCode)
      else
        sCurrencySymbol := FDefaultCurrencySymbol;

    // 'KARTA PŁATNICZA' w Emar-105
    if (sCurrencySymbol = C_CURRENCY_KAR_SYMBOL)
      or(sCurrencyName = C_CURRENCY_KAR_NAME) then // w dokumentacji te pole sie nazywa 'Kraj'
      sCurrencySymbol := C_CURRENCY_DEFAULT_SYMBOL;

    currencyRecord := FillCurrencyRecord(sCurrencySymbol);
    ACurrency_ID := GetTempCurrencyID(sCurrencySymbol); // waluta
    if not TempCurrencyList.GetKeyByValue(ACurrency_ID, currencyRecord, nil) then
      raise Exception.Create(Format('Waluta z ID = %d nie została znaleziona.', [ACurrency_ID]));
    AExchangeRate := currencyRecord.CurrentExchangeRate / 10000;
  finally
    FreeAndNil(cur);
  end;
end;

