function TSalesReport.getIBusStopNoInRide(const ARideIndex, ADefBusStopNo: Integer): Integer;
var
  i: SmallInt;
  iride: IEmar_Ride;
begin
  Result := ADefBusStopNo; // for an error elimination
  if _FileA80 <> nil then
  begin
    try
      iride := _FileA80.RideList.Items[ARideIndex];
      if iride <> nil then
      begin
        for i := 0 to Pred(iride.BusStopCount) do
        begin
          if _FileA80.RideRouteList.Items[iride.IndexOfRoute + i].IndexOfBusStopInLine = Pred(ADefBusStopNo) then
            Exit(Succ(i))
        end;
      end;
    except
      Exit;
    end;
  end;
end;

function TSalesReport.getIBusStopName(const ARideIndex, ABusStop: Integer;
  const AShortName: Boolean): String;
var
