  procedure KorBrakIdBil(const log: String; knrrf: Integer; const otw: Boolean);
  //var i,j: integer;
  begin
    if otw then
    begin
      if knrrf > 0 then Dec(knrrf);
      _File.ReportEventList[irkor].AsEvent_01.FiscalReportState := frsClose;
    end;
    _File.ReportEventList[irkor].AsEvent_01.FiscalReportNumber := Pred(knrrf);
    { AT: There are something like "buffer dbf tables" or something similar; probably are not needed
    Arap[irkor+38]:=0;
    for i:=0 to 37 do Arap[irkor+38]:=Arap[irkor+38] xor Arap[irkor+i];
    if (knrrf > 0)and(Arz[irz].NrRF=0) then Arz[irz].NrRF:=knrrf;
    for i:=0 to High(Awrz) do
      if (Awrz[i].Logo=log) and (Awrz[i].NrRF=0) then
        Awrz[i].NrRF:=knrrf;
    for i:=0 to High(Arf) do
      for j:=0 to High(Arf[i].a) do
        if (Arf[i].a[j].Logo=log) and (Arf[i].a[j].NrRF=0) then
          Arf[i].a[j].NrRF:=knrrf;
    for i:=0 to High(Awrf) do
      for j:=0 to High(Awrf[i].a) do
        if (Awrf[i].a[j].Logo=log) and (Awrf[i].a[j].NrRF=0) then
          Awrf[i].a[j].NrRF:=knrrf;
    for i:=0 to High(Askur) do
      for j:=0 to High(Askur[i].a) do
        if (Askur[i].a[j].Logo=log) and (Askur[i].a[j].NrRF=0) then
          Askur[i].a[j].NrRF:=knrrf;
    for i:=0 to High(Awsk) do
      for j:=0 to High(Awsk[i].a) do
        if (Awsk[i].a[j].Logo=log) and (Awsk[i].a[j].NrRF=0) then
          Awsk[i].a[j].NrRF:=knrrf;
    for i:=0 to High(Akont) do
      for j:=0 to High(Akont[i].a) do
        if (Akont[i].a[j].Logo=log) and (Akont[i].a[j].NrRF=0) then
          Akont[i].a[j].NrRF:=knrrf;
    for i:=0 to High(Abil) do
      for j:=0 to High(Abil[i].a) do
        if (Abil[i].a[j].Logo=log) and (Abil[i].a[j].NrRF=0) then
          Abil[i].a[j].NrRF:=knrrf;
    for i:=0 to High(Abilm) do
      for j:=0 to High(Abilm[i].a) do
        if (Abilm[i].a[j].Logo=log) and (Abilm[i].a[j].NrRF=0) then
          Abilm[i].a[j].NrRF:=knrrf;
    for i:=0 to High(Apaskm) do
      for j:=0 to High(Apaskm[i].a) do
        if (Apaskm[i].a[j].Logo=log) and (Apaskm[i].a[j].NrRF=0) then
          Apaskm[i].a[j].NrRF:=knrrf;}
    irkor:=-1;
  end; //KorBrakIdBil

  procedure WysOpiRF(const s: String);
  begin
    if bilufisk then
    begin
      OutputLine(re, clRegular, fsRegular);
      AddLine(23, s + FormatDateTime(sfdtYMD, WzZb.DataRF));
      OutputLine(re, clRegular, fsRegular);
    end
    else
    begin
      AddLine(2, C_TXT_NON_FISCAL);
      OutputLine(re, clWarning, fsRegular);
    end;
  end;

  function BadajZaprk: integer;
  begin
    if zaprk = 0 then
      Result := RTicketPrice.Brutto[0] + RTicketPrice.Brutto[1] - RTicketPrice.Bonif[0] - RTicketPrice.Bonif[1] -
              RTicketPrice.Ulga[0] - RTicketPrice.Ulga[1] + RTicketPrice.OpMan[0] + RTicketPrice.OpMan[1]
    else
      if zaprk = 1 then
        Result := RTicketPrice.PTU[0] + RTicketPrice.PTU[1]{+RTicketPrice.PtuU[0]+RTicketPrice.PTuU[1]}
      else
        if (zaprk = 2)or(Bil.DoZapl = 0) then
          Result := 0
        else //do zapłaty procent wartości (zaprk=3)
          Result := ((RTicketPrice.Brutto[0] + RTicketPrice.Brutto[1] - RTicketPrice.Bonif[0] - RTicketPrice.Bonif[1] -
                    RTicketPrice.Ulga[0] - RTicketPrice.Ulga[1] + RTicketPrice.OpMan[0] + RTicketPrice.OpMan[1]) *
                   rlUlga.ProcDoZap + 50) div 100;
  end;

  procedure WysBladWybKur(const AShowNumbers: Boolean;
    const ATicketNumber, ADocumentNumber: PWideChar); overload;
