{$REGION '43 - Odczyt biletu ZTM Rzeszów (EMAR-205)'}
        43:
          begin
            PrzejazdZTM := DajPrzejazdZTM(rel.AsEvent_43);
            if LastEmarRide = nil then
            begin           //E.B. 20.06.2023
              Inc(iRecord);
              Continue;
            end;
            TicketZTM := AddTicketZTM;

            if LastRideID > 0 then
              TicketZTM.Ride_ID := LastRideID;

            TicketZTM.CompanyOwner_ID := LastRideCompanyID; // firma właściciel kursu/towaru/usługi/przewozu zleconego/autobusu, itp., jeśli sprzedaż jest na kurs obcy (dotyczy biletów jednorazowych; okresowe – SLS_TicketXCompany); dla biletów rejestowanych z bileterek - NULL

            TicketZTM.RideRegistered := RideRegisteredList.GetLastRideRegistered; // just a pointer to the object

            TicketZTM.ZTMRideDateTime := PrzejazdZTM.DataOdczBil;
            TicketZTM.CardNumberZTM := PrzejazdZTM.NrKartyZTM;
            TicketZTM.TicketStatus := PrzejazdZTM.StatusSprBiletu;
            TicketZTM.ServerStatus := PrzejazdZTM.StatusSerw;
            TicketZTM.TicketValidTo := StrToDateTimeDef(PrzejazdZTM.DataWazBiletu, 0);
            TicketZTM.TicketZone := PrzejazdZTM.NrStrefyWaznBiletu;
            TicketZTM.TicketName := PrzejazdZTM.NazwaBiletu;

            nrprzztmp := nrprz;
            nrprzztmc := 0;
            case TicketZTM.TicketStatus of
              0:
                begin
                  if (PrzejazdZTM.NrPPocz = 255)
                    or(PrzejazdZTM.NrPPocz > LastEmarRide.BusStopCount {rlKurs.LPrzyst}) then
                    PrzejazdZTM.NrPPocz := nrprz;
                  nrprzztmp := PrzejazdZTM.NrPPocz;
                  if PrzejazdZTM.NrPPocz > LastEmarRide.BusStopCount {rlKurs.LPrzyst} then
                    PrzejazdZTM.NrPCel := 255;
                  if PrzejazdZTM.NrPCel = 255 then begin
                    //
                  end
                  else begin
                    nrprzztmc := PrzejazdZTM.NrPCel;
                  end;
                end;
            end;

            TicketZTM.BusStopNoStart := nrprzztmp;
            if (TicketZTM.BusStopNoStart > 0)and(TicketZTM.BusStopNoStart < 255) then
            begin
              TicketZTM.BusStopCodeStart := getIBusStopCode(LastEmarIndexOfRide, TicketZTM.BusStopNoStart);
              TicketZTM.BusStopNameStart := getIBusStopName(LastEmarIndexOfRide, TicketZTM.BusStopNoStart, True);
