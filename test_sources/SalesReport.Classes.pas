            EMAR205 := True;
            for i := 1 to 7 do
            begin    //E.B. 14.06.2019
              VATAmounts[i] {StPod[i]}:= rel.AsEvent_41.TaxRates[PWideChar(String(Chr(Ord('A') + i - 1)))];
              StPodZRF[i] := rel.AsEvent_41.TaxRates[PWideChar(String(Chr(Ord('A') + i - 1)))];    //aktualne stawki zapisane w pamięci fiskalnej
            end;
          end;
