  procedure DopiszNaglowek205(ADD_File: IEmar105_File);      //E.B. 18.06.2021 //52-Ans205
    function ZnakiSterujace(s: string): string;
    begin
      s := FastStringReplace(s, #1, '\4', [rfReplaceAll]);
      s := FastStringReplace(s, #2, '\3', [rfReplaceAll]);
      s := FastStringReplace(s, #3, '\1', [rfReplaceAll]);
      Result := FastStringReplace(s, #4, '\2', [rfReplaceAll]);
    end;
  var
    i, j: Integer;
  begin
    sLine := '';
    OutputLine(re, clRegular, fsRegular);

    if ADD_File.ShortcutList.Count > 0 then
    begin   //52
      AddLine(0, 'Nagłówek i stopka EMAR-205');
      OutputLine(re, clImportant, fsStrong);

      i := 0;
      sLine := '';
      while i < ADD_File.Emar205TextsList.Count do
      begin
        AddLine(0, 'Nagłówek');
        OutputLine(re, clRegular, fsStrong);
        j := 0;
        while j < 5 do
        begin
          AddLine(0, ZnakiSterujace(String(ADD_File.Emar205TextsList[i].Headers[j])));
          sLine := sLine + #13#10;
          Inc(j);
        end;
        if sLine <> '' then
          OutputLine(re, clRegular, fsRegular);

        AddLine(0, 'Stopka');
        OutputLine(re, clRegular, fsStrong);
        j := 0;
        while j < 3 do
        begin
          AddLine(0, ZnakiSterujace(String(ADD_File.Emar205TextsList[i].Footers[j])));
          sLine := sLine + #13#10;
          Inc(j);
        end;
        if sLine <> '' then
          OutputLine(re, clRegular, fsRegular);

        Inc(i);
      end;
    end;
  end;

