function TSalesReport.UpdateAndReturnRideRegisteredStartStopDateTimes(ARideId, ARideNumber: Integer;
  ARideStartDateTime, ARideStopDateTime: TDateTime): TRideRegistered;
  function isInsideTheRange(ARideDate, ARideStartTime, ARideStopTime, ACompareDateTime: TDateTime): Boolean;
  begin
    Result :=
      // later then Start
      (Trunc(ARideDate) + Frac(ARideStartTime) <= ACompareDateTime)
      // earlier than Stop
      and(
        (Frac(ARideStartTime) < Frac(ARideStopTime)) // ends at the same day
        and(Trunc(ARideDate) + Frac(ARideStopTime) >= ACompareDateTime)
        or
        (Frac(ARideStartTime) >= Frac(ARideStopTime)) // ends at the next day
        and(IncDay(Trunc(ARideDate), 1) + Frac(ARideStopTime) >= ACompareDateTime)
        );
  end;
var
  rr: TRideRegistered;
  fr: TFiscalReport;
  t: TTicket;
  tr: TTicketRoute;
  tZTM: TTicketZTM;
  ecxpr: TEmCardXPassangerRecording;
  cc: TControlPrint;
begin
  Result := nil;
  for rr in Self.RideRegisteredList do
  begin
    if
      (
        (ARideId > 0)
        and(rr.Ride_ID = ARideId)
        or
        (rr.RideNumber = aRideNumber)
      )
      and(
        (Trunc(rr.RideDate) <> Trunc(ARideStartDateTime))
        or
        (Frac(rr.RideStartTime) <> Frac(ARideStartDateTime))
        or
        (Frac(rr.RideStopTime) <> Frac(ARideStopDateTime))
        )
    then
    begin
      for fr in Self.FiscalReportList do
      begin
        for t in fr.TicketList do
        begin
          for tr in t.TicketRouteList do
          begin
            if
              (rr = tr.RideRegistered)
              and isInsideTheRange(rr.RideDate, rr.RideStartTime, rr.RideStopTime, t.SaleDate)
            then
            begin
              if not Assigned(Result) then
                Result := rr; // return the first one RideRegistered
              // T18459
              rr.RideDate := Trunc(ARideStartDateTime);
              rr.RideStartTime := Frac(ARideStartDateTime);
              rr.RideStopTime := Frac(ARideStopDateTime);
            end;
          end;
        end;
      end;

      for tZTM in Self.TicketZTMList do
      begin
        if
          (rr = tZTM.RideRegistered)
          and isInsideTheRange(rr.RideDate, rr.RideStartTime, rr.RideStopTime, tZTM.ZTMRideDateTime)
        then
        begin
          if not Assigned(Result) then
            Result := rr; // return the first one RideRegistered
          // T18459
          rr.RideDate := Trunc(ARideStartDateTime);
          rr.RideStartTime := Frac(ARideStartDateTime);
          rr.RideStopTime := Frac(ARideStopDateTime);
        end;
      end;

      for ecxpr in Self.EmCardXPassangerRecordingList do
      begin
        if
          (rr = ecxpr.RideRegistered)
          and isInsideTheRange(rr.RideDate, rr.RideStartTime, rr.RideStopTime, ecxpr.RideDate)
        then
        begin
          if not Assigned(Result) then
            Result := rr; // return the first one RideRegistered
          // T18459
          rr.RideDate := Trunc(ARideStartDateTime);
          rr.RideStartTime := Frac(ARideStartDateTime);
          rr.RideStopTime := Frac(ARideStopDateTime);
        end;
      end;

      for cc in Self.ControlPrintList do
      begin
        if
          (rr = cc.RideRegistered)
          and isInsideTheRange(rr.RideDate, rr.RideStartTime, rr.RideStopTime, cc.PrintDate)
        then
        begin
          if not Assigned(Result) then
            Result := rr; // return the first one RideRegistered
          // T18459
          rr.RideDate := Trunc(ARideStartDateTime);
          rr.RideStartTime := Frac(ARideStartDateTime);
          rr.RideStopTime := Frac(ARideStopDateTime);
        end;
      end;
    end;
  end;
end;

