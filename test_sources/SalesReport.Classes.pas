function TSalesReport.CreateRTFFile(const ARichEdit: TRichEdit): String;
const
  C_RTF_EXT = '.RTF';
var
  sRTFFilePath, sRTFFileName: String;
  Guid: Tguid;
begin
  if CFilePath <> '' then
    sRTFFileName := StringReplace(ExtractFileName(CFilePath), ExtractFileExt(CFilePath), ExtractFileExt(C_RTF_EXT), [])
  else
    if KFilePath <> '' then
      sRTFFileName := StringReplace(ExtractFileName(KFilePath), ExtractFileExt(KFilePath), ExtractFileExt(C_RTF_EXT), [])
    else
    begin
      CreateGuid(Guid);
      sRTFFileName := GuidToString(Guid) + C_RTF_EXT;
    end;

  sRTFFilePath := TempFileName(sRTFFileName);
  ARichEdit.PlainText := False;
  ARichEdit.Lines.SaveToFile(sRTFFilePath);
  ARichEdit.Clear;

  Result := sRTFFilePath;
end;

class function TSalesReport.GetRTF(const ARichEdit: TRichedit): AnsiString;
var
  stream: TMemoryStream;
  rtfString: AnsiString;
begin
  //Save to stream
  stream := TMemoryStream.Create;
  try
    stream.Clear;

    ARichEdit.PlainText := False;
    ARichEdit.Lines.SaveToStream(Stream) ;
//      {$IF DEFINED(DEBUG)}
//      ARichEdit.Lines.SaveToFile('D:\' + StringReplace(ExtractFileName(CFilePath),
//        ExtractFileExt(CFilePath), '.rtf', []));
//      {$ENDIF}
    stream.Position := 0;

    //Read from the stream into an AnsiString (rtfString)
    if (stream.Size > 0) then
    begin
      SetLength(rtfString, stream.Size);
      if (stream.Read(rtfString[1], stream.Size) <= 0) then
        raise EStreamError.CreateFmt('End of stream reached with %d bytes left to read.', [stream.Size]);
    end;

    Result := rtfString;
  finally
    stream.Free;
  end;
end;

