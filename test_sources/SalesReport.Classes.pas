function TSalesReport.getReductionRefund(AReductionPayer: Integer): Byte;
begin
  if AReductionPayer or $4 = AReductionPayer then
    Result := 4 // 1 0 0 –inny urząd
  else
    if AReductionPayer or $3 = AReductionPayer then
      Result := 3 // 0 1 1 –senat
    else
      if AReductionPayer or $2 = AReductionPayer then
        Result := 2 // 0 1 0 –sejm
      else
        if AReductionPayer or $1 = AReductionPayer then
          Result := 1 // 0 0 1 –samorząd
        else
          Result := 0; // 0 0 0 -brak dopłaty
end;

function TSalesReport.getRideCompanyIDFromRideIndex(aRideIndex: Integer): Integer;
var
  sMSG: String;
  iNumber: Integer;
  rrl: IEmar_Ride;
begin
  if aRideIndex > -1 then
  begin
    if aRideIndex < _FileA80.RideList.Count then
    begin
      rrl := _FileA80.RideList.Items[aRideIndex];
      try
        iNumber := _FileA80.CompanyList.Items[rrl.CompanyIndex].Number;
        Result := GetCompanyID(iNumber, Integer(kocPrzewoznik));
      finally
        rrl := nil;
      end;
      if Result = 0 then
      begin
        sMSG := Format(SALES_REPORT_MSG_COMPANY_OF_ROUTE_NOT_EXISTS, [iNumber]);
        AddToDesc(sMSG, True);
//        raise Exception.Create(sMSG);
      end;
    end
    else
      raise Exception.Create('Indeks wybranego kursu przekracza ilość rekordów listy');
  end
  else
    raise Exception.Create(C_TXT_COURSE_IS_NOT_RECORDED);
end;

procedure TSalesReport.DajInnyKurs(AEvent_10: IEmar_ReportEvent_10); //w rlKurs zwraca dane kursu
//o tym samym numerze rel_10.RideNumber {nrku}: innego niż zapisany w rel_10 {rlKurs}
var
  i: Integer;
begin
  ixRide_Saved := LastEmarIndexOfRide;
  _Emar_Ride_Saved := LastEmarRide;
  // TODO 1: Można przenieść poniższą część do dll
  i := 0;
  while i < Pred(_FileA80.ReferenceRideList.Count) do
  begin
    if (_FileA80.ReferenceRideList.Items[i].RideNumber = AEvent_10.RideNumber)
      and(
        (_FileA80.ReferenceRideList.Items[i].PageNumber <> AEvent_10.RidePage)
        or
        (_FileA80.ReferenceRideList.Items[i].AdrressesOfBeginningRecord <> AEvent_10.RideOffset)
          ) then
    begin
      LastEmarIndexOfRide := _FileA80.Dir.RecordIndex(
        10,
        _FileA80.ReferenceRideList.Items[i].PageNumber,
        _FileA80.ReferenceRideList.Items[i].AdrressesOfBeginningRecord);

      Break;
    end
    else
      Inc(i);
  end;
end;

