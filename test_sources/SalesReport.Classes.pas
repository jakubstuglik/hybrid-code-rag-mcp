  function ZmianaStawekPTUwRekordzieSzyfru(Arel_04: IEmar_ReportEvent_04): Boolean;  //E.B. 05.06.2019
  var
    i: Integer;
    tptu: TClientDataSet;
    stzm, stbaza: array [0..8] of Integer;
    function TeSameStawki(st1, st2: array of Integer): Boolean;
    var
      i: Integer;
    begin
      Result := True;
      for i := 1 to 7 do
      begin
        if St1[i] <> St2[i] then
          Exit(False);
      end;
    end;
    procedure OdczytajStawki;
    var i: Integer;
      ptu: SmallInt;
      fld: TField;
    begin
      for i := 1 to 7 do
      begin
        fld := tptu.FindField('VAT_' + Chr(Ord('A') + i - 1));
        if Assigned(fld)then
        begin
          if fld.AsString <> '-1' then
          begin
            if fld.AsString = '-2' then
            begin
              ptu := 20000;
              stbaza[i] := ptu;
            end
            else
            begin
              ptu := fld.AsInteger; //AT: it's already multiplied by 100 in database //ptu := Round(fld.AsFloat * 100);
              if fld.AsFloat > 0 then
                stbaza[i] := ptu
              else
                stbaza[i] := 0;
            end;
          end
          else
            stbaza[i] := $ffff;
        end;
      end;
      stbaza[8] := 30000;
    end;
    procedure ZmienRekord0;
    var
     i: Integer;
    begin
      if Assigned(rel_00) then
      begin
        for i := 1 to 7 do
          rel_00.TaxRates[i] := stbaza[i];
        rel_00.TaxRatesChange := 0; //Arap[29]:=0;
//        j:=0;                      // suma kontrolna rekordu
//        for i:=0 to DRe.RAP-2 do j:=j xor Arap[i];
//        Arap[DRe.RAP-1]:=j;
      end;
    end;
  begin
    Result := False;
    for i := 1 to 7 do
      stzm[i] := Arel_04.NewTaxRates[i]{ZmSP.St[i]};
    stzm[0] := 0;
    if TeSameStawki(VATAmounts{StPod}, stzm) then
    begin
      tptu := TVatRateHistory.ReadAllHistoryFromDatabase(dmMain).ClientDataSet;
      if not tptu.IsEmpty then
      begin
        tptu.Last;
        repeat
          OdczytajStawki;
          tptu.Prior;
        until tptu.Bof or TeSameStawki(VATAmounts{StPod}, stbaza);   //E.B. 11.06.2019
        tptu.Next;                                      //E.B. 17.07.2019
        if not tptu.Eof then
        begin
          tptu.Next;  //następny rekord za odczytanymi stawkami
          if tptu.FieldByName('ValidFrom').AsDateTime < StrToDate(sdat) then
          begin
            OdczytajStawki;     //w bileterce zmienione były stawki na następne
            ZmienRekord0;
            Exit(True);
          end
          else
          begin           //w bileterce były poprzednie stawki
            tptu.Prior;
            tptu.Prior;
          end;
        end
        else
          tptu.Prior;
        if not tptu.Bof then
        begin                      //E.B. 11.06.2019
          OdczytajStawki;
          ZmienRekord0;
          Exit(True);
        end;
      end;
    end;
  end;

