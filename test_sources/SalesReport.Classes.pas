class function TSalesReport.GetEmCardTicketTypeID(ATicketTypeID, ATicketGenreID: Byte): Byte;
begin
  Result := 0;
  {
    Bilety pracownicze PKS zapisywane są jako bilety normalne
    Czyli ATicketGenreID in (5,6) wpływa tak, jak ATicketGenreID = 1
  }
  case ATicketTypeID of
    2:
      begin //bilet okresowy
        case ATicketGenreID of
          1, 5, 6: Result := 1;
          2: Result := 2;
        end;
      end;
    3:
      begin //miesieczny
        case ATicketGenreID of
          1, 5, 6: Result := 3;
          2: Result := 5;
          3: Result := 4;
        end;
      end;
    6:
      begin //opłata manipulacyjna z kasy dworcowej
        Result := 8;
      end;
    7:
      begin //wieloprzejazdowy
        Result := 6;
      end;
    8:
      begin //sieciowy
        Result := 1;
      end;
  end;
end;

