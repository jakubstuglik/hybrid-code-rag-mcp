  procedure WysBilZag;
  var
    s, snd: String;
  begin
    AddLine(23, 'bilet międzynarodowy');
    OutputLine(re, clInformation, fsRegular);  //E.B. 04.08.2016
    if (RTicketPrice.StPTU[0] = -3)or(RTicketPrice.StPTU[0] = 0) then
      s := 'część zagraniczna '
    else
      s := 'część krajowa     ';
    snd := DajNazPrz(Bil.NrPPocz);
    if LPCRegistrationParamsParameters.BusStopName = 1 {krótke} then
      s := s + rlPrzyst.NazKr
    else
      s := s + snd;
    s := s + ' - ';
    if RTicketPrice.nrpg > 0 then
      snd := DajNazPrz(RTicketPrice.nrpg)
    else
      snd := DajNazPrz(RTicketPrice.PrzGran);  //E.B. 16.06.2009 przystanek granicy państwa
    if LPCRegistrationParamsParameters.BusStopName = 1 {krótke} then
      s := s + rlPrzyst.NazKr
    else
      s := s + snd;
    s := s + ' wartość: ' +
         Format('%6.2f', [(RTicketPrice.Brutto[0] - RTicketPrice.Bonif[0] - RTicketPrice.Ulga[0] + RTicketPrice.OpMan[0]) / 100]);
    AddLine(23, s);
    OutputLine(re, clInformation, fsRegular);  //E.B. 04.08.2016
    if (RTicketPrice.StPTU[1] = -3)or(RTicketPrice.StPTU[1] = 0) then
      s := 'część zagraniczna '
    else
      s := 'część krajowa     ';
    if LPCRegistrationParamsParameters.BusStopName = 1 {krótke} then
      s := s + rlPrzyst.NazKr
    else
      s := s + snd;
    s := s + ' - ';
    snd := DajNazPrz(Bil.NrPCel);
    if LPCRegistrationParamsParameters.BusStopName = 1 {krótke} then
      s := s + rlPrzyst.NazKr
    else
      s := s + snd;
    s := s + ' wartość: ' +
         Format('%6.2f', [(RTicketPrice.Brutto[1] - RTicketPrice.Bonif[1] - RTicketPrice.Ulga[1] + RTicketPrice.OpMan[1]) / 100]);
    AddLine(23, s);
    OutputLine(re, clInformation, fsRegular);
  end;

  function NazwaFirmyKontrolera(const AControlCompanyNumber: Integer): String;
  var
    iId: Integer;
    c: TCompany;
  begin
    Result := '';
    iId := GetCompanyID(AControlCompanyNumber, Integer(kocKontroler));
    if iId <> 0 then
    begin
      c := TCompany.Create;
      try
        if c.ReadFromDatabase(iId) then
