function DajRFEMKNowyBilet(var ASalesReport: TSalesReportEmar105;
  const AEvent_32: IEmar_ReportEvent_32;
  ARecordIndex: Integer): TRFEMKNowyBilet;
var
  iIndexOfCurrency: Integer;
  relEvent_32: IEmar_ReportEvent_32;
  rf: TRFEMKNowyBilet;
begin
  relEvent_32 := ASalesReport._File.ReportEventList.Items[ARecordIndex].AsEvent_32;
  Inc(ARecordIndex);
  if (ARecordIndex < ASalesReport._File.ReportEventList.Count)
    and(ASalesReport._File.ReportEventList.Items[ARecordIndex].Kind = 17) then // rejestracja przejazdu
    Inc(ARecordIndex);
  while (ARecordIndex < ASalesReport._File.ReportEventList.Count)
    and(ASalesReport._File.ReportEventList.Items[ARecordIndex].Kind in
    [
        33 // Rejestracja przejazdu z biletem miesięcznym (karta MIFARE) - błędy identyfikacji
      , 34 // Rejestracja przejazdu z biletem miesięcznym (karta MIFARE) - nieprawidłowe bilety
    ]) do
    Inc(ARecordIndex);
  if (ARecordIndex < ASalesReport._File.ReportEventList.Count)
    and(ASalesReport._File.ReportEventList.Items[ARecordIndex].Kind = 21) then // opłata dodatkowa
  begin
    iIndexOfCurrency := ASalesReport._File.ReportEventList.Items[ARecordIndex].AsEvent_21.IndexOfCurrency;
    if (iIndexOfCurrency < ASalesReport._File.CurrencyExchangeList.Count)
      and(ASalesReport._File.CurrencyExchangeList.Items[iIndexOfCurrency].ExchangeRate = 10000)
      and(
        (String(ASalesReport._File.CurrencyExchangeList.Items[iIndexOfCurrency].Currency).ToUpper() = C_CURRENCY_KAR_SYMBOL)
        or
        (String(ASalesReport._File.CurrencyExchangeList.Items[iIndexOfCurrency].Country).ToUpper() = C_CURRENCY_KAR_NAME)
        ) then
    begin
      relEvent_32.IndexOfCurrency := iIndexOfCurrency; // taka, jak w 'Opłata dodatkowa'
      relEvent_32.IndexOfPayType := 1; // KARTA PŁATNICZA
    end;
  end;

  rf.NrEMKarty := AEvent_32.CardNumber;
  rf.FirmaKM := AEvent_32.SaleCompany;
  if AEvent_32.ReduceCode = $FF then
    rf.KodUlgi := 0
  else
    rf.KodUlgi := AEvent_32.ReduceCode;
  rf.NrDokUlgi := AEvent_32.ReduceDocument;       //E.B. 20.06.2016
//  else rf.NrDokUlgi:=TestujStr(copy(string(PChar(@Arap[nr+18])),1,13));       //E.B. 02.05.2013
  rf.DataWDU := AEvent_32.ReduceDocumentValidTo;
  if AEvent_32.ReduceType = $FF then
    rf.TypUlgi := 0
  else
    rf.TypUlgi := AEvent_32.ReduceType;
  if AEvent_32.IndexOfCurrency = $FF then
    rf.NrWaluty := 0    //E.B. 19.01.2017
  else
    rf.NrWaluty := AEvent_32.IndexOfCurrency;
  //rekord nr 2
  rf.TypBiletu := AEvent_32.TicketType;
  rf.RodzBil := AEvent_32.TicketKind;
  rf.RelBil := AEvent_32.TicketRelations;
  rf.WazNaTr := AEvent_32.ValidForRoute;
  //if DajData(A,nr+7,dok)=0 then
  if AEvent_32.TicketValidFrom = '' then
  begin //E.B. 22.08.2011
    rf.WazOd := '';  //w karcie zapisany jest wzór biletu
    rf.WazDo := '';
  end
  else
  begin
    rf.WazOd := AEvent_32.TicketValidFrom; //DateToStr(DajData(A,nr+7,dok));
    rf.WazDo := AEvent_32.TicketValidTo; //DateToStr(DajData(A,nr+11,dok));
  end;
  rf.NrBiletu := AEvent_32.CardTicketNumber;
//  rf.NrBiletu:=string(PChar(@Arap[nr+15]));
  rf.PWazDo := AEvent_32.TicketNewValidTo;
  rf.KodSpP := AEvent_32.ExtCode;
  rf.LOkrP := AEvent_32.ExtCount;
  rf.PWazOd := AEvent_32.TicketNewValidFrom;
  rf.SposobPrz := AEvent_32.ExtKind;
  if AEvent_32.IndexOfPayType = $FF then
    rf.NrSpZapl := 0
  else
    rf.NrSpZapl := AEvent_32.IndexOfPayType;
  //rekord nr 3
  rf.LWykPrzej := AEvent_32.PaidRides;  // <-- UWAGA: w tabeli max wartość = 99
  rf.WartBil := AEvent_32.TicketPrice;
  if AEvent_32.InCountry then
    rf.RodzajBiletu := 0
  else
    rf.RodzajBiletu := 1;
  rf.NrStPTU1 := AEvent_32.PTU1;
  rf.Brutto1 := AEvent_32.Brutto1;
  rf.Ulga1 := AEvent_32.Reduce1;
  rf.NrStPTU2 := AEvent_32.PTU2;
  rf.Brutto2 := AEvent_32.Brutto2;
  if rf.Brutto2 < 0 then
    rf.Brutto2 := 0;
  rf.Ulga2 := AEvent_32.Reduce2;
  if rf.Ulga2 < 0 then
    rf.Ulga2 := 0;
  rf.NrDok := AEvent_32.DocumentNumber mod 100000000;
  rf.NrBil := AEvent_32._TicketNumberUsedHighPart;
//  if JestZadLK(A,nr+33,5,$ff) then
//    rf.KodKBil:=''
//  else
//    rf.KodKBil:=Format('%.3d',[A[nr+33]])+Format('%.10u',[CzLW(A,nr+34)]);
  rf.KodKBil := AEvent_32._ControlCode_Decoded;
  rf.WartBil := rf.Brutto1 + rf.Brutto2 - rf.Ulga1 - rf.Ulga2;
//  UWAGA: sprawdzić obsługę WartBil!!!!
  rf.GrUlgi:=0;      //E.B. 23.10.2014
  rf.NrUlgi:=0;
  rf.NazUlgi:='';
  rf.StawkaUl:=0;
//AT: Wymaga dodania parametrów !!! W Informica poniższe nie są używane !!!
//  if Par105Bezg._105bezg and Par105Bezg._105bnno_bezg then
//  begin   //E.B. 19.01.2017
//    nr:=nr+DRe.RAP;
//    if nr>=IxA.Ixrap then exit;
//    if rel.Kind = 17 then begin  //rejestracja przejazdu
//      nr:=nr+3*DRe.RAP;
//      if nr>=IxA.Ixrap then exit;
//    end;
//    if rel.Kind = 21 then begin //opłata dodatkowa
//      NrSpZ:=A[nr+13];
//      NrWal:=A[nr+14];
//      rf.NrSpZapl:=ZmianaSposobuZaplaty(NrSpZ,NrWal);
//    end;
//  end;

  OstWaluta.NrWaluty := rf.NrWaluty;              //E.B. 22.06.2018
  rf.NazSpZ := GetPaymentTypeName(ASalesReport._File, ASalesReport._FileA80, rf.NrSpZapl);
  OstSpZapl.NrSpZapl := rf.NrSpZapl;   //E.B. 22.06.2018
  OstSpZapl.NazSpZ := rf.NazSpZ;       //E.B. 22.06.2018
  rf.BuyerNIP := AEvent_32._BuyerNIP;

  Result := rf;
end;

