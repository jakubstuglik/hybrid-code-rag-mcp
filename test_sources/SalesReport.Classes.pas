{ TDictionaryInteger<T> }

function TDictionaryInteger<T>.GetKeyByValue(
  const SearchValue: Integer;
  out FoundKey: T;
  const ValueComparer: IEqualityComparer<Integer> = nil
): Boolean;
var
  Pair: TPair<T, Integer>;
  Comparer: IEqualityComparer<Integer>;
begin
  Result := False;

  // Use provided comparer or default
  if Assigned(ValueComparer) then
    Comparer := ValueComparer
  else
    Comparer := TEqualityComparer<Integer>.Default;

  for Pair in Self do
  begin
    if Comparer.Equals(Pair.Value, SearchValue) then
    begin
      FoundKey := Pair.Key;
      Exit(True);
    end;
  end;
end;

end.

