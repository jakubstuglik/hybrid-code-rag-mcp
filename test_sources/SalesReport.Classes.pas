function TSalesReport.GetTicketCount(): integer;
var
  f: TFiscalReport;
begin
  Result := 0;
  for f in FiscalReportList do
    Inc(Result, f.TicketList.Count);
end;

function TSalesReport.TicketGrossSum: Int64;
var
  f: TFiscalReport;
  t: TTicket;
begin
  Result := 0;
  for f in FiscalReportList do
    if Assigned(f.TicketList) then
      for t in f.TicketList do
        Result := Result + t.PriceSum;
end;

function TSalesReport.GetTicketRegisterCount(): integer;
var
  sl: TStringList;
  f: TFiscalReport;
begin
  sl := TStringList.Create;
  try
    sl.Duplicates := dupIgnore;
    sl.Sorted := True;
    for f in FiscalReportList do
      if Assigned(f.TicketRegister) then
        sl.Add(f.TicketRegister.CurrentLogo);
    Result := sl.Count;
  finally
    sl.Free;
  end;
end;

function TSalesReport.TicketValueSum: Int64;
var
  f: TFiscalReport;
  t: TTicket;
begin
  Result := 0;
  for f in FiscalReportList do
    if Assigned(f.TicketList) then
      for t in f.TicketList do
        Result := Result + t.AmountToPay;
end;

