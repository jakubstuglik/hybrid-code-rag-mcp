  function SprPoprRek32(const AEvent32: IEmar_ReportEvent_32; AOutputText: Boolean): Boolean;
  var
    nrem: Cardinal;
    okEM: Boolean;
    sbl: String;
  begin
    okEM := True;
    sbl := '';
    r2ok := (AEvent32.ReportRecordCount > 1)and not AEvent32.IsError(reErrorPartMissing2 or reErrorCheckSum2);
            {(lrek>1) and (Arap[ir+DRe.RAP]=101)
           and (Arap[ir+DRe.RAP+1]=lrek)
           and (Arap[ir+DRe.RAP+2]=2)
           and SumKonOk(ir+DRe.RAP,adlrnr32[2]);}
    r3ok := (AEvent32.ReportRecordCount > 2)and not AEvent32.IsError(reErrorPartMissing3 or reErrorCheckSum3);
            {(lrek>2) and (Arap[ir+DRe.RAP*2]=101)
           and (Arap[ir+DRe.RAP*2+1]=lrek)
           and (Arap[ir+DRe.RAP*2+2]=3)
           and SumKonOk(ir+DRe.RAP*2,adlrnr32[3]);}
    {pdw := @Arap[ir+11];
    nrem := pdw^;}
    nrem := AEvent32.CardNumber;
    try
      if Length(FloatToStr(nrem)) < 6 then
      begin
        okEM := False;     //<== sprawdzenie poprawności!!
        sbl := C_TXT_INCORRECT_EM_CARD_NUMBER;
      end;
    except
      okEM := False;       //<== sprawdzenie poprawności!!
      sbl := C_TXT_INCORRECT_EM_CARD_NUMBER;
    end;
    Result := r2ok and r3ok;
    if AOutputText and not Result then
    begin
      if okEM then
      begin
        AddLine(23, Format(C_FMT_EM_CARD_NUMBER, [nrem]));
        OutputLine(re, clTeal, fsStrong);
      end
      else begin
        AddLine(23, sbl);
        OutputLine(re, clError, fsRegular);
      end;
      AddLine(23, C_TXT_EM_CARD_PARTIALLY_READ_DATA);
      OutputLine(re, clError, fsRegular);
    end;
  end; //SprPoprRek32

