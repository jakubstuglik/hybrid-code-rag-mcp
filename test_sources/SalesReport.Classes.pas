function TSalesReport.getIRideRouteIndexFromBusStopNo(aRideIndex,
  aBusStopNo: integer): integer;
var
  iride: IEmar_Ride;
  i, j, k: integer;
begin
  Result := -1;
  iride := _FileA80.RideList[aRideIndex];
  i := iride.IndexOfRoute;
  j := iride.BusStopCount + i - 1;
  for k := i to j do
    if _FileA80.RideRouteList[k].IndexOfBusStopInLine + 1 = aBusStopNo then begin
      Result := k;
      break;
    end;
end;

function TSalesReport.getIRideRouteIndexFromBusStopRideNo(aRideIndex,
  aBusStopNo: integer): integer;
var
  iRideRouteIndex: Integer;
begin
  if _FileA80.getRideRouteIndexFromBusStopRideNo(aRideIndex, aBusStopNo, @iRideRouteIndex) = ERR_NO_ERROR then
    Result := iRideRouteIndex
  else
    Result := -1;
end;

