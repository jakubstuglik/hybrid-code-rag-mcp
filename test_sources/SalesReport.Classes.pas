procedure TSalesReport.CreateErrorFile(AReportFilePath: String; ASaveCFileError, ASaveWFileError: Boolean);
var
  sFilePath, sErrorFilePath: String;
  sWFilePath, sErrorWFilePath: String;
  msg: TStringList;
begin
  if WFile.CFile <> '' then // plik C jest powiązany z plikiem W
  begin
    sFilePath := WFile.DIR + WFile.CFile; // plik C
    sWFilePath := AReportFilePath; // plik W
  end
  else
    if WFile.Name <> '' then // W nie ma powiązanego pliku C
    begin
      sFilePath := ''; // plik C
      sWFilePath := AReportFilePath; // plik W
    end
    else
      if CFilePath <> '' then
      begin
        sFilePath := CFilePath; // plik C
        sWFilePath := ''; // plik W
      end
      else
        if KFilePath <> '' then
        begin
          sFilePath := KFilePath; // plik K jako C
          sWFilePath := ''; // plik W
        end
        else
        begin
          sFilePath := AReportFilePath; // plik C
          sWFilePath := ''; // plik W
        end;

  // wysyłane są 2 pliki: .error oraz sam raport
  if (sFilePath <> '')and ASaveCFileError then
  begin
    sErrorFilePath := sFilePath + '.error';
    Messages.SaveToFile(sErrorFilePath, TEncoding.UTF8); // tworzymy plik z opisem błędu
    if not(TDISPFileEmar105.CreateErrorFile(Self, sErrorFilePath)
      and TDISPFileEmar105.CreateErrorFile(Self, sFilePath)) then
      KMFilesUtil.ForceDeleteFile(PChar(sErrorFilePath));
  end;

  // wysyłane są 2 pliki: .error oraz sam raport
  if (sWFilePath <> '')and ASaveWFileError then
  begin
    sErrorWFilePath := sWFilePath + '.error';
    if sFilePath = '' then
      Messages.SaveToFile(sErrorWFilePath, TEncoding.UTF8) // tworzymy plik z opisem błędu
    else
    begin
      if Messages.Text.Trim() <> '' then
        Messages.SaveToFile(sErrorWFilePath, TEncoding.UTF8) // tworzymy plik z opisem błędu
      else
        try
          msg := TStringList.Create;
          msg.Text := ExtractFileName(sFilePath); // znaczy, iż powiązany z tym plikiem
          msg.SaveToFile(sErrorWFilePath, TEncoding.UTF8) // tworzymy plik z opisem błędu
        finally
          FreeAndNil(msg);
        end;
    end;
    if not(TDISPFileEmar105.CreateErrorFile(Self, sErrorWFilePath)
      and TDISPFileEmar105.CreateErrorFile(Self, sWFilePath)) then
      KMFilesUtil.ForceDeleteFile(PChar(sErrorWFilePath));
  end;
end;

