      end;
{$ENDREGION}

//      {$IF DEFINED(DEBUG)}
//      OutputDebugString(PChar(Format('<<<      END processing event #%d (record %d of %d): %d',
//        [rel.Kind, Succ(iRecord), _File.ReportEventList.Count, Stopwatch.ElapsedMilliseconds])));
//      {$ENDIF}
      Inc(iRecord);
    except
      raise;
    end;
    _File.ReportEventList.EndUpdate;

{$REGION 'After loop'}
    if LBilNiezgzCen > 0 then
    begin  //w raporcie są bilety niezgodne z cennikiem
      AddLine(1, C_TXT_REGISTRATION_ERR_TICKETS_WITH_WRONG_PRICES);
      OutputLine(re, clError, fsStrong);
      AddLine(8, Format(C_TXT_REGISTRATION_ERR_TICKETS_WITH_WRONG_PRICES_CNT, [LBilNiezgzCen]));
      OutputLine(re, clError, fsStrong);
      if bladcdz or bladcz then
      begin
        AddLine(1, C_TXT_REGISTRATION_ERR_AFTER_RF_CLOSE);
        OutputLine(re, clError, fsStrong);
        AddLine(1, C_TXT_REGISTRATION_ERR_CHECK_TICKET_PRICES);
        OutputLine(re, clError, fsStrong);
      end;
      AddLine(1, C_TXT_REGISTRATION_ERR_CANCEL_TICKETS);
      OutputLine(re, clError, fsStrong);
    end;

    if AErrorsInProcessTasks then
    begin  //E.B. 03.09.2013
{$REGION '      dolna sekcja, gdy raport ma błędy'}
      OutputLinesErrorBottomSection(re);
{$ENDREGION}
    end
    else
    begin
      //AT: if Result and baz then SortujAbilm;
      if LPCRegistrationParamsParameters.ExtraDataSaveCardWork then
        if not _File.IsEmar205OnlineReport() then // zwykły raport Emar-105\205
          PokazDaneDodatkowe(_File, '')
        else
        begin
          // raport Emar-205 online; pliki DD0 są odczytywane w zdarzeniu #40 'Dane dodatkowe odczytane z pliku:'
          _File.ReportEventList.BeginUpdate;
          try
            dd0File := TDISPFileEmar105.Create;
            try
              for iRecord := 0 to Pred(_File.ReportEventList.Count) do
              begin
                rel := _File.ReportEventList[iRecord];
                if rel.Kind = 40 then
                begin
                  sDD0FileName := String(rel.AsEvent_40.DDFileName).Trim + '.DAT';

                  iDD0FileID := TDispFile.IdFromNameAndFileType(dmMain, sDD0FileName, Integer(dfFileDD0Export));
                  if iDD0FileID > 0 then
                  begin
                    sDD0FilePath := KMWinSysUtils.TempFileName(sDD0FileName);
                    if dd0File.ReadFromDatabase(iDD0FileID) then
                    try
                      dd0File.FileAttachment.LoadAttachment(false, false, false);
                      CopyFile(PChar(dd0File.FileAttachment.LocalFileName), PChar(sDD0FilePath), False);
                      if dd0File.FileAttachment.FileStream.Size > 0 then
                      begin
                        dd0File.InitEmarFile(False);
                        iFileDD0LoadError :=
                          dd0File.EmarFile.LoadFromFile(PChar(sDD0FilePath));
                        // exclude ERR_REPORT_NO_REPORT because DD0 has not report
                        if (iFileDD0LoadError = NO_ERROR)or((iFileDD0LoadError xor ERR_REPORT_NO_REPORT) = NO_ERROR) then
                        begin
                          PokazDaneDodatkowe(dd0File.EmarFile, sDD0FileName);
                          DopiszWykazSkrotow(dd0File.EmarFile);
                          DopiszNaglowek205(dd0File.EmarFile);
                          DopiszParametryWiFi205(dd0File.EmarFile);
                        end;
                      end
                      else
                      begin
                        sLine := '';
                        OutputLine(re, clRegular, fsStrong);
                        AddLine(0, Format(RS_ERR_FMT_LoadAttachmentFromServer, [sDD0FileName]));
                        OutputLine(re, clError, fsStrong);
                      end;
                    finally
                      if FileExists(sDD0FilePath) then
                        KMFilesUtil.ForceDeleteFile(PChar(sDD0FilePath)); // delete temporary copy of DD0 file
                    end;
                  end
                  else // iDD0FileID = 0
                  begin
                    // brak pliku do odczytu
                    sLine := '';
                    OutputLine(re, clRegular, fsStrong);
                    AddLine(0, Format(C_FMT_FILE_NOT_FOUND, [sDD0FileName]));
                    OutputLine(re, clError, fsStrong);
                  end;
                end;
              end;
            finally
              FreeAndNil(dd0File);
            end;
          finally
            _File.ReportEventList.EndUpdate;
          end;
        end;
    end;
{$ENDREGION}

    re.Lines.EndUpdate;
    Result := CreateRTFFile(re);
  finally
//    SendMessage(re.Handle, WM_SETREDRAW, 1, 0);
    FiscalReportList.Clear; // it was used just a helpful list of local FiscalReports
    ControlPrintList.Clear; // it was used just a helpful list of local ControlPrints
    TicketZTMList.Clear;    // it was used just a helpful list of local TicketZTM
    ReportPrintList.Clear; // it was used just a helpful list of local ReportPrints

    FreeAndNil(re);
  end;

  rel := nil;
  dmMain.SendDebugPipeMessage('End ProcessTasks generation');
end; //GenerateProcessTasks

function TSalesReportEmar105.GenerateCancelledTicketsProcessTasks: String;
var
  s: String;
  iReturnAmount: Integer;
  re: TRichEdit;
  oPerson: TPerson;
  oFiscalReport: TFiscalReport;
  oTicket: TTicket;
  oCurrency: TCurrency;
  oEmCard: TEmCard;
  oCompany: TCompany;
begin
  iReturnAmount := 0;
  sLine := '';
  re := TRichEdit.CreateParented(HWND_MESSAGE); // creating without parent (messaging only)
  oPerson := TPerson.Create;
  oCurrency := TCurrency.Create;
  oEmCard := TEmCard.Create;
  oCompany := TCompany.Create;
  try
    re.Font.Name := 'Courier New'; // to have text properly formatted
    re.Font.Size := 10;
    re.SelStart := 0;

    oPerson.ReadBaseFromDatabase(Driver_ID);
    Self.FileOryg.ReadBaseFromDatabase(Self.FileOryg_ID);

{$REGION 'Header'}
    AddLine(1, Format(TASK_REPORT_NUMBER, [Self.TaskReportNumber()]));
    OutputLine(re, clRegular, fsStrong);
    AddLine(1, Format(TASK_REPORT_CANCEL_CASHIER, [oPerson.IDNumber, oPerson.FirstName + ' ' + oPerson.LastName]));
    OutputLine(re, clRegular, fsRegular);
    AddLine(1, '');
    OutputLine(re, clRegular, fsRegular);

    AddLine(1, Format(TASK_REPORT_CANCEL_REG_DATETIME, [FormatDateTime(sfdYMD, RegistrationDate), FormatDateTime(sft, RegistrationDate)]));
    OutputLine(re, clRegular, fsRegular);
    AddLine(1, '');
    OutputLine(re, clRegular, fsRegular);

    AddLine(1, Format(TASK_REPORT_CANCEL_A80_NAME, [Self.FileOryg.Name]));
    OutputLine(re, clImportant, fsRegular);
    AddLine(1, '');
    OutputLine(re, clRegular, fsRegular);

    AddLine(1, TASK_REPORT_TITLES);
    OutputLine(re, clRegular, fsStrong);
{$ENDREGION}

{$REGION 'Tickets'}
    for oFiscalReport in FiscalReportList do
    begin
      for oTicket in oFiscalReport.TicketList do
      begin
        Inc(iReturnAmount, oTicket.TicketReturnAmount);
        oCurrency.ReadFromDatabase(oTicket.Currency_ID);

        AddLine(1, FormatDateTime(sfdYMD, oTicket.SaleDate) + '  ' + FormatDateTime(sft, oTicket.SaleDate));
        AddLine(2, Format(TASK_REPORT_CANCEL_TICKET_NUMBER, [oTicket.TicketNumber]));

        case oTicket.TicketType_ID of
          1: s := TASK_REPORT_DISPOSABLE + ' ';
          2: s := TASK_REPORT_PERIODIC + '    ';
          3: s := TASK_REPORT_MONTHLY + '  ';
        end;
        case oTicket.TicketGenre_ID of
          1: s := s + TASK_REPORT_NORMAL;
          2: s := s + TASK_REPORT_REDUCED;
          3: s := s + TASK_REPORT_SCHOOL;
          4: s := s + TASK_REPORT_LUGGAGE;
          5: s := s + TASK_REPORT_WORKER_NORMAL;
        end;
        AddLine(1, s);
        OutputLine(re, clRegular, fsRegular);
        AddLine(23, Format(TASK_REPORT_CANCEL_TICKET_SALE_DATE, [FormatDateTime(sfdYMD, oTicket.TicketCancelled_SaleDate), FormatDateTime(sft, oTicket.TicketCancelled_SaleDate)]));
        AddLine(1, Format(TASK_REPORT_CANCEL_BY_DRIVER, [oPerson.IDNumber]));
        OutputLine(re, clRegular, fsRegular);
        AddLine(23, Format(TASK_REPORT_CANCEL_TICKET_REGISTER, [oFiscalReport.FiscalLogo]));
        AddLine(2, Format(TASK_REPORT_CANCEL_FISCAL_REPORT, [oFiscalReport.ReportNumber]));
        OutputLine(re, clRegular, fsRegular);
        AddLine(23, Format(TASK_REPORT_CANCEL_TICKET_AMOUNTS,
          [
            Abs(oTicket.PriceSum) / 100,
            oCurrency.Name,
            oTicket.TicketReturnAmount / 100,
            oCurrency.Name
          ]));
        OutputLine(re, clRegular, fsRegular);
        if oTicket.TicketGenre_ID = 5 then
        begin
          AddLine(21, Format(TASK_REPORT_CANCEL_TICKET_AMOUNT_TO_PAY,
            [
              Abs(oTicket.AmountToPay) / 100,
              oCurrency.Name,
              oTicket.TicketReturnAmount / 100,
              oCurrency.Name
            ]));

          OutputLine(re, clRegular, fsRegular);
        end;
        if (oTicket.EmCard_ID <> 0)
          and oEmCard.ReadFromDatabase(oTicket.EmCard_ID)
          and oCompany.ReadFromDatabase(oEmCard.Company_ID) then
        begin
          AddLine(23, Format(C_FMT_EM_CARD_AND_COMPANY, [oEmCard.CardNumber, oCompany.INumber]));
          OutputLine(re, clRegular, fsRegular);

          if oEmCard.BlockedDate = 0 then
            AddLine(23, TASK_REPORT_CANCEL_EMCARD_NOT_REGISTERED)
          else
            AddLine(23, Format(TASK_REPORT_CANCEL_EMCARD_REGISTATION_DATE, [FormatDateTime(sfdYMD, oEmCard.BlockedDate)]));
        end;
      end;
    end;
{$ENDREGION}

{$REGION 'Footer'}
    AddLine(0, '');
    OutputLine(re, clRegular, fsRegular);
    AddLine(8, Format(TASK_REPORT_CANCEL_CLOSE_TIME, [FormatDateTime(sft, EndDate)]));
    OutputLine(re, clRegular, fsStrong);
    AddLine(8, Format(TASK_REPORT_CANCEL_TICKETS_COUNT, [TicketNo]));
    OutputLine(re, clRegular, fsStrong);
    AddLine(1, Format(TASK_REPORT_CANCEL_TICKETS_AMOUNT, [Abs(TicketGross) / 100, oCurrency.Name]));
    OutputLine(re, clRegular, fsStrong);
    AddLine(6, Format(TASK_REPORT_CANCEL_TICKETS_RETURN_AMOUNT, [iReturnAmount / 100, oCurrency.Name]));
    OutputLine(re, clRegular, fsStrong);
{$ENDREGION}

    Result := CreateRTFFile(re);
  finally
    FreeAndNil(oCompany);
    FreeAndNil(oEmCard);
    FreeAndNil(oCurrency);
    FreeAndNil(oPerson);
    FreeAndNil(re);
  end;
end; //GenerateCancelledTicketsProcessTasks

