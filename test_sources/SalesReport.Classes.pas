function TSalesReportEmar105.IgnoreEvent17(AEvent17: IEmar_ReportEvent_17; ALastEmarIndexOfRide: Integer): Boolean;
begin
  // (DPA) zadanie 57699
            // w starym programie się sprawdza najpierw czy zdarzenie jest poprawne:
            // - 1 - czy są wszystkie rekordy zdarzenia i sumi kontrolne się zgadzają
            // - 2 - czy numer karty jest prawidłowy (nie może mieć mniej niż 6 cyfr)
            // - 3 - sprawdzenie indeksu przystanku docelowego czy nie przekracza
            //       liczbę przystanków kursu. Jeśli przekracza jest wpis do RTF-a (przebiegu zadania),
            //       a to zdarzenie jest pomijane (nie zapisuje się do bazy)
  Result :=
    (AEvent17.Errors <> 0) // warunek 1
    or(AEvent17.CardNumber < 100000) // warunek 2
    or(getIBusStop(LastEmarIndexOfRide, AEvent17.BusStopStart) = nil) // warunek 3
    or(getIBusStop(LastEmarIndexOfRide, AEvent17.BusStopEnd) = nil) // warunek 3
    ;
end;

procedure TSalesReportEmar105.TestujStawkiPTU(DataRF: String);  //E.B. 03.01.2011
var
  i: Integer;
  dPTU2ValidFrom: TDate;
begin
  dPTU2ValidFrom := EmarDateToDate(_FileA80.Consts.PTU2ValidFrom);
  //if (con.DatWazStPTU2>0) and (StrToDate(DataRF)>=con.DatWazStPTU2) then
  if (dPTU2ValidFrom > 0)and(StrToDate(DataRF) >= dPTU2ValidFrom) then
  begin
    for i := 1 to 7 do
      case i of
        1: VATAmounts[i] := _FileA80.Consts.RatePTU2_A; // StPod, Con.StPTU2[i];
        2: VATAmounts[i] := _FileA80.Consts.RatePTU2_B; // StPod, Con.StPTU2[i];
        3: VATAmounts[i] := _FileA80.Consts.RatePTU2_C; // StPod, Con.StPTU2[i];
        4: VATAmounts[i] := _FileA80.Consts.RatePTU2_D; // StPod, Con.StPTU2[i];
        5: VATAmounts[i] := _FileA80.Consts.RatePTU2_E; // StPod, Con.StPTU2[i];
        6: VATAmounts[i] := _FileA80.Consts.RatePTU2_F; // StPod, Con.StPTU2[i];
        7: VATAmounts[i] := _FileA80.Consts.RatePTU2_G; // StPod, Con.StPTU2[i];
      end;
  end;
//E.B. 11.01.2011 - jeśli karta pamięci zaprogramowana została zbiorem z nowymi
//stawkami PTU, a w rekordzie 0 zapisane były stare stawki PTU, to stawki
//zapisane w rekordzie 0 są ignorowane (nadpisywane przez stawki z Con.StPTU1)
end;

procedure TSalesReportEmar105.TestujStawkiPTUZRF(DataZRF: String);  //E.B. 01.02.2011
var
  i: Integer;
  dPTU1ValidFrom, dPTU2ValidFrom: TDate;
  cdsVATRates: TClientDataSet;
begin
  dPTU1ValidFrom := EmarDateToDate(_FileA80.Consts.PTU1ValidFrom);
  dPTU2ValidFrom := EmarDateToDate(_FileA80.Consts.PTU2ValidFrom);
  //if (con.DatWazStPTU2=0) and (StrToDate(DataZRF)<con.DatWazStPTU1) then
  if (dPTU2ValidFrom = 0)and(StrToDate(DataZRF) < dPTU1ValidFrom) then
  begin
    cdsVATRates := TVatRateHistory.ReadVatRatesOnDate(dmMain, StrToDate(DataZRF)).ClientDataSet;
    if cdsVATRates.RecordCount > 0 then
    begin // pobierane są stawki VAT aktualne na dzień zdarzenia
      while not cdsVATRates.Eof do
      begin
        if cdsVATRates.FieldByName('ID').AsInteger in [1..8] then
        begin
          if cdsVATRates.FieldByName('Rate').AsInteger = -1 then
            StPodZRF[cdsVATRates.FieldByName('ID').AsInteger] := $FFFF
          else
            if cdsVATRates.FieldByName('Rate').AsInteger = -2 then
              StPodZRF[cdsVATRates.FieldByName('ID').AsInteger] := 20000
            else
              if cdsVATRates.FieldByName('Rate').AsInteger = -3 then
                StPodZRF[cdsVATRates.FieldByName('ID').AsInteger] := 30000
              else
                StPodZRF[cdsVATRates.FieldByName('ID').AsInteger] := cdsVATRates.FieldByName('Rate').AsInteger;
        end;
        cdsVATRates.Next;
      end;
    end
    else // logic from the old program; it's almost 0 chanse it'll be raised
      if StrToDate(DataZRF) < StrToDate(DataZmStPTU_1) then
      begin
        for i := 1 to 7 do
          StPodZRF[i] := StPTU_0[i];
      end
      else begin
        for i := 1 to 7 do
          StPodZRF[i] := StPTU_1[i];
      end;
  end
  else
  begin
    for i := 1 to 7 do
      StPodZRF[i] := VATAmounts[i]; // StPod
  end;
end;

