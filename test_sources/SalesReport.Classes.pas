  procedure WpiszPola64_66Apaskm(ACardNumber: Int64;
    ACardTicketNumber: String;
    ATicketNewValidFrom, ATicketNewValidTo: TDate);      //E.B. 02.05.2013
  var
    i, i32: Integer;
    iEmCardTicketProlongingID_Card: Integer;
    iEmCardSaleOnBusID_Card: Integer;
    rel: IEmar_ReportEvent;
    ectp: TEmCardTicketProlonging;
    ecsob: TEmCardSaleOnBus;
  begin
//    BWazOdR := '';
//    NrBiletuR := '';
    LogoSpR := '';
    i32 := -1;
    if _File.IsReportEvent32 then
    begin
      for i := Pred(_File.ReportEventList.Count) downto 0 do
        if _File.ReportEventList.Items[i].Kind = 32 then
        begin
          rel := _File.ReportEventList.Items[i];
          if (rel.AsEvent_32.CardNumber = ACardNumber)
            and(String(rel.AsEvent_32.CardTicketNumber) = ACardTicketNumber)
            and(
              (ATicketNewValidFrom = 0{BWazOdR = ''})
              or
              (ATicketNewValidFrom <> 0{BWazOdR <> ''})
              and(EmarDateToDate(rel.AsEvent_32.TicketNewValidFrom) = ATicketNewValidFrom) //EmarDateToDate(BWazOdR))
              )
            and(EmarDateToDate(rel.AsEvent_32.TicketNewValidTo) = ATicketNewValidTo{EmarDateToDate(PWaznyDo)})then
          begin
//w raporcie może być zarejestrowana sprzedaż biletu w autobusie na nowy okres,
//ale przejazd może dotyczyć okresu poprzedniego (np. przejazd w ostatnim dniu
//miesiąca, a bilet sprzedany na nowy miesiąc) - w takim przypadku pola 64-66
//z tabeli ZPPBM, a nie tablicy Azbemk
            BWazOdR := rel.AsEvent_32.TicketNewValidFrom; //Azbemk[i].BWazOdR; //64
            NrBiletuR := ACardTicketNumber; //Azbemk[i].NrBiletuR; //66
            i32 := i;
            Break;
          end;
        end;
    end;
    if i32 <> -1 then // znalazły
    begin
      for i := Pred(i32) downto 0 do
      begin
        rel := _File.ReportEventList.Items[i];
        case rel.Kind of
          1:
            begin
              LogoSpR := String(rel.AsEvent_01.TicketRegister);
              Break;
            end;
          2:
            begin
              LogoSpR := String(rel.AsEvent_02.TicketRegister);
              Break;
            end;
          5:
            begin
              LogoSpR := String(rel.AsEvent_05.TicketRegister);
              Break;
            end;
        end;
      end;
    end
    else
    begin
//dane biletu odczytywane są z tabeli BilMrrrrmm miesiąca jazdy - w tabeli zapisywane są
//dane biletu ważnego w tym miesiącu przy rejestracji raporu ze sprzedaży
//EM-karta z biletem okresowym może mieć zapisane w tabeli z danego miesiąca
//dane kilku biletów (przedłużeń) - wszystkie mają identyczny numer biletu wzorcowego
//(wpisanego w karcie), ale różne daty końca okresu ważności - właściwy bilet ma
//BILM.BWAZNYDO=ZPPBM.PWAZNYDO
      ecsob := TEmCardSaleOnBus.Create;
      try
        iEmCardSaleOnBusID_Card :=
          TEmCardSaleOnBus.IdForPeriod(
            dmMain
            , iEmCardFirstTicket_ID // powinien być wcześniej znalezony
            , ATicketNewValidFrom
            , ATicketNewValidTo
            );
        if iEmCardSaleOnBusID_Card > 0 then
        begin
          ecsob.ReadFromDatabase(iEmCardSaleOnBusID_Card);
          BWazOdR := DateToStr(ecsob.NewValidFrom); // ??? //Azbemk[i].BWazOdR; //64
          NrBiletuR := ACardTicketNumber; //Azbemk[i].NrBiletuR; //66
          LogoSpR := LogoSp;
        end
        else
        begin // zdarzył sie przypadek gdy rekordu w SalesOnBus nie było, ale był w Prolonging
          ectp := TEmCardTicketProlonging.Create;
          try
            iEmCardTicketProlongingID_Card :=
              TEmCardTicketProlonging.IdForPeriod(
                dmMain
                , iEmCardFirstTicket_ID // powinien być wcześniej znalezony
                , ATicketNewValidFrom
                , ATicketNewValidTo
                );
            if iEmCardTicketProlongingID_Card > 0 then
            begin
              ectp.ReadFromDatabase(iEmCardTicketProlongingID_Card);
              BWazOdR := DateToStr(ectp.TicketProlongingDateFrom); // ??? //Azbemk[i].BWazOdR; //64
              NrBiletuR := ACardTicketNumber; //Azbemk[i].NrBiletuR; //66
              LogoSpR := LogoSp;
            end;
          finally
            FreeAndNil(ectp);
          end;
        end;
      finally
        FreeAndNil(ecsob);
      end;
    end;
  end;

