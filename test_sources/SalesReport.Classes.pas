  Result := AEmarFile105.RideRouteList.Items[AIndexOfRoute + iBusStopNumber].IndexOfBusStop;
end;

// Returns Name of the payment type by its Index in the file
// działa analogicznie do GetPaymentTypeID
function GetPaymentTypeName(const AEmarBaseFile, AEmarA80BaseFile: IEmar_BaseFile;
  AEmarIndexOfPayType: Integer): String;
begin
  Result := '';
  if AEmarBaseFile.IsReportEvent41 then // Emar-205
  begin
    if (AEmarIndexOfPayType > 0)
      and(AEmarIndexOfPayType <= AEmarA80BaseFile.PaymentTypeList.Count) then
