// See RejRoz.SprCzyZar
function TSalesReport.CheckIfExistsInDBFiscalReport(AFromTicketRegisterCard: Boolean): Integer;
var
  fr, frItem: TFiscalReport;
begin
  // szukamy pierwszy raport fiskalny który ma bilety
  fr := nil;
  for frItem in FiscalReportList do
    if (frItem.EndDate <> 0)and(frItem.TicketList.Count > 0) then // jeśli jest zamknięty oraz ma bilety
    begin
      fr := frItem;
      Break;
    end;
  if not Assigned(fr) then
    for frItem in FiscalReportList do
      if frItem.TicketList.Count > 0 then // jeśli ma bilet
      begin
        fr := frItem;
        Break;
      end;
//  if not Assigned(fr) then
//    if FiscalReportList.Count > 0 then
//      fr := FiscalReportList.Items[0]; // jakikolwiek
  if Assigned(fr) then
  begin
    Result := TFiscalReport.CheckIfExistsForRegistration(
        Self.dmMain,
        fr,
        Self.TicketRegisterCard_ID, // NRKARTYP
        Self.TicketRegister_ID, //  LOGO
        Self.ReportCode, //  SZYFR
        TAutoDBTransActions.SQLFormatDateTime(fr.StartDate), // DATAPOCZ
        Self.ReportType_ID, // TYPRZ
        '' // ZBIORBM
        );
    // nie można sprawdzać bez pomijania szyfru przy raportach odczytywanych z karty pamięci
    if (Result = 0)and(not AFromTicketRegisterCard) then // nie z karty, ignorowany jest szyfr
    begin
      Result := TFiscalReport.CheckIfExistsForRegistration(
          Self.dmMain,
          fr,
          Self.TicketRegisterCard_ID, // NRKARTYP
          Self.TicketRegister_ID, //  LOGO
          '', //  SZYFR
          TAutoDBTransActions.SQLFormatDateTime(fr.StartDate), // DATAPOCZ
          Self.ReportType_ID, // TYPRZ
          Self.ReportName // ZBIORBM
          );
    end;
  end
  else
  begin // szukamy raczej po szyfru raportu
    Result := TFiscalReport.CheckIfExistsForRegistration(
      Self.dmMain,
      nil,
      Self.TicketRegisterCard_ID, // NRKARTYP
      Self.TicketRegister_ID, //  LOGO
      Self.ReportCode, //  SZYFR
      TAutoDBTransActions.SQLFormatDateTime(Self.StartDate), // DATAPOCZ // w tym prypadku podaję datę z SalesReport
      Self.ReportType_ID, // TYPRZ
      '' // ZBIORBM
      );
  end;
end; //CheckIfExistsInDBFiscalReport

