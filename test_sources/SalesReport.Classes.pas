// Returns ID of the FarePriceReduction by its ReduceCode
function GetFarePriceReductionIndex(const AEmarFile: IEmar_BaseFile;
  const AEmarRide: IEmar_Ride;
  ACompanyINumber: Integer;
  AReportEvent: IEmar_ReportEvent): Integer;
var
  i: Integer; 
  iReduceCode: Integer; 
  dDateTime: TDateTime;
begin
  Result := -1;
  dDateTime := EmarDateTimeToDateTime(AReportEvent.EventDate, AReportEvent.EventTime);
  case AReportEvent.Kind of
    15: // 15 - Bilet ulgowy
      begin
        iReduceCode := AReportEvent.AsEvent_15.ReduceCode;
      end;
    else
      begin
        iReduceCode := -1;
      end;
  end;
  if ACompanyINumber = 0 then
    ACompanyINumber := AEmarFile.CompanyList.Items[AEmarRide.CompanyIndex].Number;
  i := 0;
  while i < AEmarFile.FarePriceReductionList.Count do
  begin
    if (
        (AEmarFile.FarePriceReductionList.Items[i].ReductionType = 1{ustawowa}) // dla ustawowych, numer firmy = 0
        or
        (AEmarFile.FarePriceReductionList.Items[i].ReductionCompanyINumber = ACompanyINumber)
      )
      and(AEmarFile.FarePriceReductionList.Items[i].ReductionCode = iReduceCode)
      and(
        (EmarDateToDate(AEmarFile.FarePriceReductionList.Items[i].ValidFrom) = 0)
        or
        (EmarDateToDate(AEmarFile.FarePriceReductionList.Items[i].ValidFrom) <= dDateTime)
         )
      and(
        (EmarDateToDate(AEmarFile.FarePriceReductionList.Items[i].ValidTo) = 0)
        or
        (EmarDateToDate(AEmarFile.FarePriceReductionList.Items[i].ValidTo) >= dDateTime)
         ) then
    begin
      Result := i;
      Break;
    end
    else
      Inc(i);
  end;
end;

function GetMonthTicketReductionIndex(const AEmarFile: IEmar_BaseFile;
  const AEmarRide: IEmar_Ride;
  AReportEvent: IEmar_ReportEvent): Integer;
var
  i: Integer;
  iCompanyINumber: Integer;
  iReduceCode: Integer;
  dDateTime: TDateTime;
begin
  Result := -1;
  dDateTime := EmarDateTimeToDateTime(AReportEvent.EventDate, AReportEvent.EventTime);
  case AReportEvent.Kind of
    17: // 17 - Rejestracja przejazdu z biletem okresowym (karta MIFARE)
      begin
        iCompanyINumber := AReportEvent.AsEvent_17.SaleCompany;
        iReduceCode := AReportEvent.AsEvent_17.ReduceCode;
      end;
    32: // 32 - Zakup w autobusie biletu miesięcznego / okresowego na następny okres (karta MIFARE)
      begin
        iCompanyINumber := AReportEvent.AsEvent_32.SaleCompany;
        iReduceCode := AReportEvent.AsEvent_32.ReduceCode;
      end;
    33: // 33 - Rejestracja przejazdu z biletem miesięcznym (karta MIFARE) - błędy identyfikacji
      begin //Błąd identyfikacji EM-karty
        iCompanyINumber := AReportEvent.AsEvent_33.SaleCompany;
        iReduceCode := AReportEvent.AsEvent_33.ReduceCode;
      end;
    34: // 34 - Rejestracja przejazdu z biletem miesięcznym (karta MIFARE) - nieprawidłowe bilety
      begin //Nieprawidłowy bilet w EM-karcie
        iCompanyINumber := AReportEvent.AsEvent_34.SaleCompany;
        iReduceCode := AReportEvent.AsEvent_34.ReduceCode;
      end;
    35: // 35 - przedłużenie okresu ważności biletu wieloprzejazdowego
      begin
        iCompanyINumber := AReportEvent.AsEvent_35.SaleCompany;
        iReduceCode := AReportEvent.AsEvent_35.ReduceCode;
      end;
    else
      begin
        iCompanyINumber := 0;
        iReduceCode := -1;
      end;
  end;
  if iCompanyINumber = 0 then
    iCompanyINumber := AEmarFile.CompanyList.Items[AEmarRide.CompanyIndex].Number;
  i := 0;
  while i < AEmarFile.MonthTicketReductionList.Count do
  begin
    if (
        (AEmarFile.MonthTicketReductionList.Items[i].ReductionType = 1{ustawowa}) // dla ustawowych, numer firmy = 0
        or
        (AEmarFile.MonthTicketReductionList.Items[i].ReductionCompanyINumber = iCompanyINumber)
      )
      and(AEmarFile.MonthTicketReductionList.Items[i].ReductionCode = iReduceCode)
      and(
        (EmarDateToDate(AEmarFile.MonthTicketReductionList.Items[i].ValidFrom) = 0)
        or
        (EmarDateToDate(AEmarFile.MonthTicketReductionList.Items[i].ValidFrom) <= dDateTime)
         )
      and(
        (EmarDateToDate(AEmarFile.MonthTicketReductionList.Items[i].ValidTo) = 0)
        or
        (EmarDateToDate(AEmarFile.MonthTicketReductionList.Items[i].ValidTo) >= dDateTime)
         ) then
    begin
      Result := i;
      Break;
    end
    else
      Inc(i);
  end;
end;

function DajRFWlBil(const AEvent_01: IEmar_ReportEvent_01; const ARecordsCount: Integer): TRFWlBil;
var rf: TRFWlBil;
  i: integer; //dok, gok: boolean;
  netptu: int64;
  zlawart: boolean;
  cTicketRegister: PWideChar;
begin
  FillChar(rf.NrKP, SizeOf(rf), 0);
  try
    if ARecordsCount > 1 then
    begin
      if (AEvent_01.FiscalReportDate <> '')and(AEvent_01.FiscalReportTime <> '') {A[nr+DRe.RAP+3]<>$ff} then
        rf.DataRF := EmarDateTimeToDateTime(AEvent_01.FiscalReportDate, AEvent_01.FiscalReportTime);
    end
    else   // tylko 1 rekord - data RF = dacie operacji
      rf.DataRF := EmarDateTimeToDateTime(AEvent_01.EventDate, AEvent_01.EventTime);
  except
  end;
  zlawart := false;
  rf.WalEwid := '';  //E.B. 05.09.2010
  rf.DataWalEwid := '';
  rf.GodzWalEwid := '';
  rf.NrKP := AEvent_01.CardNumber; //Czi(A,nr+11);
  cTicketRegister := AEvent_01.TicketRegister;
  rf.Logo := '';
  Move(cTicketRegister[0], rf.Logo[0], Length(cTicketRegister) * SizeOf(Char));
  rf.StatusRF := AEvent_01.FiscalReportState; //A[nr+27];
  rf.NrRF := AEvent_01.FiscalReportNumber; //Czw(A,nr+28);
  rf.WersjaPSB := AEvent_01.FirmwareVersion; //A[nr+30];
  rf.Operacja := AEvent_01.OperationKind; //A[nr+31];
  //if JestZadLK(A,nr+32,5,$ff) then
  rf.KodKRF := ShortString(AEvent_01._FiscalReportCode_Decoded); //rf.KodKRF:=Format('%.3d',[A[nr+32]])+Format('%.10u',[CzLW(A,nr+33)]);
  if rf.KodKRF = '0000000000000' then
    rf.KodKRF:='';   //E.B. 20.04.2004
  rf.StatusBil := AEvent_01.TicketRegisterState; //A[nr+32];
  netptu := 0;

  if not AEvent_01.IsError(reErrorPartMissing2 or reErrorCheckSum2) {AT: Unneded part: and(A[nr+DRe.RAP+2]=2)} then
  begin
    rf.NrStawek := AEvent_01.TaxRatesIndex; //A[nr+DRe.RAP+10];
    rf.StZerRAM := AEvent_01.MemoryClearState; //A[nr+DRe.RAP+11];
    rf.NrZerRam := AEvent_01.MemoryClearCount; //A[nr+DRe.RAP+12];
    rf.NrODok := AEvent_01.LastPrintNumber mod 100000000; //Czdw(A,nr+DRe.RAP+13) mod 100000000;
    rf.NrOBil := AEvent_01._LastTicketNumberUsedHighPart; //Czw(A,nr+DRe.RAP+17);
    rf.Brutto := AEvent_01.Brutto; //Czi(A,nr+DRe.RAP+19);
    rf.LBil := AEvent_01.TicketCount; //Czw(A,nr+DRe.RAP+23);
    rf.nrAut := '';
    {for i:=0 to 11 do
    begin
      if A[nr+DRe.RAP+26+i]=0 then break;
      if A[nr+DRe.RAP+26+i]<>$ff then
        rf.nrAut:=rf.nrAut+char(A[nr+DRe.RAP+26+i]);
    end;
    if rf.nrAut<>'' then rf.nrAut:=Trim(rf.nrAut);}
    rf.nrAut := ShortString(Trim(AEvent_01.BusSideNumber));
  end;

  if not AEvent_01.IsError(reErrorPartMissing3 or reErrorCheckSum3){AT: Unneded part: and (A[nr+DRe.RAP*2+2]=3)} then
  begin
    for i := 1 to 7 do
    begin
      rf.Netto[i] := AEvent_01.NettoByTaxRate[i]; //Czi(A,nr+DRe.RAP*2+3+i*4);
      if rf.Netto[i] < 0 then
        zlawart := True;
      netptu := netptu + rf.Netto[i];
    end;
    if (rf.WersjaPSB > 4)and(Trim(AEvent_01.CurrencyCode) <> '' {A[nr+DRe.RAP*2+31]<>$ff}) then
    begin //E.B. 05.09.2010
      rf.WalEwid := ShortString(Trim(AEvent_01.CurrencyCode)); //string(PChar(@A[nr+DRe.RAP*2+31]));
      if Trim(AEvent_01.CurrencySaveTime) <> '' then
        rf.GodzWalEwid := ShortString(TimeToStr(EmarTimeToTime(AEvent_01.CurrencySaveTime))); //TimeToStr(DajGodz(A,nr+DRe.RAP*2+35,gok));
    end;
  end;

  if not AEvent_01.IsError(reErrorPartMissing4 or reErrorCheckSum4){AT: Unneded part:  and (A[nr+DRe.RAP*3+2]=4)} then
  begin
    for i := 1 to 7 do
    begin
      rf.Ptu[i] := AEvent_01.TaxAmount[i]; //Czi(A,nr+DRe.RAP*3+3+i*4);
      if rf.Ptu[i] < 0 then
        zlawart := True;
      netptu := netptu + rf.Ptu[i];
    end;
    if (rf.WersjaPSB > 4)and(Trim(AEvent_01.CurrencySaveDate) <> '' {A[nr+DRe.RAP*3+31]<>$ff}) then //E.B. 05.09.2010
      //rf.DataWalEwid := ShortString(EmarDate(EmarDateToDate(AEvent_01.CurrencySaveDate))); //DateToStr(DajData(A,nr+DRe.RAP*3+31,dok));
      rf.DataWalEwid := ShortString(DateToStr(EmarDateToDate(AEvent_01.CurrencySaveDate))); //DateToStr(DajData(A,nr+DRe.RAP*3+31,dok));
  end;
  rf.UszkodzonyWpis := (rf.NrRF <> $ffff)and((rf.LBil > 9999)or(netptu <> rf.Brutto)or zlawart);
  Result := rf;
end;

