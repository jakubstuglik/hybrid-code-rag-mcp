function TSalesReport.ForeignCurrencyCount: integer;
var
  f: TFiscalReport;
  t: TTicket;
  sl: TStringList;
begin
  sl := TStringList.Create;
  try
    sl.Duplicates := dupIgnore;
    sl.Sorted := True;
    for f in FiscalReportList do
      if Assigned(f.TicketList) then
        for t in f.TicketList do
          if t.Currency_ID > 1 then // nie waluta referencyjna (1) oraz istniejąca (nie 0)
            sl.Add(InttoStr(t.Currency_ID));
    Result := sl.Count;
  finally
    sl.Free;
  end;
end;

function TSalesReport.ForeignCurrencySum: Int64;
var
  f: TFiscalReport;
  t: TTicket;
begin
  Result := 0;
  for f in FiscalReportList do
    if Assigned(f.TicketList) then
      for t in f.TicketList do
        if t.Currency_ID > 1 then // nie waluta referencyjna (1) oraz istniejąca (nie 0)
          Result := Result + t.AmountToPay;
end;

