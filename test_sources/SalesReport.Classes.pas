    if ADD_File.AcceptedTicketOwnerList.Count {IxA.Ixfbm}> 0 then
    begin   //32
      AddLine(0, 'Wykaz firm rozliczających przewozy pasażerów z biletami miesięcznymi');
      OutputLine(re, clImportant, fsStrong);
      i := 0;
      sLine := '';
      while i < ADD_File.AcceptedTicketOwnerList.Count {IxA.Ixfbm} do
      begin
        AddLine(0, Format('%4d', [ADD_File.AcceptedTicketOwnerList[i].CompanyNumber]));
        if not ADD_File.AcceptedTicketOwnerList[i].AllowedPasnersTravelWithTicketsNetCompany then
          AddLine(1, 'zabronione bilety sieciowe');
        sLine := sLine + #13#10;
        Inc(i);
      end;
      if sLine <> '' then
        OutputLine(re, clRegular, fsRegular);
    end;
    if ADD_File.AcceptedTradeReliefCardOwnerList.Count {IxA.Ixfuh}> 0 then
    begin   //33
      AddLine(0, 'Wykaz firm wydających akceptowane przez bileterkę karty pasażerów z ulgą handlową');
      OutputLine(re, clImportant, fsStrong);
      i := 0;
      sLine := '';
      while i < ADD_File.AcceptedTradeReliefCardOwnerList.Count {IxA.Ixfuh} do
      begin
        AddLine(0, Format('%4d', [ADD_File.AcceptedTradeReliefCardOwnerList[i].CompanyNumber]) + #13#10);
        Inc(i);
      end;
      if sLine <> '' then
        OutputLine(re, clRegular, fsRegular);
    end;
    if ADD_File.AcceptedInspectorsCompanyList.Count {IxA.Ixfkk}> 0 then
    begin  //42
      AddLine(0, 'Wykaz firm wydających akceptowane przez bileterkę karty kontrolerów');
      OutputLine(re, clImportant, fsStrong);
      i := 0;
      sLine := '';
      while i < ADD_File.AcceptedInspectorsCompanyList.Count {IxA.Ixfkk} do
      begin
        AddLine(0, Format('%4d', [ADD_File.AcceptedInspectorsCompanyList[i].CompanyNumber]) + #13#10);
        Inc(i);
      end;
      if sLine <> '' then
        OutputLine(re, clRegular, fsRegular);
    end;
    if ADD_File.ProprietaryMIFAREcardList.Count {IxA.Ixkzas}> 0 then
    begin //34
      AddLine(0, 'Wykaz zastrzeżonych EM-kart');
      OutputLine(re, clImportant, fsStrong);
      lr34 := ADD_File.ProprietaryMIFAREcardList.Count; //IxA.Ixkzas div DRe.KZAS;
      SetLength(zk, lr34);
      for i := 0 to lr34 - 1 do
        zk[i] := ADD_File.ProprietaryMIFAREcardList[i].CardNumber;
      SortZK(zk, Low(zk), High(zk));
      sLine := '';
      for i := Low(zk) to High(zk) do
        AddLine(0, Format('%.10u', [zk[i]]) + #13#10);
      if sLine <> '' then
        OutputLine(re, clRegular, fsRegular);
      SetLength(zk, 0); //zk := nil;
    end;
    if ADD_File.TicketNextPeriodList.Count {IxA.Ixkbp}> 0 then
    begin //40
      AddLine(0, 'Wykaz EM-kart z biletami do przedłużenia / sprzedaży');
      OutputLine(re, clImportant, fsStrong);
      lpemkp := 0;
      lpemks := 0;
      SetLength(tnp, ADD_File.TicketNextPeriodList.Count);
      for i := 0 to Pred(ADD_File.TicketNextPeriodList.Count) do
        tnp[i] := i;
      SortTNP(tnp, Low(tnp), High(tnp)); // sortujemy według numerów biletów
//      for i := Low(tr) to High(tr) do
      for iIndex := Low(tnp) to High(tnp) do
      begin
        i := tnp[iIndex];
        if ADD_File.TicketNextPeriodList[i].Kind {tr[i].RecType}= $FF then
        begin
          if sLine <> '' then
            OutputLine(re, clRegular, fsRegular);
          AddLine(0, 'Nieobsługiwana struktura rekordu tablicy #40. Record ' + IntToStr(iIndex + 1));
          OutputLine(re, clError, fsStrong);
        end
        else
        begin
          if ((iIndex mod 500) = 0)and(sLine <> '') then
            OutputLine(re, clRegular, fsRegular);
          if ADD_File.TicketNextPeriodList[i].Kind {tr[i].RecType} = 0 then
          begin //bilety do przedłużenia
            Inc(lpemkp);  //E.B. 19.02.2011
            AddLine(0, Format('%5d/%5dp  %.10u', [iIndex + 1, lpemkp,
              ADD_File.TicketNextPeriodList[i].CardNumber {tr[i].CardID}]) + ': ' +
              'Numer biletu: ' + String(ADD_File.TicketNextPeriodList[i].TicketNumber) {tr[i].Number}+ ' Kod przedłużenia: ' +
              Format('%.9d', [ADD_File.TicketNextPeriodList[i].ControlCode {tr[i].KodKBM}]));
//E.B. 20.10.2011 bilety przedłużane z przerwą
            case ADD_File.TicketNextPeriodList[i].ContinueType {tr[i].TypBiletu} of
              1{3}: AddLine(0, Format('%.2d',[ADD_File.TicketNextPeriodList[i].ContinueNumber {tr[i].Lp}])+      //miesięczny
                      Format('%.5d', [DataKW(StrToDate(ADD_File.TicketNextPeriodList[i].ContinuedValidTo) {tr[i].ValidTo})]) + #13#10);
              2{1}: AddLine(0, Format('%.2d',[ADD_File.TicketNextPeriodList[i].ContinueNumber {tr[i].Lp}])+     //okresowy, sieciowy
                      Format('%.5d', [DataKW(StrToDate(ADD_File.TicketNextPeriodList[i].ContinuedValidTo) {DataKW(tr[i].ValidTo})])+
                      Format('%.2d', [ADD_File.TicketNextPeriodList[i].DayCountValid {tr[i].LDniW}]) + #13#10);
              3{6}: AddLine(0, Format('%.2d',[ADD_File.TicketNextPeriodList[i].ContinueNumber {tr[i].Lp}])+     //wieloprzejazdowy
                      Format('%.5d', [DataKW(StrToDate(ADD_File.TicketNextPeriodList[i].ContinuedValidTo) {DataKW(tr[i].ValidTo})])+
                      Format('%.2d', [Round(StrToDate(ADD_File.TicketNextPeriodList[i].ContinuedValidTo) {tr[i].ValidTo}-
                        StrToDate(ADD_File.TicketNextPeriodList[i].ContinuedValidFrom) {tr[i].ValidFrom})+1])+
                      Format('%.3d', [ADD_File.TicketNextPeriodList[i].RideCount {tr[i].LPrzej}]) + #13#10);
            end;
            AddLine(20, 'Ważny od: ' + String(ADD_File.TicketNextPeriodList[i].ContinuedValidFrom {tr[i].ValidFrom}) + #13#10);
            AddLine(20, 'Ważny do: ' + String(ADD_File.TicketNextPeriodList[i].ContinuedValidTo {DataKW(tr[i].ValidTo}) + #13#10);
            if ADD_File.TicketNextPeriodList[i].ContinueType {tr[i].TypBiletu}> 0 then
            begin
              AddLine(20, 'Numer przedłużenia: '+IntToStr(ADD_File.TicketNextPeriodList[i].ContinueNumber {tr[i].Lp}) + #13#10);
              case ADD_File.TicketNextPeriodList[i].ContinueType {tr[i].TypBiletu} of
                2{1}: //okresowy
                  begin
                    AddLine(20, 'Okres ważności: ');
                    if ADD_File.TicketNextPeriodList[i].DayCountValid {tr[i].LDniW}= 0 then
                      AddLine(0, 'miesiąc' + #13#10)
                    else
                      AddLine(0, IntToStr(ADD_File.TicketNextPeriodList[i].DayCountValid {tr[i].LDniW})+' dni' + #13#10);
                  end;
                3{6}: //wieloprzejazdowy
                  begin
                    AddLine(20, 'Liczba zakupionych przejazdów: '+IntToStr(ADD_File.TicketNextPeriodList[i].RideCount {tr[i].LPrzej}) + #13#10);
                  end;
                4{7}: //okresowy przedpłacony
                  begin
                    AddLine(20, 'Wartość doładowania: '+IntToStr(ADD_File.TicketNextPeriodList[i].Price1 {tr[i].WartD}) + #13#10);
                  end;
              end;
            end;
          end
          else
          begin  //bilety do sprzedaży
            Inc(lpemks);  //E.B. 19.02.2011
            AddLine(0, Format('%5d/%5ds  %.10u', [iIndex + 1, lpemks, ADD_File.TicketNextPeriodList[i].CardNumber {tr[i].CardID}]) + ': ');
            if String(ADD_File.TicketNextPeriodList[i].TicketNumberOnCard) {tr[i].Number}<> '' then
              AddLine(1, 'Numer biletu: ' + String(ADD_File.TicketNextPeriodList[i].TicketNumberOnCard) {tr[i].Number} + #13#10);
            AddLine(20, 'Data ważności informacji o możliwości zakupu biletu: ' + FormatDateTime('dd.mm.yyyy', EmarDateToDate(ADD_File.TicketNextPeriodList[i].ContinuedValidTo)) {DateToStr(tr[i].SaleTo)} + #13#10);
            AddLine(20, 'Komunikacja ');
            if not ADD_File.TicketNextPeriodList[i].ForeignTicket {tr[i].TicketType = 0} then
              AddLine(0, 'krajowa')
            else
              AddLine(0, 'zagraniczna');
            //_p := (tr[i].BinCode>0) and (tr[i].TypUlgi=4);
            iTypUlgi := 0;
            sNazwaUlgi := '';
            for j := 0 to Pred(ADD_File.MonthTicketReductionList.Count) do
              if ADD_File.MonthTicketReductionList[j].ReductionCode = ADD_File.TicketNextPeriodList[i].ReliefBinaryCode then
              begin
                iTypUlgi := ADD_File.MonthTicketReductionList[j].ReductionType;
                sNazwaUlgi := String(ADD_File.MonthTicketReductionList[j].Name);
                Break;
              end;
            _p := (ADD_File.TicketNextPeriodList[i].ReliefBinaryCode > 0)and(iTypUlgi = 4);
            if ADD_File.TicketNextPeriodList[i].ReliefBinaryCode {tr[i].BinCode}= 0 then
              AddLine(0, ', bilet normalny' + #13#10)
            else
              if (ADD_File.TicketNextPeriodList[i].ReliefPercent {tr[i].Relief} > 0) and (iTypUlgi {tr[i].TypUlgi} in [1,2]) then
                AddLine(0, Format(', ulga: %d%%',[ADD_File.TicketNextPeriodList[i].ReliefPercent {tr[i].Relief}])+'  '+ sNazwaUlgi {tr[i].NazwaUlgi} + #13#10)
              else
                if (ADD_File.TicketNextPeriodList[i].ReliefPercent {tr[i].Relief}= 0) and (iTypUlgi {tr[i].TypUlgi} in [1,2]) then
                  AddLine(0, ', ulga kwotowa  ' + sNazwaUlgi{tr[i].NazwaUlgi} + #13#10)
                else
                  if _p then
                    AddLine(0, ', bilet pracowniczy ' + sNazwaUlgi{tr[i].NazwaUlgi} + #13#10)
                  else
                    AddLine(0, ', brak ulgi w wykazie ulg (kod: ' + IntToStr(ADD_File.TicketNextPeriodList[i].ReliefBinaryCode {tr[i].BinCode}) + ')' + #13#10);
            case ADD_File.TicketNextPeriodList[i].NumberOfVATRate1 {tr[i].ixVATRate1} of
              1..7 : AddLine(20, 'PTU ' + Chr(Ord('A') - 1 + ADD_File.TicketNextPeriodList[i].NumberOfVATRate1 {tr[i].ixVATRate1}) + ' :');
              $4E:   AddLine(20, 'Nie podlega PTU :');
              else   AddLine(20, 'Brak stawki PTU :');
            end;
            AddLine(1, Format('Cena: %.2f',[ADD_File.TicketNextPeriodList[i].Price1 {tr[i].Brutto1}/ 100]));
            if (ADD_File.TicketNextPeriodList[i].ReliefBinaryCode {tr[i].BinCode}> 0)
              and (iTypUlgi {tr[i].TypUlgi} in [1,2]) then
            begin
              AddLine(0, Format(', Ulga: %.2f',[ADD_File.TicketNextPeriodList[i].ReliefValue1 {tr[i].Relief1}/ 100]));
              try     //E.B. 10.09.2013
                wartbil := ADD_File.TicketNextPeriodList[i].Price1 {tr[i].Brutto1}- ADD_File.TicketNextPeriodList[i].ReliefValue1 {tr[i].Relief1};
              except  //E.B. 10.09.2013
                wartbil := ADD_File.TicketNextPeriodList[i].Price1 {tr[i].Brutto1};    //E.B. 10.09.2013
              end;
            end
            else
              if _p then
                wartbil := ADD_File.TicketNextPeriodList[i].ReliefValue1 {tr[i].Relief1}
              else
               wartbil := ADD_File.TicketNextPeriodList[i].Price1 {tr[i].Brutto1};
            AddLine(0, Format(', Do zapłaty: %.2f', [wartbil / 100]) + #13#10);
            if (ADD_File.TicketNextPeriodList[i].Price2 {tr[i].Brutto2}<> $ffffffff) then
            begin
              case ADD_File.TicketNextPeriodList[i].NumberOfVATRate2 {tr[i].ixVATRate2} of
                1..7 : AddLine(20, 'PTU ' + Chr(Ord('A') - 1 + ADD_File.TicketNextPeriodList[i].NumberOfVATRate2 {tr[i].ixVATRate2}) + ' :');
                $4E:   AddLine(20, 'Nie podlega PTU :');
                else   AddLine(20, 'Brak stawki PTU :');
              end;
              AddLine(0, Format(' Cena: %.2f',[ADD_File.TicketNextPeriodList[i].Price2 {tr[i].Brutto2}/100]));
              if ADD_File.TicketNextPeriodList[i].ReliefPercent {tr[i].Relief} > 0 then
              begin
                AddLine(0, Format(', Ulga: %.2f', [ADD_File.TicketNextPeriodList[i].ReliefValue2 {tr[i].Relief2}/ 100]));
                AddLine(0, Format(', Do zapłaty: %.2f', [(ADD_File.TicketNextPeriodList[i].Price2 {tr[i].Brutto2}- ADD_File.TicketNextPeriodList[i].ReliefValue2 {tr[i].Relief2})/100]) + #13#10);
                Inc(wartbil, ADD_File.TicketNextPeriodList[i].Price2 {tr[i].Brutto2}- ADD_File.TicketNextPeriodList[i].ReliefValue2 {tr[i].Relief2});
              end
              else
              begin
                AddLine(0, Format(', Do zapłaty: %.2f', [ADD_File.TicketNextPeriodList[i].Price2 {tr[i].Brutto2}/100]) + #13#10);
                Inc(wartbil, ADD_File.TicketNextPeriodList[i].Price2 {tr[i].Brutto2});
              end;
            end;
            AddLine(20, Format('Do zapłaty razem: %.2f', [wartbil / 100]) + #13#10);
          end;
        end;
      end;
      SetLength(tnp, 0);
      if (lpemkp + lpemks) > 0 then
      begin  //E.B. 19.02.2011
        AddLine(0, Format('Razem %5d EM-kart, w tym %5d z biletami do przedłużenia oraz ' +
          '%5d z biletami do sprzedaży  ', [lpemkp + lpemks, lpemkp, lpemks]));
        OutputLine(re, clRegular, fsRegular);
      end
      else
        if sLine <> '' then
          OutputLine(re, clRegular, fsRegular);
    end;
  end;

