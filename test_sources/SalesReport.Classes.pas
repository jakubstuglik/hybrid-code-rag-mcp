class function TSalesReport.TasksReport(AdmMain: TdmMain; AId: integer): AnsiString;
var
  re: TRichEdit;
  cds: TClientDataset;
  s, d: String;
  logo: string;
  logofrom, logoto: integer;
  fisc: boolean;
  lastorf: integer;
  cname: string;
  FLPCRegistrationParamsParameters: TLPCRegistrationParamsParameters;
  i, j, k: integer;
  sumd: double;
  suml, sumposl: integer;
  sumnetto, sumptu, sumbrutto, sumkasa: double;
  sumposnetto, sumposptu, sumposbrutto, sumposkasa: double;
  sumticketgross: integer;
  utarg: double;

  procedure DodSp(var s: string; dl: integer);
  begin
    while Length(s)<dl do s:=s+' ';
  end;

  procedure DodSpPrz(var s: string; dl: integer);
  begin
    while Length(s)<dl do s := ' ' + s;
  end;

  procedure OutputRate(re: TRichEdit; const AVATAmount, ASales, AVatValue: Integer; const ATaxed: Boolean);
  begin  // Netto       PTU      Brutto
    if ASales <> 0 then
    begin
      s := StringOfChar(' ',32);     //E.B. 27.09.2016
      if ATaxed then
      begin
        s := s + 'Stawka: ';
        if ASales <> 0 then
          s := s + Format('%8d', [Round(AVATAmount / 100)]) + '%'
        else
          s := s + 'zw';
        s := s + Format('%16.2f%10.2f%12.2f',[
                  (ASales-AVatValue) / 100.0,
                  AVatValue / 100.0,
                  ASales / 100.0]);
      end
      else
        s := s + 'Sprzedaż nieopodatkowana:                  ' +
          Format('%12.2f', [ASales / 100.0]);
      re.SelText := s + #13#10;
    end;
  end;

  procedure RapBilAut(aRe: TRichEdit);
    // returns an empty string when Zero
    function FormatIntEmptyZero(APositionsCnt, AValue: Integer): String;
    begin
      if AValue = 0 then
        Result := Format('%' + IntToStr(APositionsCnt) + 's', [''])
      else
        Result := Format('%' + IntToStr(APositionsCnt) + 'd', [AValue]);
    end;

    // returns an empty string when Zero
    function FormatFloatEmptyZero(APositionsCnt: Integer; AValue: Double; AFormat: String): String;
    begin
      if AValue = 0 then
        Result := Format('%' + IntToStr(APositionsCnt) + 's', [''])
      else
        Result := Format(AFormat, [AValue]);
    end;

    var
      s: string;
      lp: integer;
      lastno: integer;
      lasttime, currtime: TDateTime;
      rel: string;
      sumN, sumU, sumB, sumO, price, priceO: integer;
      count, countN, countU, countB, countO, sumprice, sumpriceO: integer;
      countMN, countMU, countMS, countON, countOU, countWN, countWU, countNP: Integer;
      sumMN, sumMU, sumMS, sumON, sumOU, sumWN, sumWU, sumNP: Integer;
      iPrintAutomaticSUMYes, iPrintAutomaticSUMNo, iPrintLogoutSUMYes, iPrintLogoutSUMNo: Integer;
      lastorf: integer;
  begin
    with aRe do begin
      s := 'Szyfr raportu: ' + Format('%19s', [AdmMain.StoredFunc('dbo', 'SLS_SalesReport_ReportCode', '@id=' + IntToStr(aId))]);
      DodSp(s,50);
      s := s + 'Szyfr następnego raportu: ' + Format('%14s', [AdmMain.StoredFunc('dbo', 'SLS_SalesReport_NextReportCode', '@id=' + IntToStr(aId))]) + #13#10;
      SelText := s;

      s := 'Nr pierwszego biletu: ' + Format('%12s', [AdmMain.StoredFunc('dbo', 'SLS_SalesReport_FirstTicketNumber', '@id=' + IntToStr(aId))]);
      DodSp(s,50);
      s := s + 'dokument: ' + Format('%30s', [AdmMain.StoredFunc('dbo', 'SLS_SalesReport_FirstPrintNumber', '@id=' + IntToStr(aId))]) + #13#10;
      SelText := s;

      s := 'Nr ostatniego biletu: ' + Format('%12s', [AdmMain.StoredFunc('dbo', 'SLS_SalesReport_LastTicketNumber', '@id=' + IntToStr(aId))]);
      DodSp(s,50);
      s := s + 'dokument: ' + Format('%30s', [AdmMain.StoredFunc('dbo', 'SLS_SalesReport_LastPrintNumber', '@id=' + IntToStr(aId))]) + #13#10;
      SelText := s;

      SelText := String(StringOfChar('—',96) + #13#10);

      if cds.FieldByName('PersonType').AsInteger = 1 then
        SelText := 'Kierowca nr ' + Trim(cds.FieldByName('PersonIDNumber').AsString) + ' '
      else
        SelText := 'Kasjer nr ' + Trim(cds.FieldByName('PersonIDNumber').AsString) + ' ';
      SelAttributes.Style := [fsBold];
