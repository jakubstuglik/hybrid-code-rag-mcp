function TSalesReport.AmountToPaySum(APaymentType: Integer): integer;
var
  f: TFiscalReport;
  t: TTicket;
  crdXY: TCashReportDetailsXY;
  pt: TTicketPaymentTypeEMAR205;
begin
  Result := 0;
  for f in FiscalReportList do
    if Assigned(f.TicketList) then
      for t in f.TicketList do
        if not t.IsEmCardDeposit then // nie (kaucja\lub zwrot kaucji)
        begin
          if t.PaymentType.Id = APaymentType then
            Result := Result + t.AmountToPay
          else
            if (APaymentType in [Ord(ptvCash), Ord(ptvCreditCard)])
              and(t.PaymentType.Id = Ord(ptvMixed)) then
            begin
              for pt in t.TicketPaymentTypeEMAR205List do
                if pt.PaymentType_ID = APaymentType then
                  Result := Result + pt.Amount;
            end;
        end;

  for crdXY in CashReportDetailsXYList do begin
    if crdXY.PaymentType.Id = APaymentType then begin
      if crdXY.XY_ID = 1 then Result := Result + crdXY.Amount
      else Result := Result - crdXY.Amount
    end;
  end;
end;

