function TSalesReport.GetTempCurrencyID(const ASymbol: String): Integer;
var
  cur: TCurrency;
  newCurrencyRecord: TCurrencyRecord;
begin
  Result := 0;
  newCurrencyRecord.Symbol := ASymbol;
  if not newCurrencyRecord.IsEmpty then
  begin
    TempCurrencyList.TryGetValue(newCurrencyRecord, Result);
    if Result = 0 then
    begin
      cur := TCurrency.Create;
      try                             
        cur.Id := TCurrency.IdFromSymbol(newCurrencyRecord.Symbol, dmMain);
        if cur.ReadFromDatabase(cur.Id) then
        begin
          Result := cur.Id;

          newCurrencyRecord.Id := cur.Id;
          newCurrencyRecord.Symbol := newCurrencyRecord.Symbol;
          newCurrencyRecord.Name := cur.Name;
          newCurrencyRecord.CurrentExchangeRate := cur.CurrentExchangeRate;
          newCurrencyRecord.Units := cur.Units;
          newCurrencyRecord.ROrder := cur.ROrder;
          TempCurrencyList.Add(newCurrencyRecord, Result); // add just added Currency to the temporary list
        end;
      finally
        FreeAndNil(cur);
      end
    end;
  end;
end;

