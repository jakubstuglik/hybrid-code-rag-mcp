  procedure WpiszDoAbilemk; //przedłużenie
  var
    iEmCardSaleOnBusID_Card: Integer;
    iEmCardTicketProlongingID_Card: Integer;
    iEmCardTicketProlongingID_CardTicket: Integer;
    iEmCardTicketProlongingID_CardTicketExtCode: Integer;
    iEmCardTicketProlongingID_CardTicketExtCodeMinus1: Integer;
    t: TTicket;
    ectp: TEmCardTicketProlonging;
  begin
    iEmCardSaleOnBusID_Card :=
      TEmCardSaleOnBus.IdForPeriod(
        dmMain
        , iEmCardFirstTicket_ID // powinien być wcześniej znalezony
        , 0
        , EmarDateToDate(String(rel.AsEvent_35.TicketNewValidFrom))
        );
    t := TTicket.Create;
    try
      if iEmCardSaleOnBusID_Card = 0 then
      begin
        ectp := TEmCardTicketProlonging.Create;
        try
          iEmCardTicketProlongingID_Card :=
            TEmCardTicketProlonging.IdFromProlongingInformation(
              dmMain
              , rel.AsEvent_35.CardNumber
              , ''
              , 0
              , 0
              , 0
              );
          if iEmCardTicketProlongingID_Card <= 0 then
          begin
            AddLine(1, Format(C_FMT_EMCARD_TICKET_PROLONGING_CARD_NOT_EXISTS, [rel.AsEvent_35.CardNumber]));
            OutputLine(re, clError, fsStrong);
            SaCzerwoneWpisy := True;
    //        Niewazny := True;
          end
          else
          begin
            iEmCardTicketProlongingID_CardTicket :=
              TEmCardTicketProlonging.IdFromProlongingInformation(
                dmMain
                , rel.AsEvent_35.CardNumber
                , String(rel.AsEvent_35.CardTicketNumber)
                , 0
                , 0
                , 0
                );
            if iEmCardTicketProlongingID_CardTicket <= 0 then
            begin
              AddLine(1, Format(C_FMT_EMCARD_TICKET_PROLONGING_TICKET_NOT_EXISTS, [String(rel.AsEvent_35.CardTicketNumber)]));
              OutputLine(re, clError, fsStrong);
              SaCzerwoneWpisy := True;
    //          Niewazny := True;
              ectp.ReadFromDatabase(iEmCardTicketProlongingID_Card); // locate on the already found record
              t.ReadFromDatabase(ectp.FirstTicket_ID);
              AddLine(1, Format(C_FMT_EMCARD_TICKET_PROLONGING_LAST_TICKET,
                [
                  t.TicketNumber //'NRBILETU'
                  , FormatDateTime(sfdDMY, t.ValidFrom) //'BWAZNYOD'
                  , FormatDateTime(sfdDMY, t.ValidTo) //'BWAZNYDO'
                  , DateTimeToStr(t.SaleDate) //'DATASPRZ'+' '+'GODZSPRZ'
                ]));
              OutputLine(re, clError, fsStrong);
            end
            else
            begin
              iEmCardTicketProlongingID_CardTicketExtCodeMinus1 :=
                TEmCardTicketProlonging.IdFromProlongingInformation(
                  dmMain
                  , rel.AsEvent_35.CardNumber
                  , String(rel.AsEvent_35.CardTicketNumber)
                  , rel.AsEvent_35.ExtCount - 1
                  , 0
                  , EmarDateToDate(String(rel.AsEvent_35.TicketNewValidTo))
                  );
              if iEmCardTicketProlongingID_CardTicketExtCodeMinus1 <= 0 then
              begin
                iEmCardTicketProlongingID_CardTicketExtCode :=
                  TEmCardTicketProlonging.IdFromProlongingInformation(
                    dmMain
                    , rel.AsEvent_35.CardNumber
                    , String(rel.AsEvent_35.CardTicketNumber)
                    , rel.AsEvent_35.ExtCount
                    , 0
                    , EmarDateToDate(String(rel.AsEvent_35.TicketNewValidTo))
                    );
                if iEmCardTicketProlongingID_CardTicketExtCode > 0 then
                  ectp.ReadFromDatabase(iEmCardTicketProlongingID_CardTicketExtCode);
              end
              else
              begin
                iEmCardTicketProlongingID_CardTicketExtCode := -1; // just to hide compiler's warning
                ectp.ReadFromDatabase(iEmCardTicketProlongingID_CardTicketExtCodeMinus1);
              end;
    //          if not t.Locate('LOKRP',rel.AsEvent_35.ExtCount-1,[]) and
    //             (not t.Locate('LOKRP',rel.AsEvent_35.ExtCount,[]) or
    //              (t.FieldByName('NRRZBA').AsInteger<>Arz[irz].NrRZ) or
    //              (t.FieldByName('DATAREJBA').AsString<>Arz[irz].DataRej) or
    ////                (t.FieldByName('NRSTANBA').AsString<>snrst)) then begin
    ////E.B. 31.10.2009  snrst może mieć nieznaczące 0 z lewej strony
    //              (t.FieldByName('NRSTANBA').AsInteger<>StrToInt(snrst))) then
              if (iEmCardTicketProlongingID_CardTicketExtCodeMinus1 <= 0)
                and(iEmCardTicketProlongingID_CardTicketExtCode <= 0) then
              begin
                AddLine(1, Format(C_FMT_EMCARD_TICKET_PROLONGING_EXTCOUNT_NOT_EXISTS,
                  [
                    rel.AsEvent_35.ExtCount - 1
                    , String(rel.AsEvent_35.CardTicketNumber)
                  ]));
                OutputLine(re, clError, fsStrong);
                SaCzerwoneWpisy := True;
    //              Niewazny := True;
              end
              else
              begin
