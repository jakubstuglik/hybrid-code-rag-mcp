class function TSalesReport.CanDeleteFromDatabase(ASource : TObject) : Boolean;
var
  iID: Int64;
  _DataSet: TDataSet;
  sr: TSalesReport;
  dm: TdmMain;
begin
  dm := nil;
  iID := 0;
  if ASource is TDataSet then
  begin
    sr := TSalesReport.Create;
    try
      _DataSet := TDataSet(ASource);
      if Assigned(sr.dmMain) then
        dm := sr.dmMain;
      if Assigned(_DataSet.FindField('ID')) then
        iId := _DataSet.FieldByName('ID').AsInteger;
    finally
      FreeAndNil(sr);
    end;
  end
  else
    if ASource is TSalesReport then
    begin
      dm := TSalesReport(ASource).dmMain;
      iID := TSalesReport(ASource).Id;
    end;

  Result := TDBSalesReport.CanDeleteFromDatabase(dm, iID);

  {$IFNDEF DSSERVER}
  if not Result then
    MessageDlg(ERR_SALESREPORT_DEL, mtError, [mbOk], 0);
  {$ENDIF}
end;

