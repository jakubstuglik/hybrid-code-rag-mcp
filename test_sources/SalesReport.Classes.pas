function TSalesReportAction.GetSalesReportFromReportFile(AReportFileName: String): TSalesReport;
var
  i: Integer;
  sFileName: String;
  aSalesReport: TIntArray;
begin
  Result := nil;
  if AReportFileName <> '#' then
  begin
    sFileName := ExtractFileName(AReportFileName);
    if Length(sFileName) > 0 then
    begin
      if (AnsiUpperCase(sFileName[1]) = 'M')or(AnsiUpperCase(sFileName[1]) = 'Z') then
      begin
        Result := GetSalesReportClass(rtDuo).Create(Self.dmMain);
        Result.CFilePath := AReportFileName;
      end
      else
      begin
        Result := GetSalesReportClass(rtEmar105).Create(Self.dmMain);
        if (AnsiUpperCase(sFileName[1]) = 'W') // plik W z wpłatomatu
          or
          (Length(sFileName) > 2)and(UpperCase(Copy(sFileName, 1, 3)) = 'CDS') // ma taka samą strukturę jak i plik W
        then
        begin
          case Result.WFile.ReadFile(AReportFileName) of
           -1: // nieobsługiwana identyfikacja zawartości
              Result.CFilePath := AReportFileName;
            0: // plik W uszkodzony (wpis w pliku: BŁĄD)
              begin
                Result.Messages.Add(Format(RS_Emar105RegistrationWFileHasError,
                  [
                    sFileName
                  ]));
                Result.CreateErrorFile(AReportFileName, True, True);
                Result.WFile.Name := '';
                FreeAndNil(Result); // niczego nie dodajemy
              end;
            1: // plik W poprawny
              begin
                if Result.WFile.CFile <> '' then
                begin
                  for i := 0 to Pred(ReportFilesList.Count) do
                    if ExtractFileName(ReportFilesList.Strings[i]) = ExtractFileName(Result.WFile.CFile) then // AT: Czy pliki W zawsze są w tym samym folderze z plikami C z którymi związane ???
                    begin
                      Result.CFilePath := ReportFilesList.Strings[i];
                      ReportFilesList.Strings[i] := '#'; // zastępujemy wczytany plik C na liscie plików (żeby nie wczytał się ponownie)
                    end;
                  if Result.CFilePath = '' then // nie ma powiązanego pliku C
                  begin // probujemy znaleźć go w bazie
                    aSalesReport := TSalesReport.IdsFromFileName(Result.dmMain, ExtractFileName(Result.WFile.CFile), rtEmar105);
                    try
                      if Length(aSalesReport) > 0 then
                      begin
                        Result.Id := aSalesReport[High(aSalesReport)];
                        Result.Changed := False; // nie zmieniamy nic, wyłącznie plik W zapisze się
                      end;
                    finally
                      SetLength(aSalesReport, 0);
                    end;
                  end;
                end;
              end;
          end;
        end
        else
          Result.CFilePath := AReportFileName; // plik C
      end;
    end
    else
    begin
      Result := GetSalesReportClass(rtUnknown).Create(Self.dmMain);
      Result.CFilePath := AReportFileName;
    end;
  end;
end;

function TSalesReportAction.RegisterSalesReports(AFilesList: TStringList): Cardinal;
  function CreateTheSameSalesReport(ASalesReport: TSalesReport): TSalesReport;
  begin
    if Assigned(ASalesReport) then
    begin
      case ASalesReport.ReportType of
        rtDuo:
          Result := TSalesReportBM.Create;
        rtEmar105, rtEmar205:
          Result := TSalesReportEmar105.Create;
        else
          Result := TSalesReport.Create;
      end;
    end
    else
      Result := TSalesReport.Create;
  end;

  {
    usuwa z listy raporty, gdy data stworzenia raportu jest późniejsza od daty rejestracji;
    był taki przypadek i raport rejestrował się na szaro;
    teraz będzie czekał na odopwiedni czas
  }
  procedure RemoveCE0FilesWithTheLaterDateCreation();
  var
    i: Integer;
    iYear, iMonth, iDay, iHour, iMinute, iSecond, iMilliSecond: Integer;
    sCE0Name: String; // Emar-205 CE 0 report (CE0_000001_CCP1701658414_20201021142855.DAT)
  begin
    i := 0;
    while i < AFilesList.Count do
    try
      sCE0Name := ExtractFileName(AFilesList.Strings[i]).ToUpper();
      if KMFilesUtil.MatchesMask(sCE0Name, C_MASK_REPORT_FILES_CE0) then
      begin
        iYear := Copy(sCE0Name, 26, 4).ToInteger();
        iMonth := Copy(sCE0Name, 30, 2).ToInteger();
        iDay := Copy(sCE0Name, 32, 2).ToInteger();
        iHour := Copy(sCE0Name, 34, 2).ToInteger();
        iMinute := Copy(sCE0Name, 36, 2).ToInteger();
        iSecond := Copy(sCE0Name, 38, 2).ToInteger();
        iMilliSecond := 0;

        if EncodeDateTime(iYear, iMonth, iDay, iHour, iMinute, iSecond, iMilliSecond) > Now() then
        begin
          AFilesList.Delete(i);
          Continue;
        end;
      end;
      Inc(i);
    except
      Inc(i);
    end;
  end;

  procedure ReorderFilesList(AFilesList: TStringList);
  var
    i, j: Integer;
{$IF DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER)}
    sOldFormatErrorFilePath, sErrorFilePath: String;
{$ENDIF}
  begin
    // usuwanie duplikatów plików, ponieważ procedura ListFiles błędnie pobiera pliki gdy w masce jest '?' (napr, dodaje CDS... dla maski C???, chociaż ilość ? nie zgadza się)
    i := 0;
    while i < AFilesList.Count do
    begin
      KMUtils.MakeReportCopy(AFilesList.Strings[i]);
{$IF DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER)}
      sOldFormatErrorFilePath := ChangeFileExt(AFilesList.Strings[i], '.error');
      sErrorFilePath := AFilesList.Strings[i] + '.error';
      // remove an old .error file with no report file extension inside its name (old format name were used before v 2.34)
      if FileExists(sOldFormatErrorFilePath) then
        KMFilesUtil.ForceDeleteFile(sOldFormatErrorFilePath); // it becomes to be created in the new format name below
      // jeśli już była próba zarejestrowania raportu i się nie udało, to pomijamy ten raport
      if FileExists(sErrorFilePath) then
      begin
        AFilesList.Delete(i);
        Continue;
      end;
{$ENDIF}

      // wyszukiwanie plików z tymi samymi nazwami
      j := Succ(i);
      while j < AFilesList.Count do
      begin
        if ExtractFileName(AFilesList.Strings[i]) = ExtractFileName(AFilesList.Strings[j]) then
        begin
          AFilesList.Delete(j);
          j := -1;
          Break;
        end
        else
          Inc(j);
      end;
      if j <> -1 then
        Inc(i);
    end;

    AFilesList.Duplicates := dupIgnore;
    // przesuwamy pliki W w górę listy
    AFilesList.CustomSort(ReportFilesListCompare);
  end;

  function ExistsErrorFileOnServerSide(AJSON, AFilePath: String): Boolean;
  {$IF NOT (DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER))}
  var
    i: Integer;
    ifile_type: Integer;
    sFileNameParam: String;
    sfile_subdir, sfile_name, sfile_error: String;
    iso: ISuperObject;
    isaFilesWithError: TSuperArray;
    fsReportFile: TFileStream;
  {$ENDIF}
  begin
    Result := False;
    {$IF NOT (DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER))}
    sFileNameParam := ExtractFileName(AFilePath);
    if (AnsiCompareStr(AJSON, '') <> 0)
      and(AnsiCompareStr(sFileNameParam, '') <> 0)
      and FileExists(AFilePath) then
    begin
      iso := SO(AJSON);
      isaFilesWithError := iso.O['files_with_error'].AsArray;

      // analizowane jedynie raporty po nieudanej próbie rejestracji
      for i := 0 to Pred(isaFilesWithError.Length) do
      begin
        ifile_type := StrToIntDef(isaFilesWithError[i].S['0'], 0);
        sfile_subdir := isaFilesWithError[i].S['1'];
        sfile_name := isaFilesWithError[i].S['2'];
        sfile_error := isaFilesWithError[i].S['3'];
        if AnsiCompareStr(AnsiUpperCase(sFileNameParam), AnsiUpperCase(sfile_name)) = 0 then
        begin
          fsReportFile := TFileStream.Create(AFilePath, fmOpenRead or fmShareExclusive);
          try
            fsReportFile.Position := 0;
            if (fsReportFile.Size > 0)
              and TSalesReport.ReplaceServerReportFileByType(
                dmMain
                , TMemoryStream(fsReportFile)
                , ifile_type // file_type
                , sfile_name // file_name
                , sfile_subdir // file_subdir
                )
              and dmMain.DeleteErrorFile(
                ifile_type
                , IncludeTrailingPathDelimiter(sfile_subdir)
                  + ExtractFileName(sfile_error)) then
            begin
              FreeAndNil(fsReportFile); // unlock file
              KMFilesUtil.ForceDeleteFile(AFilePath); // usuwanie raportu
              Result := True;
              Break;
            end;
          finally
            if Assigned(fsReportFile) then
              FreeAndNil(fsReportFile);
          end;
        end;
      end;
    end;
    {$ENDIF}
  end;

var
  bSaved, bWriteToDatabase, bFromFile, bIsNotExistWFile: Boolean;
  bBreak: LongBool;
  i, iNewReportNumber, iDriver_ID: Integer;
  sReportFileName, sOldFormatErrorFilePath, sErrorFilePath, sJSON, sMessage: String;
  sr, srTemp: TSalesReport;
{$IF DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER)}
  bIsWFileOnly: Boolean;
  bLicenceWasReaded, bCurrentUserWasRead: Boolean;
  iLicencesCompanyID: Integer;
{$ENDIF}
begin
  Result := ERR_NO_ERROR;

{$IF DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER)}
  if not TSalesReportAction.__ReadLicense(bLicenceWasReaded) then
    Exit(ERR_FILE_NOT_FOUND);

  iLicencesCompanyID := TCustomCompany.IdFromCompanyCode(XMLLicence_CompanyCode, Self.dmMain, XMLLicence_CompanyType);

  bCurrentUserWasRead := Assigned(CurrentUser);
  if not bCurrentUserWasRead then
  begin
    CurrentUser := TUser.Create;
    CurrentUser.ReadFromDatabase(1);
    CurrentUser.CompanyId := iLicencesCompanyID; // jest używane przy zapisie raportu kasowego (CashReport)
  end;
{$ENDIF}

  bSaved := False;
  Self.Clear; // clear SalesReportList
  ReportFilesList.Clear;
  ReportFilesList.AddStrings(AFilesList);

  RemoveCE0FilesWithTheLaterDateCreation();
  ReorderFilesList(ReportFilesList);
  try
    if (ReportFilesList.Count > 0)and(IsEmarDLLLoaded or LoadEmarDLL()) then
    begin
      for i := 0 to Pred(ReportFilesList.Count) do
      try
        if FileExists(ReportFilesList[i]) then
        try
          {$IF DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER)}
          sJSON := ''; // nie uwzgłędniamy
          {$ELSE}
          sJSON := dmMain.GetServerSalesReportsList(2, False); // files with error
          {$ENDIF}

          dmMain.SendDebugPipeMessage(Format('<<< [%d of %d]', [Succ(i), ReportFilesList.Count]));
          dmMain.SendDebugPipeMessage('Start registration: ' + ReportFilesList[i]);
          sOldFormatErrorFilePath := ChangeFileExt(ReportFilesList[i], '.error');
          sErrorFilePath := ReportFilesList[i] + '.error';
          sReportFileName := ExtractFileName(ReportFilesList[i]);
{$IF DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER)}
          // remove an old .error file with no report file extension inside its name (old format name were used before v 2.34)
          if FileExists(sOldFormatErrorFilePath) then
            KMFilesUtil.ForceDeleteFile(sOldFormatErrorFilePath);
          // pomijamy, gdy już była nieudana próba rejestrowania raportu
          if FileExists(sErrorFilePath) then
            Continue;
          if (MaxFilesRegisterCount > 0)and(FilesSaved + FilesError >= MaxFilesRegisterCount) then
            Exit; // żeby nie kręczyć do nieskończoności
{$ENDIF}

          {$REGION 'Finding a report with the error after trying to register on the server side'}
          {$IF NOT (DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER))}
          if ExistsErrorFileOnServerSide(sJSON, ReportFilesList[i]) then
          begin
            dmMain.SendDebugPipeMessage(Format('WARNING: File %s was replaced on server side', [sReportFileName]));
            Self.FilesSkipped := Self.FilesSkipped + 1;
            Self.Description := Self.Description + #13#10
              + #9 + Format(SALES_REPORT_MSG_REPLACED_REPORT_WITH_ERROR_ON_SERVER, [sReportFileName]);
            Continue;
          end;
          {$ENDIF}
          {$ENDREGION}

          bBreak := False;
          if Assigned(sr) then
            FreeAndNil(sr);
          sr := GetSalesReportFromReportFile(ReportFilesList[i]);
          if Assigned(sr) then
          begin
{$REGION '            Sprawdzenie za pomocą dll możliwości rejestracji raportów Emar'}
            if (sr.ReportType in [rtEmar105, rtEmar205, rtEmar105Returns, rtEmar205Returns])
              and(sr.CFilePath <> '') // accept to register W or CDS files
              and(not TInformicaValidator.CanBeRegisteredEmarReport(LicencesCompanyUnit.LicencesCompanyCode, sMessage))
            then
            begin
              sr.Messages.Add(sMessage);
              sr.CreateErrorFile(ReportFilesList[i], True, False);
              try
                {$REGION 'DISPFileCallback'}
                {$IF NOT (DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER))}
                sr._File.Callback := nil;
                Exit;
                {$ENDIF}
                {$ENDREGION}
              finally
                FreeAndNil(sr);
              end;
              Continue;
            end;
{$ENDREGION '            Sprawdzenie za pomocą dll możliwości rejestracji raportów Emar'}
            sr.Init_FileC;
            {$REGION 'OutputDebugString'}
            {$IF DEFINED(DEBUG)}
            OutputDebugString(PChar('Start processing file: ' + sReportFileName));
            {$ENDIF}
            {$ENDREGION}
            {$REGION 'DISPFileCallback'}
            {$IF NOT (DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER))}
            Self.fDISPFileCallback.SetProgressBar(0, ReportFilesList.Count, i + 1);
            Self.fDISPFileCallback.SetInfo(Format(REGISTRATION_FILE_READ_MESSAGE, [sReportFileName, i + 1, ReportFilesList.Count]));

//            Self.fDISPFileCallback.FileType := C_REPORT_FILE;
            Self.fDISPFileCallback.SaleReport := sr;
            {$ENDIF}
            {$ENDREGION}

            iNewReportNumber := sr.GetNewReportNumber(); // means that SQL procedure returns MAX+1 value
            bFromFile := True;
            {$IF DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER)}
            bIsWFileOnly := False; // czy jest rejestrowany wyłącznie plik W bez C
            {$ENDIF}

            // czy dane z tego pliku W zostały już zarejestrowane
            bIsNotExistWFile := TCashReportDetails.IsNotExistWFile(sr.WFile.Name, sr.dmMain);
            //nie ma pliku W lub nie został zarejestrowany
            if bIsNotExistWFile then
            begin
            // TODO 1: check if its C file is already registered
              if FileExists(sr.CFilePath) then // jest plik C
              begin
                sr.ReportNumber := iNewReportNumber;
                {$REGION 'OutputDebugString'}
                {$IF DEFINED(DEBUG)}
                OutputDebugString(PChar('    >>Start of file processing: ' + TimeToStr(Now())));
                {$ENDIF}
                {$ENDREGION}
{$IF DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER)}
                // False - jeśli z folderu w którym mieszczą się raporty z kart pamięci
                if AnsiCompareStr(sr.dmMain.CardFilePathServ(''), '') <> 0 then // nie pusty
                  bFromFile := Pos(sr.dmMain.CardFilePathServ(''), sr.CFilePath) = 0;
{$ENDIF}
                bSaved := sr.FillFromFile(bFromFile);
                {$REGION 'OutputDebugString'}
                {$IF DEFINED(DEBUG)}
                OutputDebugString(PChar('    <<End of file processing: ' + TimeToStr(Now())));
                {$ENDIF}
                {$ENDREGION}
    //                    TSalesReportEmar105(sr)._File.SaveToFile(PWideChar('d:\' + TSalesReportEmar105(sr)._File.OIK.TimeTableFileName + '.' + TSalesReportEmar105(sr)._File.OIK.TimeTableFileExt), 7, EMAR_SAVEMODE_FILE_A);
                if (not bSaved)and(Pos(sr.Description, Self.Description) = 0) then
                  Self.Description := Self.Description + #13#10 + sr.Description;
              end
              else // jest plik W bez pliku C i nie jest zarejestrowany
              begin
                iDriver_ID := sr.FileC.GetDriverIDFromIDNumberAndNames(ptDriver{kierowcy},
                  sr.WFile.DriverNR,
                  sr.WFile.Imie,
                  sr.WFile.Nazwisko);
                if iDriver_ID = 0 then
                  iDriver_ID := sr.FileC.GetDriverIDFromIDNumberAndNames(ptCashier{kasjer},
                    sr.WFile.DriverNR,
                    sr.WFile.Imie,
                    sr.WFile.Nazwisko);
                if iDriver_ID = 0 then
                begin
                  {$REGION 'DISPFileCallback'}
                  {$IF NOT (DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER))}
                  Self.fDISPFileCallback.ChoiceDriver(bBreak, TObject(sr), True); // wybór kierowcy
                  if not bBreak then
                    iDriver_ID := sr.FileC.GetDriverIDFromIDNumberAndNames(ptDriver{kierowcy},
                      sr.WFile.DriverNR,
                      sr.WFile.Imie,
                      sr.WFile.Nazwisko);
                  {$ELSE}
                  iDriver_ID := C_PERSON_ID_AUTOREGISTRATION;
                  {$ENDIF}
                  {$ENDREGION}
                end;

                if (iDriver_ID = 0)or bBreak then
                begin
                  sr.Messages.Add(Format(C_FMT_DRIVERS_NOT_EXISTS,
                    [
                      sr.WFile.Imie
                      , sr.WFile.Nazwisko
                      , sr.WFile.DriverNR
                    ]));
                  sr.CreateErrorFile(ReportFilesList[i], True, True);
                  try
                    {$REGION 'DISPFileCallback'}
                    {$IF NOT (DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER))}
                    sr._File.Callback := nil;
                    Exit;
                    {$ENDIF}
                    {$ENDREGION}
                  finally
                    FreeAndNil(sr);
                  end;
                  Continue;
                end;
                {$IF DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER)}
                bIsWFileOnly := True;
                {$ENDIF}
                sr.Driver_ID := iDriver_ID;
                sr.User_ID := TSalesReport.GetUserIDForSaveBasedOnPath(
                  dmMain
                  , IncludeTrailingPathDelimiter(sr.WFile.DIR) + sr.WFile.Name
                  , CurrentUser.Id);
                sr.Status := 4;
                sr.FileC.Changed := False;
                sr.FileK.Changed := False;
                sr.FileOryg.Changed := False;
                sr.Changed := False; // wyłącznie do zapisu Raportu Kasowego z procedury AutoInsertReportDetails

                bSaved := True;
              end;
              {$REGION 'OutputDebugString'}
              {$IF DEFINED(DEBUG)}
              OutputDebugString(PChar('    >>Start of file saving: ' + TimeToStr(Now())));
              {$ENDIF}
              {$ENDREGION}
              {$REGION 'DISPFileCallback'}
              {$IF NOT (DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER))}
              Self.fDISPFileCallback.SetInfo(Format(REGISTRATION_FILE_WRITE_MESSAGE, [sReportFileName, i + 1, ReportFilesList.Count]));
              {$ENDIF}

              {$REGION 'BeforeSave: Ignorowanie błędu rejestrowania się raportu o tym samym numerze dla iAutServer'}
              {$IF DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER)}
              if bSaved
                and(not bIsWFileOnly) // nie plik W
                and(sr.Id = 0) // nowy raport
                and(sr.ReportNumber <> sr.GetNewReportNumber()) then // pod tym numerem już został zarejestrowany raport
              begin // żeby nie tworzyć pliku error, po prostu będzie robiona później nowa próba rejestracji
                dmMain.SendDebugPipeMessage(Format('ERROR: ReportNumber=%d is already registered. File was skipped in step 1', [sr.ReportNumber]));
                FreeAndNil(sr);
                Continue;
              end;
              {$ENDIF}
              {$ENDREGION}
              if bSaved then
                bWriteToDatabase := sr.WriteToDatabase // zapisywanie do bazy
              else
                bWriteToDatabase := True; // nie ma sensu próbować zapisywać
              {$REGION 'AfterSave: Ignorowanie błędu rejestrowania się raportu o tym samym numerze dla iAutServer'}
              {$IF DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER)}
              if (not bWriteToDatabase)
                and(not bIsWFileOnly) // nie plik W
                and(sr.ReportNumber <> sr.GetNewReportNumber()) then // pod tym numerem już został zarejestrowany raport
              begin // żeby nie tworzyć pliku error, po prostu będzie robiona później nowa próba rejestracji
                dmMain.SendDebugPipeMessage(Format('ERROR: ReportNumber=%d is already registered. File was skipped in step 2', [sr.ReportNumber]));
                FreeAndNil(sr);
                Continue;
              end;
              {$ENDIF}
              {$ENDREGION}

              bSaved := bSaved and bWriteToDatabase;
              {$ENDREGION}
              {$REGION 'OutputDebugString'}
              {$IF DEFINED(DEBUG)}
              OutputDebugString(PChar('    <<End of file saving: ' + TimeToStr(Now())));
              {$ENDIF}
              {$ENDREGION}
              {$REGION 'DISPFileCallback'}
              {$IF NOT (DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER))}
              Self.fDISPFileCallback.SetInfo(Format(REGISTRATION_FILE_UPDATE_MESSAGE, [sReportFileName, i + 1, ReportFilesList.Count]));
              {$ENDIF}
              bSaved := bSaved and sr.FileOperationsAfterWriteToDatabase(bFromFile);
              {$ENDREGION}
              {$REGION 'OutputDebugString'}
              {$IF DEFINED(DEBUG)}
              if bSaved then
                OutputDebugString(PChar('Success! File#' + IntToStr(Self.SalesReportList.Count)))
              else
                OutputDebugString(PChar('Problems, File#' + IntToStr(Self.SalesReportList.Count) + ':' + sr.Description));
              {$ENDIF}
              {$ENDREGION}
              if not bSaved then
              begin
                if sr.Description <> '' then
                  sr.Messages.Add(Format('TSalesReportAction.LoadSalesReports: SalesReport.Description={%s}', [sr.Description]));

                sr.CreateErrorFile(ReportFilesList[i], True, True);
              end;
            end
            else
            try
              if (sr.WFile.Name <> '')and(not bIsNotExistWFile) then
              begin // plik W jest już zarejestrowany
                if (sr.WFile.Name = sReportFileName) then
                begin
                  KMFilesUtil.ForceDeleteFile(ReportFilesList[i]);
                  bSaved := True;
                end
                else
                  bSaved := False;
              end;
            finally
              FreeAndNil(sr); // nie ma nic do rejestracji
            end;

            if Assigned(sr) then
            try
             {$REGION 'Kopiujemy podstawową informację'}
              srTemp := CreateTheSameSalesReport(sr);

//              if sr.Status = 1 then // raport uszkodzony (zapisany do korekty)
//                Self.FilesError := Succ(Self.FilesError);
              srTemp.Id := sr.Id;
              srTemp.Status := sr.Status;
              srTemp.Driver_ID := sr.Driver_ID;
              srTemp.ReportType := sr.ReportType;
              srTemp.ReportNumber := sr.ReportNumber;
              srTemp.Changed := sr.Changed;

              Self.SalesReportList.Add(srTemp);
              {$ENDREGION}
            finally
              FreeAndNil(sr);
            end;

            if bSaved then
            begin
              Self.FilesSaved := Succ(Self.FilesSaved);
              dmMain.SendDebugPipeMessage('End registration: ' + ReportFilesList[i]);
            end
            else
            begin
              Self.FilesError := Succ(Self.FilesError);
              dmMain.SendDebugPipeMessage('Error while registration: ' + ReportFilesList[i]);
            end;

            {$REGION 'DISPFileCallback'}
            {$IF NOT (DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER))}
            if Self.fDISPFileCallback.BreakRegistration then
            begin
              dmMain.SendDebugPipeMessage('Break of files registration after: ' + ReportFilesList[i]);
              Self.FilesSkipped := Self.ReportFilesList.Count - Succ(i);
              while ReportFilesList.Count > i + 1 do // usuwamy resztę plików z listy
                ReportFilesList.Delete(i + 1);

              // progress na koniec
              Self.fDISPFileCallback.SetProgressBar(0, ReportFilesList.Count, i + 1);
              Self.fDISPFileCallback.SetInfo(Format(REGISTRATION_FILE_READ_MESSAGE, [sReportFileName, i + 1, ReportFilesList.Count]));

              Exit; // kończy się proces rejestracji
             end;
            {$ENDIF}
            {$ENDREGION}
          end;
        finally
          dmMain.SendDebugPipeMessage('<<<'#13#10);
        end;
      except
        on E: Exception do
        begin
          if not Assigned(sr) then
            sr := TSalesReport.Create;
          if AnsiCompareStr(sr.Messages.Text, '') <> 0 then
            sr.Messages.Add(#13#10);
          sr.Messages.Add(E.Message);
          sr.CreateErrorFile(ReportFilesList[i], True, True);
          dmMain.SendDebugPipeMessage('Error while registration: ' + ReportFilesList[i]
            + #13#10#9 + E.Message);

          if Assigned(sr) then
            FreeAndNil(sr);
        end;
      end;
    end;
  finally
{$IF DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER)}
    if Self.FilesSaved > 0 then
    begin
      // jednorazowe odpalanie po rejestracji paczki raportów
      dmMain.SendDebugPipeMessage('Start SLS_SalesReportTasksToDo_Run running');
      dmMain.StoredProc('dbo',
                         'SLS_SalesReportTasksToDo_Run',
                         '');
      dmMain.SendDebugPipeMessage('End   SLS_SalesReportTasksToDo_Run running');
    end;
    if not bLicenceWasReaded then
      Licences_Destroy;
{$ENDIF}
  end;
end; //RegisterSalesReports

procedure TSalesReportAction.UnZipSalesReportsOnServer(AFilesList: TStringList);
{$IF DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER)}
var
  sFile: String;
{$ENDIF}
begin
{$IF DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER)}
  for sFile in AFilesList do
  try
    // unzip files with the date 10 minutes older than now
    if
      IsZipFile(sFile)
      and TZipFile.IsValid(sFile)
      and(MinutesBetween(GetFileDateTime(sFile), Now()) >= 10)
    then
    begin
      if KMZipUtil.UnZip(sFile) then
        KMFilesUtil.ForceDeleteFile(sFile);
    end;
  except
    // in case archive is locked by another process
  end;
{$ENDIF}
end;

function TSalesReportAction.SendSalesReportsToServer(AFilesList: TStringList): Cardinal;
var
  i: Integer;
  sTempZipFilePath, sSubDir: String;
  ms: TMemoryStream;
begin
{$REGION '                    Przesyłanie na serwer raportów całą paczką jako archiwum'}
  Result := ERR_NO_ERROR;
  try
    {$REGION 'DISPFileCallback'}
    {$IF NOT (DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER))}
    Self.fDISPFileCallback.SetProgressBar(0, 2, 0);
    Self.fDISPFileCallback.SetInfo(REGISTRATION_FILES_ZIPPING_MESSAGE);
    {$ENDIF}
    {$ENDREGION}

    sSubDir := TGUID.NewGuid.ToString;
    sSubDir := FastStringReplace(sSubDir, '{', '', [rfReplaceAll]);
    sSubDir := FastStringReplace(sSubDir, '}', '', [rfReplaceAll]);
    // send with the User_ID saved as a folder's prefix ___UserX___
    sSubDir := Format('%s%s_%s'
      , [
          TSalesReport.GetUserIDPrefixForSave(CurrentUser.Id)
          , FormatDateTime('yyyymmdd_hhnnss', Now)
          , sSubDir
        ]);
    sTempZipFilePath := TempFileName(sSubDir + '.zip');

    KMZipUtil.SetZipPassword('');

    ms := TMemoryStream.Create;
    try
      if KMZipUtil.ZipFiles(sTempZipFilePath, AFilesList, zpmBestMethod, Format('TotalFilesCount=%d', [AFilesList.Count])) then
      begin
        ms.LoadFromFile(sTempZipFilePath);
        ms.Position := 0;

        {$REGION 'DISPFileCallback'}
        {$IF NOT (DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER))}
        Self.fDISPFileCallback.SetProgressBar(0, 2, 1);
        Self.fDISPFileCallback.SetInfo(REGISTRATION_FILES_SENDING_MESSAGE);
        {$ENDIF}
        {$ENDREGION}

        if not dmMain.SaveSalesReportFile(ms, ExtractFileName(sTempZipFilePath), sSubDir) then
        begin
          {$REGION 'DISPFileCallback'}
          {$IF NOT (DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER))}
          Self.fDISPFileCallback.SetProgressBar(0, 2, 2);
          if AFilesList.Count = 1 then
            Self.fDISPFileCallback.SetInfo(REGISTRATION_FILE_SENDING_ERROR)
          else
            Self.fDISPFileCallback.SetInfo(REGISTRATION_FILES_SENDING_ERROR);
          {$ENDIF}
          {$ENDREGION}
  //        fSalesReportEmar105.AddToDesc(RS_Emar105DeviceSaveCardServerError); // wystąpił błąd pod czas przesyłania obrazu karty pamięci na serwer
          Exit(ERR_INCORRECT_FILE);
        end
        else // usuwanie raportów oraz zip
        begin
          // przenoszenie raportów do folderu ReportCopy oraz ich usuwanie
          for i := 0 to Pred(AFilesList.Count) do
            if KMUtils.MakeReportCopy(AFilesList.Strings[i]) then
              KMFilesUtil.ForceDeleteFile(PChar(AFilesList.Strings[i])); // usuwanie pliku

          {$REGION 'DISPFileCallback'}
          {$IF NOT (DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER))}
          Self.fDISPFileCallback.SetProgressBar(0, 2, 2);
          if AFilesList.Count = 1 then
            Self.fDISPFileCallback.SetInfo(REGISTRATION_FILE_SENT_MESSAGE)
          else
            Self.fDISPFileCallback.SetInfo(REGISTRATION_FILES_SENT_MESSAGE);
          {$ENDIF}
          {$ENDREGION}

          KMFilesUtil.ForceDeleteFile(sTempZipFilePath);
        end;
      end;
    finally
      FreeAndNil(ms);
    end;
  except
    Result := ERR_USER_TERMINATE;
  end;
{$ENDREGION}
end; //SendSalesReportsToServer

class function TSalesReportAction.AutoRegisterSalesReports(AFolders: TStringList;
  AMaxFilesRegisterCount: Integer = 0): Cardinal;
var
  sFolder: String;
  srAction: TSalesReportAction;
  slFilesList, slFolderNamesToExclude: TStringList;
begin
  Result := ERR_NO_ERROR;
  slFilesList := TStringList.Create;
  slFolderNamesToExclude := TStringList.Create;
  srAction := TSalesReportAction.Create;
  try
    slFolderNamesToExclude.Add('ReportCopy'); // folder, w którym są kopie raportów, jest ignorowany
    srAction.MaxFilesRegisterCount := AMaxFilesRegisterCount;

{$REGION '    UnZip files in case they are not unzipped for a long time (more or equal to XX minutes)'}
    for sFolder in AFolders do
      RecursiveListFiles(sFolder, '????????_??????_????????-????-????-????-????????????.zip', slFolderNamesToExclude, slFilesList, False);
    srAction.UnZipSalesReportsOnServer(slFilesList);
{$ENDREGION}

    slFilesList.Clear();
    for sFolder in AFolders do
      RecursiveListFiles(sFolder, C_MASK_REPORT_FILES, slFolderNamesToExclude, slFilesList, False);

    if slFilesList.Count > 0 then
      Result := srAction.RegisterSalesReports(slFilesList)
    else
      srAction.dmMain.SendDebugPipeMessage(#9'Nothing to register');
  finally
    FreeAndNil(srAction);
    FreeAndNil(slFolderNamesToExclude);
    FreeAndNil(slFilesList);
  end;
end;

