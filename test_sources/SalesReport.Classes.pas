  procedure PokazDaneDodatkowe(ADD_File: IEmar105_File; ADD0FileName: String);
    type
      TADWORD = array of dword;
    var
      i, j, iIndex, lr34, iTypUlgi: integer;
      zk, tnp: TADWORD;
  // kolejny numer EM-K z biletem do: p-przedłużenia, s-sprzedaży
      lpemkp, lpemks: integer; //E.B. 19.02.2011
      wartbil: dword;
      sNazwaUlgi: String;
      _p: boolean;

    procedure SortZK(var A: TADWORD; iLo, iHi: integer);
    var
      Lo, Hi: Integer;
      Mid, T: dword;
    begin
      Lo := iLo;
      Hi := iHi;
      Mid := A[(Lo + Hi) div 2];
      repeat
        while A[Lo] < Mid do Inc(Lo);
        while A[Hi] > Mid do Dec(Hi);
        if Lo <= Hi then begin
          T := A[Lo];
          A[Lo] := A[Hi];
          A[Hi] := T;
          Inc(Lo);
          Dec(Hi);
        end;
      until Lo > Hi;
      if Hi > iLo then SortZK(A, iLo, Hi);
      if Lo < iHi then SortZK(A, Lo, iHi);
    end;

    procedure SortTNP(var A: TADWORD; iLo, iHi: integer);
      function GetTicketNumberOfItem(AIndex: Integer): String;
      begin
        if ADD_File.TicketNextPeriodList[AIndex].Kind = 0 then
          Result := String(ADD_File.TicketNextPeriodList[AIndex].TicketNumber)
        else
          Result := String(ADD_File.TicketNextPeriodList[AIndex].TicketNumberOnCard);
      end;
    var
      Lo, Hi: Integer;
      T: Integer;
      Mid: String;
    begin
      Lo := iLo;
      Hi := iHi;
      Mid := GetTicketNumberOfItem(A[(Lo + Hi) div 2]);
      repeat
        while GetTicketNumberOfItem(A[Lo]) < Mid do Inc(Lo);
        while GetTicketNumberOfItem(A[Hi]) > Mid do Dec(Hi);
        if Lo <= Hi then begin
          T := A[Lo];
          A[Lo] := A[Hi];
          A[Hi] := T;
          Inc(Lo);
          Dec(Hi);
        end;
      until Lo > Hi;
      if Hi > iLo then SortTNP(A, iLo, Hi);
      if Lo < iHi then SortTNP(A, Lo, iHi);
    end;

