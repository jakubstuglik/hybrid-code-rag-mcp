class function TSalesReport.FindServerReportCorrect(AdmMain: TdmMain; AReportFileName: String): ISuperObject;
var
  sJSON: String;

  i: Integer;
  iso: ISuperObject;
  isaFilesWithoutError: TSuperArray;
begin
  Result := nil;
  sJSON := AdmMain.GetServerSalesReportsList(1, False); // bez pliku .error

  iso := SO(sJSON);
  isaFilesWithoutError := iso.O['files_without_error'].AsArray;

  // raporty czekające na rejestrację
  for i := 0 to Pred(isaFilesWithoutError.Length) do
  begin
    if CompareStr(isaFilesWithoutError[i].S['2'].ToUpper, AReportFileName.ToUpper) = 0 then
    begin
      if not Assigned(Result) then
        Result := isaFilesWithoutError[i]
      else // expects that nam eof file is unique
        Exit(nil);
    end;
  end;
end;

