function TSalesReportEmar105.CorrectEventDateTime(): Boolean;
  function PrevCorrectDateTime(AFromIndex: Integer): Integer;
  var
    i: Integer;
  begin
    Result := -1;
    for i := Pred(AFromIndex) downto 0 do
    begin
      if (String(_File.ReportEventList[i].EventDate) <> '')
        and(String(_File.ReportEventList[i].EventDate) <> '') then
        Exit(i);
    end;
  end;
  function NextCorrectDateTime(AFromIndex: Integer): Integer;
  var
    i: Integer;
  begin
    Result := -1;
    for i := Succ(AFromIndex) to Pred(_File.ReportEventList.Count) do
    begin
      if (String(_File.ReportEventList[i].EventDate) <> '')
        and(String(_File.ReportEventList[i].EventDate) <> '') then
        Exit(i);
    end;
  end;
var
  iRecord, iCorrectIndex: Integer;
  rel, relCorrect: IEmar_ReportEvent;
begin
  Result := True;
  for iRecord := 0 to Pred(_File.ReportEventList.Count) do
  begin
    rel := _File.ReportEventList[iRecord];
    if (String(rel.EventDate) = '')or(String(rel.EventTime) = '') then
    begin
      iCorrectIndex := PrevCorrectDateTime(iRecord);
      if iCorrectIndex = -1 then
        iCorrectIndex := NextCorrectDateTime(iRecord);

      if iCorrectIndex <> -1 then
      begin
        relCorrect := _File.ReportEventList[iCorrectIndex];
        rel.EventDate := PWideChar(String(relCorrect.EventDate));
        rel.EventTime := PWideChar(String(relCorrect.EventTime));
      end
      else
        Result := False;
    end;
  end;
end;

