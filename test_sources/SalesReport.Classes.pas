    begin
      iStart := ABusStopStart;
      iEnd := Pred(ABusStopEnd);

      for i := iStart to iEnd do
        Inc(Result, _FileA80.RideRouteList.Items[AIndexOfRoute + i].Distance);
    end
    else
    begin
      iStart := ARideBusStopCount - ABusStopStart;
      iEnd := ARideBusStopCount - Pred(ABusStopEnd);

      for i := iStart downto iEnd do
        Inc(Result, _FileA80.RideRouteList.Items[AIndexOfRoute + i].Distance);
    end;
  end;*)

