// finds ID based on EmCard record in the list or add it to the database and the temporary list as well
function TSalesReport.GetTempEmCardID(const AEmCardRecord: TEmCardRecord): Integer;
var
  emc: TEmCard;
begin
  Result := 0;
  if not AEmCardRecord.IsEmpty then
  begin
    TempEmCardList.TryGetValue(AEmCardRecord, Result);
    if Result = 0 then
    begin
      Result := TEmCard.Find(dmMain, AEmCardRecord);
      if Result = 0 then
      begin
        emc := TEmCard.Create;
        try        
          emc.AssignFromRecord(AEmCardRecord);
          emc.Changed := True;
          if emc.WriteToDatabase then
          begin
            Result := emc.Id;
            TempEmCardList.Add(AEmCardRecord, emc.Id); // add just added EmCard to the temporary list
          end;
        finally
          FreeAndNil(emc);
        end;
      end
      else
        TempEmCardList.Add(AEmCardRecord, Result); // add an existence EmCard to the temporary list
    end;
  end;
end;

// finds ID based on Logo in the list or add it to the database and the temporary list as well
function TSalesReport.GetTempTicketRegisterID(const ALogo: String;
  const ACurrentFiscalizationDate: TDate;
  const ATicketRegisterType: TicketRegisterType;
  const ATicketRegisterFiskal: Boolean;
  const ATicketSerialNumber, AStockNumber: String): Integer;
var
  sMessage: String;
  tr: TTicketRegister;

  procedure UpdateTicketRegister(AId: Integer);
  begin
    tr := TTicketRegister.Create;
    try
      // gdy CurrentFiscalizationDate = NULL
      if tr.ReadFromDatabase(AId) then
      begin
        // może być nie zerowe gdy rejestrujemy raport fiscalny nr 1
        if (tr.CurrentFiscalizationDate = 0)and(ACurrentFiscalizationDate > 0) then
          tr.CurrentFiscalizationDate := ACurrentFiscalizationDate;
        if (AStockNumber <> '')and(tr.StockNumber <> AStockNumber) then
          tr.StockNumber := AStockNumber;
        if (ATicketSerialNumber <> '')and(tr.TRSN <> ATicketSerialNumber) then
          tr.TRSN := ATicketSerialNumber;
        if not tr.WriteToDatabase then
          AddToDesc(Format(SALES_REPORT_MSG_TICKETREGISTER_NOT_SAVED, [ALogo]));
      end;
    finally
      FreeAndNil(tr);
    end;
  end;
begin
  // szukamy czy już dodaliśmy
  Result := 0;
  if ALogo <> '' then
  begin
    // parametr 'Rejestracja raportów tylko z bileterek ufiskalnionych'
    if LPCRegistrationParamsParameters.RegistrationRaportsTicketFiscal
      and(not ATicketRegisterFiskal) then // w tym momencie nie ma znaczenia czy jest w bazie
    begin
      Result := -3;
      AddToDesc(Format(SALES_REPORT_MSG_TICKETREGISTER_NOT_FISCAL, [ALogo]));
    end
    else
    begin
      TempTicketRegisterList.TryGetValue(ALogo, Result);
      if Result = 0 then
      begin
        Result := TTicketRegister.GetTicketRegisterId(ALogo, Ord(ATicketRegisterType), LicencesCompanyID, dmMain);
        if Result = 0 then
        begin
          if not Assigned(Licences) then
          begin
            Result := -100;
            AddToDesc(RS_LIC_ERR_READ, True);
          end
          else
          begin
{$REGION '            Sprawdzenie za pomocą dll możliwości dodania bileterki Emar'}
            if ATicketRegisterType in [trEmar105, trEmar205, trEmar305] then
            begin
              if not TInformicaValidator.CanBeAddedEmarTicketRegister(LicencesCompanyUnit.LicencesCompanyCode, sMessage) then
              begin
                AddToDesc(sMessage);
                Exit(0);
              end;
            end;
{$ENDREGION '            Sprawdzenie za pomocą dll możliwości dodania bileterki Emar'}

            // parametr 'Rejestracja raportów tylko z bileterek zarejestrowanych'
            if LPCRegistrationParamsParameters.RegistrationRaportsTicketRegistered then
            begin
              Result := -2;
              AddToDesc(Format(SALES_REPORT_MSG_TICKETREGISTER_NOT_REGISTERED, [ALogo]), True);
            end
            else
            begin
              if (Licences.Value('BUSTICKETDEV') <> -1) // uwzględniamy parametr licencji
                and (ATicketRegisterType in [trEmar105, trEmar305, trEmar205, trPosnet, trNovitus]) // zadanie 64708
                and(Licences.Value('BUSTICKETDEV') <= Licences.GetCurrentValue('BUSTICKETDEV')) then
              begin
                Result := -1;
                AddToDesc(Format(SALES_REPORT_MSG_TICKETREGISTER_OUT_OF_MAXVALUE, [ALogo]));
              end
              else
              begin
                if (Licences.Value('BUSPC') <> -1) // uwzględniamy parametr licencji Komputerów Pokładowych
                  and (ATicketRegisterType in [trEmar205, trPosnet, trNovitus]) // when it's Emar-205, Posnet or Novitus TicketRegister, BucPC automatically shall be added in the MAT_TicketRegister_INSERT SQL procedure, so we have count actual value before
                  and(Licences.Value('BUSPC') <= Licences.GetCurrentValue('BUSPC')) then
                begin
                  Result := -1;
                  AddToDesc(Format(SALES_REPORT_MSG_BUSPC_OUT_OF_MAXVALUE, [ATicketSerialNumber]));
                end
                else
                begin
                  tr := TTicketRegister.Create;
                  try
                    tr.Clear;
                    tr.CurrentLogo := ALogo;
                    tr.CurrentFiscalizationDate := ACurrentFiscalizationDate;
                    tr.TRType := ATicketRegisterType;
                    tr.TRSN := ATicketSerialNumber;
                    tr.StockNumber := AStockNumber;
                    tr.CompanyOwner_ID := LicencesCompanyID; // właścicielem bileterki autobusowej czy komputera pokładowego jest firma z licencji
                    tr.InService := True;
                    tr.InServiceStartDate := Trunc(Now());

                    if tr.WriteToDatabase then
                    begin
                      Result := tr.Id;
                      TempTicketRegisterList.Add(ALogo, tr.Id); // add just added TicketRegister to the temporary list
                    end
                    else
                      AddToDesc(Format(SALES_REPORT_MSG_TICKETREGISTER_NOT_SAVED, [ALogo]));
                  finally
                    FreeAndNil(tr);
                  end;
                end;
              end;
            end;
          end;
        end
        else
        begin
          if Result > 0 then // istnieje w bazie
          begin
            UpdateTicketRegister(Result);
            TempTicketRegisterList.Add(ALogo, Result); // add an existence TicketRegister to the temporary list
          end
          else
            if Result = -2 then // ScrapDate IS NOT NULL
              AddToDesc(Format(SALES_REPORT_MSG_TICKETREGISTER_IS_SCRAPPED, [ALogo]))
            else
              if Result = -1 then // InService and(InServiceStartDate > Now)
                AddToDesc(Format(SALES_REPORT_MSG_TICKETREGISTER_IS_NOT_IN_USE, [ALogo]));
        end;
      end
      else
        UpdateTicketRegister(Result);
    end;
  end
  else
    AddToDesc(SALES_REPORT_MSG_TICKETREGISTER_IS_BLANK);
end;

