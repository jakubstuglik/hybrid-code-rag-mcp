  procedure WyswOpisPrzEm(const Arel: IEmar_ReportEvent_17);
  var
    s: String;
  begin
    //with Apaskm[ipaskm0].a[ipaskm] do
//    begin
    case TypBM of
      1: begin
        s := C_TXT_PERIODIC_COMMA;
        {if not powEMK then begin
          if Askur<>nil then
            inc(Askur[iskur0].a[iskur].LPasBON);
          inc(Arz[irz].LPasBON);
        end;}
      end;
      2: begin
        s := C_TXT_PERIODIC_REDUCTION_COMMA;
        {if not powEMK then begin
          if Askur<>nil then
            inc(Askur[iskur0].a[iskur].LPasBOU);
          inc(Arz[irz].LPasBOU);
        end;}
      end;
      3: begin
        s := C_TXT_MONTHLY_COMMA;
        {if not powEMK then begin
          if Askur<>nil then
            inc(Askur[iskur0].a[iskur].LPasBMN);
          inc(Arz[irz].LPasBMN);
        end;}
      end;
      4: begin
        s := C_TXT_MONTHLY_SCHOOL_COMMA;
        {if not powEMK then begin
          if Askur<>nil then
            inc(Askur[iskur0].a[iskur].LPasBMS);
          inc(Arz[irz].LPasBMS);
        end;}
      end;
      5: begin
        s := StringReplace(C_TXT_MONTHLY_COMMA, ',', ' ', []);//'Miesięczny ';
        if RodzBil <> 5 then
          s := s + C_TXT_REDUCED_COMMA
        else
          s := s + C_TXT_LABOR_COMMA;
        {if not powEMK then begin
          if Askur<>nil then
            inc(Askur[iskur0].a[iskur].LPasBMU);
          inc(Arz[irz].LPasBMU);
        end;}
      end;
      6: begin
        LPrzBO := Arel.PaidRides;//Arap[ir+DRE.RAP+33];
        s := Format(C_FMT_EM_CARD_TICKER_MULTIPLE_COLON, [LPrzBO]); //'Wieloprzejazdowy - liczba przejazdów: ' + IntToStr(LPrzBO) + ',';
        {if not powEMK then
        begin
          if TypUlgi = 0 then
          begin
            if Askur<>nil then
              inc(Askur[iskur0].a[iskur].LPasBWN);
            inc(Arz[irz].LPasBWN);
          end
          else begin
            if Askur<>nil then
              inc(Askur[iskur0].a[iskur].LPasBWU);
            inc(Arz[irz].LPasBWU);
          end;
        end;}
      end;
      8: begin
        s := C_TXT_NETWORK;
        AddLine(23, s);
        OutputLine(re, clRegular, fsRegular);
        {if not powEMK then begin
          if Askur<>nil then
            inc(Askur[iskur0].a[iskur].LPasBMN);
          inc(Arz[irz].LPasBMN);
        end;}
      end;
      else s := '';
    end;
    if not siec then
    begin
      case RodzBM of
        0: s := s + C_TXT_EM_CARD_TICKET_TYPE_COURSE;
        1: s := s + C_TXT_EM_CARD_TICKET_TYPE_RELATION;
        2: s := s + C_TXT_EM_CARD_TICKET_TYPE_HOURS_INTERVAL;
      end;
      if s <> '' then
      begin
        AddLine(23, s);
        OutputLine(re, clRegular, fsRegular);
        if (TypBM = 6)and(LPrzBO > 99) then
        begin  //E.B. 08.11.2012
          AddLine(23, C_TXT_EM_CARD_TICKET_OVERFLOW_RIDES);
          OutputLine(re, clError, fsRegular);
          LPrzBO:=99;
        end;
      end;
      s := Format(C_FMT_EM_CARD_TICKET_ROUTE_AND_RELATIONSHIP, [NrTrasy]);//'Trasa nr: ' + IntToStr(NrTrasy) + ', Relacja biletu: ';
      case RelBil of
        1: s := s + C_TXT_ONE_WAY;
        2: s := s + C_TXT_ONE_WAY_CHANGE_TRAIN;
        3: s := s + C_TXT_RETURN;
        4: s := s + C_TXT_RETURN_CHANGE_TRAIN;
        5: s := s + C_TXT_ONE_WAY + ' + ' + C_TXT_ONE_WAY_CHANGE_TRAIN;
        6: s := s + C_TXT_RETURN + ' + ' + C_TXT_RETURN_CHANGE_TRAIN;
      end;
      if s <> '' then
      begin
        AddLine(23, s);
        OutputLine(re, clRegular, fsRegular);
        if (TypBM = 6)and({Arap[ir+37]}Arel.RideRemaining < 255) then
        begin
          AddLine(23, Format(C_FMT_EM_CARD_TICKET_RIDES_TO_USE_COUNT, [{Arap[ir+37]}Arel.RideRemaining]));
          OutputLine(re, clRegular, fsRegular);
        end;
      end;
      if RodzBil > 1 then
      begin //informacja o uldze
        case TypUlgi of
          1: s := C_TXT_REDUCTION_STATUTORY;
          2: s := C_TXT_REDUCTION_TRADE;
          else s := C_TXT_TICKET_LABOR;
        end;
        s := s + Format(C_FMT_DOCUMENT_NUMBER, [String(NrDokUlgi)]);
        if DokuWBezt then
          s := s + C_TXT_DASH_VALID_ALWAYS
        else
          s := s + Format(C_FMT_DASH_VALID_TO, [String(DataWDU)]);
        AddLine(23, s);
        OutputLine(re, clTeal, fsStrong);
      end;
    end;
    s := Format(C_FMT_EM_CARD_TICKET_PAY_DATE_USHERETTE_PRICE,
      [
        FormatDateTime(sfdtDMY, EmarDateTimeToDateTime(DataSp, GodzSp)),
        LogoSp,
        WartBil
      ]);
    AddLine(23, s);
    OutputLine(re, clRegular, fsRegular);
//    end; {with}
  end; //WyswOpisPrzEm

