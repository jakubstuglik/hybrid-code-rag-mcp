// po zmianie czegokolwiek w tej procedurze, trzeba zmienić SLS_SalesReport_ReCalculate w SQL
procedure TSalesReport.Calculate;
var
  fr: TFiscalReport;
  t: TTicket;
  srTasksToDo: TSalesReportTasksToDo;
begin
  // children's calculations
  for fr in FiscalReportList do
    fr.Calculate(ReportType_ID);

  // own calculations
  FiscalReportPrintNo := FiscalReportList.Count; // Liczba raportów fiskalnych
  TicketRegNo := GetTicketRegisterCount(); // Liczba bileterek użytych w raporcie zadaniowym
  TicketNo := GetTicketCount(); // Liczba biletów (musi dokładnie odpowiadać liczbie rekordów w SLS_Ticket)
  RidesNo := RideRegisteredList.Count; // Liczba kursów raportu

  PassangerWithSingleTicketNo := GetPassangerCount(Integer(ttvBiletJednorazowy)); // Liczba pasażerów wsiadających z zakupionymi wcześniej biletami (EMAR-105)
  PassangerWithMonthNormalNo := GetPassangerCount(Integer(ttvBiletMiesieczny), Integer(tgvNormalny)); // Liczba przewiezionych pasażerów z biletami miesięcznymi normalnymi (bileterka EMAR-105)
  PassangerWithMonthReductionNo := GetPassangerCount(Integer(ttvBiletMiesieczny), Integer(tgvUlgowy)); // Liczba przewiezionych pasażerów z biletami miesięcznymi ulgowymi (bileterka EMAR-105)
  PassangerWithMonthReductSchoolNo := GetPassangerCount(Integer(ttvBiletMiesieczny), Integer(tgvSzkolny)); // Liczba przewiezionych pasażerów z biletami miesięcznymi szkolnymi (bileterka EMAR-105)
  PassangerWithTempNormalNo := GetPassangerCount(Integer(ttvBiletOkresowy), Integer(tgvNormalny)); // Liczba przewiezionych pasażerów z biletami okresowymi normalnymi (bileterka EMAR-105)
  PassangerWithTempReductionNo := GetPassangerCount(Integer(ttvBiletOkresowy), Integer(tgvUlgowy)); // Liczba przewiezionych pasażerów z biletami okresowymi ulgowymi (bileterka EMAR-105)
  PassangerWithMultiRideNormalNo := GetPassangerCount(Integer(ttvBiletWieloprzejazdowy), Integer(tgvNormalny)); // Liczba przewiezionych pasażerów z biletami wieloprzejazdowymi normalnymi (bileterka EMAR-105)
  PassangerWithMultiRideReductionNo := GetPassangerCount(Integer(ttvBiletWieloprzejazdowy), Integer(tgvUlgowy)); // Liczba przewiezionych pasażerów z biletami wieloprzejazdowymi ulgowymi (bileterka EMAR-105)

  if PassangerNo = 0 then
    PassangerNo := PassangerWithSingleTicketNo + PassangerWithMonthNormalNo +
      PassangerWithMonthReductionNo + PassangerWithMonthReductSchoolNo +
      PassangerWithTempNormalNo + PassangerWithTempReductionNo +
      PassangerWithMultiRideNormalNo + PassangerWithMultiRideReductionNo;

  TicketValue := TicketValueSum;
  TicketGross := TicketGrossSum;
  // DPA-ATY: AdditionalFeeCharge oraz AdditionalFeeChargeAbroad z SLS_Ticket to raczej opłaty manipulacyjne
//  AdditionalFeeNo := AdditionalFeeCount;
//  AdditionalFeeValue := AdditionalFeeValueSum;
  CashValue := AmountToPaySum(Integer(ptvCash));
  NonCashValue := AmountToPaySum(Integer(ptvCheck)) +
    AmountToPaySum(Integer(ptvTransfer)) + AmountToPaySum(Integer(ptvCreditCard))
    + AmountToPaySum(Integer(ptvBon));

  ForeignCurrencyNo := ForeignCurrencyCount;
  ForeignCurrencyValue := ForeignCurrencySum;
  RecogNo := GetRecogCount();
  RecogCash := RecogSum(Ord(ptvCash));
  RecogNonCash := RecogSum(Integer(ptvCheck)) +
    RecogSum(Integer(ptvTransfer)) + RecogSum(Integer(ptvCreditCard))
    + RecogSum(Integer(ptvBon));
  RecogValue := RecogCash + RecogNonCash;

  {
    podsumowanie biletów ze zdarzenia #32 'Zakup w autobusie biletu miesięcznego / okresowego na następny okres (karta MIFARE)',
    które powstaną później po wywoływaniu procedury SLS_SalesReportTasksToDo_RUN
  }
  for srTasksToDo in SalesReportTasksToDoList do
  begin
    t := srTasksToDo.Ticket;
    if (srTasksToDo.Type_ID = 2)and Assigned(t) then // pochodzi ze zdarzenia #32
    begin
      TicketNo := TicketNo + t.PassangerNumber;

      if t.TicketType_ID = Integer(ttvBiletJednorazowy) then
        PassangerWithSingleTicketNo := PassangerWithSingleTicketNo + t.PassangerNumber; // Liczba pasażerów wsiadających z zakupionymi wcześniej biletami (EMAR-105)
      if (t.TicketType_ID = Integer(ttvBiletMiesieczny))and(t.TicketGenre_ID = Integer(tgvNormalny)) then
        PassangerWithMonthNormalNo := PassangerWithMonthNormalNo + t.PassangerNumber; // Liczba przewiezionych pasażerów z biletami miesięcznymi normalnymi (bileterka EMAR-105)
      if (t.TicketType_ID = Integer(ttvBiletMiesieczny))and(t.TicketGenre_ID = Integer(tgvUlgowy)) then
        PassangerWithMonthReductionNo := PassangerWithMonthReductionNo + t.PassangerNumber; // Liczba przewiezionych pasażerów z biletami miesięcznymi ulgowymi (bileterka EMAR-105)
      if (t.TicketType_ID = Integer(ttvBiletMiesieczny))and(t.TicketGenre_ID = Integer(tgvSzkolny)) then
        PassangerWithMonthReductSchoolNo := PassangerWithMonthReductSchoolNo + t.PassangerNumber; // Liczba przewiezionych pasażerów z biletami miesięcznymi szkolnymi (bileterka EMAR-105)
      if (t.TicketType_ID = Integer(ttvBiletOkresowy))and(t.TicketGenre_ID = Integer(tgvNormalny)) then
        PassangerWithTempNormalNo := PassangerWithTempNormalNo + t.PassangerNumber; // Liczba przewiezionych pasażerów z biletami okresowymi normalnymi (bileterka EMAR-105)
      if (t.TicketType_ID = Integer(ttvBiletOkresowy))and(t.TicketGenre_ID = Integer(tgvUlgowy)) then
        PassangerWithTempReductionNo := PassangerWithTempReductionNo + t.PassangerNumber; // Liczba przewiezionych pasażerów z biletami okresowymi ulgowymi (bileterka EMAR-105)
      if (t.TicketType_ID = Integer(ttvBiletWieloprzejazdowy))and(t.TicketGenre_ID = Integer(tgvNormalny)) then
        PassangerWithMultiRideNormalNo := PassangerWithMultiRideNormalNo + t.PassangerNumber; // Liczba przewiezionych pasażerów z biletami wieloprzejazdowymi normalnymi (bileterka EMAR-105)
      if (t.TicketType_ID = Integer(ttvBiletWieloprzejazdowy))and(t.TicketGenre_ID = Integer(tgvUlgowy)) then
        PassangerWithMultiRideReductionNo := PassangerWithMultiRideReductionNo + t.PassangerNumber; // Liczba przewiezionych pasażerów z biletami wieloprzejazdowymi ulgowymi (bileterka EMAR-105)

      PassangerNo := PassangerNo + t.PassangerNumber;

      TicketValue := TicketValue + t.AmountToPay;
      TicketGross := TicketGross + t.PriceSum;
      if (t.AmountToPay - srTasksToDo.NonCashInTicketPrice) <> 0 then
        CashValue := CashValue + t.AmountToPay - srTasksToDo.NonCashInTicketPrice;
      if srTasksToDo.NonCashInTicketPrice <> 0 then
        NonCashValue := NonCashValue + srTasksToDo.NonCashInTicketPrice;
      if t.Currency_ID > 1 then
      begin
        ForeignCurrencyNo := ForeignCurrencyNo + 1;
        ForeignCurrencyValue := ForeignCurrencyValue + t.AmountToPay;
      end;
    end;
  end;

  //te wartości wypelniane są podczas rejestracji raportu dla duo
//  if not (ReportType_ID in [Ord(rtDuo), Ord(rtDuoReturns)]) then begin
//    EmCardMonthTicketMusterNo := 0; //to do
//    EmCardTempTicketMusterNo := 0; //to do
//    EmCardMultiRideTicketMusterNo := 0; //to do
//  end;

  UserStationNumber := GetUserStationParam;
  Currency_ID := DefaultCurrencyID; // waluta ewidencyjna
end;

