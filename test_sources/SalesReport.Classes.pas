function TSalesReportEmar105.FillFromFile(aFromFile: boolean): Boolean;

  function _PopulateWronglyPrintedTickets(AStoredSalesReportID: Integer): Integer;
  var
    iCorrectedFR, iFR, iT, iTCorrected: Integer;
    srCorrected: TSalesReportEmar105;
    frCorrected: TFiscalReport;
    t: TTicket;
  begin
    Result := 0;

    srCorrected := TSalesReportEmar105.Create;
    try
      srCorrected.CFilePath := CFilePath;
      srCorrected.Init_FileC;
//      IEmar105_File(srCorrected._File).LoadFromFile(PWideChar(srCorrected.CFilePath));
      srCorrected._File := _File;
      if ReadFromDatabase(AStoredSalesReportID) then
      begin
        srCorrected.ReportType := Self.ReportType;
        srCorrected.ReportType_Id := Self.ReportType_Id;
{$REGION '        Already selected Driver/cashier'}
        srCorrected.Driver_ID := Self.Driver_ID;
        srCorrected.FirstName := Self.FirstName;
        srCorrected.LastName := Self.LastName;
{$ENDREGION}

        if not srCorrected.FillSalesReportFromFile(aFromFile) then
          Exit;

        if srCorrected.FileProcessTasksPath = '' then
        begin
          AddToDesc(srCorrected.Description, True);
          Exit;
        end;

        Changed := True;

        FileC.PrepareDISPFileFromPath(CFilePath, LicencesCompanyID, dfSalesReportFileC, 0);
        FileC.FileAttachment.Subdir := srCorrected.FileC.FileAttachment.Subdir;
        FileC.FileAttachment.OldId := FileC.FileAttachment.Id; // zastępuje ten plik
        FileC.FileAttachment.Id := 0;

        FileProcessTasksPath := srCorrected.FileProcessTasksPath;
        FileProcessTasks.PrepareDISPFileFromPath(FileProcessTasksPath, LicencesCompanyID, dfSalesReportProcessTasks, 0);
        FileProcessTasks.FileAttachment.OldId := FileProcessTasks.FileAttachment.Id; // zastępuje ten plik
        FileProcessTasks.FileAttachment.Id := 0;

        iFR := 0;
        // Uwaga! Liczba raportów fiskalnych NIE może się różnić
        while iFR < FiscalReportList.Count do
        begin
          if FiscalReportList[iFR].TicketList.Count > 0 then
          begin
            frCorrected := nil;
            iCorrectedFR := 0;
            while iCorrectedFR < srCorrected.FiscalReportList.Count do
            begin
              if FiscalReportList[iFR].ReportNumber =
                srCorrected.FiscalReportList[iCorrectedFR].ReportNumber then
              begin
                frCorrected := srCorrected.FiscalReportList[iCorrectedFR];
                Break;
              end;
              Inc(iCorrectedFR);
            end;

            if Assigned(frCorrected) then
            begin
              iT := 0;
              iTCorrected := 0;
              while iTCorrected < frCorrected.TicketList.Count do
              begin
                if (FiscalReportList[iFR].TicketList[iT].TicketNumber <>
                    frCorrected.TicketList[iTCorrected].TicketNumber) then
                begin
                  {
                    NOTE: cloning uses with newly created and did not saved ticket;
                    otherwise it'll require to clear any dependencies to other objects
                  }
                  t := FiscalReportList[iFR].CloneTicket(frCorrected.TicketList[iTCorrected]);
                  Self.PassangerNo := Self.PassangerNo + t.PassangerNumber; // this field does not change in the Calculate procedure
                  Inc(Result);
                end
                else
                  Inc(iT);
                Inc(iTCorrected);
              end;
            end;
          end;
          Inc(iFR);
        end;

        Calculate();
      end
      else
      begin
        Self.Description := srCorrected.Description; // nadpisujemy wynik działania
      end;
    finally
      FreeAndNil(srCorrected);
    end;
  end;

  function _ReRegister(ASalesReportID: Integer): Boolean;
  begin
    Id := ASalesReportID; // nadpisujemy
    ReadFromDatabase(Id); // odczytywanie plików
    DeleteAllExceptHeader := True; // delete all related items and objects
    Description := '';
    Status := Ord(TSalesReportStatus.srsNone); // zerowanie
    if Assigned(FileC) and Assigned(FileC.FileAttachment) then
    begin
      FileC.FileAttachment.OldId := FileC.FileAttachment.Id; // zastępuje ten plik
      FileC.FileAttachment.Id := 0;
    end;
    if Assigned(FileK) and Assigned(FileK.FileAttachment) then
    begin
      FileK.FileAttachment.OldId := FileK.FileAttachment.Id; // zastępuje ten plik
      FileK.FileAttachment.Id := 0;
    end;
    if Assigned(FileProcessTasks) and Assigned(FileProcessTasks.FileAttachment) then
    begin
      FileProcessTasks.FileAttachment.OldId := FileProcessTasks.FileAttachment.Id; // zastępuje ten plik
      FileProcessTasks.FileAttachment.Id := 0;
    end;

    Result := FillSalesReportFromFile(aFromFile);
  end;

  function _PopulateFixedCE(AStoredSalesReportID: Integer): Boolean;
  var
    iCorrectedFR, iFR, iT, iTCorrected, iTicketPayment: Integer;
    srCorrected: TSalesReportEmar105;
    frCorrected: TFiscalReport;
    t: TTicket;
  begin
    Result := False;

    srCorrected := TSalesReportEmar105.Create;
    try
      srCorrected.CFilePath := CFilePath;
      srCorrected.Init_FileC;
//      IEmar105_File(srCorrected._File).LoadFromFile(PWideChar(srCorrected.CFilePath));
      srCorrected._File := _File;
      if ReadFromDatabase(AStoredSalesReportID) then
      begin
        srCorrected.ReportType := Self.ReportType;
        srCorrected.ReportType_Id := Self.ReportType_Id;
{$REGION '        Already selected Driver/cashier'}
        srCorrected.Driver_ID := Self.Driver_ID;
        srCorrected.FirstName := Self.FirstName;
        srCorrected.LastName := Self.LastName;
{$ENDREGION}

        if not srCorrected.FillSalesReportFromFile(aFromFile) then
          Exit;

        if srCorrected.FileProcessTasksPath = '' then
        begin
          AddToDesc(srCorrected.Description, True);
          Exit;
        end;

        Changed := True;

        FileC.PrepareDISPFileFromPath(CFilePath, LicencesCompanyID, dfSalesReportFileC, 0);
        FileC.FileAttachment.Subdir := srCorrected.FileC.FileAttachment.Subdir;
        FileC.FileAttachment.OldId := FileC.FileAttachment.Id; // zastępuje ten plik
        FileC.FileAttachment.Id := 0;

        FileProcessTasksPath := srCorrected.FileProcessTasksPath;
        FileProcessTasks.PrepareDISPFileFromPath(FileProcessTasksPath, LicencesCompanyID, dfSalesReportProcessTasks, 0);
        FileProcessTasks.FileAttachment.OldId := FileProcessTasks.FileAttachment.Id; // zastępuje ten plik
        FileProcessTasks.FileAttachment.Id := 0;

        iFR := 0;
        // Uwaga! Liczba raportów fiskalnych NIE może się różnić
        while iFR < FiscalReportList.Count do
        begin
          if FiscalReportList[iFR].TicketList.Count > 0 then
          begin
            frCorrected := nil;
            iCorrectedFR := 0;
            while iCorrectedFR < srCorrected.FiscalReportList.Count do
            begin
              if FiscalReportList[iFR].ReportNumber =
                srCorrected.FiscalReportList[iCorrectedFR].ReportNumber then
              begin
                frCorrected := srCorrected.FiscalReportList[iCorrectedFR];
                Break;
              end;
              Inc(iCorrectedFR);
            end;

            if
              Assigned(frCorrected)
              and(FiscalReportList[iFR].TicketList.Count = frCorrected.TicketList.Count)
            then
            begin
              iT := 0;
              while iT < FiscalReportList[iFR].TicketList.Count do
              begin
                if
                  (FiscalReportList[iFR].TicketList[iT].TicketNumber =
                    frCorrected.TicketList[iT].TicketNumber)
                  and(FiscalReportList[iFR].TicketList[iT].PaymentType.Id <>
                    frCorrected.TicketList[iT].PaymentType.Id)
                then
                begin
                  {
                    #100528
                    Gdy najpierw jest zarejestrowany raport Emar-205 Online (CE) bez zdarzenia 1 oraz 41,
                    to jest traktowany jako Emar-105 i nie zapisuja się zapłaty kartą.
                    Ten typ sprawdzania naprawia sposoby zapłaty.
                  }
                  if FiscalReportList[iFR].TicketList[iT].OrygPaymentType_ID = 0 then
                    FiscalReportList[iFR].TicketList[iT].OrygPaymentType_ID :=
                      FiscalReportList[iFR].TicketList[iT].PaymentType.Id;
                  FiscalReportList[iFR].TicketList[iT].PaymentType_ID :=
                    frCorrected.TicketList[iT].PaymentType.Id;
                  FiscalReportList[iFR].TicketList[iT].PaymentType.Id :=
                    frCorrected.TicketList[iT].PaymentType.Id;
                  FiscalReportList[iFR].TicketList[iT].PaymentType.Changed := False;
                end;

                Inc(iT);
              end;
            end;
          end;
          Inc(iFR);
        end;

        Calculate();

        Result := True;
      end
      else
      begin
        Self.Description := srCorrected.Description; // nadpisujemy wynik działania
      end;
    finally
      FreeAndNil(srCorrected);
    end;
  end;

var
  iSalesReportID, iSalesReportStatus: Integer;
  iPopulateWronglyPrintedTickets: Integer;
  iFileErrorCode, iCompareFile: LongWord;
  sExtractFileName: string;
  sFullReportNumber: String;
  sSavedFilePath: String;
  sEmar105ReportIsAlreadyRegistered, sSalesReportIsBroken: String;
  sSubDir: String;
begin
  Result := Init_FileC();
  if Result then
  begin
    try
      if CFilePath <> '' then
      begin
        sExtractFileName := ExtractFileName(CFilePath);

        if FileExists(CFilePath) then
          iFileErrorCode := _File.LoadFromFile(PChar(CFilePath))
        else
          iFileErrorCode := ERR_FILE_NOT_FOUND;
      end
      else
        if KFilePath <> '' then
        begin
          sExtractFileName := ExtractFileName(KFilePath);
          if FileExists(KFilePath) then
            iFileErrorCode := _File.LoadFromFile(PChar(KFilePath))
          else
            iFileErrorCode := ERR_FILE_NOT_FOUND
        end
        else
        begin
          iFileErrorCode := ERR_NO_ERROR;
          if FileC.Company_ID = 0 then
            FileC.Company_ID := GetLicencesCompanyID;
          CFilePath := TempFileName(FileC.GetNewFileName(dfSalesReportFileC));
          _File.SaveToFile(PChar(CFilePath), _File.Version, EMAR_SAVEMODE_FULL_REPORT);
          sExtractFileName := ExtractFileName(CFilePath);
        end;
    except
      iFileErrorCode := ERR_INCORRECT_FILE;
    end;

    Result := False;

    case iFileErrorCode of
      ERR_NO_ERROR:
        begin
          if CFilePath = '' then // in case was [Po awarii] but file is correct
          begin
            CFilePath := KFilePath;
            KFilePath := '';
          end;
          if (_File.ReportEventList.Count = 1) // jedynie zdarzenie #0 - 'Szyfr raportu'
            or _File.IsReportEvent41 // lub jednak 205
            or IsEmar205OnlineReport() // CE report
          then
            Self.ReportType := rtEmar205 // bileterka EMAR-205
          else
            Self.ReportType := rtEmar105; // bileterka EMAR-105
          iSalesReportID := GetIDFromReportName(dmMain, sExtractFileName, Integer(Self.ReportType));
          if iSalesReportID <> 0 then
          begin
            sSubDir := TGUID.NewGuid.ToString;
            sSubDir := FastStringReplace(sSubDir, '{', '', [rfReplaceAll]);
            sSubDir := FastStringReplace(sSubDir, '}', '', [rfReplaceAll]);
            sSubDir := Format('%s_%s', [FormatDateTime('yyyymmdd_hhnnss', Now), sSubDir]);

            sFullReportNumber := TSalesReport.GetFullReportNumber(dmMain, iSalesReportID);
            if IsEmar205OnlineReport() then
              sEmar105ReportIsAlreadyRegistered := Format(RS_Emar205ReportOnlineIsAlreadyRegistered,
                      [
                        sExtractFileName
                        , DateToStr(Floor(TSalesReport.GetRegistrationDate(dmMain, iSalesReportID)))
                        , Copy(sFullReportNumber, 9, 2)
                        , Copy(sFullReportNumber, 11, 5)
                      ])
            else
              sEmar105ReportIsAlreadyRegistered := Format(RS_Emar105ReportIsAlreadyRegistered,
                      [
                        sExtractFileName
                        , Self._File.OIK.CardSerialNumber
                        , DateToStr(Floor(TSalesReport.GetRegistrationDate(dmMain, iSalesReportID)))
                        , Copy(sFullReportNumber, 9, 2)
                        , Copy(sFullReportNumber, 11, 5)
                      ]);
            sSalesReportIsBroken := Format(RS_SalesReportIsBroken, [sExtractFileName]);
            iSalesReportStatus := TSalesReport.GetStatus(dmMain, iSalesReportID);
            if iSalesReportStatus = Ord(TSalesReportStatus.srsCorrect) then // poprawnie zarejestrowany
            begin
              sSavedFilePath := KMWinSysUtils.TempFileName(IncludeTrailingPathDelimiter(sSubDir) + sExtractFileName);
              try
                ForceDirectories(ExtractFilePath(sSavedFilePath));
                CopyFile(
                  PChar(TDISPFile.GetLocalFilePath(dmMain, TDISPFile.IdFromNameAndFileType(dmMain, sExtractFileName, Integer(dfSalesReportFileC))))
                  , PChar(sSavedFilePath)
                  , False);
                if KMFilesUtil.GetFileSize(sSavedFilePath) = 0 then
                begin
                  AddToDesc(Format(C_MSG_INCORRECT_FILE_READING_ERROR_FROM_SERVER, [sExtractFileName]), False);
                  Exit;
                end;
                iCompareFile := _File.CompareFile(PChar(sSavedFilePath));
                  // EBO zaproponował zawsze tworzyć plik z informacją,
                  // że raport jest zarejestrowany i nie usuwać raportu,
                  // natomiast dać możliwość to zrobic użytkownikowi
//                if (iCompareFile = ERR_NO_ERROR) then
//                begin
////                  PrepareFromFile(dfSalesReportFileC); // potrzebny do dalszego usuwania pliku z raportem
//                  Id := iSalesReportID;
//                  Status := 4; // imitacja porządku
//                  Self.AddToDesc(sEmar105ReportIsAlreadyRegistered);
//                  Result := False;
//                end
//                else
                  // liczba biletów ta sama, jedynie niektóre „bilet nie został zapisany do pamięci fiskalnej – zapis pominięty”.
                  if iCompareFile = ERR_COMPARE_TICKET_WRONGLY_PRINTED then
                  begin
                    iPopulateWronglyPrintedTickets := _PopulateWronglyPrintedTickets(iSalesReportID);
{$IF NOT(DEFINED(DSSERVER))}
                    if MessageDlg(Format(sEmar105ReportIsAlreadyRegistered
                        + #13#10#13#10 + RS_Emar105ReportQuestionToBeRegisteredNewTickets, [iPopulateWronglyPrintedTickets])
                      , mtConfirmation
                      , [mbYes, mbNo]
                      , 0) = ID_YES then
{$ELSE}
                    if True then
{$ENDIF}
                      Result := iPopulateWronglyPrintedTickets > 0
                    else
                      Result := False;
                  end
                  else // raporty róznią się ale wyłącznie w sposób dodania do raportu nowych zdarzeń (NIE EDYCJI)
                    if iCompareFile = ERR_COMPARE_ADDED_EVENTS then
                    begin
                      Result := _ReRegister(iSalesReportID)
                        and(not(Self.Status in [Ord(TSalesReportStatus.srsNone)
                          , Ord(TSalesReportStatus.srsBroken)])); // if Status = 0, report was not properly populated
                      if (not Result)and(Self.Description = '') then
                        Self.AddToDesc(sSalesReportIsBroken, True);
                    end
                    else
                      // do raportu CE doszło zdarzenie #41
                      if iCompareFile = ERR_COMPARE_CE_ADDED_IDENTIFY_EVENTS then
                      begin
                        Result := _PopulateFixedCE(iSalesReportID)
                          and(not(Self.Status in [Ord(TSalesReportStatus.srsNone)
                            , Ord(TSalesReportStatus.srsBroken)
                            , Ord(TSalesReportStatus.srsCorrectWithWarning)])); // if Status = 0, report was not properly populated
                        if (not Result)and(Self.Description = '') then
                          Self.AddToDesc(sSalesReportIsBroken, True);
                      end
                      else
                      begin
                        Result := False;
                        if _ReRegister(iSalesReportID)
                          and(Self.Status in [Ord(TSalesReportStatus.srsNone)
                            , Ord(TSalesReportStatus.srsBroken)]) then
                          Self.AddToDesc(sSalesReportIsBroken, True)
                        else
                          Self.AddToDesc(sEmar105ReportIsAlreadyRegistered, True);
                      end;
              finally
                KMFilesUtil.ForceDeleteFile(PChar(sSavedFilePath));
                ForceDeleteDir(ExtractFilePath(sSavedFilePath), False);
              end;
            end
            else
              // status "na poamarańczowo" - 11
              if iSalesReportStatus = Ord(TSalesReportStatus.srsCorrectWithWarning) then
              begin
                sSavedFilePath := KMWinSysUtils.TempFileName(IncludeTrailingPathDelimiter(sSubDir) + sExtractFileName);
                try
                  ForceDirectories(ExtractFilePath(sSavedFilePath));
                  CopyFile(
                    PChar(TDISPFile.GetLocalFilePath(dmMain, TDISPFile.IdFromNameAndFileType(dmMain, sExtractFileName, Integer(dfSalesReportFileC))))
                    , PChar(sSavedFilePath)
                    , False);
                  if KMFilesUtil.GetFileSize(sSavedFilePath) = 0 then
                  begin
                    AddToDesc(Format(C_MSG_INCORRECT_FILE_READING_ERROR_FROM_SERVER, [sExtractFileName]), False);
                    Exit;
                  end;
                  iCompareFile := _File.CompareFile(PChar(sSavedFilePath));
                  // do raportu CE doszło zdarzenie #41
                  if iCompareFile = ERR_COMPARE_CE_ADDED_IDENTIFY_EVENTS then
                  begin
                    Result := _PopulateFixedCE(iSalesReportID)
                      and(not(Self.Status in [Ord(TSalesReportStatus.srsNone)
                        , Ord(TSalesReportStatus.srsBroken)])); // if Status = 0, report was not properly populated
                    if (not Result)and(Self.Description = '') then
                      Self.AddToDesc(sSalesReportIsBroken, True);
                  end
                  else
                  begin
                    Result := _ReRegister(iSalesReportID)
                      // if Status = 0, report was not properly populated
                      // 11 - status "na poamarańczowo", jest w maiarę ok
                      and(iSalesReportStatus = Ord(TSalesReportStatus.srsCorrectWithWarning))
                      // nie wolno nadpisać niepoprawnym raportem
                      and(not(Status in [Ord(TSalesReportStatus.srsNone), Ord(TSalesReportStatus.srsBroken)]));
                    if (not Result)and(Self.Description = '') then
                      Self.AddToDesc(sSalesReportIsBroken, True);
                  end;
                finally
                  KMFilesUtil.ForceDeleteFile(PChar(sSavedFilePath));
                  ForceDeleteDir(ExtractFilePath(sSavedFilePath), False);
                end;
              end
              else // Status=1 - NIEpoprawnie zarejestrowany,-10-usnięta awaria
              begin
                Result := _ReRegister(iSalesReportID)
                  // if Status = 0, report was not properly populated
                  and(
                    (iSalesReportStatus = Ord(TSalesReportStatus.srsBroken)) // 1 - błedny raport
                    or
                    (iSalesReportStatus = Ord(TSalesReportStatus.srsBrokenDeleted)) // -10 - usunięty błędny raport
                  )
                  // może zostać zarejestrowany z jakim kolwek statusem
                  and(not(Status in [Ord(TSalesReportStatus.srsNone)]));
                if (not Result)and(Self.Description = '') then
                  Self.AddToDesc(sSalesReportIsBroken, True);
              end;
          end
          else
          begin
            Result := FillSalesReportFromFile(aFromFile);
          end;
        end;
      ERR_INCORRECT_FILE:
        begin
          AddToDesc(
            Format(C_MSG_INCORRECT_FILE_READING_ERROR,
              [ExtractFileName(IfThen(CFilePath <> '', CFilePath, KFilePath))]), False);
        end;
      ERR_FILE_NOT_FOUND:
        begin
          AddToDesc(C_MSG_FILE_NOT_FOUND, False);
//            raise Exception.Create(C_MSG_FILE_NOT_FOUND);
        end;
      ERR_USER_TERMINATE:
        begin
          if Description = '' then
            AddToDesc(C_MSG_REGISTRATION_USER_TERMINATE, False);
        end;
      ERR_REPORT_NO_REPORT:
        begin
          AddToDesc(Format(C_MSG_NO_REPORT_IN_CARD, [_File.OIK.CardSerialNumber]), False);
        end;
      ERR_REPORT_NO_DIR_RECORD:
        begin
          AddToDesc(C_MSG_DIR_NOT_FOUND, False);
        end;
      else
        AddToDesc(ClassName + '.WriteFromFile: ' + C_MSG_UNKNOWN_READING_ERROR, False);
    end;
  end;
end; // FillFromFile

