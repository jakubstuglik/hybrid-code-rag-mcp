function TSalesReportEmar105.getFiscalReportTicketNo(AFiscalReport: TFiscalReport): Integer;
var
  t: TTicket;
  srTasksToDo: TSalesReportTasksToDo;
begin
  Result := 0;
  if Assigned(AFiscalReport) then
  begin
    {
      podsumowanie biletów ze zdarzenia #32 'Zakup w autobusie biletu miesięcznego / okresowego na następny okres (karta MIFARE)',
      które powstaną później po wywoływaniu procedury SLS_SalesReportTasksToDo_RUN
    }
    for srTasksToDo in SalesReportTasksToDoList do
    begin
      t := srTasksToDo.Ticket;
      if (srTasksToDo.Type_ID = 2)and Assigned(t) and(srTasksToDo.FiscalReport = AFiscalReport) then // pochodzi ze zdarzenia #32
      begin
        Result := Result + t.PassangerNumber;
      end;
    end;
    // bilety z listy do zapisu do bazy
    for t in AFiscalReport.TicketList do
      if Assigned(t) then
        Result := Result + t.PassangerNumber;
  end;
end;

