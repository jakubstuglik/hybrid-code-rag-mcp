  TicketRoute: TTicketRoute;
  TicketGoods: TTicketGoods;
  RideRegistered: TRideRegistered;
  //EmCardXPassanger: TEmCardXPassanger;
  EmCardXPassangerRecording: TEmCardXPassangerRecording;
  EmCardTicketProlonging: TEmCardTicketProlonging;
//  EmCardSaleOnBus: TEmCardSaleOnBus;
//  EmCardTicketPrefSetOnEmCard: TEmCardTicketPrefSetOnEmCard;
  Ride: TRide;
  RoutePoint: TBasicRoutePoint;
  FarePriceReduction: TFarePriceReduction;
  RideRegisteredXBusStop: TRideRegisteredXBusStop;
  TicketXCompany: TTicketXCompany;
  SalesReportTasksToDo: TSalesReportTasksToDo;
  ControlPrint: TControlPrint;
  TicketZTM: TTicketZTM;

//  sast: Boolean; //są stawki ptu
  iTax1Rates, iTax2Rates: Integer;

  iCheckIfExistsInDBFiscalReport: Integer;
  s: String;
//  iFiscalReportID: Integer;
  bnrrf: Integer; //bieżący numer raportu fiskalnego
  iLastEmarSaleCompanyID, iCompanyID, iSaleCompany_ID: Integer;
  iPrice, iNormalPrice, iDiscountCharge, iReductionValue, iReductionPercentage, iAdditionalFeeCharge: Integer;
  iPriceAbroad, iNormalPriceAbroad, iDiscountChargeAbroad, iReductionValueAbroad, iAdditionalFeeChargeAbroad: Integer;
  iAmountToPay: Integer;
  i36TicketsCash, i36TicketsNonCash, i36TicketsAmountToPay: Integer;
  i36TicketsCash_Tmp, i36TicketsNonCash_Tmp, i36TicketsAmountToPay_Tmp: Integer;
  i36TicketPrice, {i36TicketPriceAbroad,} i36Amount: Integer;
  s36TicketCurrency, s36CurrencyDefSymbol: String;
  iFarePriceReductionList, iFarePriceReduction_ID: Integer;
  iEmCard_ID: Integer;
  iEmCardTicketProlonging: Integer;
  iEmCardFirstTicket_ID, iTicket_ID, iTicketType_ID: Integer;
  iEmCardTicketProlongingID_Card: Integer;
  iEmCardSaleOnBus_Base: Integer;
  iFiscalReportNumber: Integer;
  arEmCardSaleOnBus: TIntArray;
  sTicketNumberBM: String;
//  bBreak: LongBool;
  bonEM: Integer;
  powEMK: boolean; //powtórna rejestracja EM-karty (drgania)
  poprEMK: boolean; //false-nieprawidłowe dane - pominąć odczyt
  bladEMK: string; //opis błędu EM-karty
  r2ok, r3ok, r4ok: Boolean; //sumy kontrolne rekordów 2,3,4 ok

  iA80FileId: Integer;
  iFileALoadError: Cardinal;
  sA80FilePath: String;
  sFullReportNumber: String;
  dCurrentFiscalizationDate: TDate;
  iBusStop: IEmar_BusStop;
  lrekTotal: Integer; // ilość rekordów w zdarzeniach
  bErrorsInProcessTasksMock: Boolean;
begin
  Result := False;

  iCompanyID := GetLicencesCompanyID();
  Company_ID := iCompanyID;
  User_ID := TSalesReport.GetUserIDForSaveBasedOnPath(dmMain, Self.CFilePath, CurrentUser.Id);

  // save all required data
  if not WriteToDatabaseRequestedData() then
    Exit;

  PrepareFromFile(dfSalesReportFileC);
  // "Begin": zbiór A80
  sA80FilePath := KMWinSysUtils.TempFileName(_File.AFileName);
  if Status = 0 then // poprawny C
  begin
    if IsEmar205OnlineReport() then
      iA80FileId := TDispFile.IdFromNameAndFileType(dmMain, _File.AFileName, Integer(dfFileA80Export))
    else
      iA80FileId := TDispFile.IdFromNameAndFileType(dmMain, _File.AFileName, Integer(dfEmar105));
    if iA80FileId > 0 then
    begin
      if not _LoadA80(iA80FileId, sA80FilePath) then
        Exit;

      FileOryg_ID := iA80FileId;
    end
    else // iFileAId = 0
    begin
      if IsEmar205OnlineReport()
        and(not IsEmar205OnlineReportWithoutCardMode()) // nie 'tryb pracy bez karty pamięci'
      then
      begin // A80 should exists for an Emar205 online reports
        if Trim(_File.AFileName) = '' then
          AddToDesc(RS_Emar105MissingRegistrationFileError)
        else
          AddToDesc(Format(RS_Emar105RegistrationFileALoadingError, [_File.AFileName]));
        Exit; // błąd odczytu zbioru
      end;

      if not(
        IsEmar205OnlineReportWithoutCardMode() // nie 'tryb pracy bez karty pamięci'
        )
      then
      begin
        if Trim(_File.AFileName).Length < 21 then // A80_YYYYMMDD_nnnn.Dxx
        begin
          AddToDesc(RS_Emar105MissingRegistrationFileError);
          Exit; // brak zbioru
        end;

        if not _SaveAndLoadLocalA80(sA80FilePath) then
          Exit; // błąd odczytu zbioru
      end;
    end;
  end;
  // "End": zbiór A80

{$REGION '  sprawdzanie, czy karta jest zarejestrowana'}
  if
    (FileC.FileType in [dfSalesReportFileC, dfSalesReportFileK])
    and(not IsEmar205OnlineReport())
  then
  begin
    TicketRegisterCard_ID := TTicketRegisterCard.GetIdByCardSN(IntToStr(_File.OIK.CardSerialNumber), dmMain);
    if TicketRegisterCard_ID <= 0 then
    begin
      if TicketRegisterCard_ID = -2 then // 'ScrapDate' Is Null
        AddToDesc(Format(RS_Emar105RegistrationCardScrapDateError, [_File.OIK.CardSerialNumber]), True)
      else
        if TicketRegisterCard_ID = -1 then // 'Blocked'
          AddToDesc(Format(RS_Emar105RegistrationCardBlockedError, [_File.OIK.CardSerialNumber]), True)
        else
          AddToDesc(Format(RS_Emar105RegistrationCardError, [_File.OIK.CardSerialNumber]), True);
      Exit;
    end;
  end;
{$ENDREGION}

  // ATY: !!! Should be at the top, because includes some error fixes inside !!!
  FileProcessTasksPath := GenerateProcessTasks(bErrorsInProcessTasks);
  if FileProcessTasksPath = '' then // wystąpił błąd, plik nie został wygenerowany
    Exit
  else
    Self.FileProcessTasks.PrepareDISPFileFromPath(FileProcessTasksPath, iCompanyID, dfSalesReportProcessTasks, 0);
  // ATY: !!! Should be at the top, because includes some error fixes inside !!!

{$REGION '  Function''s valiables initialization'}
  ZeroMemory(@OstSpZapl, SizeOf(OstSpZapl));
  ZeroMemory(@OstWaluta, SizeOf(OstWaluta));

  fr := nil;
  bonEM := 0;
  bnrrf := 0;
  nrpb := -2;
  nr := -1;
  wlaczeniezasilania := True;
  bylootwrf := false;
  bilufisk := false;
  otwrfdat := False;
  przedluzenie := False;
  EMAR205 := False;

  LastEmarIndexOfRide := -1;
  LastEmarIndexOfCurrency := -1;
  LastEmarIndexOfPaymentType := -255; // ponieważ -1=mieszany
  if (_File.ReportEventList.Count = 1) // jedynie zdarzenie #0 - 'Szyfr raportu'
    or _File.IsReportEvent41 // lub jednak 205
    or IsEmar205OnlineReport() // CE report
  then
    ReportType := rtEmar205 // bileterka EMAR-205
  else
    ReportType := rtEmar105; // bileterka EMAR-105

  if IsNew and(RegistrationDate = 0) then // w prypadku edycji nie zmieniamy daty rejestracji
    RegistrationDate := Now();
  if Self.ReportNumber = 0 then
    Self.ReportNumber := Self.GetNewReportNumber();
  ControlPrintsNo := 0;
{$ENDREGION ' Function''s valiables initialization'}

  if bErrorsInProcessTasks and(Status <> 1) then
  begin
    KFilePath := CFilePath;
    CFilePath := '';

    PrepareFromFile(dfSalesReportFileC);
  end;

  case FileC.FileType of
    dfSalesReportFileC,
    dfSalesReportFileK: begin
      Driver_ID := FileC.GetDriverIDFromIDNumberAndNames(ptDriver{kierowcy},
        _File.OIK.DriverNumber,
        _File.OIK.DriverFirstName,
        _File.OIK.DriverLastName);
      if Driver_ID = 0 then
        Driver_ID := FileC.GetDriverIDFromIDNumberAndNames(ptCashier{kasjer},
          _File.OIK.DriverNumber,
          _File.OIK.DriverFirstName,
          _File.OIK.DriverLastName);
      if Driver_ID = 0 then
      begin
        {$IF DEFINED(REGFILESRV) OR DEFINED(IAFILEMAKER)}
        Driver_ID := C_PERSON_ID_AUTOREGISTRATION;
        {$ELSE}
        if not aFromFile then // z karty
          Driver_ID := TTicketRegisterCard.GetDriver(dmMain, TicketRegisterCard_ID)
        else
        begin
          // jest wymagana NOT NULL wartość w RideRegisteredXBusStop.Driver_ID
          AddToDesc(RS_Emar105RegistrationDriverSelectionError);
          Exit;
        end;
        {$ENDIF}
      end;
      PersonIDNumber := _File.OIK.DriverNumber;
      FirstName := _File.OIK.DriverFirstName;
      LastName := _File.OIK.DriverLastName;
    end;
  end;

  _File.ReportEventList.BeginUpdate;

  StartDate := GetReportStartDate();
  EndDate := GetReportEndDate();

  PersonType := Ord(ptDriver){kierowcy};

  rel_01 := nil; // last calling of the event 01

  // jeżeli był znalezony błąd w przebiegu zadania lub zapisujemy plik K
  if bErrorsInProcessTasks or(Status = 1) then
    Result := True
  else
  try
    iRecord := 0;
    while iRecord < _File.ReportEventList.Count do
    begin
      rel := _File.ReportEventList.Items[iRecord];
      dmMain.SendDebugPipeMessage(#9 + Format('Event %d of %d (kind=%d)',
        [
          Succ(iRecord)
          , _File.ReportEventList.Count
          , rel.Kind
        ]));
      {$IF DEFINED(DEBUG)}
      Stopwatch := TStopwatch.StartNew;
      OutputDebugString(PChar(Format('>>>      START an object creation in the event #%d (record %d of %d): %s',
        [rel.Kind, Succ(iRecord), _File.ReportEventList.Count, FormatDateTime('hh:mm:ss.zzz', Now())])));
      {$ENDIF}

{$REGION 'omijanie błędnego rekordu'}
      if not ZnaNastRek(Self, iRecord, nil, bErrorsInProcessTasksMock, lrekTotal, True) then
      begin // ignore such record
        Inc(iRecord);
        Continue;
      end;
{$ENDREGION}

{$REGION 'wyszukiwanie błędnie wydrukowanych biletów'}
      if Assigned(fr) and _File.IsTicketRegisterEmar205(PChar(fr.FiscalLogo)) then
      begin
        if IsSimpleTicketWronglyPrinted(rel) then
        begin
          Inc(iRecord);
          Continue;
        end;
      end
{$ENDREGION}
      else // Emar-105
{$REGION 'wyszukiwanie duplikatów zwykłego biletu po zerowaniu pamięci bilterki'}
        if Assigned(fr) and IsWrongSimpleTicket(rel{, iRecord, fr.FiscalLogo}) then
        begin
          Inc(iRecord);
          Continue;
        end;
{$ENDREGION}

      case rel.Kind of
{$REGION ' 0 - Szyfr raportu i stawki PTU'}
        0: // Szyfr raportu i stawki PTU
          begin
            ReportCode := String(rel.AsEvent_00.ReportCode); // szyfr raportu (dotyczy bileterki Emar-105, odczytywany z raportu)

            if (rel.AsEvent_00.TaxRates[1] > 0)and(rel.AsEvent_00.TaxRates[2] > 0) then
            begin
              iTax1Rates := 0;
              iTax2Rates := 0;
              for j := 1 to 7 do
              begin
                case j of
                  1:
                    begin
                      iTax1Rates := _FileA80.Consts.RatePTU1_A;
                      iTax2Rates := _FileA80.Consts.RatePTU2_A;
                    end;
                  2:
                    begin
                      iTax1Rates := _FileA80.Consts.RatePTU1_B;
                      iTax2Rates := _FileA80.Consts.RatePTU2_B;
                    end;
                  3:
                    begin
                      iTax1Rates := _FileA80.Consts.RatePTU1_C;
                      iTax2Rates := _FileA80.Consts.RatePTU2_C;
                    end;
                  4:
                    begin
                      iTax1Rates := _FileA80.Consts.RatePTU1_D;
                      iTax2Rates := _FileA80.Consts.RatePTU2_D;
                    end;
                  5:
                    begin
                      iTax1Rates := _FileA80.Consts.RatePTU1_E;
                      iTax2Rates := _FileA80.Consts.RatePTU2_E;
                    end;
                  6:
                    begin
                      iTax1Rates := _FileA80.Consts.RatePTU1_F;
                      iTax2Rates := _FileA80.Consts.RatePTU2_F;
                    end;
                  7:
                    begin
                      iTax1Rates := _FileA80.Consts.RatePTU1_G;
                      iTax2Rates := _FileA80.Consts.RatePTU2_G;
                    end;
                end;

                if EmarDateToDate(_FileA80.Consts.PTU2ValidFrom) > 0 then
                begin
                  if iTax2Rates = rel.AsEvent_00.TaxRates[j] then
                    VATAmounts[j] := iTax2Rates; // StPod
                end
                else
                begin
                  if rel.AsEvent_00.TaxRatesChange = 0 then
                    VATAmounts[j] := rel.AsEvent_00.TaxRates[j] {rSzyfr.St[i]}   //E.B. 05.06.2019
                  else
                    if iTax1Rates = rel.AsEvent_00.TaxRates[j] then
                      VATAmounts[j] := iTax1Rates // StPod
                    else
                      rel.AsEvent_00.TaxRates[j] := VATAmounts[j]; // StPod
                end;
              end;
            end
            else
              for j := 1 to 7 do
                rel.AsEvent_00.TaxRates[j] := VATAmounts[j]; // StPod
//              sast := True;
          end;
{$ENDREGION}
{$REGION ' 1 - Zmiana bileterki – identyfikacja bileterki'}
        1:
          begin
            rel_01 := rel.AsEvent_01;

            lrek := rel.ReportRecordCount;
            r2ok := (lrek > 1)and not rel.AsEvent_01.IsError(reErrorPartMissing2 or reErrorCheckSum2); //(lrek>1) and SumKonOk(ir+DRe.RAP,adlrnr5[2]);
            r3ok := (lrek > 2)and not rel.AsEvent_01.IsError(reErrorPartMissing3 or reErrorCheckSum3); //(lrek>2) and SumKonOk(ir+DRe.RAP*2,adlrnr5[3]);
            r4ok := (lrek > 3)and not rel.AsEvent_01.IsError(reErrorPartMissing4 or reErrorCheckSum4); //(lrek>3) and SumKonOk(ir+DRe.RAP*3,adlrnr5[4]);
            WzZb := DajRFWlBil(rel.AsEvent_01, lrek);

            if WzZb.WersjaPSB > 4 then
            begin //E.B. 05.09.2010
              r3ok := (lrek > 2)and not rel.AsEvent_01.IsError(reErrorPartMissing3 or reErrorCheckSum3); //(lrek>2) and SumKonOk(ir+DRe.RAP*2,38);
              r4ok := (lrek > 3)and not rel.AsEvent_01.IsError(reErrorPartMissing4 or reErrorCheckSum4); //(lrek>3) and SumKonOk(ir+DRe.RAP*3,38);
            end;
            //AT: repeat ir:=ir+DRe.RAP;
            //AT: until (ir>=IxA.Ixrap) or (Arap[ir+2]=1);
            //AT: ir:=ir-DRe.RAP;
            if not r2ok or (not r3ok and not r4ok) then
            begin
              lrek := 1;
              WzZb.UszkodzonyWpis := False;
            end;
//          if r2ok and (not r3ok or not r4ok) then begin
//E.B. 10.01.2011 - jeżeli KP była włożona przy RF zamkniętym po zmianie stawek
//PTU, to stawki nie były wymieniane
            if r2ok then
            begin
              if WzZb.DataRF = 0 then
              begin   //E.B. 21.12.2014
                TestujStawkiPTU(DateToStr(EmarDateToDate(rel.EventDate)){sdat});
                TestujStawkiPTUZRF(DateToStr(EmarDateToDate(rel.EventDate)){sdat});
              end
              else begin
                TestujStawkiPTU(DateToStr(WzZb.DataRF));  //E.B. 03.01.2011
                TestujStawkiPTUZRF(DateToStr(WzZb.DataRF));  //E.B. 01.02.2011
              end;
            end
            else //E.B. 01.02.2011 - tu może być stan nieokreślony
              for i:=1 to 7 do
                StPodZRF[i] := VATAmounts[i]; // StPod
            if r3ok and not r4ok then
            begin //odtworz ptu
              j := 0;
//E.B. 01.02.2011 - wartości odtwarzane wg stawek zamknięcia RF
              for i := 1 to 7 do
              begin
                j := j + WzZb.Netto[i];
                if StPodZRF[i] <> $ffff then
                begin           //E.B. 01.02.2011
                  if StPodZRF[i] <> 20000 then
                  begin         //E.B. 01.02.2011
                    x := WzZb.Netto[i] * StPodZRF[i] / 10000;    //E.B. 01.02.2011
                    if Frac(x) >= 0.5 then
                      x := x + 0.001;
                    WzZb.Ptu[i] := Round(x);
                    j := j + WzZb.Ptu[i];
                  end
                  else
                  begin
                    WzZb.Ptu[i] := 0;
                  end;
                end
                else
                  WzZb.Ptu[i] := 0;
              end;
              WzZb.UszkodzonyWpis := (WzZb.NrRF <> $ffff)and
                                   ((WzZb.LBil > 9999)or(j <> WzZb.Brutto));
              lrek := 4;
            end
            else
              if not r3ok and r4ok then
              begin //odtworz net.
                j := 0;
//E.B. 01.02.2011 - wartości odtwarzane wg stawek zamknięcia RF
                for i := 1 to 7 do
                begin
                  j := j + WzZb.Ptu[i];
                  if WzZb.Ptu[i] > 0 then
                  begin
                    x := WzZb.Ptu[i] * 10000 / StPodZRF[i];      //E.B. 01.02.2011
                    if Frac(x) <= 0.5 then
                      x := x - 0.001;
                    WzZb.Netto[i] := Round(x);
                    j := j + WzZb.Netto[i];
                  end
                  else
                    WzZb.Netto[i] := 0;
                end;
                WzZb.UszkodzonyWpis := (WzZb.NrRF <> $ffff)and
                                     ((WzZb.LBil > 9999)or(j <> WzZb.Brutto));
              end;

            wlaczeniezasilania := True;
            PowerOnNo := PowerOnNo + 1; // Liczba włączeń zasilania

            if EMAR205 <> _File.IsTicketRegisterEmar205(rel.AsEvent_01.TicketRegister) then
              fr := nil;
            EMAR205 := EMAR205 and _File.IsTicketRegisterEmar205(rel.AsEvent_01.TicketRegister);

            if (rel.AsEvent_01.FiscalReportNumber = High(Word))
              or
              (rel.AsEvent_01.FiscalReportNumber = 0) // ufiskalniona
              and(rel.AsEvent_01.FiscalReportState = frsClose) then
              bnrrf := -DayOf(EmarDateToDate(rel.EventDate)) // !!! set NrRF = Minus Day
            else
            begin
              if rel.AsEvent_01.FiscalReportState = frsClose then
                bnrrf := rel.AsEvent_01.FiscalReportNumber
              else
                bnrrf := rel.AsEvent_01.FiscalReportNumber + 1;
            end;

            if bnrrf = 1 then
              dCurrentFiscalizationDate := Trunc(EmarDateTimeToDateTime(rel.AsEvent_01.FiscalReportDate, rel.AsEvent_01.FiscalReportTime))
            else
              dCurrentFiscalizationDate := 0;


            // uszkodzony wpis
            if (lrek < 4)
              or(rel.AsEvent_01.FiscalReportDate ='')and(rel.AsEvent_01.FiscalReportTime = '')
              or(EmarDateTimeToDateTime(rel.AsEvent_01.FiscalReportDate, rel.AsEvent_01.FiscalReportTime) = 0)
              or WzZb.UszkodzonyWpis then
            begin
              // niepełny wpis identyfikacji bileterki lub brak daty otwarcia RF
              if not WzZb.UszkodzonyWpis then
              begin
                if (rel.AsEvent_01.FiscalReportDate <> '')
                  and(rel.AsEvent_01.FiscalReportTime <> '')
                  and(
                    (EmarDateTimeToDateTime(rel.AsEvent_01.FiscalReportDate, rel.AsEvent_01.FiscalReportTime) < EMAR105ReportsBeginDate)
                    or(EmarDateTimeToDateTime(rel.AsEvent_01.FiscalReportDate, rel.AsEvent_01.FiscalReportTime) >
                      EmarDateTimeToDateTime(rel.AsEvent_01.EventDate, rel.AsEvent_01.EventTime))
                     ) then
                begin
//                  rel.AsEvent_01.FiscalReportDate := rel.AsEvent_01.EventDate;  // data operacji
//                  rel.AsEvent_01.FiscalReportTime := rel.AsEvent_01.EventTime;
//                  WzZb.DataRF := dat;  // data operacji
//                  WzZb.UszkodzonyWpis := True;  // ignorować wpis!!!!
//                  AddLine(23, C_TXT_PARTIALLY_USHERETTE_IDENTYFICATION_WRITE);
//                  AddLine(1, C_TXT_DASH_INCORRECT_DATA);
//                  OutputLine(re, clError, fsRegular);
//                  AddLine(23, C_TXT_USHERETTE_RAM_DISRUPTION);
//                  OutputLine(re, clError, fsRegular);
                end
                else
                begin
                  if rel.AsEvent_01.FiscalReportState = frsOpen then
                  begin //otwarty rf
                    // AT: ZapisOtwarciaRF(irkb);     //weryfikacja stawek????????????
                    if bnrrf = 1 then
                      dCurrentFiscalizationDate := Trunc(EmarDateTimeToDateTime(rel.AsEvent_01.FiscalReportDate, rel.AsEvent_01.FiscalReportTime))
                    else
                      dCurrentFiscalizationDate := 0;
                    fr := ZapisOtwarciaRF(rel.AsEvent_01.TicketRegister, bnrrf, dCurrentFiscalizationDate);
//                    if irkor > 0 then
//                      AddLine(23, C_TXT_CORRECTION_NONE_USHERETTE_IDENTYFICATION)
//                    else
                      if bnrrf > 0 then
                      begin
//                        AddLine(23, C_TXT_FISCAL_REPORT_NUMBER);
//                        AddLine(1, IntToStr(bnrrf) + '  ' + C_TXT_OPENED);
                        otwrfdat := True;      //E.B. 05.11.2018
                      end;
                  end
                  else //zamkniety rf
                  begin
                    if bilufisk then
                    begin   // ufiskalniona
//                      if bnrrf = 0 then
//                        bnrrf := -DayOf(EmarDateToDate(rel.EventDate)); // !!! set NrRF = Minus Day
//                      AddLine(23, C_TXT_LAST_FISCAL_REPORT_NUMBER);
//                      AddLine(1, IntToStr(WzZb.NrRF) + '  ' + C_TXT_CLOSED);
                    end
                    else
                    begin
//                      AddLine(23, C_TXT_CLOSED_NON_FISCAL_REPORT);
                    end;
                    otwrfdat := False;        //E.B. 05.11.2018
                  end;
//                  OutputLine(re, clRegular, fsRegular);
//                  AddLine(23, C_TXT_PARTIALLY_USHERETTE_IDENTYFICATION_WRITE);
//                  if lrek = 4 then
//                    AddLine(1, C_TXT_DASH_INCORRECT_FISCAL_REPORT_DATE);
//                  OutputLine(re, clError, fsRegular);
                end;
              end
              else
              begin
                if (EmarDateToDate(rel.AsEvent_01.FiscalReportDate) < EMAR105ReportsBeginDate)
                  or(EmarDateToDate(rel.AsEvent_01.FiscalReportDate) > EmarDateToDate(rel.AsEvent_01.EventDate)) then
                begin
//                  rel.AsEvent_01.FiscalReportDate := rel.AsEvent_01.EventDate; // data operacji
//                  rel.AsEvent_01.FiscalReportTime := rel.AsEvent_01.EventTime; // data operacji
                end
                else
                begin
                  if rel.AsEvent_01.FiscalReportState = frsOpen then // otwarty rf
                  begin
                    // AT: ZapisOtwarciaRF(irkb);
                    if bnrrf = 1 then
                      dCurrentFiscalizationDate := Trunc(EmarDateTimeToDateTime(rel.AsEvent_01.FiscalReportDate, rel.AsEvent_01.FiscalReportTime))
                    else
                      dCurrentFiscalizationDate := 0;
                    fr := ZapisOtwarciaRF(rel.AsEvent_01.TicketRegister, bnrrf, dCurrentFiscalizationDate);
//                    if irkor > 0 then
//                      AddLine(23, C_TXT_CORRECTION_NONE_USHERETTE_IDENTYFICATION)
//                    else
//                      if bnrrf > 0 then
//                      begin
//                        AddLine(23, C_TXT_FISCAL_REPORT_NUMBER);
//                        AddLine(1, IntToStr(bnrrf) + '  ' + C_TXT_OPENED);
//                      end;
                  end
                  else //zamkniety rf
                    if bilufisk then
                    begin   // ufiskalniona
