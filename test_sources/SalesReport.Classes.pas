            TicketGross := TicketGross + Integer(rel.AsEvent_16.TicketPrice) * Integer(rel.AsEvent_16.BaggageCount); // Wartość biletów brutto [gr]
            TicketValue := TicketValue + Integer(rel.AsEvent_16.PaidAmound) * rel.AsEvent_16.BaggageCount; // Kwota zapłacona za bilety [gr]
            PassangerNo := PassangerNo + rel.AsEvent_16.BaggageCount; // Liczba pasażerów (do sprzedanych bietów): uwaga przy rejestracji należy również uzupełniać tabelę SLS_RideRegistration odpowiednimi danymi
            TicketNo := TicketNo + 1; // Liczba biletów (musi dokładnie odpowiadać liczbie rekordów w SLS_Ticket)

            t.SaleDate := EmarDateTimeToDateTime(rel.AsEvent_16.EventDate, rel.AsEvent_16.EventTime); // data i godzina sprzedaży biletu
            t.SaleYear := YearOf(t.SaleDate); // Rok sprzedaży (Rok z SaleDate)
            t.SaleMonth := MonthOf(t.SaleDate); // Miesiąc sprzedaży (misiąc z SaleDate)
            t.Company_ID := LicencesCompanyID; // Firma – sprzedawca biletu
            //t.CompanyRide_ID := LastRideCompanyID; // firma właściciel kursu/towaru/usługi/przewozu zleconego/autobusu, itp., jeśli sprzedaż jest na kurs obcy (dotyczy biletów jednorazowych; okresowe – SLS_TicketXCompany); dla biletów rejestowanych z bileterek - NULL
            t.TicketType.ReadFromDatabase(Integer(ttvBiletJednorazowy));
            t.TicketType_ID := t.TicketType.Id; // Rodzaj sprzedaży/rejestracji
            //t.MonthTicketSaleOnBus := ; // 1- sprzedaż biletu na nowy okres w autobusie. wpp. – nie. Dotyczy tylko biletów em-kartowych okresowych/miesięcznych. Jeśli nastąpiło przedłużenie ważności biletu w autobusie lub sprzedaż biletu na nowy okres w autobusie, konieczne jest uzupełnienie SLS_EmCardXPassanger (aktualny bilet, a także wzór biletu, wydanie/zwrot EM-Karty) oraz SLS_Em
            //t.MonthTicketType := ; // Rodzaj biletu miesięcznego: 0-na kurs, 1-na relację, 2-w zakresie godzin. Dotyczy to również biletów jednorazowych sprzedanych w kasie dworcowej. Bilet sieciowy ma wpisaną wartość 1
            t.TicketGenre.ReadFromDatabase(Integer(tgvBagazowy));
            t.TicketGenre_ID := t.TicketGenre.Id; // Rodzaj biletu: 1-normalny, 2-ulgowy, 3-szkolny, 4-bagażowy, 5-pracowniczy normalny, 6-pracowniczy ulgowy, NULL- nie bilet
            //t.TicketLayout_ID := ; // wygląd biletu na wydruku na wydruku (predefiniowane wartości), np. marginesy, odstępy, itp. Na podstawie szablonów określonych typów (kolumna [Type]: 1-bilety jednorazowe, 2-bilety okresowe, 3-inne) W kolumnie [Layout] xml z wyglądem biletu. [Name] – nazwa. Sprzedaż własna
            //t.MonthTicketPriceComputingType_ID := ; // Sposób obliczania ceny biletu: [Name] – nazwa, [ReadOnly] – tylko do odczytu, [CompMethod] – schemat obliczania ceny. Można będzie skopiować metodę i ją zmodyfikować (dotyczy biletów okresowych). Sprzedaż własna
            //t.TicketNumberBM := ; // symbol literowy oznaczający serię biletów/paragonów wydrukowanych na danej bileterece + 9 cyfr uzupełnione zerami – kolejne liczby. Do rejestracji z BM oraz sprzedaży własnej [NRBILETU]. Uwaga: przy sprzedaży na kolejny okres kopiowany jest stary numer biletu i wymieniane są 2 pierwsze cyfry po literze na kolejne: 00, 01, 02, .. 63. To musi zrobić funkcja rejestrująca! Z bileterki EMAR jest stary numer.
            t.TicketNumber := rel.AsEvent_16._TicketNumberUsedHighPart; // numer paragonu fiskalnego (z urządzenia fiskalnego)
            t.PrintNumber := rel.AsEvent_16.DocumentNumber; // numer wydruku (z urządzenia fiskalnego) – każdy kolejny wydruk
            t.ControlNumber := rel.AsEvent_16.TicketCode; // Kod kontrolny biletu (skrót) (z urządzenia fiskalnego)
            //t.EPNumber := ; // numer biletu z E-Podróżnika
            //t.EPCode := ; // szyfr biletu z E-Podróżnika lub szyfr biletu ze sprzedaży w kasach stacjonarnych lub bileterki EMAR
            //t.EPDynamic := ; // 1 – bilet sprzedany w taryfie dynamicznej wpp. – taryfa niedynamiczna
            t.ValidFrom := StrToDate(rel.AsEvent_16.EventDate); // ??? // od kiedy ważny bilet; dla biletów jednorazowych – data ważności biletu
            t.ValidTo := StrToDate(rel.AsEvent_16.EventDate);   // ??? // do kiedy ważny bilet; dla biletów jednorazowych – data ważności biletu
            t.TimeFrom := FloatToDateTime(getIBusStopDepartureTime(
                getIRideRouteIndexFromBusStopRideNo(LastEmarIndexOfRide, rel.AsEvent_16.BusStopStart), LastEmarIndexOfRide) / C_MinutesPerDay); // od której godziny ważny bilet (bilety jednorazowe – godzina odjazdu)
            t.TimeTo := FloatToDateTime(getIBusStopArrivalTime(
                getIRideRouteIndexFromBusStopRideNo(LastEmarIndexOfRide, rel.AsEvent_16.BusStopEnd), LastEmarIndexOfRide) / C_MinutesPerDay); // do której godziny ważny bilet (bilety jednorazowe – godzina przyjazdu)
            t.FarePriceReduction_ID := 0; // NULL – bilet normalny, wpp. bilet ulgowy
            //t.ReductionName := ; // nazwa ulgi (dla biletu ulgowego)
            //t.ReductionPercentage := ; // procent ulgi
            t.ReductionRefund := 0; // ??? // 0- bez dopłaty do ulgi, 1- dopłata do ulgi – ulga ustawowa; (do zestawienia biletów do dopłat), 2- sejm, 3- senat, 4- inne
            //t.FarePrice_ID := ; // cena biletu (taryfa pasażerska normalna lub z ulgą kwotową / bagażowa / miesięczna) – informacyjnie
            //t.FarePriceAdditionalFee_ID := ; // cena taryfy opłaty manipulacyjnej – informacyjnie
            //t.FarePriceDiscount_ID := ; // cena taryfy bonifikaty – informacyjnie
            t.PassangerNumber := rel.AsEvent_16.BaggageCount; // liczba pasażerów (1 lub więcej jeśli kilka biletów na jednym blankiecie), NULL – nie dotyczy (np. paragony). UWAGA: Jeśli zwrot biletu – liczba pasażerów – ujemna

            //t.AdditionalFeeCharge := ; // kwota opłaty manipulacyjnej [gr] (zawsze 1 opłata dla całego biletu – doliczana na końcu), NULL – nie dotyczy (np. paragony). Dotyczy tylko biletów jednorazowych

            if Assigned(LastEmarRide) then
            begin
              LastEmarRide.DajCenBag(
                t.SaleDate,
                getTicketRegisterFirmwareVersionByte(EMAR205, rel_01, rel_41),
                rel.AsEvent_16.BusStopStart,
                rel.AsEvent_16.BusStopEnd,
                rel.AsEvent_16.BaggageCount,
                rel.AsEvent_16.TicketPrice,
                @RTicketPrice);
            end
            else
            begin
              AddToDesc(C_TXT_ERR_RIDE_NOT_DEFINED, True);
              Exit;
            end;
            if RTicketPrice.Brutto[0] = Integer(rel.AsEvent_16.TicketPrice) then
              SetTicketPrices(t, RTicketPrice)
            else // cena nie zgadza się
              SetTicketPricesWhenIncorrect(t, RTicketPrice
                , rel.AsEvent_16.TicketPrice
                , rel.AsEvent_16.PaidAmound);

            //t.AdditionalFeeChargeAbroad := ; // kwota opłaty manipulacyjnej [gr] (zawsze 1 opłata dla całego biletu – doliczana na końcu), NULL – nie dotyczy (np. paragony). Dotyczy tylko biletów jednorazowych. Odcinek zagraniczny

            t.PriceSum := t.Price + t.PriceAbroad; // kwota brutto biletu =[Price] + [PriceAbroad]. jeśli paragon – wartość paragonu brutto.
            t.EmployeeTicket := 0; // Obliczanie ceny do zapłaty: (dla wszystkich biletów niepracowniczych – 0). 0-zapis pełnej wartości, 1-zapis wartości PTU (dla biletów pracowniczych), 2-nic (do zapłaty=0) (dla biletów pracowniczych)
            t.AmountToPay := rel.AsEvent_16.PaidAmound; // kwota do zapłaty [gr] – inna w przypadku np. biletu pracowniczego; dla pozostałych AmountToPay=PriceSum
            // start: waluta
            if LastEmarIndexOfCurrency <> rel.AsEvent_16.IndexOfCurrency then
              LastEmarIndexOfCurrency := rel.AsEvent_16.IndexOfCurrency;
            t.Currency_ID := DefaultCurrencyID; // waluta ewidencyjna
            t.ExchangeRate := LastCurrencyExchangeRate;
            // end: waluta
            if LastEmarIndexOfPaymentType <> rel.AsEvent_16.IndexOfPayType then
              LastEmarIndexOfPaymentType := rel.AsEvent_16.IndexOfPayType;
//            t.PaymentType.ReadFromDatabase(LastPaymentTypeID);
//            t.PaymentType_Id := t.PaymentType.Id; // sposób płatności – predefiniowane wartości: 1-gotówka, 2-przelew, 3-karta płatnicza, 4-czek, 5-bon
            SetTicketPaymentType(rel.AsEvent_16, t);
            t.BuyerNIP := rel.AsEvent_16._BuyerNIP; // NIP nabywcy

            {$REGION 'TicketRoute'}
            TicketRoute := t.AddTicketRouteDisposable;
            if LastRideID > 0 then
              TicketRoute.Ride_ID := LastRideID;

            TicketRoute.CompanyOwner_ID := LastRideCompanyID; // firma właściciel kursu/towaru/usługi/przewozu zleconego/autobusu, itp., jeśli sprzedaż jest na kurs obcy (dotyczy biletów jednorazowych; okresowe – SLS_TicketXCompany); dla biletów rejestowanych z bileterek - NULL

            TicketRoute.RideRegistered := RideRegisteredList.GetLastRideRegistered; // just a pointer to the object
            TicketRoute.RoadDistance :=
              getIBusStopDistance(
                getIRideRouteIndexFromBusStopRideNo(LastEmarIndexOfRide, rel.AsEvent_16.BusStopStart),
                getIRideRouteIndexFromBusStopRideNo(LastEmarIndexOfRide, rel.AsEvent_16.BusStopEnd),
                False);
            TicketRoute.TarifDistance :=
              getIBusStopDistance(
                getIRideRouteIndexFromBusStopRideNo(LastEmarIndexOfRide, rel.AsEvent_16.BusStopStart),
                getIRideRouteIndexFromBusStopRideNo(LastEmarIndexOfRide, rel.AsEvent_16.BusStopEnd),
                True);
            TicketRoute.NameFrom := getIBusStopName(LastEmarIndexOfRide, rel.AsEvent_16.BusStopStart, True);
            TicketRoute.NameTo := getIBusStopName(LastEmarIndexOfRide, rel.AsEvent_16.BusStopEnd, True);
            TicketRoute.BusStopNoFrom := getIBusStopNoInLine(LastEmarIndexOfRide, rel.AsEvent_16.BusStopStart); // w trasie linii
            TicketRoute.BusStopNoTo := getIBusStopNoInLine(LastEmarIndexOfRide, rel.AsEvent_16.BusStopEnd);  // w trasie linii
            TicketRoute.BusStopCodeFrom := getIBusStopCode(LastEmarIndexOfRide, rel.AsEvent_16.BusStopStart);
            TicketRoute.BusStopCodeTo := getIBusStopCode(LastEmarIndexOfRide, rel.AsEvent_16.BusStopEnd);
            TicketRoute.DepartureTime := TimeToStr(
              getIBusStopDepartureTime(getIRideRouteIndexFromBusStopRideNo(LastEmarIndexOfRide, rel.AsEvent_16.BusStopStart), LastEmarIndexOfRide) / C_MinutesPerDay);
            TicketRoute.ArrivalTime := TimeToStr(
              getIBusStopArrivalTime(getIRideRouteIndexFromBusStopRideNo(LastEmarIndexOfRide, rel.AsEvent_16.BusStopEnd), LastEmarIndexOfRide) / C_MinutesPerDay);
            if TicketRoute.Ride_ID > 0 then
            begin
              if not Assigned(Ride) then
                Ride := TRide.Create;
              if Ride.Id <> TicketRoute.Ride_ID then
                Ride.ReadFromDatabase(-TicketRoute.Ride_ID); // read withour RouteSchema, otherwise iAutServer became freezes

              RoutePoint := Ride.FirstPoint;
              if Assigned(RoutePoint) then
                TicketRoute.BusStandNumberDeparture := RoutePoint.BusStopStandName;
              RoutePoint := Ride.LastPoint;
              if Assigned(RoutePoint) then
                TicketRoute.BusStandNumberArrival := RoutePoint.BusStopStandName;
            end
            else
            begin
//                    FreeAndNil(TicketRoute);
//                    raise Exception.CreateFmt(SALES_REPORT_MSG_ROUTE_NOT_EXISTS,
//                      [
//                        _FileA80.CompanyList.Items[_Emar_Ride.CompanyIndex].Name,
//                        _Emar_Ride.Number,
//                        String(_Emar_Ride.Version),
//                        String(_Emar_Ride.ValidFrom)
//                      ]);
            end;
            {$ENDREGION}

            {$REGION 'TicketXCompany'}
            t.AddTicketXCompanyDisposable;
            {$ENDREGION}
          end;
{$ENDREGION}
{$REGION '17 - Rejestracja przejazdu z biletem okresowym (karta MIFARE)'}
        17:
          begin
            if pominR17 then
            begin
              popnr := rel.AsEvent_17.Kind;
              Inc(iRecord);
              Continue;
            end;
            pominR17 := False;

            if IgnoreEvent17(rel.AsEvent_17, LastEmarIndexOfRide) then
            begin
              Inc(iRecord);
              Continue;
            end;

            przedluzenie := (rel.AsEvent_17.TicketNewValidTo <> '')and(EmarDateToDate(rel.AsEvent_17.TicketNewValidTo) <> 0);
            iEmCard_ID := GetTempEmCardID(FillEmCardRecord(rel.AsEvent_17));
            iSaleCompany_ID := GetCompanyID(rel.AsEvent_17.SaleCompany, Integer(kocPrzewoznik));
            iFarePriceReductionList :=
                GetMonthTicketReductionIndex(
                  _FileA80
                  , LastEmarRide
                  , rel.AsEvent_17);
            if iFarePriceReductionList > -1 then
            begin
              iFarePriceReduction_ID := GetTempFarePriceReductionID(
                  rel
                  , LastRideCompanyID
                ); // NULL – bilet normalny, wpp. bilet ulgowy
              // NULL też może być kiedy ulga nie została znalezioną
            end
            else
              iFarePriceReduction_ID := 0;
            iEmCardFirstTicket_ID :=
              TTicket.GetFirstTicketId(
                dmMain
                , iSaleCompany_ID
                , iFarePriceReduction_ID
                , EmarDateToDate(rel.AsEvent_17.TicketValidFrom)
                , EmarDateToDate(rel.AsEvent_17.TicketValidTo)
                , rel.AsEvent_17.TicketNumber);

            EmCardXPassangerRecording := TEmCardXPassangerRecording.Create(Self);
            try
              EmCardXPassangerRecording.CardNumber := rel.AsEvent_17.CardNumber;
              EmCardXPassangerRecording.Driver_ID := Driver_ID; // dla rejestracji na kursie = NULL
  //              EmCardXPassangerRecording.HTTPUser_ID := THttpUser.IdFromLogin(CurrentUser.Login, dmMain);
              EmCardXPassangerRecording.RecordingType := 2; // 2- rejestracja na kursie
              if Assigned(LastEmarRide) then
              begin
                EmCardXPassangerRecording.RideRegistered := RideRegisteredList.GetLastRideRegistered(); // just a pointer to the object
                EmCardXPassangerRecording.RideNumber := IntToStr(EmCardXPassangerRecording.RideRegistered.RideNumber);
                EmCardXPassangerRecording.RideDate := EmarDateTimeToDateTime(rel.AsEvent_17.EventDate, rel.AsEvent_17.EventTime); // Data i godzina zarejestrowania przejazdu w bileterce (data wykonania operacji w bileterce).
                // (DPA) zadanie 57699
                // wg dokumentacji SLS_EmCardXPassangerRecording.docx
                // to pole ma być zawsze NULL
                EmCardXPassangerRecording.RideValue := 0; // rel.AsEvent_17.TicketPrice;
                EmCardXPassangerRecording.RideDistance :=
                  getIBusStopDistance(
                    getIRideRouteIndexFromBusStopRideNo(LastEmarIndexOfRide, rel.AsEvent_17.BusStopStart),
                    getIRideRouteIndexFromBusStopRideNo(LastEmarIndexOfRide, rel.AsEvent_17.BusStopEnd),
                    false);
                iBusStop := getIBusStop(LastEmarIndexOfRide, rel.AsEvent_17.BusStopStart);
                EmCardXPassangerRecording.StartBusStopName := iBusStop.Name;
                EmCardXPassangerRecording.StartBusStopCode := integer(iBusStop.Code);
                EmCardXPassangerRecording.StartBusStopNo := getIBusStopNoInLine(LastEmarIndexOfRide, rel.AsEvent_17.BusStopStart);
                EmCardXPassangerRecording.StartBusStop_ID := GetBusStopID(integer(iBusStop.Code), Company_ID);
                iBusStop := getIBusStop(LastEmarIndexOfRide, rel.AsEvent_17.BusStopEnd);
                EmCardXPassangerRecording.EndBusStopName := iBusStop.Name;
                EmCardXPassangerRecording.EndBusStopCode := integer(iBusStop.Code);
                EmCardXPassangerRecording.EndBusStopNo := getIBusStopNoInLine(LastEmarIndexOfRide, rel.AsEvent_17.BusStopEnd);
                EmCardXPassangerRecording.EndBusStop_ID := GetBusStopID(integer(iBusStop.Code), Company_ID);
              end;

              EmCardXPassangerRecording.EmCard.Id := iEmCard_ID;
              EmCardXPassangerRecording.EmCard.Changed := False;

              if rel.AsEvent_17.ReduceType = 4 then // bilet pracowniczy
              begin
                if rel.AsEvent_17.ReduceCode = 0 then // nie ulgowy
                  EmCardXPassangerRecording.TicketGenre_ID := Integer(tgvPracowniczyNormalny)
                else
                  EmCardXPassangerRecording.TicketGenre_ID := Integer(tgvPracowniczyUlgowy);
              end
              else
                if rel.AsEvent_17.ReduceType = 5 then
                  EmCardXPassangerRecording.TicketGenre_ID := Integer(tgvPracowniczyUlgowy) //RodzBil := 6
                else
                  if rel.AsEvent_17.TicketType = 4 then // szkolny
                    EmCardXPassangerRecording.TicketGenre_ID := Integer(tgvSzkolny)
                  else
                    if rel.AsEvent_17.ReduceType in [1, 2] // 1-ustawowa, 2-handlowa
                    then
                      EmCardXPassangerRecording.TicketGenre_ID := Integer(tgvUlgowy)
                    else // 1-okresowy, 3-miesięczny, 6-okresowy na zadaną liczbę przejazdów (wieloprzejazdowy)
                      EmCardXPassangerRecording.TicketGenre_ID := Integer(tgvNormalny);

              EmCardXPassangerRecording.TicketSaleDate := EmarDateTimeToDateTime(rel.AsEvent_17.TicketSaleDate, rel.AsEvent_17.TicketSaleTime);
              if iSaleCompany_ID = LicencesCompanyID then
              begin
                if
                  (rel.AsEvent_17.ExtCode = 2) // sprzedaż w autobusie
                  and(EmarDateToDate(rel.AsEvent_17.EventDate, False) >= EmarDateToDate(rel.AsEvent_17.TicketNewValidFrom, False))
                then
                begin // ważny jest bilet na okres przed zakupem bieżącego przedłużenia w autobusie
                  EmCardXPassangerRecording.TicketValidFrom := EmarDateToDate(rel.AsEvent_17.TicketNewValidFrom, False);
                  EmCardXPassangerRecording.TicketValidTo := EmarDateToDate(rel.AsEvent_17.TicketNewValidTo, False);
                end
                else
                begin
                  EmCardXPassangerRecording.TicketValidFrom := EmarDateToDate(rel.AsEvent_17.TicketValidFrom, False);
                  EmCardXPassangerRecording.TicketValidTo := EmarDateToDate(rel.AsEvent_17.TicketValidTo, False);
                end;
              end
              else
              begin
                EmCardXPassangerRecording.TicketValidFrom := EmarDateToDate(rel.AsEvent_17.TicketValidFrom, False);
                EmCardXPassangerRecording.TicketValidTo := EmarDateToDate(rel.AsEvent_17.TicketValidTo, False);
              end;
              // DPA: zadanie 57699 - zmiana w dokumentacji (logo bileterki zapisane na karcie)
              // i odczytano w zdarzeniu
              EmCardXPassangerRecording.TicketRegisterLogo := String(rel.AsEvent_17.TicketRegister);
              if not(rel.AsEvent_17.ExtCode in [$FF, 2, 3]) // sprzedaż lub przedłużenie biletu wieloprzejazdowego - poprzedzone zdarzeniami 32 lub 35; $FF - gdy ważność biletu NIE została przedłużona w bileterce autobusowej
              then
              begin
                EmCardTicketProlonging := TEmCardTicketProlonging.Create;
                try
                  iEmCardTicketProlongingID_Card :=
                    TEmCardTicketProlonging.IdForPeriod(
                      dmMain
                      , iEmCardFirstTicket_ID // powinien być wcześniej znalezony
                      , EmarDateToDate(rel.AsEvent_17.TicketNewValidFrom)
                      , EmarDateToDate(rel.AsEvent_17.TicketNewValidTo)
                      );
                  if (iEmCardTicketProlongingID_Card > 0)and(EmCardTicketProlonging.ReadFromDatabase(iEmCardTicketProlongingID_Card)) then
                    EmCardXPassangerRecording.TicketNumberBM := EmCardTicketProlonging.TicketNumberBM
                  else
                    EmCardXPassangerRecording.TicketNumberBM := String(rel.AsEvent_17.TicketNumber);
                finally
                  FreeAndNil(EmCardTicketProlonging);
                end;
              end
              else
                EmCardXPassangerRecording.TicketNumberBM := String(rel.AsEvent_17.TicketNumber);
              EmCardXPassangerRecording.TicketRelBilRej := rel.AsEvent_17.RideTicketRelation; // ??? może TicketRelations

              EmCardXPassangerRecording.PassangerNumber := 1; // TODO 1: Check this ???

              if rel.AsEvent_17.ReduceCode <> $FF then
                EmCardXPassangerRecording.ReductionCode := rel.AsEvent_17.ReduceCode;
              if iFarePriceReductionList > -1 then
              begin
                EmCardXPassangerRecording.ReductionNumber := _FileA80.MonthTicketReductionList.Items[iFarePriceReductionList].ReductionNumber;
                EmCardXPassangerRecording.FarePriceReductionGroup_ID :=
                  TDBFPriceReduction.GroupIdFromGRUPA(
                    _FileA80.MonthTicketReductionList.Items[iFarePriceReductionList].ReductionGroup
                    , TTicketTypeValues(rel.AsEvent_17.TicketType)
                    );

                EmCardXPassangerRecording.Reduction_ID :=
                  GetTempFarePriceReductionID(
                    rel
                    , LastRideCompanyID
                  ); // NULL – bilet normalny, wpp. bilet ulgowy
              end;

              {
                Jeżeli przy rejestracji przejazdu wystąpi błąd,
                a następnie zostanie zarejestrowany kolejny przejazd z tej samej EM-karty,
                to jeden z tych przejazdów powinien zostać zapisany jako błędny -
                nie powinny być wykazane dwa przejazdy pasażera z danę EM-kartą na jednym kursie
              }
              if
                (iRecord + 2 <= Pred(_File.ReportEventList.Count))
                and(_File.ReportEventList[iRecord + 1].Kind in [33, 34])
                and(String(_File.ReportEventList[iRecord + 1].EventDate) = String(rel.EventDate))
                and(String(_File.ReportEventList[iRecord + 1].EventTime) = String(rel.EventTime))
                and(_File.ReportEventList[iRecord + 2].Kind = rel.Kind)
              then
              begin
                if _File.ReportEventList[iRecord + 1].Kind = 33 then
                  EmCardXPassangerRecording.ErrorCode := _File.ReportEventList[iRecord + 1].AsEvent_33.ErrorCode
                else
                  EmCardXPassangerRecording.ErrorCode := _File.ReportEventList[iRecord + 1].AsEvent_34.ErrorCode;
              end
              else
