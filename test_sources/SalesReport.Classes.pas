            + Format('%-8s', [String(ADD_File.CurrencyExchangeList[i].Currency)])
            + Format('%3d', [ADD_File.CurrencyExchangeList[i].CountOfUnits])
            + '   ' + Format('%9.6f %7.4f  %9.6f',
              [
                ADD_File.CurrencyExchangeList[i].ExchangeRateOfPLN / 1000000
                , ADD_File.CurrencyExchangeList[i].ExchangeRate / 10000
                , ADD_File.CurrencyExchangeList[i].ExchangeRateOfCurrency / 1000000
