// Returns ID of the payment type by its Index in the file
class function TSalesReport.GetPaymentTypeID(AdmMain: TdmMain;
  const AEmarBaseFile, AEmarA80BaseFile: IEmar_BaseFile;
  AEmarIndexOfPayType: Integer): Integer;
begin
  Result := 0;
  if AEmarBaseFile.IsReportEvent41 or AEmarBaseFile.IsEmar205OnlineReport() then // Emar-205
  begin
    if (AEmarIndexOfPayType > 0)
      and(AEmarIndexOfPayType <= AEmarA80BaseFile.PaymentTypeList.Count) then
      Result := TPayments.IdFromName(String(AEmarA80BaseFile.PaymentTypeList[AEmarIndexOfPayType - 1].PaymentType), AdmMain);
  end
  else
  begin
    if AEmarIndexOfPayType > 0 then                                          //E.B. 19.01.2017
      if AEmarIndexOfPayType <= AEmarA80BaseFile.PaymentTypeList.Count then
        Result := TPayments.IdFromName(String(AEmarA80BaseFile.PaymentTypeList[AEmarIndexOfPayType - 1].PaymentType), AdmMain)
      else
        Result := 3; // KARTA PŁATNICZA
  end;
  if Result = 0 then
    Result := TPayments.DefaultPaymentId; // by default
end;

function TSalesReport.GetCompanyID(AINumber, ACompanyKind: Integer): Integer;
var
  companyRecord: TCompanyRecordKey;
begin
  companyRecord.INumber := AINumber;
  companyRecord.Kind := ACompanyKind;
  if not fTempCompanyList.ContainsKey(companyRecord) then
  begin
    Result := TCustomCompany.IdFromINumber(AINumber, ACompanyKind, dmMain);
    if Result > 0 then
      fTempCompanyList.Add(companyRecord, Result);
  end
  else
    if not fTempCompanyList.TryGetValue(companyRecord, Result) then
      Result := 0;
end;

function TSalesReport.GetBusStopID(ABusStopCode, ACompanyId: Integer): Integer;
var
  busStopRecord: TBusStopRecord;
begin
  busStopRecord.BusStopCode := ABusStopCode;
  busStopRecord.CompanyId := ACompanyId;
  if not FTempBusStopList.ContainsKey(busStopRecord) then
  begin
    Result := TBusStop.IdFromCodeAndCompanyId(ABusStopCode, ACompanyId, dmMain);
    if Result > 0 then
      FTempBusStopList.Add(busStopRecord, Result);
  end
  else
    if not FTempBusStopList.TryGetValue(busStopRecord, Result) then
      Result := 0;
end;

