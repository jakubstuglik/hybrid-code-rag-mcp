function TSalesReportEmar105.WriteToDatabaseRequestedData(): Boolean;
var
  r2ok, r3ok: Boolean;
  iRecord, lrek: Integer;
  dCurrentFiscalizationDate: TDate;
  rel: IEmar_ReportEvent;
begin
  Result := True;

  EMAR205 := False;
  if Assigned(_File) then
  begin
    iRecord := 0;
    while Result and(iRecord < _File.ReportEventList.Count) do
    begin
      rel := _File.ReportEventList.Items[iRecord];

      case rel.Kind of
        1: // Zmiana bileterki – identyfikacja bileterki
          begin
            EMAR205 := EMAR205 and _File.IsTicketRegisterEmar205(rel.AsEvent_01.TicketRegister);
            if not EMAR205{_File.IsReportEvent41} then // nie Emar-205
            begin
              if rel.AsEvent_01.FiscalReportNumber = 1 then
                dCurrentFiscalizationDate := Trunc(EmarDateTimeToDateTime(rel.AsEvent_01.FiscalReportDate, rel.AsEvent_01.FiscalReportTime))
              else
                dCurrentFiscalizationDate := 0;
              Result := Result and
                (GetTempTicketRegisterID(rel.AsEvent_01.TicketRegister, dCurrentFiscalizationDate, EMAR205, rel.AsEvent_01.FiscalReportNumber <> High(Word), '', '') > 0);
            end;
          end;
        2: // 'Otwarcie raportu fiskalnego'
          begin
            // pierwszy raport sprzedażowy (fiskalny) z tej bileterki
            if rel.AsEvent_02.NewFiscalReportNumber = 1 then
              dCurrentFiscalizationDate := Trunc(EmarDateTimeToDateTime(rel.AsEvent_02.EventDate, rel.AsEvent_02.EventTime))
            else
              dCurrentFiscalizationDate := 0;
            Result := Result and
              (GetTempTicketRegisterID(rel.AsEvent_02.TicketRegister, dCurrentFiscalizationDate, EMAR205, rel.AsEvent_02.FiscalReportState <> 0, '', '') > 0);
          end;
        5: // 'Zamknięcie raportu fiskalnego'
          begin
            // pierwszy raport sprzedażowy (fiskalny) z tej bileterki
            if rel.AsEvent_05.FiscalReportNumber = 1 then
              dCurrentFiscalizationDate := Trunc(EmarDateTimeToDateTime(rel.AsEvent_05.EventDate, rel.AsEvent_05.EventTime))
            else
              dCurrentFiscalizationDate := 0;
            Result := Result and
              (GetTempTicketRegisterID(rel.AsEvent_05.TicketRegister, dCurrentFiscalizationDate, EMAR205, rel.AsEvent_05.FiscalReportState <> 0, '', '') > 0);
          end;
  {$REGION '17 - Rejestracja przejazdu z biletem okresowym (karta MIFARE)'}
        17:
          begin
            // prawidłowe zdarzenie rejestracji przejazdu z Em-Kartą
            if not(
                (rel.AsEvent_17.Errors <> 0) // warunek 1
                or(rel.AsEvent_17.CardNumber < 100000) // warunek 2
              ) then
              Result := Result and (GetTempEmCardID(FillEmCardRecord(rel.AsEvent_17)) <> 0);
          end;
  {$ENDREGION}
  {$REGION '32 - Zakup w autobusie biletu miesięcznego / okresowego na następny okres (karta MIFARE)'}
        32:
          begin
            lrek := rel.ReportRecordCount;
            r2ok := (lrek > 1)and not rel.IsError(reErrorPartMissing2 or reErrorCheckSum2);
            r3ok := (lrek > 2)and not rel.IsError(reErrorPartMissing3 or reErrorCheckSum3);
            if not r2ok or not r3ok then
            begin
              Inc(iRecord);
              Continue;
            end;
            Result := Result and (GetTempEmCardID(FillEmCardRecord(rel.AsEvent_32)) <> 0);
          end;
  {$ENDREGION}
  {$REGION '33 - Rejestracja przejazdu z biletem miesięcznym (karta MIFARE) - błędy identyfikacji'}
        33:
          begin //Błąd identyfikacji EM-karty
            if FLPCRegistrationParamsParameters.GetEMCardWrongReads then begin
              if rel.AsEvent_33.ErrorCode in C_Event33EmCardSaveRule then
                Result := Result and (GetTempEmCardID(FillEmCardRecord(rel.AsEvent_33)) <> 0);
            end;
          end;
  {$ENDREGION}
  {$REGION '34 - Rejestracja przejazdu z biletem miesięcznym (karta MIFARE) - nieprawidłowe bilety'}
        34:
          begin //Nieprawidłowy bilet w EM-karcie
            if FLPCRegistrationParamsParameters.GetEMCardWrongReads then
            begin
              lrek := rel.ReportRecordCount;
              r2ok := (lrek > 1)and not rel.IsError(reErrorPartMissing2 or reErrorCheckSum2);
              r3ok := (lrek > 2)and not rel.IsError(reErrorPartMissing3 or reErrorCheckSum3);
              if not r2ok or not r3ok then
              begin
                Inc(iRecord);
                Continue;
              end;
              Result := Result and (GetTempEmCardID(FillEmCardRecord(rel.AsEvent_34)) <> 0);
            end;
          end;
  {$ENDREGION}
  {$REGION '35 - przedłużenie okresu ważności biletu wieloprzejazdowego'}
        35:
          begin
            if FLPCRegistrationParamsParameters.GetEMCardWrongReads then
              Result := Result and (GetTempEmCardID(FillEmCardRecord(rel.AsEvent_35)) <> 0);
          end;
  {$ENDREGION}
  {$REGION '41 - Identyfikacja bileterki EMAR-205'}
        41:
          begin
            EMAR205 := True;
            dCurrentFiscalizationDate := 0;
            Result := Result and
              (GetTempTicketRegisterID(rel.AsEvent_41.FiscalPrinterNumber, dCurrentFiscalizationDate, EMAR205, True, String(rel.AsEvent_41.DeviceUniqueNumber), UIntToStr(rel.AsEvent_41.DeviceServiceNumber)) > 0);
            Result := Result and
              (GetTempBusPCID(Ord(bpcEmar205), String(rel.AsEvent_41.DeviceUniqueNumber)
                , String(rel.AsEvent_41.FirmwareVersion), IntToStr(rel.AsEvent_41.DeviceServiceNumber)) > 0);
          end;
      end;
  {$ENDREGION}

      Inc(iRecord);
    end;
  end;
end;

function TSalesReportEmar105._SaveAndLoadLocalA80(ATempA80FilePath: String): Boolean;
var
  iFileALoadError: Cardinal;
begin
  Result := True;
  iFileALoadError := _File.SaveToFile(PWideChar(ATempA80FilePath), _File.Version, EMAR_SAVEMODE_FILE_A);
  if iFileALoadError <> ERR_NO_ERROR then
  begin
    if FileExists(ATempA80FilePath) then
      KMFilesUtil.ForceDeleteFile(PChar(ATempA80FilePath)); // delete temporary copy of A80 file
    AddToDesc(Format(RS_Emar105RegistrationFileALoadingError, [_File.AFileName]));
    Exit(False); // błąd odczytu zbioru
  end;
  FileOryg.Id := 0;
  FileOryg.PrepareFromPath(ATempA80FilePath, LicencesCompanyID, dfEmar105, _File.Version, False);
  FileOryg.ValidFrom := 0; // zapisze NULL, co znaczy że A80 nie będzie brany pod uwage przy wyborze ostatnio zarejestrowanego zbioru do programowania karty
  FileOryg.ValidTo := 0; // zapisze NULL, co znaczy że A80 nie będzie brany pod uwage przy wyborze ostatnio zarejestrowanego zbioru do programowania karty
end;

function TSalesReportEmar105._LoadA80(AFileId: Integer; AA80FilePath: String): Boolean;
var
  iFileALoadError: Cardinal;
begin
  Result := False;
  if FileOryg.ReadFromDatabase(AFileId) then
  try
    FileOryg.FileAttachment.LoadAttachment(false, false, false);
    CopyFile(PChar(FileOryg.FileAttachment.LocalFileName), PChar(AA80FilePath), False);
    if FileOryg.FileAttachment.FileStream.Size > 0 then
    begin
      FileOryg.InitEmarFile(False);
      iFileALoadError := FileOryg.EmarFile.LoadFromFile(PChar(AA80FilePath));
      // exclude ERR_REPORT_NO_REPORT because A80 has not report
      if (iFileALoadError <> NO_ERROR)and((iFileALoadError xor ERR_REPORT_NO_REPORT) <> NO_ERROR) then
        AddToDesc(Format(RS_Emar105RegistrationFileALoadingError, [_File.AFileName]))
      else
        Result := True;
    end
    else
    begin
      if IsEmar205OnlineReport() then // dla raportu Emar-205 online zbiór musi byc odczytany
      begin
        KMFilesUtil.ForceDeleteFile(PChar(FileOryg.FileAttachment.LocalFileName)); // i tak ma zerowy rozmiar
        AddToDesc(Format(RS_Emar105RegistrationFileALoadingError, [_File.AFileName]));
        Exit; // błąd odczytu zbioru
      end
      else // nie Emar-205 online
      begin
        if not _SaveAndLoadLocalA80(AA80FilePath) then
          Exit; // błąd odczytu zbioru
      end;
      Result := True;
    end;
  finally
    if FileExists(AA80FilePath) then
      KMFilesUtil.ForceDeleteFile(PChar(AA80FilePath)); // delete temporary copy of A80 file
    if FileExists(FileOryg.FileAttachment.LocalFileName) and(FileOryg.FileAttachment.FileStream.Size = 0) then
      KMFilesUtil.ForceDeleteFile(PChar(FileOryg.FileAttachment.LocalFileName)); // delete it if is an empty to eliminate an issue in the future
  end;
end;

