//              NrStrefyW:=PrzejazdZTM.NrStrefyWaznBiletu;      //-38-numer strefy ważności biletu (1/2/3/4)
//              BWaznyDo:=PrzejazdZTM.DataWazBiletu;            //-39-Ostatni dzień ważności biletu
//              NrPPocz:=PrzejazdZTM.NrPPocz;              //-40-nr przystanku wsiadania
//              NrPCel:=PrzejazdZTM.NrPCel;                //-41-nr przystanku docelowego
//            end;
          end;
{$ENDREGION}
      end;

{$REGION 'After case'}
      if not IsEmar205OnlineReport() then
        if (rel.Kind in [1, 2, 5, 13, 15, 16, 21, 30]) and not sast then
        begin
          AddLine(0, C_TXT_MISSING_PTU);
