function TSalesReportEmar105.FillEmCardRecord(AEmarEvent: IEmar_ReportEvent): TEmCardRecord;
var
  iCardNumber: Int64;
  iSaleCompanyINumber: Integer;
  iRegistrationUserID: Integer;
  dRegistrationDate: TDateTime;
begin
  case AEmarEvent.Kind of
    17:
      begin
        iCardNumber := AEmarEvent.AsEvent_17.CardNumber;
        iSaleCompanyINumber := AEmarEvent.AsEvent_17.SaleCompany;
        iRegistrationUserID := Self.User_ID;
        dRegistrationDate := EmarDateToDate(AEmarEvent.EventDate);
      end;
    32:
      begin
        iCardNumber := AEmarEvent.AsEvent_32.CardNumber;
        iSaleCompanyINumber := AEmarEvent.AsEvent_32.SaleCompany;
        iRegistrationUserID := Self.User_ID;
        dRegistrationDate := EmarDateToDate(AEmarEvent.EventDate);
      end;
    33:
      begin
        iCardNumber := AEmarEvent.AsEvent_33.CardNumber;
        iSaleCompanyINumber := AEmarEvent.AsEvent_33.SaleCompany;
        iRegistrationUserID := Self.User_ID;
        dRegistrationDate := EmarDateToDate(AEmarEvent.EventDate);
      end;
    34:
      begin
        iCardNumber := AEmarEvent.AsEvent_34.CardNumber;
        iSaleCompanyINumber := AEmarEvent.AsEvent_34.SaleCompany;
        iRegistrationUserID := Self.User_ID;
        dRegistrationDate := EmarDateToDate(AEmarEvent.EventDate);
      end;
    35:
      begin
        iCardNumber := AEmarEvent.AsEvent_35.CardNumber;
        iSaleCompanyINumber := AEmarEvent.AsEvent_35.SaleCompany;
        iRegistrationUserID := Self.User_ID;
        dRegistrationDate := EmarDateToDate(AEmarEvent.EventDate);
      end;
    else
      begin
        iCardNumber := 0;
        iSaleCompanyINumber := 0;
        iRegistrationUserID := 0;
        dRegistrationDate := 0;
      end;
  end;

  Result.CardNumber := IntToStr(iCardNumber);
  Result.CardType := 2; // (2) MIFARE Classic 1k 4b UID
  Result.Capacity := 1; // pojemność w Kb
  Result.Company_ID := GetCompanyID(iSaleCompanyINumber, Integer(kocPrzewoznik));
  Result.RegistrationUser_ID := iRegistrationUserID;
  Result.RegistrationDate := dRegistrationDate;
  if Result.Company_ID = 0 then
    AddToDesc(Format(SALES_REPORT_MSG_COMPANY_NOT_EXISTS, [iSaleCompanyINumber]), True);
end;

function TSalesReportEmar105.FillRideRegisteredRecord(
  const AEmar_Ride: IEmar_Ride): TRideRegisteredRecord;
var
  ixLine: Integer;
  ixFirstRideBS: Integer;
  ixLastRideBS: Integer;
  ixLineRoute: Integer;
  _Emar_RideOpen: IEmar_Ride;
  _Emar_Line: IEmar_Line;
begin
  _Emar_RideOpen := AEmar_Ride;
  try
    if _Emar_RideOpen <> nil then
    begin
      ixLine := _Emar_RideOpen.IndexOfLine;
      _Emar_Line := _FileA80.LineList.Items[ixLine];
      ixFirstRideBS := _Emar_RideOpen.IndexOfRoute;
      ixLastRideBS := _Emar_RideOpen.BusStopCount + _Emar_RideOpen.IndexOfRoute - 1;

      // fill record
// AT: Zostanie uzupełniane w zd. #10     Result.RideDate := EmarDateToDate(_FileA80.ReportStartedRideList.Items[AReportRideIndex].StartDate);
      Result.INumber := _FileA80.CompanyList.Items[_Emar_RideOpen.CompanyIndex].Number;
// AT: Zostanie uzupełniane w zd. #10     Result.RideStartTime := Frac(_Emar_RideOpen.DepartureTime / C_MinutesPerDay);
// AT: Zostanie uzupełniane w zd. #29     Result.RideStopTime := Frac(_Emar_RideOpen.TimeOfArrival / C_MinutesPerDay);
      Result.RideNumber := _Emar_RideOpen.Number;
      Result.RideVariant := _Emar_RideOpen.Version;
      Result.RideValidFrom := EmarDateToDate(_Emar_RideOpen.ValidFrom);
      Result.LineNumber := _Emar_Line.LineNumber;
      Result.LineVariant := _Emar_Line.LineVariant;
      Result.LineTypeId := LineTypeID(_FileA80, _Emar_Line.LineType);
      Result.RideTypeCommunicationId := RideTypeCommunicationID(_Emar_RideOpen.KindOfComunnication);
      Result.OneWay := _Emar_RideOpen.Direction;
      Result.RideDistanceToEndStop := getIBusStopDistance(ixFirstRideBS, ixLastRideBS, False);
      Result.RideNumberOfStops := _Emar_RideOpen.BusStopCount;

      Result.RideFirstBusStopNumber := _FileA80.RideRouteList[ixFirstRideBS].IndexOfBusStopInLine + 1;
      Result.RideFirstBusStopCode := _FileA80.BusStopList.Items[_Emar_RideOpen.IndexOfFirstBusStop].Code;
      Result.RideFirstBusStopShortName := _FileA80.BusStopList.Items[_Emar_RideOpen.IndexOfFirstBusStop].ShortName;
      Result.RideFirstBusStopName := _FileA80.BusStopList.Items[_Emar_RideOpen.IndexOfFirstBusStop].Name;

      Result.RideLastBusStopNumber := _FileA80.RideRouteList[ixLastRideBS].IndexOfBusStopInLine + 1;
      Result.RideLastBusStopCode := _FileA80.BusStopList.Items[_Emar_RideOpen.IndexOfLastBusStop].Code;
      Result.RideLastBusStopShortName := _FileA80.BusStopList.Items[_Emar_RideOpen.IndexOfLastBusStop].ShortName;
      Result.RideLastBusStopName := _FileA80.BusStopList.Items[_Emar_RideOpen.IndexOfLastBusStop].Name;

      Result.RideShortName := Result.RideFirstBusStopShortName + ' - ' + Result.RideLastBusStopShortName;

      if (_Emar_Line.IndexOfFirstBusStop > -1)or(_Emar_Line.IndexOfFirstBusStop >= _FileA80.BusStopList.Count) then
      begin
        Result.LineFirstBusStopNumber := 1;
        Result.LineFirstBusStopCode := _FileA80.BusStopList.Items[_Emar_Line.IndexOfFirstBusStop].Code;
        Result.LineFirstBusStopShortName := _FileA80.BusStopList.Items[_Emar_Line.IndexOfFirstBusStop].ShortName;
        Result.LineFirstBusStopName := _FileA80.BusStopList.Items[_Emar_Line.IndexOfFirstBusStop].Name;
      end
      else
        raise Exception.Create(Format(RS_Err_LogIndexOutOfRangeWithMax, [_Emar_Line.IndexOfFirstBusStop, _FileA80.BusStopList.Count]));
      if (_Emar_Line.IndexOfLastBusStop > -1)or(_Emar_Line.IndexOfLastBusStop >= _FileA80.BusStopList.Count) then
      begin
        Result.LineLastBusStopNumber := _Emar_Line.BusStopCount;
        Result.LineLastBusStopCode := _FileA80.BusStopList.Items[_Emar_Line.IndexOfLastBusStop].Code;
        Result.LineLastBusStopShortName := _FileA80.BusStopList.Items[_Emar_Line.IndexOfLastBusStop].ShortName;
        Result.LineLastBusStopName := _FileA80.BusStopList.Items[_Emar_Line.IndexOfLastBusStop].Name;
      end
      else
        raise Exception.Create(Format(RS_Err_LogIndexOutOfRangeWithMax, [_Emar_Line.IndexOfLastBusStop, _FileA80.BusStopList.Count]));
      Result.LineNumberOfStops := _Emar_Line.BusStopCount;
      ixLineRoute := _Emar_Line.IndexOfFirstRoutePoint + _Emar_Line.BusStopCount - 1;
      if (_FileA80.LineRouteList.Count > 0)and(ixLineRoute >= 0)and(ixLineRoute < _FileA80.LineRouteList.Count) then
        Result.LineDistanceToEndStop := _FileA80.LineRouteList[ixLineRoute].Distance
      else
      begin
//        AT: W tej chwili nie szukamy w FileOryg
//        if FileOryg.Id <> 0 then
//        begin
//          for i := 0 to Pred(FileOryg.FileXRideList.Count) do
//            if StrToIntDef(FileOryg.FileXRideList[i].EmarRideKey, -1) = AReportRideIndex then
//            begin
//              FileOryg.FileXRideList[i].Ride_ID
//            end;
//
//        end
//        else
          Result.LineDistanceToEndStop := 0;
      end;

      Result.NoSingleTickets := True; //TODO 1: Rozszerzyć warunek zgodnie z dok. w SLS_RideRegistered //_FileA80.ReportStartedRideList.Items[AReportRideIndex].NormalTicketCount = 0;

      Result.CountRideRealization := 1; //TODO 1: Zrobić zgodnie z dok. w SLS_RideRegistered

      Result.RideDistanceToEndStop := _Emar_RideOpen.Distance;

      Result.RideCommunicationNetworkID := 0;

      if LineTypeID(_FileA80, _Emar_Line.LineType) = Ord(ltKomunikacjaZamknieta) then // komunikacja zamknięta
        Result.LineServiceTypeID := Ord(lstPrzewozyRegularneSpecjalne)
      else
        Result.LineServiceTypeID := LineServiceTypeID(_FileA80, _Emar_Line.ServiceType);
    end;
  finally
    _Emar_RideOpen := nil;
    _Emar_Line := nil;
  end;
end;

