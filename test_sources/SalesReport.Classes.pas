                    ' ważny do: ' + PrzejazdZTM.DataWazBiletu +
                    ' w strefie nr: '+IntToStr(PrzejazdZTM.NrStrefyWaznBiletu));
                  OutputLine(re, clError, fsStrong);
                  if PrzejazdZTM.StatusSerw in [1, 2] then
                  begin
                    AddLine(23, StatusySerwera0_2_43[PrzejazdZTM.StatusSerw]);
                    OutputLine(re, clError, fsStrong);
                  end;
                end;
              5,6:
                begin
                  AddLine(23, StatusyBiletu_43[PrzejazdZTM.StatusSprBiletu]);
                  OutputLine(re, clError, fsStrong);
                end;
              7:
                begin
                  AddLine(23, StatusyBiletu_43[PrzejazdZTM.StatusSprBiletu]+' nr '+IntToStr(PrzejazdZTM.StatusSerw));
                  OutputLine(re, clError, fsStrong);
                end;
              8:
                begin
                  AddLine(23, StatusyBiletu_43[PrzejazdZTM.StatusSprBiletu]);
