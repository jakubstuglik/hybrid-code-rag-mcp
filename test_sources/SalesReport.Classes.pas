      finally
        FreeAndNil(c);
      end;

      if Self._File.SaveToFile(PChar(AFilePath), Self._File.Version, EMAR_SAVEMODE_FILE_A80_EXPORT) = ERR_NO_ERROR then
        Result := ERR_NO_ERROR;
    end;
  end;
end;

