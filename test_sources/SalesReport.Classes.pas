function TSalesReport.getIBusStop(aIndexOfRide,
  aBusStopNo: integer): IEmar_BusStop;
var
  iride: IEmar_Ride;
begin
  Result := nil;
  if _FileA80 <> nil then
  begin
    if aIndexOfRide > -1 then
    begin
      if aIndexOfRide < _FileA80.RideList.Count then
      begin
        try
          iride := _FileA80.RideList.Items[aIndexOfRide];
          if
            (iride <> nil)
            and (aBusStopNo <= iride.BusStopCount)
          then
            Result := _FileA80.BusStopList.Items[
                        _FileA80.RideRouteList.Items[iride.IndexOfRoute + aBusStopNo - 1].IndexOfBusStop];
        except
          Exit;
        end;
      end
      else
        AddToDesc('Indeks wybranego kursu przekracza ilość rekordów listy');
    end
    else
      AddToDesc(C_TXT_COURSE_IS_NOT_RECORDED, True);
  end;
end;

function TSalesReport.getIBusStopArrivalTime(const ABusStop,
  ARideIndex: Integer): Int64;

  function _BusStopArrivalTime(const AEmarFile105: IEmar_BaseFile; const ABusStopTo, ARideIndex: Integer): Int64;
  var
    i, iDriveTime, iStopTime: Int64;
    rrl: IEmar_Ride;
  begin
    Result := 0;
    iDriveTime := 0;
    iStopTime := 0;
    if (ARideIndex > -1)and(ARideIndex < AEmarFile105.RideList.Count) then
    begin
      rrl := AEmarFile105.RideList.Items[ARideIndex];
      try
        i := rrl.IndexOfRoute;
        while i < ABusStopTo do
        begin
          Inc(iDriveTime, iStopTime + AEmarFile105.RideRouteList.Items[i].RideTime);
          Inc(i);
          iStopTime := AEmarFile105.RideRouteList.Items[i].StopTime;
        end;
        Result := iDriveTime;
      finally
        rrl := nil;
      end;
    end;
  end;

var
  rrl: IEmar_Ride;
begin
  Result := 0;
  if ARideIndex > -1 then
  begin
    if ARideIndex < _FileA80.RideList.Count then
    begin
      rrl := _FileA80.RideList.Items[ARideIndex];
      try
        Result := rrl.DepartureTime + _BusStopArrivalTime(_FileA80, ABusStop, ARideIndex);
      finally
        rrl := nil;
      end;
    end
    else
      AddToDesc('Indeks wybranego kursu przekracza ilość rekordów listy');
  end
  else
    AddToDesc(C_TXT_COURSE_IS_NOT_RECORDED, True);
end;

