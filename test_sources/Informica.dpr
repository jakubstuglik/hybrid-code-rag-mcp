procedure StartApp;
begin
  Application.Initialize;
  Application.MainFormOnTaskbar := True;
  Application.ShowMainForm := False;
  Application.CreateForm(TfrmMainTurdus, frmMainTurdus);
  Application.Run;
end;

var DirOnStart : string;

begin
  {$IFDEF DEBUG}
  ReportMemoryLeaksOnShutdown := True;
  {$ENDIF}

  GetDir(0,DirOnStart);
  NoChromiumOnStart := FileExists(DirOnStart+'\NoChromiumOnStart.ini');
  WriteToFileLog    := FileExists(DirOnStart+'\WriteToFileLog.ini'); //w³¹czenie zapisu do logu ExeName.log
  if NoChromiumOnStart then
    StartApp
  else begin
    CreateGlobalCEFApp;
    if GlobalCEFApp.StartMainProcess then
      StartApp;
    DestroyGlobalCEFApp;
  end;

end.

