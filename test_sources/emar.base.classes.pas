function TEmar_PA_File_Ticket_List.IndexOf(AItem: IEmar_PA_File_Ticket): Integer;
var
  i: Integer;
begin
  if Assigned(AItem) then
    for i := 0 to Pred(fItems.Count) do
      if (AnsiString(Items[i].NumberBM) = AnsiString(AItem.NumberBM))
        and(AnsiString(Items[i].SaleDate) = AnsiString(AItem.SaleDate))
        and(AnsiString(Items[i].SaleTime) = AnsiString(AItem.SaleTime))
        and(Items[i].EmCardNumber = AItem.EmCardNumber)
        and(Items[i].TicketGenre = AItem.TicketGenre)
        and(Items[i].ReductionType = AItem.ReductionType)
        and(Items[i].ReductionCode = AItem.ReductionCode)
        and(Items[i].ReductionPercentage = AItem.ReductionPercentage)
        and(Items[i].TicketAbroad = AItem.TicketAbroad)
        and(Items[i].VatCode1 = AItem.VatCode1)
        and(Items[i].VatRate1 = AItem.VatRate1)
        and(Items[i].Brutto1 = AItem.Brutto1)
        and(Items[i].ReductionAmount1 = AItem.ReductionAmount1)
        and(Items[i].VatCode2 = AItem.VatCode2)
        and(Items[i].VatRate2 = AItem.VatRate2)
        and(Items[i].Brutto2 = AItem.Brutto2)
        and(Items[i].ReductionAmount2 = AItem.ReductionAmount2)
        and(Items[i].RideNumbersDays = AItem.RideNumbersDays)
        and(Items[i].ValidDayCount = AItem.ValidDayCount)
        and(AnsiString(Items[i].NewValidFrom) = AnsiString(AItem.NewValidFrom))
        and(AnsiString(Items[i].NewValidTo) = AnsiString(AItem.NewValidTo))
        and(Items[i].ContinueCount = AItem.ContinueCount)
        and(Items[i].Removed = AItem.Removed) then
        Exit(i);

  Result := - 1;
end;

