procedure TEmar_ReportEvent.GetFromData;
var
  p: PEmar105_ReportEvent_Begin;
begin
  if Assigned(pData) and Assigned(aData) then Move(aData^, pData^, GetDataLength);
  CheckDataOfEmar105ReportEvent;
  if not IsError(reErrorPartMissing1 or reErrorNoMemoryAllocated) then begin
    p := pData;
    fKind := p^.EventID;
    fEventDate := EmarDateToString(p^.EventDate);
    fEventTime := EmarTimeToString(p^.EventTime);
  end else begin
    fKind := reUnknowEvent;
    fEventDate := '';
    fEventTime := '';
  end;
end;

