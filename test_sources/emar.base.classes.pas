function TEmar_Oik.DecodeControlCodes(s: string): string;
begin
  s := StringReplace(s, #1, '\4', [rfReplaceAll]);
  s := StringReplace(s, #2, '\3', [rfReplaceAll]);
  s := StringReplace(s, #3, '\1', [rfReplaceAll]);
  s := StringReplace(s, #4, '\2', [rfReplaceAll]);
  Result := s;
end;

