procedure TEmar_Cards_File_Card.WriteToJson(jtw: TJsonTextWriter);
begin
  jtw.WriteStartObject;
    jtw.WritePropertyName('CardNumber');
      jtw.WriteValue(Self.CardNumber);
    jtw.WritePropertyName('CardType');
      jtw.WriteValue(Self.CardType);
    jtw.WritePropertyName('CardDeposit');
      jtw.WriteValue(Self.CardDeposit);
    if Self.CardRegistrationDate <> '' then
    begin
      jtw.WritePropertyName('CardRegistrationDate');
        jtw.WriteValue(Self.CardRegistrationDate);
    end;
    if Self.CardDisposalDate <> '' then
    begin
      jtw.WritePropertyName('CardDisposalDate');
        jtw.WriteValue(Self.CardDisposalDate);
    end;
    if Self.CardBlockedDate <> '' then
    begin
      jtw.WritePropertyName('CardBlockedDate');
        jtw.WriteValue(Self.CardBlockedDate);
    end;
    jtw.WritePropertyName('CardControlOnly');
      jtw.WriteValue(Self.CardControlOnly);
  jtw.WriteEndObject;
end;

procedure TEmar_Cards_File_Card._Clear;
begin
  fBufferStr := '';
  fCardNumber := 0;
  fCardType := 0;
  fCardDeposit := 0;
  fCardRegistrationDate := '';
  fCardDisposalDate := '';
  fCardBlockedDate := '';
  fCardControlOnly := True;
end;

