function TEmar_InterfacedObject.CopyL(s: PAnsiChar; max: integer): ansistring;
var
  i: integer;
begin
  if s^ = #$ff then Result := ''
  else begin
    Result := AnsiString(StringOfChar(' ', max));
    // for i := 1 to max do
    // Result := Result + ' ';
    if s^ = #0 then Result := ''
    else begin
      i := 1;
      repeat
        Result[i] := s^;
        Inc(s);
        Inc(i);
      until (i > max) or (s^ = #0);
      if i < max then SetLength(Result, i);
    end;
  end;
end;

