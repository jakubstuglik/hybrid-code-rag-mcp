// UWAGA 2: uwzględnienie błędu bileterki - przy końcówkach 6 i 7 groszy
// i zaokrąglaniu do 5 groszy zaokrąglenie nie było liczone.
// ==> do bloku fiskalnego zostaje zapisana wartość bez zaokrąglenia!!!
// W przypadku biletu dwutaryfowego - zaokrąglana jest każda część wartości
// biletu oddzielnie i błędna końcówka może wystąpić tylko w jednej części;
// przypadek nr 2: ulga kwotowa ==> jeśli w tablicy wskaźników zapisany jest
// indeks=0 (ulga zabroniona) bileterka wybiera kwotę innej ulgi (poprzednio
// wybranej) korekta: kwotę ulgi oblicza się jako różnicę pomiędzy ceną biletu
// normalnego i ceną zapisaną przez bileterkę
function TEmar_FarePriceReduction.KorektaOblUlgi(const ds: TDateTime; const DoZapl, zaprk: Integer; c: PRTicketPrice;
  kwu: PDouble; cobl: PInteger): Cardinal;
var
  U0, U1, c1, c2: integer;
begin
  Result := 0;
  if ((Self.ReductionAmount <> 0) or (Self.ReductionType <> 2)) and (Self.ReductionRoundMethod = 1) then begin
    U0 := Round((c^.Brutto[0] - c^.Bonif[0]) * (100 - Self.ReductionAmount) / 10);
    U0 := (U0 + 5) div 10;
    if (U0 mod 10) in [6, 7] then U0 := U0 + (U0 mod 10) - 5;
    U0 := c^.Brutto[0] - c^.Bonif[0] - U0;
    U1 := Round((c^.Brutto[1] - c^.Bonif[1]) * (100 - Self.ReductionAmount) / 10);
    U1 := (U1 + 5) div 10;
    if (U1 mod 10) in [6, 7] then U1 := U1 + (U1 mod 10) - 5;
    U1 := c^.Brutto[1] - c^.Bonif[1] - U1;
    c1 := (c^.Brutto[0] + c^.Brutto[1] - c^.Bonif[0] - c^.Bonif[1] + c^.OpMan[0] + c^.OpMan[1]);
    c2 := c1 - U0 - U1;
    if c2 = DoZapl then begin
      c^.Ulga[0] := U0;
      c^.Ulga[1] := U1;
    end else begin
      c2 := c1 - U0 - c^.Ulga[1];
      if c2 = DoZapl then begin
        c^.Ulga[0] := U0;
      end else begin
        c2 := c1 - c^.Ulga[0] - U1;
        if c2 = DoZapl then c^.Ulga[1] := U1
        else exit;
      end;
    end;
    if Self.NrStawkaPTU > 0 then begin
      c^.NrStU := Self.NrStawkaPTU;
      c^.StPtuU := Self.Owner.GetCurrentRatePTU(ds, c^.NrStU){ StPod[c^.NrStU] } / 100;
      // c^.PtuU[0]:=Round(c^.Ulga[0]*c^.StPtuU/(100+c.StPtuU));
      // c^.PtuU[1]:=Round(c^.Ulga[1]*c^.StPtuU/(100+c.StPtuU));
      // E.B. 11.01.2005
      c^.PtuU[0] := (Round(Int(c^.Ulga[0] * c^.StPtuU / (100 + c^.StPtuU) * 100)) + 50) div 100;
      c^.PtuU[1] := (Round(Int(c^.Ulga[1] * c^.StPtuU / (100 + c^.StPtuU) * 100)) + 50) div 100;
    end;
    kwu^ := (c^.Ulga[0] + c^.Ulga[1]) / 100;
    cobl^ := (c^.Brutto[0] + c^.Brutto[1] - c^.Bonif[0] - c^.Bonif[1] - c^.Ulga[0] - c^.Ulga[1] + c^.OpMan[0] +
      c^.OpMan[1]);
  end else if (Self.ReductionAmount = 0) and (Self.ReductionType = 2) then begin // ulga kwotowa
    c^.Ulga[0] := cobl^ - DoZapl;
    kwu^ := (c^.Ulga[0] + c^.Ulga[1]) / 100;
    cobl^ := (c^.Brutto[0] + c^.Brutto[1] - c^.Bonif[0] - c^.Bonif[1] - c^.Ulga[0] - c^.Ulga[1] + c^.OpMan[0] +
      c^.OpMan[1]);
    Result := 1;
  end;
end;

