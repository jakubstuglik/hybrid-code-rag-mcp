function TEmar_Cards_File.LoadFromFile(aFileName: pchar): longword;
var
  fs: TFileStream;
begin
  if FileExists(aFileName) then begin
    fs := TFileStream.Create(aFileName, fmOpenRead or fmShareDenyWrite);
    try
      // fVerifyCheckSum := true;
      try
        Result := LoadFromStream(fs);
      finally
        // fVerifyCheckSum := false;
      end;
    finally
      fs.Free;
    end;
  end
  else Result := ERR_FILE_NOT_FOUND;
end;

function TEmar_Cards_File.LoadFromStream(aStream: TStream): longword;
begin
  // TODO 1: add an implementation
  Result := ERR_INCORRECT_FILE;
end;

function TEmar_Cards_File.SaveToFile(aFileName: pchar): longword;
begin
  fStream.Clear;
  try
    Result := SaveToStream(fStream);
    if Result = ERR_NO_ERROR then fStream.SaveToFile(aFileName);
  finally
    fStream.Clear;
  end;
end;

function TEmar_Cards_File.SaveToStream(aStream: TStream): longword;
var
  sw:   TStreamWriter;
  jtw:  TJsonTextWriter;
begin
  Result := ERR_UNEXPECTED_ERROR;
  try
    sw := TStreamWriter.Create(aStream);
    try
      jtw := TJsonTextWriter.Create(sw);
      try
        CardList.WriteToJson(jtw);
      finally
        jtw.Free;
      end;
    finally
      sw.Free;
    end;
    Result := ERR_NO_ERROR;
  except
  end;
end;

