// E.B. 20.12.2007 Data dodania poniższego komentarza (o szkodliwości braku
// komentarzy przy wprowadzaniu zmian)
// Funkcja używana była przy analizie raportów z EMAR-105 i DUO-BUS do ustalenia
// stawek PTU obowiązujących w raporcie fiskalnym - informacje odczytywane były
// z rekordu identyfikacji bileterki i miały w nich wartości dotyczące stawek
// nieczynnych i zwolnionej zapisane w różny sposób
// baza: stawki czynne: wartość z dwoma miejscami po przecinku
// stawki nieczyne: wartość -1
// stawka zwolniona: wartość -2
// sprzedaż nie podlegająca PTU: wartość -3  -> dotyczy sprzedaży
// w komunikacji zagranicznej
// EMAR-105: stawki czynne: % podatku x 100 (liczba całkowita -> word)
// stawki nieczynne: wartość $ffff  (-1)
// stawka zwolniona: wartość 20000
// sprzedaż niepodlegająca PTU: w raporcie nie jest podawana
// przy obliczaniu kodu kontrolnego przyjmowana jest wartość 30000; wartość
// zdefiniowana w rekordzie CONST
// DUO-BUS/PRINTO-BUS: stawki czynne: % podatku x 100 ('00700' - 5 znaków)
// stawki nieczynne: ' -100'
// stawka zwolniona: ' -200' (w sekcji identyfikacji kasy)
// '20000' -> w rekordzie CONST
// sprzedaż niepodlegająca PTU: w raporcie nie jest podawana
// Rekordy pliku "PA*" / "BA*" z danymi biletów do sprzedaży na następny
// okres w autobusie: stawki czynne: % podatku x 100
// stawka zwolniona: '00000' - do obliczenia (odróżnienie stawki 0 od zwolnionej
// na podstawie numeru stawki w rekordzie RF z zarejestrowaną sprzedażą biletu)
// sprzedaż niepodlegająca PTU: '00000'
// rozpoznanie rodzaju stawki PTU na podstawie numeru stawki PTU:
// 0-brak stawki, 8-nie podlega
function TEmar_BaseFile.StDoBaz(st: Integer): Currency;
begin
  if st = $FFFF then Result := - 1      // nieczynna
  else if st = 20000 then Result := - 2 // zwolniona
  else if st = 30000 then Result := - 3 // E.B. 07.07.2004 - nie podlega
  else if st = - 100 then Result := 0   // D.P. 10.12.2007 - import BM z PA*.DAT (komunikacja krajowa stptu2)
  else Result := st / 100;
end;

