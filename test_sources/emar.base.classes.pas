  DodOdlOdg: PInteger; OdlTarOK: PBoolean; OdlDrog, OdlTariff: PInteger): Cardinal;
var
  odgp:            Boolean;
  odg:             Boolean;
  odldodg, odlodg: Integer;
  odld, odld0,        // odległości drogowe
  odl, odl0: Integer; // odległości taryfowe
begin
  Result := ERR_NO_ERROR;

  odgp := RideRouteList.Items[AIndexOfBusStopStartInRoute].InBranch;
  // Atrk[AIndexOfBusStopStartInRoute+12] and $80=$80;
  odg := False;
  OdlTarOK^ := True;
  odl := 0;
  odlodg := 0;
  DodOdlOdg^ := 0;
  odld := 0;
  odldodg := 0;
  OdlDrog^ := 0;
  OdlTariff^ := 0;
//  if AIndexOfBusStopEndInRoute > AIndexOfBusStopStartInRoute then // E.B. 09.09.2005
    //repeat
    while AIndexOfBusStopStartInRoute < AIndexOfBusStopEndInRoute do
    begin
      Inc(AIndexOfBusStopStartInRoute);
      if { not }odgp{ and RideRouteList.Items[AIndexOfBusStopStartInRoute].InBranch } then
      // (Atrk[AIndexOfBusStopStartInRoute+12] and $80=$80) then begin
      begin
        odl0 := RideRouteList.Items[AIndexOfBusStopStartInRoute].FareDistanceInShortcut;
        // Smallint(Czw(Atrk,AIndexOfBusStopStartInRoute+10));
        odld0 := RideRouteList.Items[AIndexOfBusStopStartInRoute].DistanceInShortcut;
        // Smallint(Czw(Atrk,AIndexOfBusStopStartInRoute+8));
        odlodg := odlodg + odl0;
        odldodg := odldodg + odld0;
        if odl0 < 0 then OdlTarOK^ := False;
        if not RideRouteList.Items[AIndexOfBusStopStartInRoute].InBranch then odgp := False;
      end else begin
        if RideRouteList.Items[AIndexOfBusStopStartInRoute].InBranch then begin // odg
          if not odg then // pierwszy w odg
          begin
            // if tar then kmodg:=kmodg+CzIDuo(Adtrk,it+28,5)
            // else kmodg:=kmodg+StrToFloat(CzSDuo(Adtrk,it+22,6))
            odl0 := RideRouteList.Items[AIndexOfBusStopStartInRoute].FareDistance;
            // Smallint(Czw(Atrk,AIndexOfBusStopStartInRoute+10));
            odld0 := RideRouteList.Items[AIndexOfBusStopStartInRoute].Distance;
            // Smallint(Czw(Atrk,AIndexOfBusStopStartInRoute+8));
            odlodg := odlodg + odl0;
            odldodg := odldodg + odld0;
          end else begin
            // if tar then kmodg:=kmodg+CzIDuo(Adtrk,it+39,3)
            // else kmodg:=kmodg+StrToFloat(CzSDuo(Adtrk,it+35,4));
            odl0 := RideRouteList.Items[AIndexOfBusStopStartInRoute].FareDistanceInShortcut;
            // Smallint(Czw(Atrk,AIndexOfBusStopStartInRoute+10));
            odld0 := RideRouteList.Items[AIndexOfBusStopStartInRoute].DistanceInShortcut;
            // Smallint(Czw(Atrk,AIndexOfBusStopStartInRoute+8));
            odlodg := odlodg + odl0;
            odldodg := odldodg + odld0;
          end;
          odg := true;
        end else begin      // trasa główna
          if odg then begin // wyjście z odg
            // kmodg:=0;
            odlodg := 0;
            odldodg := 0;
            odg := false;
          end;
          odl := odl + RideRouteList.Items[AIndexOfBusStopStartInRoute].FareDistance;
          // Atrk[AIndexOfBusStopStartInRoute+11];
          odld := odld + RideRouteList.Items[AIndexOfBusStopStartInRoute].Distance;
          // Atrk[AIndexOfBusStopStartInRoute+9];
        end;
      end;
    end;
    //until AIndexOfBusStopStartInRoute = AIndexOfBusStopEndInRoute;
  odl := odl + odlodg;
  odld := odld + odldodg;
  // Result:=odl;
  OdlDrog^ := odld;
  OdlTariff^ := odl;
end;

