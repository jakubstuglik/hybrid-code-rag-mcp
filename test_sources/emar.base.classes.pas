function TEmar_FarePriceReductionList.CompareMonthReductions(List: TEmar_InterfaceList;
  Index1, Index2: Integer): Integer;
var
  l:      TEmar_FarePriceReductionList;
  iL, iR: IEmar_FarePriceReduction;
begin
  l := TEmar_FarePriceReductionList(List);
  iL := l.Items[Index1];
  iR := l.Items[Index2];
  Result := iL.ReductionCompanyINumber - iR.ReductionCompanyINumber;
  if Result = 0 then begin
    Result := iL.ReductionGroup - iR.ReductionGroup;
    if Result = 0 then begin
      Result := iL.ReductionNumber - iR.ReductionNumber;
      if Result = 0 then
          Result := System.DateUtils.CompareDate(StrToDateDef(iL.ValidFrom, EncodeDate(2000, 1, 1)),
          StrToDateDef(iR.ValidFrom, EncodeDate(2000, 1, 1)));
    end;
  end;
end;

