function TEmar_Ride.OblBon(const LBon: Byte; const ipocz: Integer; const ds: TDateTime; const nrpp, nrpk: Byte;
  const kraj: Boolean; ABonus: PInteger): Cardinal;
var
  BonK:                   IEmar_RideBonus; // TRLBonOp;
  Tar:                    IEmar_Tariff;    // TRLTar;
  nrc:                    Byte;
  c:                      IEmar_Price; // TRLCen;
  dw:                     TDateTime;
  p, k, i, m, inr, ipcen: Integer; // E.B. 18.07.2016
  JestBon:                Boolean;
begin
  Result := ERR_NO_ERROR;

  i := 1;
  ABonus^ := 0;
  while i <= LBon do begin
    BonK := Self.Owner.RideBonusList[ipocz + i - 1]; // DajRLBon(Abk,(ipocz+i-1)*DRe.BK,RE,WyswRL);
    if string(BonK.ValidFrom) = ''{ BonK.WaznaOd=0 } then dw := StrToDate(Self.Owner.GetCalendarBegin) - 1
      // Con.PoczKal-1;
    else dw := StrToDate(BonK.ValidFrom); // ??? //Con.PoczKal+BonK.WaznaOd;
    if dw <= ds then Break;
    Inc(i);
  end;
  JestBon := False;
  while i <= LBon do begin
    if (BonK.SprKal(ds, @JestBon) = ERR_NO_ERROR) and JestBon then
    // if (String(BonK.ValidFrom) = '')or(StrToDate(BonK.ValidFrom) <= ds) then // ???
    begin
      // JestBon := True;
      Break;
    end;
    Inc(i);
    if i <= LBon then BonK := Self.Owner.RideBonusList[ipocz + i - 1]; // DajRLBon(Abk,(ipocz+i-1)*DRe.BK,RE,WyswRL);
  end;
  if JestBon then begin
    if nrpp < BonK.IndexOfFirstBusStopInRoute + 1{ BonK.OdPrzyst } then Exit;
    Tar := Self.Owner.TariffList[BonK.IndexOfTariff]; // DajRLTar(Ata,(BonK.NrTaryfy-1)*DRe.TA,RE,WyswRL);
    inr := BonK.FirstPriceIndex;                      // BonK.NrPInd-1;
    ipcen := tar.IndexOfPrice;                        // (Tar.NrPCeny-1)*DRe.CE;

    p := nrpp - BonK.IndexOfFirstBusStopInRoute{ BonK.OdPrzyst + 1 };
    k := nrpk - BonK.IndexOfFirstBusStopInRoute{ BonK.OdPrzyst + 1 };
    m := ((p - 1) * (2 * (BonK.IndexOfLastBusStopInRoute{ BonK.DoPrzyst } -
      BonK.IndexOfFirstBusStopInRoute{ BonK.OdPrzyst } + 1) - p) div 2) + k - p - 1;
    nrc := Self.Owner.PriceIndexes.PriceIndex[inr + m]; // Anc9[inr+m];
    if nrc = 0 then Exit;                               // E.B. 18.07.2016
    c := Self.Owner.PricesList[ipcen + (nrc - 1)];      // DajRLCen(Ace,ipcen+(nrc-1)*DRe.CE,RE,WyswRL);  //rekord ceny
    if Tar.Kind{ Tar.TypTaryfy } in [71, 76] then begin // bonifikata/ulga kwotowa przypisana do taryfy zagranicznej
      if kraj then ABonus^ := c.Price                   // bonifikata/ulga kwotowa za odcinek krajowy
      else ABonus^ := c.Zone;                           // bonifikata/ulga kwotowa za odcinek zagraniczny
    end
    else ABonus^ := c.Price;
  end;
end;

function TEmar_Ride.OblCenMie(const Ads: TDateTime; const AIndexOfBusStopStart: integer; const ATariffOffset: integer;
  const APriceNumber: integer; const APassangerCount: integer; ABusStopEndNo: PInteger;
  AIndexOfPriceCityFarePriceScale: PInteger; c: PRTicketPrice): Cardinal;
var
  i:           integer;
  iCityTariff: IEmar_RidesCityTariff;
  iCityPrice:  IEmar_CityTariffPrice;
  iTariff:     IEmar_Tariff;
begin
  Result := ERR_NO_ERROR;
  FillChar(c^.NrSt[0], SizeOf(TRTicketPrice), 0);
  iCityTariff := Owner.RidesCityFarePriceScaleList[Self.IndexOfCityTariff + ATariffOffset];
  {
    Przystanek docelowy – ostatni przystanek w tabeli 20 z numerem taryfy miejskiej,
    wartość zero kończy wyszukiwanie niezależnie od statusu przystanku
  }
  ABusStopEndNo^ := BusStopCount;
  for i := AIndexOfBusStopStart to BusStopCount do
    if Owner.FarePriceScaleZoneNumbers.Zone[iCityTariff.FirstPriceIndex + i - 1] = 0 then
      Break
    else
      ABusStopEndNo^ := i;
  iTariff := Owner.TariffList[iCityTariff.IndexOfTariff];
  c^.NrSt[0] := iTariff.IndexOfVAT;
  c^.StPtu[0] := Owner.GetCurrentRatePTU(Ads, c^.NrSt[0]) / 100;
  AIndexOfPriceCityFarePriceScale^ := iTariff.IndexOfPrice;
  i := iTariff.PriceCount;
  while i > 1 do begin
    iCityPrice := Owner.PriceCityFarePriceScaleList[AIndexOfPriceCityFarePriceScale^];
    if (TEmar_InterfacedObject(iCityPrice).Id <> 0) and (iCityPrice.PriceNumber = APriceNumber) then Break;
    Dec(i);
    Inc(AIndexOfPriceCityFarePriceScale^);
  end;
  iCityPrice := Owner.PriceCityFarePriceScaleList[AIndexOfPriceCityFarePriceScale^];
  c^.Cena[0] := integer(iCityPrice.Price) * APassangerCount; // iCityPrice.Price + iCityPrice.ReductionAmount;
  c^.Ulga[0] := integer(iCityPrice.ReductionAmount) * APassangerCount;
  c^.Brutto[0] := integer(iCityPrice.Price + iCityPrice.ReductionAmount) * APassangerCount;
  // integer(iCityPrice.Price) * APassangerCount;
  if (iTariff.FeeCalculateMethod = fcmFeeOfPassangerCount) then
      c^.OpMan[0] := integer(iCityPrice.HandlingFee) * APassangerCount
  else c^.OpMan[0] := iCityPrice.HandlingFee;
  c^.PTU[0] := (Round(Int((c^.Cena{ Brutto }[0] + c^.OpMan[0]) * c^.StPtu[0] / (100 + c^.StPtu[0]) * 100)) +
    50) div 100;
  c^.WStawce[0] := c^.Cena{ Brutto }[0] + c^.OpMan[0];
end;

function TEmar_Ride.OblOpMan(const ds: TDateTime; const nrpp, nrpk: Byte; const kraj: Boolean; AHandlingFree: PInteger)
  : Cardinal;
var
  OpMan:     IEmar_RideHandlingFee; // TRLBonOp;
  Tar:       IEmar_Tariff;          // TRLTar;
  nrc:       Byte;
  c:         IEmar_Price; // TRLCen;
  i, m:      Integer;
  dw:        TDateTime;
  JestOpMan: Boolean;
begin
  Result := ERR_NO_ERROR;

  i := 1;
  AHandlingFree^ := 0;
  while i <= FeeCount{ Kur.LOM } do begin
    OpMan := Self.Owner.fRideHandlingFeeList[IndexOfFee + i - 1]; // DajRLOpM(Aomk,(Kur.NrOM1-1+i-1)*DRe.OMK,RE,WyswRL);
    if string(OpMan.ValidFrom) = ''{ BonK.WaznaOd=0 } then dw := StrToDate(Self.Owner.GetCalendarBegin) - 1
      // Con.PoczKal-1;
    else dw := StrToDate(OpMan.ValidFrom); // ??? //Con.PoczKal+OpMan.WaznaOd;
    if dw <= ds then Break;
    Inc(i);
  end;
  JestOpMan := False;
  while i <= FeeCount{ Kur.LOM } do begin
    if (OpMan.SprKal(ds, @JestOpMan) = ERR_NO_ERROR) and JestOpMan then
    // if SprKal(OpMan.KalDniWaz,ds,RE,WyswRL) then begin
    // if (String(OpMan.ValidFrom) = '')or(StrToDate(OpMan.ValidFrom) <= ds) then
    begin
      // JestOpMan := True;
      Break;
    end;
    Inc(i);
    if i <= FeeCount{ Kur.LOM } then OpMan := Self.Owner.fRideHandlingFeeList[IndexOfFee + i - 1];
    // DajRLOpM(Aomk,(Kur.NrOM1-1+i-1)*DRe.OMK,RE,WyswRL);
  end;
  if JestOpMan then begin
    if nrpp < OpMan.IndexOfFirstBusStopInRoute{ OpMan.OdPrzyst } then Exit;
    Tar := Self.Owner.fTariffList[OpMan.IndexOfTariff{ - 1 }]; // DajRLTar(Ata,(OpMan.NrTaryfy-1)*DRe.TA,RE,WyswRL);
    m := ((nrpp{ - 1??? }) * (2 * (OpMan.IndexOfLastBusStopInRoute{ OpMan.OdPrzyst } -
      OpMan.IndexOfFirstBusStopInRoute{ OpMan.OdPrzyst } + 1) - nrpp) div 2) + nrpk - nrpp{ - 1 };
    nrc := Self.Owner.fPriceIndexes2.PriceIndex[OpMan.FirstPriceIndex{ - 1 } + m];
    // DajRLIcen(Anc9,OpMan.NrPInd-1+m,RE,WyswRL);
    if nrc = 0 then Exit;
    c := Self.Owner.fPriceList[Tar.IndexOfPrice{ -1 } + nrc{ -1 }];
    // DajRLCen(Ace,(Tar.NrPCeny-1+nrc-1)*DRe.CE,RE,WyswRL);   //E.B. 18.07.2016
    if Tar.Kind = 72 then begin              // opłata manipulacyjna przypisana do taryfy zagranicznej
      if kraj then AHandlingFree^ := c.Price // opłata manipulacyjna za odcinek krajowy
      else AHandlingFree^ := c.Zone;         // opłata manipulacyjna za odcinek zagraniczny
    end
    else AHandlingFree^ := c.Price;
  end;
end;

function TEmar_Ride.OblUlg(const ANrUlgi: Integer; const nrpp, nrpk: Byte; const ds: TDateTime; const zak: Integer;
  const kraj: Boolean; ATicketPrice: PRTicketPrice): Cardinal; stdcall;
var
  i:    integer;
  UlgK: IEmar_RideReduction; // TRLUlgK;
  Ulg:  IEmar_FarePriceReduction;

  function OblKwoUlgZao(wart, pro, zao: integer; zao5: integer = 0; zao10: integer = 0): integer;
  // funkcja oblicza wartość ulgi w groszach dla ulg procentowych
  // wart: brutto-bonifikata, pro: %, zao: kod zaokrąglenia
  // zao5,zao10: zaokrąglenie zależne od wartości
  // UWAGA: powtórzony sposób liczenia bileterki - nie zmieniać !!!!!
  // obliczana jest cena biletu ulgowego = (brutto-bon)*(100-%)/100
  // ulga = brutto - cena z ulgą
  // UWAGA: nie można użyć Round - bileterka przy końcówce 0,5 zaokrągla
  // ZAWSZE w górę, Round do parzystej liczby całkowitej
  begin
    case zao of
    1: begin                                         { do 5 gr }
        Result := (wart * (100 - pro) + 50) div 100; // cena zaokrąglona do 1 gr
        Result := ((Result + 2) div 5) * 5;          // cena zaokrąglona dp 5 gr
      end;
    // przypadek nr 3: zaokrąglenie do 10 groszy - bileterka najpierw zaokrągla
    // do 1 grosza, a dopiero potem do 10 groszy (np. cena wyliczonego biletu
    // ulgowego = 2.345 - normalne zaokrąglenie do 10 gr = 2.30, bileterka = 2.40
    // 2.345 => 2.35 => 2.40
    2: begin                                        { do 10 gr }
        Result := (wart * (100 - pro) + 50) div 10; // cena zaokr. do 1 gr
        Result := ((Result + 50) div 100) * 10;     // cena zaokr. do 10 gr
      end;
    3: begin                                         // w dół do 5 gr
        Result := (wart * (100 - pro) + 50) div 100; // cena zaokrąglona do 1 gr
        if Result mod 5 <> 0 then begin
          Result := Result div 5 * 5; // E.B. 16.06.2004
        end;
      end;
    4: begin                                         // w dól do 10 gr
        Result := (wart * (100 - pro) + 50) div 100; // cena zaokrąglona do 1 gr
        if Result mod 10 <> 0 then begin
          Result := Result div 10 * 10; // E.B. 16.06.2004
        end;
      end;
    5: begin                                                      // zależnie od wartości
        Result := (wart * (100 - pro) + 50) div 100;              // cena zaokrąglona do 1 gr
        if Result <= Zao5 then Result := ((Result + 2) div 5) * 5 // cena zaokrąglona dp 5 gr
        else if Result <= Zao10 then Result := ((Result + 5) div 10) * 10 // cena zaokr. do 10 gr
        else Result := ((Result + 50) div 100) * 100; // do 1 zł
      end;
  else begin
      Result := (wart * (100 - pro) + 50) div 100; // cena zaokrąglona do 1 gr
    end;
    end;
    Result := wart - Result; // kwota ulgi
  end;

begin
  Result := ERR_NO_ERROR;

  UlgK := Self.Owner.RideReductionList[Self.IndexOfPriceReduction + ANrUlgi];
  // DajRLUlgK(Auk,(NrPUlgKur)*DRe.UK,RE,WyswRL);
  Ulg := Self.Owner.FarePriceReductionList[UlgK.IndexOfReduction]; // DajRLUlg(Aul,(UlgK.NrUlgi-1)*DRe.UL,RE,WyswRL);
  if (Ulg.ReductionAmount{ Ulg.Ulga } <> 0) or (Ulg.ReductionType{ Ulg.TypUlgi } <> 2) then begin // ulga procentowa
    ATicketPrice^.Ulga[zak] := OblKwoUlgZao(ATicketPrice^.Brutto[zak] - ATicketPrice^.Bonif[zak],
      Ulg.ReductionAmount{ Ulg.Ulga }, Ulg.ReductionRoundMethod{ Ulg.ZaokragCeny },
      Self.Owner.GetMaxTicketPrice5{ Con.Zao5 }, Self.Owner.GetMaxTicketPrice10{ Con.Zao10 });
    if Ulg.NrStawkaPTU{ Ulg.NrStPtu } > 0 then begin // podatek od kwoty ulgi (dopłaty)
      ATicketPrice^.NrStU := Ulg.NrStawkaPTU{ Ulg.NrStPtu };
      ATicketPrice^.StPtuU := Self.Owner.GetCurrentRatePTU(ds, ATicketPrice^.NrStU){ StPod } / 100;
    end;
  end else begin // ulga kwotowa                          //E.B. 18.07.2016
    Self.OblBon(UlgK.BonusCount{ UlgK.LBon }, UlgK.IndexOfBonus{ UlgK.NrBonUlgi1-1 }, ds, nrpp, nrpk, kraj, @i);
    if ATicketPrice^.Brutto[zak] - ATicketPrice^.Bonif[zak] - i <= 0 then ATicketPrice^.Ulga[zak] := 0
    else ATicketPrice^.Ulga[zak] := i;
  end;
end;

function TEmar_Ride.DajCen(ds: TDateTime; WersjaPSB, nrpp, nrpk, lb: byte; nrulg, typulg, wartbil, bonEM: integer;
  c: PRTicketPrice): Cardinal;
var
  tark:               IEmar_RideTariff; // TRLTarKur;
  tar:                IEmar_Tariff;     // TRLTar;
  i, ipocz, j, pg:    integer;          // nr przystanku granicznego w trasie kursu
  odl:                integer;
  lzak:               integer;
  anrp:               array [0 .. 2] of byte;
  odlodg:             integer;
  jesttark:           boolean;
  dw:                 TDateTime;
  c1:                 TRTicketPrice;
  kr:                 boolean; // true - początek kraj (kurs zagraniczny)
  typt:               integer; // typ taryfy - 4-zagraniczna
  OdlTariff:          Integer;
  iPriceKm:           Integer;
  _Emar_PriceIndexes: IEmar_PriceIndexes;

  procedure CenaTarSt(p1, p2, typ, odl, inr, ipcen: integer);
  var
    st1, st2: Byte;
    sazera:   Boolean;
    it:       Integer;
  begin
    // if p2>High(Ans)-inr+1 then begin
    if p2 >= Self.Owner.fZoneNumberList.Count - inr + 1 then begin
      // c.Brutto[j]:=OblCenKm(tar,odl,RE,WyswRL);
      if tar.OblCenKm(odl, @iPriceKm) = ERR_NO_ERROR then c^.Brutto[j] := iPriceKm
      else c^.Brutto[j] := 0;
      Exit;
    end;
    st1 := Self.Owner.FarePriceScaleZoneNumbers.Zone[inr + p1 - 1]; // Ans[inr+p1-1];
    st2 := Self.Owner.FarePriceScaleZoneNumbers.Zone[inr + p2 - 1]; // Ans[inr+p2-1];
    if typ = 10 then begin
      it := Self.IndexOfRoute; // (kur.PoczTrasy-1+p1-1)*DRe.TRK;
      sazera := False;
      while p1 <= p2 do begin
        // E.B. 04.07.2008 program sterujący bileterki w wersji poniżej 1.04 przy
        // sprawdzaniu ciągłości strefy badał również przystanki z trasy linii, które
        // nie występują w trasie kursu (StatusPrzystanku=$80)
        if WersjaPSB{ WzZb.WersjaPSB } < 4 then // program sterujący w wersji 1.00 - 1.03
        begin
          if (Self.Owner.FarePriceScaleZoneNumbers.Zone[inr + p1 - 1]{ Ans[inr+p1-1] } = 0) then begin
            sazera := True;
            Break;
          end;
        end else if (not Self.Owner.RideRouteList[it].SkipBusStop) // (Atrk[it+12] and $08=0)
          and (Self.Owner.FarePriceScaleZoneNumbers.Zone[inr + p1 - 1]{ Ans[inr+p1-1] } = 0) then begin
          // wersja programu sterującego od 1.04 - przystanki z trasy linii nie występujące
          // w trasie kursu są pomijane
          sazera := True;
          Break;
        end;
        Inc(p1);
        Inc(it); // it := it + DRe.TRK;
      end;
      if sazera then begin
        // c.Brutto[j] := OblCenKm(tar,odl,RE,WyswRL);
        if tar.OblCenKm(odl, @iPriceKm) = ERR_NO_ERROR then c^.Brutto[j] := iPriceKm;
        Exit;
      end;
    end;
    if st2 >= st1 then st2 := st2 - st1
    else st2 := st1 - st2;
    c^.Brutto[j] := Self.Owner.PricesList[{ Self.Owner.PriceIndexesOld.PriceIndex[ }ipcen + st2{ ] }].Price;
    // Czi(Ace,ipcen+st2*DRe.CE+7);
  end; // CenaTarSt
  procedure CenaTarTb(p1, p2, podta, pdota, typ, inr, ipcen: integer);
  var
    p, k, m, nc: Integer;
  begin
    p := p1 - podta + 1;
    k := p2 - podta + 1;

    m := ((p - 1) * (2 * (pdota - podta + 1) - p) div 2) + k - p - 1;

    if typ = 9 then // E.B. 08.07.2016
    begin
      if ((inr + m) >= _Emar_PriceIndexes.Count{ High(Anc9) }) or (inr < 0) or (ipcen < 0) then nc := - 1
      else nc := _Emar_PriceIndexes.PriceIndex[inr + m] - 1; // Anc9[inr+m]-1;
    end
    else // E.B. 08.07.2016
      if ((inr + m div 2) >= Self.Owner.PriceIndexesOld.Count{ High(Anc3) }) or (inr < 0) or (ipcen < 0) then nc := - 1
        // indeks ceny poza zakresem tabeli
      else if m mod 2 = 0 then
          nc := (Self.Owner.PriceIndexesOld.PriceIndex[inr + m div 2]{ Anc3[inr+m div 2] } shr 4) - 1
      else nc := (Self.Owner.PriceIndexesOld.PriceIndex[inr + m div 2]{ Anc3[inr+m div 2] } and $0F) - 1;
    if nc >= 0 then c.Brutto[j] := Self.Owner.PricesList[ipcen + nc].Price // Czi(Ace,ipcen+nc*DRe.CE+7)
    else c.Brutto[j] := 0;
  end; // CenTarTb
  procedure CenTarTbZag(p1, p2, podta, pdota, inr, ipcen: Integer);
  var
    p, k, m, nc: integer;
  begin
    p := p1 - podta + 1;
    k := p2 - podta + 1;
    m := ((p - 1) * (2 * (pdota - podta + 1) - p) div 2) + k - p - 1;
    // E.B. 08.07.2016
    if ((inr + m) >= _Emar_PriceIndexes.Count{ High(Anc9) }) or (inr < 0) or (ipcen < 0) then nc := - 1
    else nc := _Emar_PriceIndexes.PriceIndex[inr + m] - 1; // Anc9[inr+m]-1;
    if nc >= 0 then begin
      if kr then c.Brutto[j] := Self.Owner.PricesList[ipcen + nc].Price
        // Czi(Ace,ipcen+nc*DRe.CE+7) //cena za odcinek krajowy
      else c.Brutto[j] := Self.Owner.PricesList[ipcen + nc].Zone;
      // Czi(Ace,ipcen+nc*DRe.CE+3);  //cena za odcinek zagraniczny
    end
    else c.Brutto[j] := 0;
  end; // CenTarTbZag
  procedure CenaTarKmSt(p1, p2, odl, inr, ipcen: integer; var cb: integer);
  var
    sp, so: byte; // strefa pierwszego i ostatniego przystanku
    it:     integer;
  begin
    it := Self.IndexOfRoute + p1 - 1; { kur.PoczTrasy-1+p1-1)*DRe.TRK };
    so := { 20 }Self.Owner.FarePriceScaleZoneNumbers.Zone[inr + p2 - 1]; // Ans[inr+p2-1];
    // sp := {20}Self.Owner.FarePriceScaleZoneNumbers.Zone[inr + p1 - 1]; //Ans[inr+p1-1];
    if so <> 0 then begin
      while (p1 < p2){ and(sp <> 0) } do begin
        // E.B. 04.07.2008 program sterujący bileterki w wersji poniżej 1.04 przy
        // sprawdzaniu ciągłości strefy badał również przystanki z trasy linii, które
        // nie występują w trasie kursu (StatusPrzystanku=$80)
        if WersjaPSB{ WzZb.WersjaPSB } < 4 then // program sterujący w wersji 1.00 - 1.03
        begin
          sp := { 20 }Self.Owner.FarePriceScaleZoneNumbers.Zone[inr + p1 - 1]; // Ans[inr+p1-1];
          if sp <> so then Break;
        end else if not Self.Owner.RideRouteList[it].SkipBusStop then // Atrk[it+12] and $08=0
        begin
          // wersja programu sterującego od 1.04 - przystanki z trasy linii nie występujące
          // w trasie kursu są pomijane
          sp := { 20 }Self.Owner.FarePriceScaleZoneNumbers.Zone[inr + p1 - 1]; // Ans[inr+p1-1];
          if sp <> so then Break;
        end;
        Inc(p1);
        Inc(it); // it:=it+DRe.TRK;
      end;
      Dec(so);
    end;
    if p1 = p2 then begin
      cb := { 17 }Self.Owner.PricesList[{ Self.Owner.PriceIndexesOld.PriceIndex[ }ipcen + so{ ] }].Price;
      // Czi(Ace,ipcen+so*DRe.CE+7);
    end else begin
      // cb:=OblCenKm(tar,odl,RE,WyswRL);
      if tar.OblCenKm(odl, @cb) <> ERR_NO_ERROR then cb := 0;
      Exit;
    end;
  end; // CenTarKmSt
// kraj - dla taryf zagranicznych: true-cena za odcinek krajowy, false-za zagraniczny
  procedure ObliczBUM(var c: TRTicketPrice); // bonifikata, ulga, opłata manipulacyjna
  var
    nrst:         Byte;
    iBonus:       Integer;
    iHandlingFee: Integer;
  begin
    if tar.Kind{ tar.TypTaryfy } = 4 then // E.B. 18.07.2016
        Self.OblBon(Self.BonusCount, Self.IndexOfBonus{ kur.NrBon1-1 }, ds, nrpp, nrpk, kr, @iBonus)
    else Self.OblBon(Self.BonusCount, Self.IndexOfBonus{ kur.NrBon1-1 }, ds, anrp[j], anrp[j + 1], kr, @iBonus);
    c.Bonif[j] := iBonus;

    if bonEM > 0 then c.Bonif[j] := c.Bonif[j] + c.Brutto[j] - (c.Brutto[j] * (100 - bonEM) + 50) div 100;
    if c.Bonif[j] >= c.Brutto[j] then c.Bonif[j] := 0;
    if tar.Kind{ tar.TypTaryfy } = 4 then // E.B. 18.07.2016
        Self.OblOpMan(ds, nrpp, nrpk, kr, @iHandlingFee)
    else Self.OblOpMan(ds, anrp[j], anrp[j + 1], kr, @iHandlingFee);
    c.OpMan[j] := iHandlingFee;

    if tar.DuoAllowDayCountChangeOnSale{ tar.MnOpM=1 } then c.OpMan[j] := c.OpMan[j] * lb;
    if kr then nrst := tar.IndexOfVAT{ tar.NrStPTU }
    else nrst := tar.IndexOfForeignVAT{ tar.NrStPTU1 };
    if (nrulg >= 0) and ((typulg <> 1) or (nrst <> $4E{ =78 8 })) then
      if tar.Kind{ tar.TypTaryfy } = 4 then // E.B. 18.07.2016
          Self.OblUlg({ kur.NrUlgi1-1+nrulg, c, }nrulg, nrpp, nrpk, ds, j, kr, @c)
      else Self.OblUlg({ kur.NrUlgi1-1+nrulg,c, }nrulg, anrp[j], anrp[j + 1], ds, j, kr, @c);
    c.Brutto[j] := c.Brutto[j] * lb;
    c.Bonif[j] := c.Bonif[j] * lb;
    c.Ulga1[j] := c.Ulga[j]; // E.B. 04.08.2009 - na wydruku kopii biletów powinna
    // być pokazana ulga od ceny taryfowej (dla jednego pasażera)
    c.Ulga[j] := c.Ulga[j] * lb;
    if c.NrStU > 0 then c.PTuU[j] := (Round(Int(c.Ulga[j] * c.StPtuU / (100 + c.StPtuU) * 100)) + 50) div 100;
    c.WStawce[j] := c.Brutto[j] - c.Bonif[j] - c.Ulga[j] + c.OpMan[j];
    if nrst <> 0 then begin
      c.NrSt[j] := nrst;
      if Self.Owner.StDoBaz(Self.Owner.GetCurrentRatePTU(ds, nrst){ StPod[nrst] }) > 0 then begin
        c.StPtu[j] := Self.Owner.GetCurrentRatePTU(ds, nrst){ StPod[nrst] } / 100;
        c.PTU[j] := (Round(Int(c.WStawce[j] * c.StPtu[j] / (100 + c.StPtu[j]) * 100)) + 50) div 100;
      end
      else // -2=zwolniona, -3=nie podlega
      begin
        c.StPtu[j] := Self.Owner.StDoBaz(Self.Owner.GetCurrentRatePTU(ds, nrst){ StPod[nrst] });
        c.PTU[j] := 0;
      end;
    end;
  end;

begin // DajCen
  Result := ERR_NO_ERROR;
  _Emar_PriceIndexes := Self.Owner.PriceIndexes;
  // c^.NrSt[0] := 10;

  // ds:=StrToDate(kur.DataKursu);  //E.B. 23.07.2011 - nie wiem, dlaczego cena
  // liczona była dla dnia rozpoczęcia kursu, a nie dla dnia sprzedaży biletu???
  // kto i po co dodał tę linię?? przecież przy analizie raportu procedura wywoływana
  // była z różnymi datami
  FillChar(c^.NrSt[0], SizeOf(TRTicketPrice), 0);
  i := 1;
  ds := Trunc(ds);

  while i <= Self.TariffCount do begin
    if (i < 0) or (i > Self.Owner.RideTariffList.Count) then begin
      Result := ERR_LIST_OUT_OF_RANGE;
      Exit;
    end;
    tark := Self.Owner.RideTariffList[Self.IndexOfTariff + i - 1];
    // DajRLTarK(Atk,(kur.Taryfa1-1+i-1)*DRe.TK,RE,WyswRL);
    if string(tark.ValidFrom) = ''{ 0 } then dw := StrToDate(Self.Owner.GetCalendarBegin) - 1
    else dw := StrToDate(tark.ValidFrom); // ??? //Con.PoczKal+tark.WaznaOd;
    if dw <= ds then Break;
    Inc(i);
  end;
  // if i > Self.Owner.RideTariffList.Count then
  // begin
  // Result := ERR_LIST_ITEM_NOT_FOUND;
  // Exit;
  // end;
  //
  // if (i < 0)or(i >= Self.Owner.RideTariffList.Count) then
  // begin
  // Result := ERR_LIST_OUT_OF_RANGE;
  // Exit;
  // end;

  tar := Self.Owner.TariffList[tark.IndexOfTariff]; // DajRLTar(Ata,(tark.NrTaryfy-1)*DRe.TA,RE,WyswRL);
  typt := tar.Kind;
  if typt = 4 then begin
    kr := Self.VATOrder;                          // kur.PoczKraj;
    pg := Self.VATChangeBusStopIndex + 1;         // kur.PrzGran;
    c^.przgran := Self.VATChangeBusStopIndex + 1; // kur.PrzGran; //E.B. 16.06.2009
    if Self.VATOrder{ kur.PoczKraj } then begin
      if pg >= nrpk then begin
        lzak := 1;
        anrp[0] := nrpp;
        anrp[1] := nrpk; // relacja krajowa
        kr := True;      // E.B. 26.07.2010
      end else if pg <= nrpp then begin
        lzak := 1;
        anrp[0] := nrpp;
        anrp[1] := nrpk; // relacja zagraniczna
        kr := False;     // E.B. 26.07.2010
      end else begin
        lzak := 2;
        anrp[0] := nrpp;
        anrp[1] := pg;
        anrp[2] := nrpk;
      end;
    end else begin
      if pg <= nrpp then begin
        lzak := 1;
        anrp[0] := nrpp;
        anrp[1] := nrpk; // relacja krajowa
        kr := True;      // E.B. 26.07.2010
      end else if pg >= nrpk then begin
        lzak := 1;
        anrp[0] := nrpp;
        anrp[1] := nrpk; // relacja zagraniczna
        kr := False;     // E.B. 26.07.2010
      end else begin
        lzak := 2;
        anrp[0] := nrpp;
        anrp[1] := pg;
        anrp[2] := nrpk;
      end;
    end;
  end else begin
    kr := True;
    lzak := 1;
    anrp[0] := nrpp;
    if (tark.IndexOfLastBusStopInRoute + 1{ tark.DoPrzyst } > nrpp) and
      (tark.IndexOfLastBusStopInRoute + 1{ tark.DoPrzyst } < nrpk) then begin
      anrp[1] := tark.IndexOfLastBusStopInRoute + 1{ tark.DoPrzyst };
      lzak := 2;
      c^.nrpg := anrp[1];
    end else if (tark.IndexOfFirstBusStopInRoute + 1{ tark.OdPrzyst } > nrpp) and
      (tark.IndexOfFirstBusStopInRoute + 1{ tark.OdPrzyst } < nrpk) then begin
      anrp[1] := tark.IndexOfFirstBusStopInRoute + 1{ tark.OdPrzyst };
      lzak := 2;
      c^.nrpg := anrp[1];
    end;
    anrp[lzak] := nrpk;
  end;
  ipocz := i;
  c1 := c^;
  for j := 0 to lzak - 1 do begin
    // c1.Odl[j]:=OblOdlPrz(Atrk,(Self.IndexOfRoute {kur.PoczTrasy}-1+anrp[j]-1)*DRe.TRK,
    // (Self.IndexOfRoute {kur.PoczTrasy}-1+anrp[j+1]-1)*DRe.TRK,DRe.TRK,0,odlodg,c1.OdlTarOK,
    // c1.OdlDrog[j]);
    Self.Owner.OblOdlPrz(Self.IndexOfRoute{ kur.PoczTrasy-1 } + anrp[j] - 1, Self.IndexOfRoute{ kur.PoczTrasy-1 } +
      anrp[j + 1] - 1, 0, @odlodg, @(c1.OdlTarOK), @(c1.OdlDrog[j]), @OdlTariff);
    c1.Odl[j] := OdlTariff;

    // odl:=OblOdlPrz(Atrk,(Self.IndexOfRoute {kur.PoczTrasy}-1+anrp[j]-1)*DRe.TRK,
    // (Self.IndexOfRoute {kur.PoczTrasy}-1+anrp[j+1]-1)*DRe.TRK,DRe.TRK,1,odlodg,c.OdlTarOK,
    // c.OdlDrog[j]);
    Self.Owner.OblOdlPrz(Self.IndexOfRoute{ kur.PoczTrasy-1 } + anrp[j] - 1, Self.IndexOfRoute{ kur.PoczTrasy-1 } +
      anrp[j + 1] - 1, 1, @odlodg, @(c^.OdlTarOK), @(c^.OdlDrog[j]), @OdlTariff);
    odl := OdlTariff;
    c^.Odl[j] := odl;
    // E.B. 15.01.2016 - w taryfie zagranicznej mogą być tabele cen ważne wg kalendarza
    // if typt<>4 then begin
    jesttark := False;
    while i <= Self.TariffCount{ kur.LTaryf } do begin
      if not ((tark.IndexOfFirstBusStopInRoute + 1{ tark.OdPrzyst } <= anrp[j]) and
        (tark.IndexOfLastBusStopInRoute + 1{ tark.DoPrzyst } >= anrp[j + 1])) then begin
        Inc(i);
        tark := Self.Owner.RideTariffList[Self.IndexOfTariff + i - 1];
        // DajRLTarK(Atk,(Self.IndexOfTariff {kur.Taryfa1}-1+i-1)*DRe.TK,RE,WyswRL);
        Continue;
      end;
      if (tark.SprKal(ds, @jesttark) = ERR_NO_ERROR) and jesttark then // if SprKal(tark.KalDniWaz,ds,RE,WyswRL) then
      // if (String(tark.ValidFrom) = '')or(StrToDate(tark.ValidFrom) <= ds) then // ???
      begin
        // jesttark := True;
        Break;
      end;
      inc(i);
      tark := Self.Owner.RideTariffList[Self.IndexOfTariff + i - 1];
      // DajRLTarK(Atk,(Self.IndexOfTariff {kur.Taryfa1}-1+i-1)*DRe.TK,RE,WyswRL);
    end;
    if jesttark then tar := Self.Owner.TariffList[tark.IndexOfTariff];
    // DajRLTar(Ata,(tark.IndexOfTariff {tark.NrTaryfy}-1)*DRe.TA,RE,WyswRL);
    // end
    // else jesttark:=true;
    if jesttark then begin
      case tar.Kind of
      1{ kilometrowa }: begin
          // c.Brutto[j]:=OblCenKm(tar,odl,RE,WyswRL);
          Result := tar.OblCenKm(odl, @iPriceKm);
          if Result = ERR_NO_ERROR then c^.Brutto[j] := iPriceKm
          else Exit;
          if odl = c1.odl[j] then c1.Brutto[j] := c^.Brutto[j]
          else begin
            // c1.Brutto[j]:=OblCenKm(tar,c1.odl[j],RE,WyswRL);
            Result := tar.OblCenKm(c1.odl[j], @iPriceKm);
            if Result = ERR_NO_ERROR then c1.Brutto[j] := iPriceKm
            else Exit;
          end;
        end;
      2{ strefowa }, 10{ strefowo-kilometrowa }: begin
          CenaTarSt(anrp[j] - tark.IndexOfFirstBusStopInRoute{ tark.OdPrzyst + 1 },
            anrp[j + 1] - tark.IndexOfFirstBusStopInRoute{ tark.OdPrzyst + 1 }, tar.Kind, odl,
            tark.FirstPriceIndex{ tark.NrPInd-1 }, tar.IndexOfPrice{ tar.NrPCeny-1 });
          c1.Brutto[j] := c^.Brutto[j];
        end;
      3{ tabelowa typu 1 (max 15 cen w taryfie) }, 9{ tabelowa typu 2 (max 255 cen w taryfie) }: begin
          CenaTarTb(anrp[j], anrp[j + 1], tark.IndexOfFirstBusStopInRoute + 1{ tark.OdPrzyst },
            tark.IndexOfLastBusStopInRoute + 1{ tark.DoPrzyst }, tar.Kind, tark.FirstPriceIndex{ tark.NrPInd-1 },
            tar.IndexOfPrice{ tar.NrPCeny-1 });
          c1.Brutto[j] := c^.Brutto[j];
        end;
      4{ zagraniczna (max 255 cen w taryfie) }: begin
          CenTarTbZag(nrpp, nrpk, tark.IndexOfFirstBusStopInRoute + 1{ tark.OdPrzyst },
            tark.IndexOfLastBusStopInRoute + 1{ tark.DoPrzyst }, tark.FirstPriceIndex{ tark.NrPInd-1 },
            tar.IndexOfPrice{ tar.NrPCeny-1 });
          c1.Brutto[j] := c^.Brutto[j];
        end;
      5{ kilometrowo-strefowa }: begin
          CenaTarKmSt(anrp[j] - tark.IndexOfFirstBusStopInRoute{ tark.OdPrzyst },
            anrp[j + 1] - tark.IndexOfFirstBusStopInRoute{ tark.OdPrzyst }, odl, tark.FirstPriceIndex{ tark.NrPInd-1 },
            tar.IndexOfPrice{ tar.NrPCeny-1 }, c^.Brutto[j]);
          if odl = c1.odl[j] then c1.Brutto[j] := c^.Brutto[j]
          else CenaTarKmSt(anrp[j] - tark.IndexOfFirstBusStopInRoute{ tark.OdPrzyst },
              anrp[j + 1] - tark.IndexOfFirstBusStopInRoute{ tark.OdPrzyst }, c1.odl[j],
              tark.FirstPriceIndex{ tark.NrPInd-1 }, tar.IndexOfPrice{ tar.NrPCeny-1 }, c1.Brutto[j]);
        end;
      end;
      c^.Cena[j] := c^.Brutto[j];
      c1.Cena[j] := c^.Brutto[j];
      ObliczBUM(c^);
      if (c^.odl[j] <> c1.odl[j]) and (c^.Brutto[j] <> wartbil) then begin
        ObliczBUM(c1);
        c^ := c1;
      end;
    end;
    i := ipocz;
    if typt <> 4 then tark := Self.Owner.RideTariffList[Self.IndexOfTariff + i - 1]
      // DajRLTarK(Atk,(Self.IndexOfTariff {kur.Taryfa1}-1+i-1)*DRe.TK,RE,WyswRL)
    else kr := not kr;
  end;
end; // DajCen

function TEmar_Ride.DajCenBag(ds: TDateTime; WersjaPSB, nrpp, nrpk, lbil: Byte; wartbil: Integer; c: PRTicketPrice)
  : Cardinal; stdcall;
var
  tark:        IEmar_RideTariff; // TRLTarKur;
  tar:         IEmar_Tariff;     // TRLTar;
  i, iPriceKm: integer;
  dw:          TDateTime;
  odl, odlodg: integer;
  jesttarb:    boolean;
  cb:          TRTicketPrice; // TRcen;
begin                         // DajCenBag
  Result := ERR_NO_ERROR;
  FillChar(c^.NrSt[0], SizeOf(TRTicketPrice), 0);
  i := 1;
  ds := Trunc(ds);
  while i <= Self.BaggageTariffCount{ kur.LTaryfBag } do begin
    if ((Self.IndexOfBaggageTariff + i - 1) < 0) or
      ((Self.IndexOfBaggageTariff + i - 1) >= Self.Owner.LuggageTariffList.Count) then begin
      Result := ERR_LIST_OUT_OF_RANGE;
      Exit;
    end;
    tark := Self.Owner.LuggageTariffList[Self.IndexOfBaggageTariff + i - 1];
    // DajRLTarK(Atbk,(kur.TaryfaBag1-1+i-1)*DRe.TBK,RE,WyswRL);

    if string(tark.ValidFrom) = ''{ 0 } then dw := StrToDate(Self.Owner.GetCalendarBegin) - 1
    else dw := StrToDate(tark.ValidFrom); // ??? //Con.PoczKal+tark.WaznaOd;
    if dw <= ds then Break;
    Inc(i);
  end;
  // odl := OblOdlPrz(Atrk,(kur.PoczTrasy-1+nrpp-1)*DRe.TRK,
  // (kur.PoczTrasy-1+nrpk-1)*DRe.TRK,DRe.TRK,0,odlodg,c.OdlTarOK,c.OdlDrog[0]);
  // c.Odl[0] := odl;
  Self.Owner.OblOdlPrz(Self.IndexOfRoute{ kur.PoczTrasy-1 } + nrpp - 1, Self.IndexOfRoute{ kur.PoczTrasy-1 } + nrpk - 1,
    0, @odlodg, @(c^.OdlTarOK), @(c^.OdlDrog[0]), @odl);
  c^.Odl[0] := odl;
  jesttarb := False;
  while i <= Self.BaggageTariffCount{ kur.LTaryfBag } do begin
    if (tark.IndexOfFirstBusStopInRoute + 1{ tark.OdPrzyst } > nrpp) or
      (tark.IndexOfLastBusStopInRoute + 1{ tark.DoPrzyst } < nrpk) then Break;
    if (tark.SprKal(ds, @jesttarb) = ERR_NO_ERROR) and jesttarb then // if SprKal(tark.KalDniWaz,ds,RE,WyswRL) then
    // if (String(tark.ValidFrom) = '')or(StrToDate(tark.ValidFrom) <= ds) then // ???
    begin
      // jesttarb := True;
      Break;
    end;
    Inc(i);
    tark := Self.Owner.LuggageTariffList[Self.IndexOfBaggageTariff + i - 1];
    // DajRLTarK(Atbk,(kur.TaryfaBag1-1+i-1)*DRe.TBK,RE,WyswRL);
  end;
  if jesttarb then begin
    tar := Self.Owner.TariffList[tark.IndexOfTariff{ - 1 }]; // DajRLTar(Ata,(tark.NrTaryfy-1)*DRe.TA,RE,WyswRL);
    case tar.Kind{ tar.TypTaryfy } of
    11{ bagażowa – od odległości }: begin
        if tar.OblCenKm(odl, @iPriceKm) = ERR_NO_ERROR then c^.Brutto[0] := iPriceKm * lbil
          // OblCenKm(tar,odl,RE,WyswRL)*lbil;
        else c^.Brutto[0] := 0;
      end;
    6{ bagażowa – od ceny za przejazd }: begin
        DajCen(ds, WersjaPSB, nrpp, nrpk, 1, - 1, 0, - 1, 0, @cb);
        // DajCen(kur,ds,nrpp,nrpk,1,-1,0,0,-1,0,cb,RE,WyswRL);
        if tar.OblCenKm(cb.Brutto[0] + cb.Brutto[1], @iPriceKm) = ERR_NO_ERROR then c^.Brutto[0] := iPriceKm * lbil
          // OblCenKm(tar,cb.Brutto[0]+cb.Brutto[1],RE,WyswRL)*lbil;
        else c^.Brutto[0] := 0;
      end;
    end;
    c^.Cena[0] := c^.Brutto[0];
    c^.WStawce[0] := c^.Brutto[0];
    if tar.IndexOfVAT{ tar.NrStPTU } <> 0 then begin
      c^.NrSt[0] := tar.IndexOfVAT; // Tar.NrStPTU;
      if Self.Owner.StDoBaz(Self.Owner.GetCurrentRatePTU(ds, tar.IndexOfVAT){ StPod[tar.NrStPTU] }) > 0 then begin
        c^.StPtu[0] := Self.Owner.GetCurrentRatePTU(ds, tar.IndexOfVAT){ StPod[tar.NrStPTU] } / 100;
        // c^.PTU[0]:=Round(c^.Brutto[0]*c^.StPtu[0]/(100+c.StPtu[0]));
        // E.B. 11.01.2005
        c^.PTU[0] := (Round(Int(c^.Brutto[0] * c^.StPtu[0] / (100 + c^.StPtu[0]) * 100)) + 50) div 100;
      end
      else // -2=zwolniona, -3=nie podlega
      begin
        c^.StPtu[0] := Self.Owner.StDoBaz(Self.Owner.GetCurrentRatePTU(ds, tar.IndexOfVAT)){ StPod[tar.NrStPTU] };
        c^.PTU[0] := 0;
      end;
    end;
  end;
end; // DajCenBag

