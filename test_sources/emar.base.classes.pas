procedure TEmar_Driver.WriteStructToJson(jtw: TJsonTextWriter);
begin
  jtw.WritePropertyName(jSTR);
  jtw.WriteStartArray;
  jtw.WriteValue('FirstName');
  jtw.WriteValue('LastName');
  jtw.WriteEndArray;

  jtw.WritePropertyName(jINT);
  jtw.WriteStartArray;
  jtw.WriteValue('Number');
  jtw.WriteValue('Status');
  jtw.WriteValue('PIN');
  jtw.WriteValue('Status1');
  jtw.WriteValue('Status2');
  jtw.WriteValue('Status3');
  jtw.WriteValue('Status4');
  jtw.WriteValue('O205_1');
  jtw.WriteValue('O205_2');
  jtw.WriteValue('O205_3');
  jtw.WriteValue('O205_4');
  jtw.WriteValue('DaysBeforeBlock');
  jtw.WriteValue('DaysBeforePrompt');
  jtw.WriteValue('MaxPassengersOnGroupTicket');
  jtw.WriteEndArray;

  jtw.WritePropertyName(jBOOL);
  jtw.WriteStartArray;
  // Status 1
  jtw.WriteValue('RideBusStopNumberFromOne');   // bit 7
  jtw.WriteValue('GroupTicketAllowed');         // bit 6
  jtw.WriteValue('CanBackwardAfterTicketSold'); // bit 5
  jtw.WriteValue('PrintControlTicketAllowed');  // bit 4
  jtw.WriteValue('DriverTaskReportAllowed');    // bit 3
  jtw.WriteValue('NoLimitPrintTaskReport');     // bit 2
  jtw.WriteValue('AdditionalFeesAllowed');      // bit 1
  jtw.WriteValue('ChangeClockSettingAllowed');  // bit 0
  // Status 2
  jtw.WriteValue('PeriodicReportsAllowed');           // bit 7
  jtw.WriteValue('RideReportAllowed');                // bit 6
  jtw.WriteValue('ShowPassengerNameOnTicketControl'); // bit 5
  jtw.WriteValue('TicketRegisterChangeAllowed');      // bit 4
  jtw.WriteValue('ChangeMenuAccessCodeAllowed');      // bit 3
  jtw.WriteValue('FullFillCardWorkMode');             // bit 2
  jtw.WriteValue('CheckingControlNumbers');           // bit 1
  jtw.WriteValue('ChoiceRideBeyondCalendar');         // bit 0
  // Status 3
  jtw.WriteValue('StarKeySwitchSaleMode');                   // bit 7
  jtw.WriteValue('BusSideNumberEntering');                   // bit 6
  jtw.WriteValue('OptionalBusSideNumberEntering');           // bit 5
  jtw.WriteValue('HintBusSideNumberStoredInTicketRegister'); // bit 4
  jtw.WriteValue('RemaindPrintMonthFiscalReport');           // bit 3
  jtw.WriteValue('ForcePrintMonthFiscalReport');             // bit 2
  jtw.WriteValue('PayInForeignCurrencyAllowed');             // bit 1
  jtw.WriteValue('PrintSideNumberOnTicket');                 // bit 0
  // Status 4
  jtw.WriteValue('CashOnlyPayment');                  // bit 7
  jtw.WriteValue('ShowBilanceAllowed');               // bit 6
  jtw.WriteValue('ChoiceRideBeyondTaskAllowed');      // bit 5
  jtw.WriteValue('ChoiceReliefWithouEnteringNumber'); // bit 4
  jtw.WriteValue('SaveRideInfoToCardWithoutPrint');   // bit 3
  jtw.WriteValue('NextTicketPeriodSaleAllowed');      // bit 2
  jtw.WriteValue('PrintBillRestForeignCurrency');     // bit 1
  jtw.WriteValue('PrintLineData');                    // bit 0
  // Option205 1
  jtw.WriteValue('UsePaymentTerminal');                // bit 7
  jtw.WriteValue('CardPaymentWithoutPaymentTerminal'); // bit 6
  jtw.WriteEndArray;
end;

