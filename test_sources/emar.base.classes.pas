function TEmar_DriverBalances_File.SaveToStream(aStream: TStream): longword;
var
  str: TStringStream;
  i:   integer;
  hm:  THashManager;
  s:   ansistring;
begin
  str := TStringStream(aStream);
  str.WriteString(C_TXT_DRIVERBALANCES_HEADER + #13#10);
  str.WriteString(Format(C_FMT_DRIVERBALANCES_DATETIME, [Self.PrepareDate, Self.PrepareTime]) + #13#10);
  for i := 0 to Pred(DriverList.Count) do str.WriteString(DriverList[i].SaveToBuffer + #13#10);
  str.Position := 0; // ??? 0?
  hm := THashManager.Create(nil);
  try
    hm.Algorithm := 'Message Digest 5';
    hm.CalcStream(str, str.Size);
    s := 'FFFE' + hm.DigestString[fmtHEX];
    str.Seek(0, soFromEnd);
    str.Write(s[1], Length(s));
  finally
    hm.Free;
  end;
  Result := ERR_NO_ERROR;
end;

