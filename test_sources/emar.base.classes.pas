procedure TEmar_InterfacedObject.CopyString(p: PAnsiChar; max: integer; src: string);
var
  i:  integer;
  pp: PAnsiChar;
begin
  pp := p;
  for i := 1 to max do
    if i <= Length(src) then begin
      pp^ := ansichar(src[i]);
      Inc(pp^);
    end;
end;

