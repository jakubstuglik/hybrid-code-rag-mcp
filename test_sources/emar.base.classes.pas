procedure TEmar_DriverSalePrefSet.SetCardStatus(ix: TEmar205_DriverSaleStatusBytes; const Value: byte);
begin
  case ix of
  1: begin
      fRideBusStopNumberFromOne := Value and $80 = 0;
      fGroupTicketAllowed := Value and $40 = 0;
      fCanBackwardAfterTicketSold := Value and $20 = 0;
      fPrintControlTicketAllowed := Value and $10 = 0;
      fDriverTaskReportAllowed := Value and $08 = 0;
      fNoLimitPrintTaskReport := Value and $04 = 0;
      fAdditionalFeesAllowed := Value and $02 = 0;
      fChangeClockSettingAllowed := Value and $01 = 0;
    end;
  2: begin
      fPeriodicReportsAllowed := Value and $80 = 0;
      fRideReportAllowed := Value and $40 = 0;
      fShowPassengerNameOnTicketControl := Value and $20 = 0;
      fTicketRegisterChangeAllowed := Value and $10 = 0; // T32152
      fChangeMenuAccessCodeAllowed := Value and $08 = 0;
      fFullFillCardWorkMode := Value and $04 = 0;
      fCheckingControlNumbers := Value and $02 <> 0;
      fChoiceRideBeyondCalendar := Value and $01 = 0;
    end;
  3: begin
      fStarKeySwitchSaleMode := Value and $80 <> 0;
      fBusSideNumberEntering := Value and $40 = 0;
      fOptionalBusSideNumberEntering := Value and $20 <> 0;
      fHintBusSideNumberStoredInTicketRegister := Value and $10 = 0;
      fRemaindPrintMonthFiscalReport := Value and $08 = 0;
      fForcePrintMonthFiscalReport := Value and $04 = 0;
      fPayInForeignCurrencyAllowed := Value and $02 = 0;
      fPrintSideNumberOnTicket := Value and $01 = 0;
    end;
  4: begin
      fCashOnlyPayment := Value and $80 <> 0; // zadanie 66588 !!!
      fShowBilanceAllowed := Value and $40 <> 0;
      fChoiceReliefWithouEnteringNumber := Value and $20 <> 0;
      fChoiceRideBeyondTaskAllowed := Value and $10 <> 0;
      fSaveRideInfoToCardWithoutPrint := Value and $08 <> 0;
      fNextTicketPeriodSaleAllowed := Value and $04 = 0;
      fPrintBillRestForeignCurrency := Value and $02 <> 0;
      fPrintLineData := Value and $01 = 0;
    end;
  end;
end;

