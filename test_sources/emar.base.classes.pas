procedure TEmar_BaseFile.SaveList(aList: IEmar_InterfaceList; aStream: TStream = nil);
var
  ms:               TMemoryStream;
  l:                TEmar_InterfaceList;
  i, np, pp, cp, j: integer;
  de:               IEmar_DirEntry;
  irr:              IEmar_ReferenceRide;
begin
  if not Assigned(aStream) then aStream := fStream;
  if Assigned(aStream) then begin
    ms := TMemoryStream.Create;
    try
      l := TEmar_InterfaceList(aList);
      if (l.Id = 100) or (l.Count > 0) then begin
        case fFileType of
        EMAR_FILE_TYPE_EMAR105, EMAR_FILE_TYPE_CKM, EMAR_FILE_TYPE_EMAR205: begin
            cp := Fat.IndexOfFirstPage($FF, fAtPageNumber);
            if cp < 0 then Exit; // może raise jakiś ???
            i := Dir.IndexOf(l.Id);
            if i < 0 then de := Dir.AddItem(l.id)
            else de := Dir[i];
            de.FirstPage := cp;
            de.RecCount := l.Count;
            de.Version := _RecordVersion(fVersion, l.Id);
            if l.Id = 100 then begin
              de.RecLength := 255;
              Fat.PageId[cp] := 100;
              if l.Count = 0 then Inc(fAtPageNumber);
            end else begin
              // de.Version := _RecordVersion(fVersion, l.Id);
              de.RecLength := l[0].RecordLength(fVersion);
            end;
            FillChar(fPage, FLASH_528, $FF);
            ms.Clear;
            if FileType = EMAR_FILE_TYPE_CKM then ms.Write(fPage, 512)
            else ms.Write(fPage, SizeOf(fPage));
            if (l.Id = 100)and(l.Count = 0) then
            begin
              pp := $FFFF;
              np := $FFFF;
              ms.Read(fPage, FLASH_528);
              fPage.aContent[0] := l.Id;
              FillPageCtrlBytes(fPage, l.Id, cp, pp, np);
              aStream.Write(fPage, FLASH_528);
            end
            else
            begin
              ms.Position := 0;
              pp := $FFFF;
              for i := 0 to l.Count - 1 do begin
                j := ms.Position;
                l[i].SaveToBuffer(ms, fVersion);
                if l.Id = TEmar_RideList(fRideList).Id then begin
                  irr := fReferenceRideList.AddItem;
                  irr.RideNumber := (l[i] as IEmar_Ride).Number;
                  irr.Departure := (l[i] as IEmar_Ride).DepartureTime;
                  irr.PageNumber := cp;
                  irr.AdrressesOfBeginningRecord := j;
                end;
                if ms.Position + l[i].RecordLength(fVersion) > 512 then begin
                  if i < l.Count - 1 then np := cp + 1
                  else np := $FFFF;
                  ms.Position := 0;
                  if FileType = EMAR_FILE_TYPE_CKM then begin
                    ms.Read(fPage, 512);
                    aStream.Write(fPage, 512)
                  end else begin
                    ms.Read(fPage, FLASH_528);
                    FillPageCtrlBytes(fPage, l.Id, cp, pp, np);
                    aStream.Write(fPage, FLASH_528);
                  end;
                  Fat.PageId[cp] := l.Id;
                  pp := cp;
                  Inc(cp);
                  fAtPageNumber := cp;
                  FillChar(fPage, FLASH_528, $FF);
                  ms.Position := 0;
                  if FileType = EMAR_FILE_TYPE_CKM then ms.Write(fPage, 512)
                  else ms.Write(fPage, FLASH_528);
                  ms.Position := 0;
                end;
              end;
              if ms.Position > 0 then begin
                Fat.PageId[cp] := l.Id;
                ms.Position := 0;
                if FileType = EMAR_FILE_TYPE_CKM then begin
                  ms.Read(fPage, 512);
                  aStream.Write(fPage, 512);
                end else begin
                  ms.Read(fPage, FLASH_528);
                  FillPageCtrlBytes(fPage, l.Id, cp, pp, $FFFF);
                  aStream.Write(fPage, FLASH_528);
                end;
                fAtPageNumber := cp + 1;
              end;
            end;
          end;
        end;
      end;
    finally
      ms.Free;
    end;
  end;
end;

function TEmar_BaseFile.SaveToFile(aFilePath: pchar; aVersion: integer; aSaveMode: integer): longword;
begin
  fLastSavedFileName := aFilePath;
  if not(aSaveMode in
    [
      EMAR_SAVEMODE_FILE_A
      , EMAR_SAVEMODE_REPORT_ONLY
      , EMAR_SAVEMODE_FULL_REPORT
      , EMAR_SAVEMODE_FILE_A80_EXPORT
      , EMAR_SAVEMODE_FILE_DD0_EXPORT
    ])
  then
    Result := ERR_UNEXPECTED_SAVEMODE
  else
  try
    SaveMode := aSaveMode;
    if SaveMode <> EMAR_SAVEMODE_JSON_DD then begin
      fStream.Clear;
      try
        Result := SaveToStream(fStream, aVersion);
  {$IFNDEF ZIP}
        // jeśli używamy ZIP, to plik już jest zapisany.
        if Result = ERR_NO_ERROR then fStream.SaveToFile(aFilePath);
  {$ENDIF}
      finally
        fStream.Clear;
      end;
    end else
      Result := ERR_UNEXPECTED_SAVEMODE;
  except
    Result := ERR_INCORRECT_FILE;
  end;
end;

function TEmar_BaseFile.OblOdlPrz(AIndexOfBusStopStartInRoute, AIndexOfBusStopEndInRoute: Integer; const AWar: Byte;
  DodOdlOdg: PInteger; OdlTarOK: PBoolean; OdlDrog, OdlTariff: PInteger): Cardinal;
// Emar-105
// oblicza odległość między przystankami
// AIndexOfBusStopStartInRoute,AIndexOfBusStopEndInRoute: indeksy przystanków początkowego i docelowego w Atrk
// ABusStopCount: długość rekordu (DRTRK)
// Result - odległość taryfowa
// OdlDrog - odległość drogowa
// AWar=0 - jeśli trasa wg linii i odgałęzienie, to pierwszy przystanek za
// odgałęzieniem musi być bezpośrednio za ostatnim przystankiem
// w odgałęzieniu (jeśli pomiędzy nimi wystąpi przystanek ze statusem $08,
// to odległość przejechana w ogdałęzieniu nie jest pomijana)
// Odległość będzie obliczone poprawnie, jeśli pomijane przystanki
// będą miały status $88
// AWar=1 - w sytuacji j.w. ignorowane są wszystkie przystanki ze statusem $08
// za odgałęzieniem, niezależnie od tego, czy mają status $88, czy $08
// Od wersji 1.28 programu (20.07.2002) poprawiony został zapis trasy kursu
// wg linii do zbioru - wszystkie pomijane przystanki za odgałęzieniem
// mają wpisany status $88 - bileterka traktuje je jak przystanki w odgałęzieniu
// - poprawnie rozpoznaje koniec odgałązienia i pomija długość odgałęzienia
// przy relacjach nie rozpoczynających się i nie kończących w odgałęzieniu
var
  odgp:            Boolean;
  odldodg, odlodg: Integer;
  odld, odld0,        // odległości drogowe
  odl, odl0: Integer; // odległości taryfowe
begin
  if (AIndexOfBusStopStartInRoute < 0) or (AIndexOfBusStopStartInRoute >= RideRouteList.Count) then
      Exit(ERR_LIST_OUT_OF_RANGE)
  else if (AIndexOfBusStopEndInRoute < 0) or (AIndexOfBusStopEndInRoute >= RideRouteList.Count) then
      Exit(ERR_LIST_OUT_OF_RANGE)
  else Result := ERR_NO_ERROR;

  odgp := RideRouteList.Items[AIndexOfBusStopStartInRoute].InBranch;
  // Atrk[AIndexOfBusStopStartInRoute+12] and $80=$80;
  OdlTarOK^ := True;
  odl := 0;
  odlodg := 0;
  DodOdlOdg^ := 0;
  odld := 0;
  odldodg := 0;
  OdlDrog^ := 0;
  OdlTariff^ := 0;
  if AIndexOfBusStopEndInRoute > AIndexOfBusStopStartInRoute then // E.B. 09.09.2005
    repeat
      Inc(AIndexOfBusStopStartInRoute);
      if not odgp and RideRouteList.Items[AIndexOfBusStopStartInRoute].InBranch then
      // (Atrk[AIndexOfBusStopStartInRoute+12] and $80=$80) then begin
      begin
        odl0 := RideRouteList.Items[AIndexOfBusStopStartInRoute].FareDistance;
        // Smallint(Czw(Atrk,AIndexOfBusStopStartInRoute+10));
        odld0 := RideRouteList.Items[AIndexOfBusStopStartInRoute].Distance;
        // Smallint(Czw(Atrk,AIndexOfBusStopStartInRoute+8));
        odlodg := odlodg + odl0;
        odldodg := odldodg + odld0;
        if odl0 < 0 then OdlTarOK^ := False;
      end else begin
        if (AWar = 0) and RideRouteList.Items[AIndexOfBusStopStartInRoute].SkipBusStop then
        // (Atrk[AIndexOfBusStopStartInRoute+12] and $08=$08) then begin
        begin
          odl := odl + odlodg;
          odld := odld + odldodg;
          DodOdlOdg^ := DodOdlOdg^ + odlodg;
        end;
        odlodg := 0;
        odldodg := 0;
        // if Atrk[AIndexOfBusStopStartInRoute+12] and $01=$01 then
        if RideRouteList.Items[AIndexOfBusStopStartInRoute].IsFirstBusStopAfterBranch then begin
          if odgp then begin
            odl := odl + RideRouteList.Items[AIndexOfBusStopStartInRoute].FareDistanceInShortcut;
            // Atrk[AIndexOfBusStopStartInRoute+10];
            odgp := False;
            odld := odld + RideRouteList.Items[AIndexOfBusStopStartInRoute].DistanceInShortcut;
            // Atrk[AIndexOfBusStopStartInRoute+8];
          end else begin
            odl := odl + RideRouteList.Items[AIndexOfBusStopStartInRoute].FareDistance;
            // Atrk[AIndexOfBusStopStartInRoute+11];
            odld := odld + RideRouteList.Items[AIndexOfBusStopStartInRoute].Distance;
            // Atrk[AIndexOfBusStopStartInRoute+9];
          end;
        end else begin
          odl0 := RideRouteList.Items[AIndexOfBusStopStartInRoute].FareDistance;
          // Smallint(Czw(Atrk,AIndexOfBusStopStartInRoute+10));
          odl := odl + odl0;
          odld0 := RideRouteList.Items[AIndexOfBusStopStartInRoute].Distance;
          // Smallint(Czw(Atrk,AIndexOfBusStopStartInRoute+8));
          odld := odld + odld0;
          if odl0 < 0 then OdlTarOK^ := False;
        end;
      end;
    until AIndexOfBusStopStartInRoute = AIndexOfBusStopEndInRoute;
  odl := odl + odlodg;
  odld := odld + odldodg;
  // Result:=odl;
  OdlDrog^ := odld;
  OdlTariff^ := odl;
end;

