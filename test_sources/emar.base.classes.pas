procedure TEmar_InterfaceList.QuickSort(iLo, iHi: Integer; SCompare: TEmar_InterfaceListSortCompare);
var
  I, J, P: Integer;
begin
  repeat
    I := iLo;
    J := iHi;
    P := (iLo + iHi) shr 1;
    repeat
      while SCompare(Self, I, P) < 0 do Inc(I);
      while SCompare(Self, J, P) > 0 do Dec(J);
      if I <= J then begin
        if I <> J then fItems.Exchange(I, J);
        if P = I then P := J
        else if P = J then P := I;
        Inc(I);
        Dec(J);
      end;
    until I > J;
    if iLo < J then QuickSort(iLo, J, SCompare);
    iLo := I;
  until I >= iHi;
end;

procedure TEmar_InterfaceList.SetCapacity(const Value: integer);
begin
  fItems.Capacity := Value;
end;

procedure TEmar_InterfaceList._Sort(SCompare: TEmar_InterfaceListSortCompare);
begin
  if (fItems.Count < 2) or not Assigned(SCompare) then Exit;
  QuickSort(0, fItems.Count - 1, SCompare);
end;

procedure TEmar_InterfaceList._Clear;
begin
  fItems.Clear;
end;

