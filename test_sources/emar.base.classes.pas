procedure TEmar_BaseFile.TryToRepairFAT(AStream: TMemoryStream);
var
  i, i100, i101, iMaxPage, iPage, iPagesCount: Integer;
  locFAT1: TEmar_Fat;
  locDIR1: TEmar_Dir;
  de:   IEmar_DirEntry;
  pg:   TEmarPage528;
begin
  // TODO 1: add support of Emar-205 card file
  if Assigned(AStream) and(AStream.Size > 0) then
  begin
    iPagesCount := AStream.Size div FLASH_528;
    if Fat.PageCount <> iPagesCount then
      Exit;

    locFAT1 := TEmar_Fat.Create(Self, 1);
    try
      AStream.Seek(0, soFromBeginning); // FAT1
      AStream.Read(locFAT1.fPages[0], FLASH_528 * (locFAT1.PageCount div 512));

      locDIR1 := TEmar_Dir.Create(Self, 1);
      try
        locDIR1.LoadFromBuffer(AStream, 0); // DIR1

        i100 := locDIR1.IndexOf(100);
        if i100 <> -1 then
        begin
          de := locDIR1.Items[i100];
          i100 := de.FirstPage;
        end;
        i101 := locDIR1.IndexOf(101);
        if i101 <> -1 then
        begin
          de := locDIR1.Items[i101];
          i101 := de.FirstPage;
        end;
      finally
        FreeAndNil(locDIR1);
      end;

      // TODO 2: check if data page starts from the page # 256 in Emar-205 and CKM
      if (i100 = -1)or(i101 = -1) then
      begin
        i := 0;
        repeat
          AStream.Seek((256 + i) * FLASH_528, soFromBeginning);
          AStream.Read(pg.aContent[0], 1);
          if pg.aContent[0] = 100 then
            i100 := 256 + i
          else
            if pg.aContent[0] = 101 then
              i101 := 256 + i;
          Inc(i);
        until (i100 <> -1)and(i101 <> -1)or(i >= iPagesCount);
      end;

      if (i100 = -1)or(i101 = -1) then
        Exit;

      i := Dir.IndexOf(100);
      if i = -1 then
      begin
        de := Dir.AddItem(100);
        de.FirstPage := i100;
        de.RecLength := 255;
      end
      else
      begin
        de := Dir.Items[i];
        if de.FirstPage <> i100 then
          de.FirstPage := i100;
        if de.RecLength <> 255 then
          de.RecLength := 255;
      end;
      i := Dir.IndexOf(101);
      if i = -1 then
      begin
        de := Dir.AddItem(101);
        de.FirstPage := i101;
        de.RecLength := 39;
      end
      else
      begin
        de := Dir.Items[i];
        if de.FirstPage <> i101 then
          de.FirstPage := i101;
        if de.RecLength <> 39 then
          de.RecLength := 39;
      end;

      i := iPagesCount - Fat.PageCount div 512; // Emar-105, CKM: 4096-8=40888; Emar-205: 2048-4=2044
      if Self.FileType <> EMAR_FILE_TYPE_CKM then
      begin
        Dec(i, 2); // DIR2 and OIK2
        iMaxPage := i; // without DIR2, OIK 2 and FAT2

        locFAT1.PageId[i] := 6; // Emar-105: 4086; Emar-205: 2042 -> DIR2
        Inc(i);
        locFAT1.PageId[i] := 4; // Emar-105: 4087; Emar-205: 2043 -> OIK2
        Inc(i);
      end
      else
        iMaxPage := i; // without FAT2

      repeat
        locFAT1.PageId[i] := 2; // Emar-105, CKM: 4088-4095; Emar-205: 2044-2047 -> FAT2
        Inc(i);
      until i >= iPagesCount;

      if i100 < i101 then
        i := i100
      else
        i := i101;
      iPage := i;
      while i < iMaxPage do // report events area
      begin
        AStream.Seek(i * FLASH_528, soFromBeginning);
        AStream.Read(pg.aContent[0], 1);

        if (pg.aContent[0] in [100, 101]) then
        begin
          locFAT1.PageId[iPage] := pg.aContent[0];
          Inc(iPage);
        end;

        Inc(i);
      end;

      // restore FAT from the reapired
      for i := 0 to Pred(locFAT1.PageCount) do
        if locFAT1.PageId[i] <> Fat.PageId[i] then
          Fat.PageId[i] := locFAT1.PageId[i];
    finally
      FreeAndNil(locFAT1);
    end;
  end;
end;

procedure TEmar_BaseFile.TryToRepairDIR(AStream: TMemoryStream);
var
  i, j, iStartAt: Integer;
  de:   IEmar_DirEntry;
begin
  if Assigned(AStream) and(AStream.Size > 0) then
  begin
    if Fat.IsCorrect and(not Dir.IsCorrect) then
    begin
      Dir.Clear;
      iStartAt := 11; // after 8 pages of FAT, OIK, DIR, CONSTS
      for i := Low(FAT.fPages) to High(FAT.fPages) do
        for j := Low(FAT.fPages[i].aContent) to High(FAT.fPages[i].aContent) do
        begin
          if
            (iStartAt <= i * 512 + j)
            and(FAT.fPages[i].aContent[j] <> $FF)
            and(DIR.IndexOf(FAT.fPages[i].aContent[j]) = -1) then
          begin
            de := Dir.AddItem(FAT.fPages[i].aContent[j]);
            de.FirstPage := i * 512 + j;
            if de.Id = 101 then // report
              de.RecLength := 39
            else
              de.RecLength := 255; // TODO 1: update this
          end;
        end;
    end;
  end;
end;

