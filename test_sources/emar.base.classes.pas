function TEmar_ReportEvent.CheckDataOfEmar105ReportEvent: boolean;
var
  i:     integer;
  _kind: integer;
  f:     cardinal;
  p:     PByte;
begin
  f := reErrorCheckSum1 or reErrorCheckSum2 or reErrorCheckSum3 or reErrorCheckSum4 or reErrorPartMissing1 or
    reErrorPartMissing2 or reErrorPartMissing3 or reErrorPartMissing4 or reErrorEventStructure or
    reErrorNoMemoryAllocated;
  ClrError(f);
  if Assigned(pData) then begin
    p := pData;
    for i := 0 to fDataRecCount - 1 do begin
      if (PEmar105_ReportEvent_NextRecord(p)^.ID <> 101) or (PEmar105_ReportEvent_NextRecord(p)^.Count <> fDataRecCount)
        or (PEmar105_ReportEvent_NextRecord(p)^.Index <> i + 1) then AddError(reErrorEventStructure);
      if (PEmar105_ReportEvent_NextRecord(p)^.Index <> i + 1) then AddError(reErrorPartMissing1 shl i);
      if EmarXORSum(p^, SizeOf(TEmar105_BaseReport_Rec)) <> 0 then
        if (i = 0) then begin
          _kind := PEmar105_ReportEvent_Begin(p)^.EventID;
          if not (_kind in [31, 32, 33, 34]) and
            (EmarXORSum(p^, SizeOf(TEmar105_BaseReport_Rec), Emar105_RepEventsLen[_kind]) <> 0) then
              AddError(reErrorCheckSum1)
        end
        else AddError(reErrorCheckSum1 shl i);
      Inc(p, SizeOf(TEmar105_BaseReport_Rec));
    end;
  end
  else AddError(reErrorNoMemoryAllocated);
  Result := not IsError(f);
end;

function TEmar_ReportEvent.GetLastByteOfFirstRecord: Integer;
begin
  if Assigned(pData) then
  begin
    Result := TEmar105_BaseReport_Rec(pData^).XORSum;
  end
  else
    Result := $FF;
end;

