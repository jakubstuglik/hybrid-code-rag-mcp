begin
  Result := _New;
end;

function TEmar_RideBonusList._add_list(aList: IEmar_RideBonusList; var ix_list, ix_add: integer): boolean;
var
  i, j, e, ix: integer;
  bOk:         boolean;
begin
  Result := (Count > 0) and (aList.Count > 0);
  if Result then begin
    e := Count;
    for i := 0 to e - 1 do
      if IsEqualTariff(Items[i], aList[0]) then begin
        bOk := true;
        for j := 1 to aList.Count - 1 do begin
