function TEmar_InterfacedObject.WriteToJson(const jtw: TJsonTextWriter): integer;
var
  T, lT: TRttiType;
  P:     TRttiProperty;
  M:     TRttiMethod;
  O:     TObject;
  V:     TValue;
  i, j:  integer;
  jcp:   TEmarJsonCustomProperty;
//  jt:    TEmarJsonDataType;
//  isArr: boolean;
begin
  SortForExportToJson;
  jtw.WriteStartObject;
  try
    T := fCTX.GetType(ClassType);
//    jt := jdtNone;
//    isArr := false;
    for i := 0 to FJsonProperties.Count - 1 do begin
      jcp := FJsonProperties[i];
      P := T.GetProperties[jcp.RttiPropertyIndex];
//      if jt <> jcp.JsonDataType then begin
//        if isArray then
//          jtw.WriteEndArray;
//        jt := jcp.JsonDataType;
//        case jt of
//          jtd
//        end;
//      end;
//    end;


      case FJsonProperties[i].JsonDataType of
        jdtClass: begin
          O := P.GetValue(Self).AsObject;
          if O is TEmar_InterfacedObject then begin
            jtw.WritePropertyName(jcp.JsonPropertyName);
            Result := TEmar_InterfacedObject(O).WriteToJson(jtw);
            if Result <> ERR_NO_ERROR then
              Exit;
          end;
        end;
        jdtString: begin
          jtw.WritePropertyName(jcp.JsonPropertyName);
          jtw.WriteValue(P.GetValue(Self).AsString);
        end;
        jdtInteger: begin
          jtw.WritePropertyName(jcp.JsonPropertyName);
          jtw.WriteValue(P.GetValue(Self).AsInt64);
        end;
        jdtFloat: begin
          jtw.WritePropertyName(jcp.JsonPropertyName);
          jtw.WriteValue(P.GetValue(Self).AsExtended);
        end;
        jdtBoolean: begin
          jtw.WritePropertyName(jcp.JsonPropertyName);
          jtw.WriteValue(P.GetValue(Self).AsBoolean);
        end;
        jdtObjectList: begin
          O := P.GetValue(Self).AsObject;
          lT := fCTX.GetType(O.ClassInfo);
          M := lT.GetMethod('ToArray');
          if Assigned(M) then begin
            V := M.Invoke(O, []);
            if V.GetArrayLength > 0 then begin
              jtw.WritePropertyName(jcp.JsonPropertyName);
              jtw.WriteStartArray;
              for j := 0 to V.GetArrayLength - 1 do begin
                Result := TEmar_InterfacedObject(V.GetArrayElement(j).AsObject).WriteToJson(jtw);
                if Result <> ERR_NO_ERROR then
                  Exit;
              end;
              jtw.WriteEndArray;
            end;
          end;
        end;
        jdtCustom:
          if Assigned(FOnCustomWriteJson) then FOnCustomWriteJson(jtw, jcp.JsonPropertyName);
      end;
    end;
  finally
    jtw.WriteEndObject;
  end;
  Result := ERR_NO_ERROR;
end;

function TEmar_InterfacedObject.WriteToJsonFile(
  const aFileName: string): integer;
begin
  Result := ERR_NO_ERROR;
end;

procedure TEmar_InterfacedObject.WriteValidFrom(var aBuf; aBeginDate, aValidFrom: string);
var
  i: integer;
  p: pWord;
begin
  if aValidFrom <> '' then i := DaysBetween(aBeginDate, aValidFrom)
  else i := 0;
  p := @aBuf;
  if i > 0 then p^ := CalcWord(word(i))
  else p^ := 0;
end;

procedure TEmar_InterfacedObject.WriteValidTo(var aBuf; aBeginDate, aValidTo: string; aDef: word = $FFFF);
var
  p: pWord;
  i: integer;
begin
  p := @aBuf;
  if aValidTo = '' then p^ := CalcWord(aDef)
  else begin
    i := DaysBetween(aBeginDate, aValidTo);
    if i >= 0 then p^ := CalcWord(word(i))
    else p^ := CalcWord(aDef);
  end;
end;

function TEmar_InterfacedObject._CheckSum(var s: ansistring): byte;
begin
  if s <> '' then Result := EmarXORSum(s[1], Length(s))
  else Result := 0;
end;

