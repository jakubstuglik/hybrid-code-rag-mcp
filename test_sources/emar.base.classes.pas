procedure TEmar_ReportEvent.HexToArray(var aDest; aLen: integer; s: string);
var
  p:    PByte;
  i, j: integer;
begin
  p := @aDest;
  for i := 0 to aLen - 1 do begin
    j := i shl 1;
    if j + 2 <= Length(s) then begin
      p^ := StrToInt('$' + Copy(s, j + 1, 2));
      Inc(p);
    end
    else Break;
  end;
end;

