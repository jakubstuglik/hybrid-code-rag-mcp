function TEmar_RideRouteList.AddList(List: IEmar_RideRouteList): integer;
var
  i, j:     Integer;
  _IsEqual: boolean;
begin
  for I := 0 to Count - 1 do begin
    _IsEqual := true;
    // od punktu i zapisanych tras szukam podobnych tras, aby nie powtarzać trasy
    for j := 0 to List.Count - 1 do
      // jeżeli lista już zapisanych punktów jest mniejsza od indeksu i (zap.listy) + dlugosc trasy dodawanej to nie ma trasy równej
      // jeżeli choć jeden punkt z trasy dodawanej jest różny od punktu trasy zapisanej to trasy są różne i można
      // skończyć porównywanie z trasą zapisaną od indeksu "i", przechodzimy do "i+1"
      if (i + j > Count - 1) or not Items[i + j].IsEqual(List[j]) then begin
        _IsEqual := false;
        break;
      end;
    // jeżeli nie znaleziono różnic to dodawna trasa jest taka sama jak zapisana od indeksu i - i jest indeksem, koniec
    if _IsEqual then begin
      Result := i;
      exit;
    end;
  end;
  // jeżeli nie ma podobej trasy, to indeks nowej ustawiam na ostatni indeks zapisanej+1 (=count)
  Result := Count;
  // dodaję trasę
  for i := 0 to List.Count - 1 do _Add(List[i])
end;

