function TEmar_BaseFile.LoadFromFile(aFilePath: pchar): longword;
  function GetByte(AData: PByte; APosition: Integer): Byte;
  begin
    Inc(AData, APosition);
    Result := AData^;
  end;
var
  bIsEmar105CardFile, bXOR: Boolean;
  iOIK105: IEmar105_OIK;
  p:     PByte;
  btXOR: Byte;
  cCardSerialNumber_OIK1: Cardinal;
begin
  fFileName := AnsiUpperCase(aFilePath);
  fAFileName := ExtractFileName(fFileName);
  { ' Usunąć gdy będzie EMAR-205 ' }
  if fFileType = EMAR_FILE_TYPE_EMAR205 then begin
    Result := ERR_USB_DEVICE_NOT_SUPPORTED;
    Exit;
  end;

  Result := _LoadFileToStream(aFilePath);
  if Result <> ERR_NO_ERROR then Exit;
  try
    bIsEmar105CardFile := CharInSet(AnsiUpperCase(fAFileName)[1], ['C', 'K']) and (fStream.Size = 4096 * FLASH_528);
    try
      if fFileType = EMAR_FILE_TYPE_DUOBUS then begin
        Result := _LoadOtherParts(fStream);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      if IsRequired(fFat) and (Fat.PageCount > 0) then begin
        // if file K size differs with 4096 * FLASH_528, it could be file C
        if bIsEmar105CardFile then
          fStream.Seek( - 8 * FLASH_528, soFromEnd) // FAT2
        else
          fStream.Seek(0, soFromBeginning); // FAT1
        fStream.Read(Fat.fPages[0], FLASH_528 * (Fat.PageCount div 512))
      end;

      if IsRequired(fOik) then begin
        fOik.Number := 1;
        fStream.Seek(8 * FLASH_528, soFromBeginning); // OIK1
        GetOikAsClass.LoadFromBuffer(fStream);
        // if file K size differs with 4096 * FLASH_528, it could be file C
        if bIsEmar105CardFile then
        begin
          if Supports(fOik, IEmar105_OIK, iOIK105) then
          begin
            cCardSerialNumber_OIK1 := iOIK105.CardSerialNumber;

            bXOR := True;

            if bXOR then
            begin
              p := TEmar_Oik(iOIK105).pData;
              btXOR := EmarXORSum(p^, 12); // Numer,  data produkcji, typ karty, kod pojemności – 0..11
              bXOR := bXOR and (btXOR = GetByte(p, 12))and(btXOR <> $FF); // 12 bytes
            end;

            if bXOR then
            begin
              p := TEmar_Oik(iOIK105).pData;
              Inc(p, 17);
              btXOR := EmarXORSum(p^, 14); // NIP
              bXOR := bXOR and (btXOR = GetByte(p, 14))and(btXOR <> $FF); // 14 bytes
            end;

            if bXOR then
            begin
              p := TEmar_Oik(iOIK105).pData;
              Inc(p, 32);
              btXOR := EmarXORSum(p^, 132); // Nagłówki
              bXOR := bXOR and (btXOR = GetByte(p, 132))and(btXOR <> $FF); // 132 bytes
            end;

            if bXOR then
            begin
              p := TEmar_Oik(iOIK105).pData;
              Inc(p, 165);
              btXOR := EmarXORSum(p^, 99); // Stopki
              bXOR := bXOR and (btXOR = GetByte(p, 99))and(btXOR <> $FF); // 99 bytes
            end;

            if bXOR then
            begin
              p := TEmar_Oik(iOIK105).pData;
              Inc(p, 321);
              btXOR := EmarXORSum(p^, 2); // PIN
              bXOR := bXOR and (btXOR = GetByte(p, 2))and(btXOR <> $FF); // 2 bytes
            end;

            if bXOR then
            begin
              p := TEmar_Oik(iOIK105).pData;
              Inc(p, 354);
              btXOR := EmarXORSum(p^, 4); // Statusy: 354-357
              bXOR := bXOR and (btXOR = GetByte(p, 4))and(btXOR <> $FF); // 4 bytes
            end;

            if (not bXOR)or(cCardSerialNumber_OIK1 = $FFFFFFFF) then
            begin
              fOik.Number := 2;
              fStream.Seek( - 9 * FLASH_528, soFromEnd); // OIK2
              GetOikAsClass.LoadFromBuffer(fStream);
              fOik.Number := 1;
              if iOIK105.CardSerialNumber = $FFFFFFFF then
              begin // read OIK1 again instead
                fStream.Seek(8 * FLASH_528, soFromBeginning); // OIK1
                GetOikAsClass.LoadFromBuffer(fStream);
              end;
            end;
          end;
        end;
        if (fAFileName <> '')
          and Supports(fOik, IEmar105_OIK, iOIK105)
          and not CharInSet(AnsiUpperCase(fAFileName)[1], ['C', 'K'])
          and(Copy(fAFileName, 1, 2).ToUpper <> 'CE')
        then fAFileName := string(iOIK105.TimeTableFileName) + '.' + string(iOIK105.TimeTableFileExt);
      end;

      // TODO 1: add DIR2 reading in case bIsEmar105CardFile; like FAT and OIK above
      if IsRequired(fDir) then Dir.LoadFromBuffer(fStream, 0); // DIR1 ?

      if IsRequired(fConsts) then
        TEmar_InterfacedObject(fConsts).LoadFromBuffer(fStream);

      if IsRequired(fFat) and(not Fat.IsCorrect) then
        TryToRepairFAT(fStream);

      // $11 = 17 - Ceny
      if IsRequired(fPriceList) then begin
        Result := LoadList(fPriceList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $D = 13 - Ulgi kursów
      if IsRequired(fRideReductionList) then begin
        Result := LoadList(fRideReductionList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $A = 10 - Kursy
      if IsRequired(fRideList) then begin
        Result := LoadList(fRideList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $8 = 08 - Firmy
      if IsRequired(fCompanyList) then begin
        Result := LoadList(fCompanyList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $9 = 09 - Przystanki
      if IsRequired(fBusStopList) then begin
        Result := LoadList(fBusStopList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $2F = 47 - Słupki przystanków
      if IsRequired(fBusStopStandList) then begin
        Result := LoadList(fBusStopStandList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $B = 11 - Trasy kursów
      if IsRequired(fRideRouteList) then begin
        Result := LoadList(fRideRouteList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $C = 12 - Taryfy kursów
      if IsRequired(fRideTariffList) then begin
        Result := LoadList(fRideTariffList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $E = 14 - Kalendarz
      if IsRequired(fCalendarList) then begin
        Result := LoadList(fCalendarList);
        if Result <> ERR_NO_ERROR then Exit;
        if not(IsEmar205OnlineReport() or IsEmar205OnlineDD0()) then
          fCalendarList.CalendarLength := MonthsCount(StrToDate(_GetCalendarBegin), StrToDate(_GetCalendarEnd)) + 1;
      end;
      // $F = 15 - Oznaczenia kursów
      if IsRequired(fRideDesignationList) then begin
        Result := LoadList(fRideDesignationList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $10 = 16 - Taryfy
      if IsRequired(fTariffList) then begin
        Result := LoadList(fTariffList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $12 = 18 - Indeksy cen dla cenników tabelowych typu 1 (max 15 cen w taryfie)
      if IsRequired(fPriceIndexes1) then TEmar_PriceIndexes(fPriceIndexes1).LoadFromBuffer(fStream, Version);
      // $13 = 19 - Indeksy cen dla cenników tabelowych typu 2 (max 255 cen w taryfie) (to samo co TEmar_PriceIndexes (18))
      if IsRequired(fPriceIndexes2) then TEmar_PriceIndexes(fPriceIndexes2).LoadFromBuffer(fStream, Version);
      // $14 = 20 - Numery stref dla taryf strefowych
      if IsRequired(fFarePriceScaleZoneNumbers) then
          TEmar_FarePriceScaleZoneNumber(fFarePriceScaleZoneNumbers).LoadFromBuffer(fStream, Version);
      // $16 = 22 - Sposoby zapłaty
      if IsRequired(fPaymentTypeList) then begin
        Result := LoadList(fPaymentTypeList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $17 = 23 - Ulgi
      if IsRequired(fFarePriceReductionList) then begin
        Result := LoadList(fFarePriceReductionList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $33 = 51 - Numery linii - musi być odczytane przed liniami!!!
      if IsRequired(fLineNumberList) then begin
        Result := LoadList(fLineNumberList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $1A = 26 - Linie
      if IsRequired(fLineList) then begin
        Result := LoadList(fLineList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $1B = 27 - Bonifikaty kursów
      if IsRequired(fRideBonusList) then begin
        Result := LoadList(fRideBonusList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $1C = 28 - Opłaty manipulacyjne kursów
      if IsRequired(fRideHandlingFeeList) then begin
        Result := LoadList(fRideHandlingFeeList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $1D = 29 - Opłaty dodatkowe
      if IsRequired(fAdditionalFeeList) then begin
        Result := LoadList(fAdditionalFeeList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $1E = 30 - Taryfy bagażowe kursów
      if IsRequired(fLuggageTariffList) then begin
        Result := LoadList(fLuggageTariffList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // 35 - tarify miejskie
      if IsRequired(fRidesCityFarePriceScaleList) then begin
        Result := LoadList(fRidesCityFarePriceScaleList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // 36 - ceny tarif miejskich
      if IsRequired(fPriceCityFarePriceScaleList) then begin
        Result := LoadList(fPriceCityFarePriceScaleList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $25 = 37 - Trasy linii
      if IsRequired(fLineRouteList) then begin
        Result := LoadList(fLineRouteList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $26 = 38 Emar105,CKM100 - Litery numerów bocznych autobusów
      if IsRequired(fLettersBusStopSideNumberList) then begin
        Result := LoadList(fLettersBusStopSideNumberList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // 38 - Duo/Printo Bus - Taryfy biletów miesięcznych kursów
      if IsRequired(fRideMonthTariffList) then begin
        Result := LoadList(fRideMonthTariffList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // 39 - Duo/Printo Bus - Rodzaje komunikacji
      if IsRequired(fCommunicationKindList) then begin
        Result := LoadList(fCommunicationKindList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // 40 - Duo/Printo Bus - Strefy biletowe
      if IsRequired(fTicketZoneList) then begin
        Result := LoadList(fTicketZoneList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // 41 - Duo/Printo Bus - Taryfa biletów sieciowych
      if IsRequired(fNetTicketTariffList) then begin
        Result := LoadList(fNetTicketTariffList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // 42 - Duo/Printo Bus - Taryfy dla EP-Bilety
      if IsRequired(fEPTariffList) then begin
        Result := LoadList(fEPTariffList);
        if Result <> ERR_NO_ERROR then Exit;
      end;

      // $2B = 43 - Wykaz stref biletowych
      if IsRequired(fZoneNumberList) then begin
        Result := LoadList(fZoneNumberList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $2C = 44 - Ulgi BM (jak 23 - Ulgi)
      if IsRequired(fMonthTicketReductionList) then begin
        Result := LoadList(fMonthTicketReductionList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // 44 - Duo/Printo Bus - Cennik strefowy biletów miesięcznych (BM, BMU) z przesiadką w strefie
      if IsRequired(fBMZonePriceList) then begin
        Result := LoadList(fBMZonePriceList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $2D = 45 - Taryfa doładowań EM-karty - realizacja odłożona
      if IsRequired(fChargingTariffList) then begin
        Result := LoadList(fChargingTariffList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $2E = 46 - Ceny doładowań EM-karty - realizacja odłożona
      if IsRequired(fChargingTariffPriceList) then begin
        Result := LoadList(fChargingTariffPriceList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $1F = 31 - Skorowidz kursów
      if IsRequired(fReferenceRideList) then begin
        Result := LoadList(fReferenceRideList);
        if Result <> ERR_NO_ERROR then Exit;
      end;

      // dane dodatkowe
      // $15 = 21 - Przeliczniki walut – dane dodatkowe
      if IsRequired(fCurrencyExchangeList) then begin
        Result := LoadList(fCurrencyExchangeList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $18 = 24 - Zadania – dane dodatkowe
      if IsRequired(fTaskList) then begin
        Result := LoadList(fTaskList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $19 = 25 - Pozycje zadań – dane dodatkowe
      if IsRequired(fTaskPositionList) then begin
        Result := LoadList(fTaskPositionList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $20 = 32 - Wykaz firm rozliczających przewozy pasażerów z biletami miesięcznymi – dane dodatkowe
      if IsRequired(fAcceptedTicketOwnerList) then begin
        Result := LoadList(fAcceptedTicketOwnerList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $21 = 33 - Wykaz firm wydających akceptowane przez bileterkę karty pasażerów z ulgą handlową – dane dodatkowe
      if IsRequired(fAcceptedTradeReliefCardOwnerList) then begin
        Result := LoadList(fAcceptedTradeReliefCardOwnerList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $22 = 34 - Wykaz zastrzeżonych kart MIFARE – dane dodatkowe
      if IsRequired(fProprietaryMIFAREcardList) then begin
        Result := LoadList(fProprietaryMIFAREcardList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $27 = 39 - Przeliczniki walut po zmianie waluty cennika
      if IsRequired(fExchangeRateAfterChangeCurrencyList) then begin
        Result := LoadList(fExchangeRateAfterChangeCurrencyList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $28 = 40 - Wykaz kart MIFARE z biletami do przedłużenia / sprzedaży na następny okres – dane dodatkowe
      if IsRequired(fTicketNextPeriodList) then begin
        Result := LoadList(fTicketNextPeriodList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $29 = 41 - Wykaz skrótów klawiszowych do funkcji bileterki – dane dodatkowe
      if IsRequired(fShortcutList) then begin
        Result := LoadList(fShortcutList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $2A = 42 - Wykaz firm wydających akceptowane przez bileterkę karty kontrolerów – dane dodatkowe
      if IsRequired(fAcceptedInspectorsCompanyList) then begin
        Result := LoadList(fAcceptedInspectorsCompanyList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // $30 = 48 - Kierowcy (solobus)
      // if IsRequired(fDriverList) then begin
      // Result := LoadList(fDriverList);
      // if Result <> ERR_NO_ERROR then Exit;
      // end;
      // 52 - Nagłówki i stopki Emar-205
      if IsRequired(fEmar205TextsList) then begin
        Result := LoadList(fEmar205TextsList);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // 53 - Parametry WI-FI EMAR-205 – dane dodatkowe
      if IsRequired(fEmar205WiFiList) then begin
        Result := LoadList(fEmar205WiFiList);
        if Result <> ERR_NO_ERROR then Exit;
      end;

      // 100 - Rozpoczęte kursy
      if IsRequired(fReportStartedRides) then begin
        Result := LoadList(fReportStartedRides);
        if Result <> ERR_NO_ERROR then Exit;
      end;
      // na przykład: 101 - raport zadaniowy i inne
      if fFileType <> EMAR_FILE_TYPE_DUOBUS then Result := _LoadOtherParts(fStream);
    finally
      fStream.Clear;
    end;
  except
    fStream.Clear;
    Result := ERR_INCORRECT_FILE;
  end;
end;

function TEmar_BaseFile.LoadList(aList: IEmar_InterfaceList; aStream: TStream = nil): longword;
var
  l:    TEmar_InterfaceList;
  li:   TEmar_InterfacedObject;
  de:   IEmar_DirEntry;
  i, r: integer;
  ms:   TMemoryStream;
begin
  Result := ERR_NO_ERROR;
  if not Assigned(aStream) then aStream := fStream;
  if Assigned(aStream) then begin
    try
      ms := TMemoryStream.Create;
      try
        l := TEmar_InterfaceList(aList);
        l.Clear;
        case fFileType of
        EMAR_FILE_TYPE_EMAR105, EMAR_FILE_TYPE_CKM, EMAR_FILE_TYPE_EMAR205: begin
            i := fDir.IndexOf(l.Id);
            if i >= 0 then begin
              de := fDir[i];
              i := fFat.IndexOfFirstPage(l.Id);
              if (i = de.FirstPage) then begin
                r := 0;
                aStream.Seek(i * FLASH_528, soFromBeginning);
                if FileType = EMAR_FILE_TYPE_CKM then ms.CopyFrom(aStream, 512)
                else ms.CopyFrom(aStream, FLASH_528);
                if ms.Size = 0 then Exit;
                ms.Position := 0;
                l.Capacity := de.RecCount;
                repeat
                  li := TEmar_InterfacedObject(l.AddItem);
                  li.LoadFromBuffer(ms, fVersion);
                  if ms.Position + li.RecordLength(fVersion) > 512 then begin
                    i := fFat.NextPage(l.Id, i);
                    if i > 0 then begin
                      ms.Clear;
                      if FileType = EMAR_FILE_TYPE_CKM then begin
                        aStream.Seek(i * 512, soFromBeginning);
                        ms.CopyFrom(aStream, 512);
                      end else begin
                        aStream.Seek(i * FLASH_528, soFromBeginning);
                        ms.CopyFrom(aStream, FLASH_528);
                      end;
                      if ms.Size = 0 then Exit;
                      ms.Position := 0;
                    end
                    else Break;
                  end;
                  Inc(r);
                until r = de.RecCount;
              end;
            end;
          end;
        EMAR_FILE_TYPE_DUOBUS: begin
            i := fDir.IndexOf(l.Id);
            if i >= 0 then begin
              de := fDir[i];
              r := 0;
              aStream.Seek(de.FirstPage, soFromBeginning);
              repeat
                li := TEmar_InterfacedObject(l._AddItem);
                li.LoadFromBuffer(aStream, fVersion);
                inc(r);
              until r = de.RecCount;
            end;
          end;
        end;
      finally
        ms.Free;
      end;
    except
      Result := ERR_INCORRECT_FILE;
    end;
  end;
end;

