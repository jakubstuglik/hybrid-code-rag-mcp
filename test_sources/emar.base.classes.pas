  Result := (fArrivalStand = ARideRoute.ArrivalStand) and (fArrivalZone = ARideRoute.ArrivalZone) and
    (fCurrentEndZone = ARideRoute.CurrentEndZone) and (fDepartureStand = ARideRoute.DepartureStand) and
    (fDepartureZone = ARideRoute.DepartureZone) and (fDepartureStandNumber = ARideRoute.DepartureStandNumber) and
    (fDistance = ARideRoute.Distance) and (fDistanceInShortcut = ARideRoute.DistanceInShortcut) and
    (fEnableSaleToSkipedBusStop = ARideRoute.EnableSaleToSkipedBusStop) and (fEndOfZone = ARideRoute.EndOfZone) and
    (fFareDistance = ARideRoute.FareDistance) and (fFareDistanceInShortcut = ARideRoute.FareDistanceInShortcut) and
    (fInBranch = ARideRoute.InBranch) and (fIndexOfBusStop = ARideRoute.IndexOfBusStop) and
    (fIndexOfBusStopInLine = ARideRoute.IndexOfBusStopInLine) and (fIsConditional = ARideRoute.IsConditional) and
    (fIsCountryBorder = ARideRoute.IsCountryBorder) and
    (fIsFirstBusStopAfterBranch = ARideRoute.IsFirstBusStopAfterBranch) and
    (fReceiveSaleDiagram = ARideRoute.ReceiveSaleDiagram) and (fRideTime = ARideRoute.RideTime) and
    (fShowArrivalStand = ARideRoute.ShowArrivalStand) and (fShowDepartureStand = ARideRoute.ShowDepartureStand) and
    (fShowOnInfoBoard = ARideRoute.ShowOnInfoBoard) and (fSkipBusStop = ARideRoute.SkipBusStop) and
    (fStopTime = ARideRoute.StopTime)
