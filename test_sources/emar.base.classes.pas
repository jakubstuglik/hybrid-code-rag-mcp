procedure TEmar_InterfacedObject.SetTicketRegisterCode31(p: PAnsiChar; aLen: integer; aTicketRegister: string;
  aWithEndZero: boolean);
var
  s:          AnsiString;
  b, iLength: Byte;
begin
  iLength := Length(aTicketRegister);
  if iLength > 12 then begin
    s := AnsiString(Copy(aTicketRegister, 1, 3) + ' ' + Copy(aTicketRegister, 7, iLength - 6));
    b := StrToInt(Copy(aTicketRegister, 5, 2));
    s[4] := AnsiChar(Char(b + $31{ 49 } { or $80 }));
  end
  else s := AnsiString(aTicketRegister);
  if aWithEndZero then System.AnsiStrings.StrPLCopy(p, s, aLen)
  else Move(s[1], p^, aLen);
end;

procedure TEmar_InterfacedObject.SortForExportToJson;
begin
  if fIsIndexSorted then Exit;
  JsonInitProperties;
  FJsonProperties.Sort(TComparer<TEmarJsonCustomProperty>.Construct(
    function(const L, R: TEmarJsonCustomProperty): integer
    begin
      if L.JsonDataType = R.JsonDataType then
          Result := L.IndexByType - R.IndexByType
      else if L.JsonDataType < R.JsonDataType then Result := - 1
      else Result := 1;
    end));
  FIsNameSorted := false;
  FIsIndexSorted := true;
end;

procedure TEmar_InterfacedObject.SortForImportFromJson;
begin
  if fIsNameSorted then Exit;
  JsonInitProperties;
  FJsonProperties.Sort(TComparer<TEmarJsonCustomProperty>.Construct(
    function(const L, R: TEmarJsonCustomProperty): integer
    begin
      Result := CompareText(L.JsonPropertyName, R.JsonPropertyName);
    end));
  FIsNameSorted := true;
  FIsIndexSorted := false;
end;

