function TEmar_InterfacedObject.GetTicketRegisterCode31(p: PAnsiChar; aLen: integer): string;
var
  s, t: ansistring;
  b:    byte;
begin
  s := Trim(CopyL(p, aLen));
  if aLen > 3 then begin
    if (Length(s) > 3) and (s[4] <> ' ') then begin
      b := Ord(s[4]) - $31{ 49 }; // and $7f;
      s[4] := ' ';
      t := ansistring(IntToStr(b));
      if Length(t) = 1 then t := '0' + t;
      Insert(t, s, 5);
    end;
  end;
  Result := string(s);
end;

