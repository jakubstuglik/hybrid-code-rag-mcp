function TEmar_RideTariff.SprKal(ds: TDateTime; AResult: PBoolean): Cardinal;
var
  Kal:                    IEmar_Calendar; // TRLKal;
  i:                      Integer;
  y1, y2, m1, m2, d1, d2: Word;
begin
  Result := ERR_NO_ERROR;
  AResult^ := False;
  try
    if IndexOfCalendar{ KalDniWaz } = - 1 then begin
      AResult^ := True;
      Exit;
    end;
    DecodeDate(StrToDate(Self.Owner.GetCalendarBegin){ Con.PoczKal }, y1, m1, d1);
    DecodeDate(ds, y2, m2, d2);
    i := (y2 - y1) * 12 + m2 - m1;
    Kal := Self.Owner.CalendarList[IndexOfCalendar{ KalDniWaz-1 } + i]; // DajRLKal(Ad,(KalDniWaz-1+i)*DRe.D,RE,WyswRL);
    // AT:    dec(d2); i:=d2 div 8+1; d2:=d2 mod 8;
    AResult^ := Kal.Day[d2]; // AT: {Kal.Miesiac[i] and (1 shl d2)<>0;
  except
    Result := ERR_LIST_ITEM_NOT_FOUND;
  end;
end; // SprKal

