function TEmar_InterfacedObject.EmarGetDate(var aDate: TEmarDateTypeRec): TDateTime;
var
  b: Boolean;
  y: word;
begin
  if (aDate.wYear = $FFFF) or (aDate.wYear = $0000) or (aDate.bMonth > 12) or (aDate.bMonth = $00) or (aDate.bDay > 31)
    or (aDate.bDay = $00) then Result := 0
  else begin
    if Assigned(Owner) then b := Owner.BigEndian
    else b := TEmar_BaseFile(Self).BigEndian;
    if b then y := Swap(aDate.wYear)
    else y := aDate.wYear;
    if not TryEncodeDate(y, aDate.bMonth, aDate.bDay, Result) then
      Result := 0;
  end;
end;

function TEmar_InterfacedObject.EmarGetDateTime(var aDateTime: TEmarDateTimeTypeRec): TDateTime;
var
  d, t: TDateTime;
begin
  d := EmarGetDate(aDateTime.rDate);
  t := EmarGetTime(aDateTime.rTime);
  if (d = 0) or (t < 0) then Result := 0
  else Result := d + t;
end;

function TEmar_InterfacedObject.EmarGetTime(var aTime: TEmarTimeTypeRec): TDateTime;
begin
  if not TryEncodeTime(aTime.bHour, aTime.bMinute, aTime.bSecond, 0, Result) then
    Result := - 1;
end;

function TEmar_InterfacedObject.EmarLRCSum(var aBuffer; aSize: integer): byte;
var
  p: PByte;
  i: integer;
begin
  p := @aBuffer;
  Result := 0;
  for i := 1 to aSize do begin
    Result := (Result + p^) mod 256;
    Inc(p);
  end;
  Result := not Result;
end;

procedure TEmar_InterfacedObject.EmarSetDate(aDate: PEmarDateTypeRec; aNewDate: TDateTime);
var
  b: Boolean;
  y, m, d: word;
begin
  if aNewDate = 0 then FillChar(aDate^, SizeOf(aDate^), $FF)
  else begin
    DecodeDate(aNewDate, y, m, d);
    if Assigned(Owner) then b := Owner.BigEndian
    else b := TEmar_BaseFile(Self).BigEndian;
    if b then y := Swap(y);
    aDate^.wYear := y;
    aDate^.bMonth := m;
    aDate^.bDay := d;
  end;
end;

procedure TEmar_InterfacedObject.EmarSetTime(aTime: PEmarTimeTypeRec; aNewTime: TDateTime);
