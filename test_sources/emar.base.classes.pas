constructor TEmar_Fat.Create(aOwner: TEmar_BaseFile; aId: integer);
begin
  inherited;
  Nr := 1;
  case Owner.FileType of
    EMAR_FILE_TYPE_EMAR105, EMAR_FILE_TYPE_CKM: PageCount := 4096;
    EMAR_FILE_TYPE_EMAR205: PageCount := 2048;
  end;
end;

destructor TEmar_Fat.Destroy;
begin

  inherited;
end;

function TEmar_Fat.GetIsCorrect: Boolean;
var
  i, iPage, id, iSpecialPagesCount, iFirstPageAfterDataPage: Integer;
//id: 0 - strona uszkodzona, 255-pusta, 100-wykaz kursów, 101-raport
begin
  // get special pages count
  if Owner.FileType = EMAR_FILE_TYPE_CKM then
    iSpecialPagesCount := 8 // without DIR and CONST
  else
    iSpecialPagesCount := 10;
  iFirstPageAfterDataPage := PageCount - iSpecialPagesCount;

  for i := Low(fPages) to High(fPages) do // Checking of 8 pages of FAT
    if PageId[i] <> 1 then
      Exit(False);

  if
    (PageId[8] <> 3) // Check OIK
    or
    (Owner.FileType <> EMAR_FILE_TYPE_CKM)
      and(
        (PageId[9] <> 5)  // Check DIR
        or
        (PageId[10] <> 7) // Check CONST
         )
  then
    Exit(False);

  iPage := iSpecialPagesCount;
  repeat
    Inc(iPage);   //11 or 9 - pierwsza strona tabel z danymi
    id := PageId[iPage];
    if (iPage < iFirstPageAfterDataPage)and not(id in [C_DATA_PAGE_ID_MIN..C_DATA_PAGE_ID_MAX, 0, 100, 101, 255]) then
    begin
//AT:      Fat[(iPage div 512)* FLASH_528 + iPage mod 512] := $FF;
    end;
  until (iPage = iFirstPageAfterDataPage)or(id in [100, 101]);

  while iPage < iFirstPageAfterDataPage do
  begin
    id := PageId[iPage];
    if not(id in [0, 100, 101, 255]) then
      Exit(False);
    Inc(iPage);
  end;
  // TODO 1: update below for Emar-205 as well
  if
    (PageCount = 4096) // report from the Emar-105 card
    and(not Owner.IsEmar205OnlineReport())
  then
  begin
    if PageId[iPage] <> 6 then // 4086 -> DIR2
      Exit(False);
    Inc(iPage);
    if PageId[iPage] <> 4 then // 4087 -> OIK2
      Exit(False);
    Inc(iPage);
    repeat
      if PageId[iPage] <> 2 then // 4088-4095 -> FAT2
        Exit(False);
      Inc(iPage);
    until iPage > 4095;
  end;

  Result := True;
end;

function TEmar_Fat.GetPageCount: integer;
begin
  Result := Length(fPages) * 512;
end;

function TEmar_Fat.GetPageId(index: integer): integer;
var
  p: integer;
begin
  p := index div 512;
  if p < PageCount then begin
    Result := fPages[p].aContent[index mod 512];
  end
  else Result := - 1;
end;

function TEmar_Fat.IndexOfFirstEmptyPage: integer;
begin
  Result := IndexOfFirstPage($FF);
end;

function TEmar_Fat.IndexOfFirstPage(PageId: integer; StartAt: integer = - 1): integer;
var
  i, j: integer;
begin
  Result := - 1;
  for i := low(fPages) to high(fPages) do
    for j := low(fPages[i].aContent) to high(fPages[i].aContent) do
      if fPages[i].aContent[j] = PageId then begin
        if StartAt <= i * 512 + j then begin
          Result := i * 512 + j;
          Exit;
        end;
      end;
end;

procedure TEmar_Fat.LoadFromBuffer(aStream: TStream; aVer: byte);
begin
  aStream.Position := fPageNr * FLASH_528;
  aStream.Read(fPages[0], FLASH_528 * Length(fPages));
end;

function TEmar_Fat.NextPage(aPageId, aFromPage: integer): integer;
var
  i: integer;
begin
  for i := aFromPage + 1 to PageCount - 1 do
    if PageId[i] = aPageId then begin
      Result := i;
      Exit;
    end;
  Result := - 1;
end;

procedure TEmar_Fat.SaveToBuffer(aStream: TStream; aVer: byte);
var
  i:      integer;
  pp, np: word;
begin
  if Owner.FileType = EMAR_FILE_TYPE_CKM then begin
    aStream.Position := fPageNr * 512;
    for i := low(fPages) to high(fPages) do aStream.Write(fPages[i], 512);
  end else begin
    for i := low(fPages) to high(fPages) do begin
      if Length(fPages) = 1 then begin
        pp := $FFFF;
        np := $FFFF;
      end else if i = low(fPages) then begin
        pp := $FFFF;
        np := 1 + fPageNr;
      end else if i = high(fPages) then begin
        pp := i - 1 + fPageNr;
        np := $FFFF;
      end else begin
        pp := i - 1 + fPageNr;
        np := i + 1 + fPageNr;
      end;
      FillPageCtrlBytes(fPages[i], Id, i + fPageNr, pp, np);
    end;
    aStream.Position := fPageNr * FLASH_528;
    aStream.Write(fPages[0], FLASH_528 * Length(fPages));
  end;
end;

procedure TEmar_Fat.SetNr(const Value: integer);
begin
  if Owner.FileType <> EMAR_FILE_TYPE_DUOBUS then begin
    if fNr <> Value then begin
      if not ((Value < 1) or (Value > 2)) then begin
        fNr := Value;
        if fNr = 1 then begin
          Id := 1;
          fPageNr := 0;
        end else begin
          case Owner.FileType of
            EMAR_FILE_TYPE_EMAR105, EMAR_FILE_TYPE_CKM:
              begin
                Id := 2;
                fPageNr := 4088;
              end;
            EMAR_FILE_TYPE_EMAR205:
              begin
                Id := 2;
                fPageNr := 2044;
              end;
          end;
        end;
      end;
    end;
  end else begin
    Id := 0;
    fNr := 0;
    fPageNr := 0;
  end;
end;

procedure TEmar_Fat.SetPageCount(Value: integer);
var
  l, p: integer;
begin
  l := Length(fPages);
  p := Value div 512;
  if Value mod 512 > 0 then Inc(p);
  if p <> l then begin
    SetLength(fPages, p);
    if l < Value then FillChar(fPages[l], SizeOf(fPages[l]) * (p - l), $FF);
  end;
end;

procedure TEmar_Fat.SetPageId(index: integer; const Value: integer);
var
  p: integer;
begin
  if index < PageCount then begin
    p := index div 512;
    fPages[p].aContent[index mod 512] := Value
  end;
end;

procedure TEmar_Fat._Clear;
var
  i, l{ ,pc }: integer;
begin
  Nr := 1;
  l := Length(fPages);
  if l > 0 then begin
    // pc := PageCount;
    FillChar(fPages[0], SizeOf(fPages[0]) * l, $FF);
    for i := 0 to l - 1 do begin
      PageId[i] := 1; // FAT 1
      // PageId[pc-i-1] := 2; // FAT 2 - pry programowaniu trzeba ustawić
    end;
    PageId[l] := 3; // OIK 1
    if Owner.FileType <> EMAR_FILE_TYPE_CKM then begin
      PageId[l + 1] := 5; // DIR 1
      PageId[l + 2] := 7; // CONST
    end;
    // PageId[pc-l-1] := 4; // OIK 2 - pry programowaniu trzeba ustawić
    // PageId[pc-l-2] := 6; // DIR 2 - pry programowaniu trzeba ustawić
  end;
end;

