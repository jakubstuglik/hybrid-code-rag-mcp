function TEmar_PZ_File.LoadChunkFromStream(aStream: TStream; var s: ansistring): integer;
var
  l:    integer;
  iPos: int64;
  ch:   ansichar;
  str:  ansistring;
begin
  Result := - 1;
  iPos := aStream.Position;
  if aStream.Read(ch, 1) = 0 then begin
    Result := 0;
    Exit;
  end;
  case ch of
  'W': l := 3;
  'A': l := 2;
else aStream.Position := iPos;
  Exit;
  end;
  str := ansistring(StringOfChar('0', l));
  if aStream.Read(str[1], l) <> l then Exit;
  l := AnsiStrToIntDef(str, 0);
  if l = 0 then Exit;
  aStream.Position := iPos;
  SetLength(s, l);
  aStream.Read(s[1], l);
  case ch of
  'W': Result := PZ_FILE_HEADER;
  'A': REsult := PZ_FILE_EMCARD;
  end;
end;

function TEmar_PZ_File.LoadFromFile(aFileName: pchar): longword;
var
  fs: TFileStream;
begin
  if FileExists(aFileName) then begin
    fs := TFileStream.Create(aFileName, fmOpenRead or fmShareDenyWrite);
    try
      fVerifyCheckSum := true;
      try
        Result := LoadFromStream(fs);
      finally
        fVerifyCheckSum := false;
      end;
    finally
      fs.Free;
    end;
  end
  else Result := ERR_FILE_NOT_FOUND;
end;

function TEmar_PZ_File.LoadFromStream(aStream: TStream): longword;
var
  s:       ansistring;
  recKind: integer;
  p:       PAnsiChar;
  t:       IEmar_PZ_File_EmCard;
  // d: integer;
begin
  Result := ERR_INCORRECT_FILE;
  Clear;
  repeat
    s := '';
    recKind := LoadChunkFromStream(aStream, s);
    if (recKind > 0) and (Length(s) < 4) then Exit;
    case recKind of
    PZ_FILE_HEADER: begin
        p := @s[2];
        fDataLength := IntL(p, 3);
        Inc(p, 3);
        fProgramName := CopyPStr(p, 6);
        Inc(p, 6);
        fProgramVersion := CopyPStr(p, 7);
        Inc(p, 7);
        fDataVersion := CopyPStr(p, 6);
        Inc(p, 6);
        fPrepareDate := DuobusDateToString(CopyL(p, 10));
        Inc(p, 10);
        fPrepareTime := CopyPStr(p, 8);
        Inc(p, 8);
        fINumber := IntL(p, 4);
        Inc(p, 4);
        fFileName := CopyPStr(p, 11);
        Inc(p, 11);
        fEmCardCount := IntL(p, 5);
        Inc(p, 5);
        fFileSize := IntL(p, 8);
      end;
    PZ_FILE_EMCARD: begin
        t := EmCardList.AddItem;
        p := @s[2];
        t.DataLength := IntL(p, 2);
        Inc(p, 2);
        t.EmCardNumber := CardinalL(p, 10);
        Inc(p, 10);
        t.Date := DuobusDateToPChar(CopyL(p, 10));
        Inc(p, 10);
        t.Indicator := IntL(p, 1);
        Inc(p);
        t.Time := CopyPStr(p, 8);
      end;
    end;

  until recKind <= 0;
  Result := ERR_NO_ERROR;
end;

function TEmar_PZ_File.SaveToFile(aFileName: pchar): longword;
begin
  fStream.Clear;
  try
    Result := SaveToStream(fStream);
    if Result = ERR_NO_ERROR then fStream.SaveToFile(aFileName);
  finally
