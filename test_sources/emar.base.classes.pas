function TEmar_PriceIndexes.AddList(aList: IEmar_PriceIndexes): integer;
var
  ix_list, ix_add: integer;
begin
  if _add_list(aList, ix_list, ix_add) then begin
    Result := ix_list;
    // jeśli lista indeksów cen posiada wszystkie indeksy dodawane to wychodzimy
    if ix_add >= aList.Count then Exit;
  end else begin
    Result := fData.Count;
    ix_add := 0;
  end;
  // dodajemy numery cen, które brakują, albo wszystkie
  for ix_list := ix_add to aList.Count - 1 do fData.Add(aList.PriceIndex[ix_list]);
end;

