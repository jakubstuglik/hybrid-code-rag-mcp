function TEmar_ReportEvent.ArrayToHex(var aSrc; aLen: integer; AFFAsEmpty: Boolean): string;
var
  i:    integer;
  p:    PByte;
  isFF: Boolean;
begin
  p := @aSrc;
  Result := '';
  for i := 1 to aLen do begin
    Result := Result + IntToHex(p^, 2);
    Inc(p);
  end;
  if AFFAsEmpty then begin
    isFF := True;
    for i := 1 to Length(Result) do
      if AnsiUpperCase(Result[i]) <> 'F' then begin
        isFF := False;
        Break;
      end;
    if isFF then Result := '';
  end;
end;

