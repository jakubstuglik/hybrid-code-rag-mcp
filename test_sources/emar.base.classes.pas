function TEmar_BA_File_EmCard.SaveToBuffer: pchar;
var
  s: TStringBuilder;
begin
  s := TStringBuilder.Create;
  try
    DataLength := 288;
    s.Append('B' + FormatIntProperty(DataLength, 3));
    s.Append(FormatStrProperty(NumberBM, 10));
    s.Append(DateToDuobusDateFormat(SaleDate, '          '));
    s.Append(FormatStrProperty(SaleTime, 8));
    s.Append(FormatInt64Property(EmCardNumber, 10));
    s.Append(FormatIntProperty(TicketGenre, 1));
    s.Append(FormatIntProperty(ReductionType, 1));
    s.Append(FormatIntProperty(ReductionCode, 3));
    s.Append(FormatIntProperty(ReductionPercentage, 3));
    if TicketAbroad then s.Append('1')
    else s.Append('0');
    s.Append(FormatIntProperty(VatCode1, 1));
    s.Append(FormatIntProperty(VatRate1, 5));
    s.Append(FormatIntProperty(Brutto1, 9));
    s.Append(FormatIntProperty(ReductionAmount1, 9));
    s.Append(FormatIntProperty(VatCode2, 1));
    s.Append(FormatIntProperty(VatRate2, 5));
    s.Append(FormatIntProperty(Brutto2, 9));
    s.Append(FormatIntProperty(ReductionAmount2, 9));
    s.Append(FormatStrProperty(NumberOfPasses, 2));
    s.Append(DateToDuobusDateFormat(ValidFrom, '          '));
    s.Append(DateToDuobusDateFormat(ValidTo, '          '));
    s.Append(FormatStrProperty(Logo, 14));
    s.Append(FormatStrProperty(FiscalReportNumber, 8));
    s.Append(FormatStrProperty(TicketNumber, 8));
    s.Append(DateToDuobusDateFormat(RenewalDate, '          '));
    s.Append(FormatStrProperty(RenewalTime, 8));
    s.Append(FormatIntProperty(TicketRenewalNumber, 2));
    s.Append(FormatStrProperty(NumberBMAfterRenewal, 10));
    s.Append(FormatIntProperty(RenewalINumber, 4));
    s.Append(FormatIntProperty(DriverNumber, 6));
    // s.Append(FormatStrProperty(String(StringToDuobusString(DriverFirstName)), 20));
    // s.Append(FormatStrProperty(String(StringToDuobusString(DriverLastName)), 30));
    s.Append(FormatStrProperty(DriverFirstName, 20));
    s.Append(FormatStrProperty(DriverLastName, 30));
    s.Append(DateToDuobusDateFormat(ReturnDate, '          '));
    s.Append(FormatStrProperty(ReturnTime, 8));
    s.Append(FormatStrProperty(ReturnAmount, 9));
    s.Append(FormatStrProperty(BuyerNIP, 20));
  finally
    fBufferStr := s.ToString;
    Result := pchar(fBufferStr);
    s.Free;
  end;
end;

