function TEmar_InterfacedObject.EmarXORSum(var aBuffer; aSize, aDataSize: integer): byte;
var
  p: PByte;
  i: integer;
begin
//  OutputDebugString(PChar('--- Start EmarXORSum ---'));
  p := @aBuffer;
  Result := 0;
  if aDataSize = 0 then aDataSize := aSize;
  for i := 1 to aSize do begin
//    OutputDebugString(PChar(Format('%d : %s', [Pred(i), IntToHex(Integer(p^), 2)])));
    if (i > aDataSize) and (i <> aSize) then // oprócz rekordów z danymi oraz ostatniego bajtu CRC
        Result := Result xor $FF
    else Result := Result xor p^;
    Inc(p);
  end;
//  OutputDebugString(PChar('--- Stop EmarXORSum ---'));
end;

