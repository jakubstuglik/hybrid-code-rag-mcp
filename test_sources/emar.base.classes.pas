function TEmar_RideReductionList.A6DCompare(List: TEmar_InterfaceList; Index1, Index2: Integer): Integer;
var
  vL, vR: boolean;
  l:      TEmar_RideReductionList;
  iL, iR: IEmar_RideReduction;
begin
  l := TEmar_RideReductionList(List);
  iL := l.Items[Index1];
  iR := l.Items[Index2];
  vL := not (iL.lp < 1) or (iL.lp > 199);
  vR := not (iR.lp < 1) or (iR.lp > 199);
  if vL then
    if vR then begin
      Result := iL.lp - iR.lp;
    end
    else Result := - 1
  else if vR then Result := 1
  else Result := 0;
end;

