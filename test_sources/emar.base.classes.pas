function TEmar_NA_File.LoadChunkFromStream(aStream: TStream; var s: ansistring): integer;
var
  l:    integer;
  iPos: int64;
  ch:   ansichar;
  str:  ansistring;
begin
  Result := - 1;
  iPos := aStream.Position;
  if aStream.Read(ch, 1) = 0 then begin
    Result := 0;
    Exit;
  end;
  case ch of
  'W', 'B': l := 3;
else aStream.Position := iPos;
  Exit;
  end;
  str := ansistring(StringOfChar('0', l));
  if aStream.Read(str[1], l) <> l then Exit;
  l := AnsiStrToIntDef(str, 0);
  if l = 0 then Exit;
  aStream.Position := iPos;
  SetLength(s, l);
  aStream.Read(s[1], l);
  case ch of
  'W': Result := NA_FILE_HEADER;
  'B': REsult := NA_FILE_EMCARD_TICKET;
  end;
end;

function TEmar_NA_File.LoadFromFile(aFileName: pchar): longword;
var
  fs: TFileStream;
begin
  if FileExists(aFileName) then begin
    fs := TFileStream.Create(aFileName, fmOpenRead or fmShareDenyWrite);
    try
      fVerifyCheckSum := true;
      try
        Result := LoadFromStream(fs);
      finally
        fVerifyCheckSum := false;
      end;
    finally
      fs.Free;
    end;
  end
  else Result := ERR_FILE_NOT_FOUND;
end;

function TEmar_NA_File.LoadFromStream(aStream: TStream): longword;
var
  s:       ansistring;
  recKind: integer;
  p:       PAnsiChar;
  t:       IEmar_NA_File_EmCard;
begin
  Result := ERR_INCORRECT_FILE;
  Clear;
  repeat
    s := '';
    recKind := LoadChunkFromStream(aStream, s);
    if (recKind > 0) and (Length(s) < 5) then Exit;
    case recKind of
    NA_FILE_HEADER: begin
        p := @s[2];
        fDataLength := IntL(p, 3);
        Inc(p, 3);
        // p := @s[5];
        fProgramName := CopyPStr(p, 6);
        Inc(p, 6);
        fProgramVersion := CopyPStr(p, 7);
        Inc(p, 7);
        fDataVersion := CopyPStr(p, 6);
        Inc(p, 6);
        fPrepareDate := DuobusDateToString(CopyL(p, 10));
        Inc(p, 10);
        fPrepareTime := CopyPStr(p, 8);
        Inc(p, 8);
        fPersonIDNumber := IntL(p, 6);
        Inc(p, 6);
        // fFirstName := DuobusStringToString(CopyL(p,20)); Inc(p,20);
        // fLastName := DuobusStringToString(CopyL(p,30)); Inc(p,30);
        fFirstName := CopyPStr(p, 20);
        Inc(p, 20);
        fLastName := CopyPStr(p, 30);
        Inc(p, 30);
        fINumber := IntL(p, 4);
        Inc(p, 4);
        fFileName := CopyPStr(p, 12);
        Inc(p, 12); // !!!
        fEmCardCount := IntL(p, 5);
        Inc(p, 5);
        fFileSize := IntL(p, 8);
      end;
    NA_FILE_EMCARD_TICKET: begin
        t := EmCardList.AddItem;

        p := @s[2];
        t.DataLength := IntL(p, 3);
        Inc(p, 3);
        // t.DataLength := d;
        t.NumberBM := CopyPStr(p, 10);
        Inc(p, 10);
        t.SaleDate := DuobusDateToPChar(CopyL(p, 10));
        Inc(p, 10);
        t.SaleTime := CopyPStr(p, 8);
        Inc(p, 8);
        t.EmCardNumber := CardinalL(p, 10);
        Inc(p, 10);
        t.TicketGenre := IntL(p, 1);
        Inc(p);
        t.ReductionType := IntL(p, 1);
        Inc(p);
        t.ReductionCode := IntL(p, 3);
        Inc(p, 3);
        t.ReductionPercentage := IntL(p, 3);
        Inc(p, 3);
        t.TicketAbroad := p^ = '1';
        Inc(p);
        t.VatCode1 := IntL(p, 1);
        Inc(p);
        t.VatRate1 := IntL(p, 5);
        Inc(p, 5);
        t.Brutto1 := IntL(p, 9);
        Inc(p, 9);
        t.ReductionAmount1 := IntL(p, 9);
        Inc(p, 9);
        t.VatCode2 := IntL(p, 1);
        Inc(p);
        t.VatRate2 := IntL(p, 5);
        Inc(p, 5);
        t.Brutto2 := IntL(p, 9);
        Inc(p, 9);
        t.ReductionAmount2 := IntL(p, 9);
        Inc(p, 9);

        t.NumberOfPasses := CopyPStr(p, 2);
        Inc(p, 2);
        t.ValidFrom := DuobusDateToPChar(CopyL(p, 10));
        Inc(p, 10);
        t.ValidTo := DuobusDateToPChar(CopyL(p, 10));
        Inc(p, 10);
        if t.DataLength > 179 then begin // od wersji struktury R01.01
          t.Logo := CopyPStr(p, 14);
          Inc(p, 14);
        end else begin
          t.Logo := CopyPStr(p, 12);
          Inc(p, 12);
        end;
        t.FiscalReportNumber := CopyPStr(p, 8);
        Inc(p, 8);
        t.TicketNumber := CopyPStr(p, 8);
        Inc(p, 8);
        t.RenewalDate := DuobusDateToPChar(CopyL(p, 10));
        Inc(p, 10);
        t.RenewalTime := CopyPStr(p, 8);
        Inc(p, 8);
        t.TicketRenewalNumber := IntL(p, 2);
        Inc(p, 2);
        t.NumberBMAfterRenewal := CopyPStr(p, 10); // Inc(p,10);
      end;
    end;

  until recKind <= 0;
  Result := ERR_NO_ERROR;
end;

function TEmar_NA_File.SaveToFile(aFileName: pchar): longword;
begin
  fStream.Clear;
  try
    Result := SaveToStream(fStream);
    if Result = ERR_NO_ERROR then fStream.SaveToFile(aFileName);
  finally
    fStream.Clear;
  end;
end;

function TEmar_NA_File.SaveToStream(aStream: TStream): longword;
var
  str: TStringStream;
  i:   integer;
  hm:  THashManager;
  s:   ansistring;
begin
  str := TStringStream(aStream);
  DataLength := 126;
  str.WriteString('W' + FormatIntProperty(DataLength, 3));
  str.WriteString(FormatStrProperty(ProgramName, 6));
  str.WriteString(FormatStrProperty(ProgramVersion, 7));
  str.WriteString(FormatStrProperty(DataVersion, 6));
  str.WriteString(DateToDuobusDateFormat(PrepareDate, '          '));
  str.WriteString(FormatStrProperty(PrepareTime, 8));
  str.WriteString(FormatIntProperty(PersonIDNumber, 6));
  str.WriteString(FormatStrProperty(FirstName, 20));
  str.WriteString(FormatStrProperty(LastName, 30));
  // str.WriteString(FormatStrProperty(String(StringToDuobusString(FirstName)), 20));
  // str.WriteString(FormatStrProperty(String(StringToDuobusString(LastName)), 30));
  str.WriteString(FormatIntProperty(INumber, 4));
  str.WriteString(FormatStrProperty(FileName, 12)); // !!!
  EmCardCount := EmCardList.Count;
  str.WriteString(FormatIntProperty(EmCardCount, 5));
  str.WriteString(FormatIntProperty(0, 8));
  for i := 0 to EmCardList.Count - 1 do str.WriteString(EmCardList[i].SaveToBuffer);
  FileSize := str.Size;
  str.Position := 118;
  str.WriteString(FormatIntProperty(FileSize, 8));
  str.Position := 0; // ??? 0?
  hm := THashManager.Create(nil);
  try
    hm.Algorithm := 'Message Digest 5';
    hm.CalcStream(str, str.Size);
    s := 'FFFE' + hm.DigestString[fmtHEX];
    str.Seek(0, soFromEnd);
    str.Write(s[1], Length(s));
  finally
    hm.Free;
  end;
  Result := ERR_NO_ERROR;
end;

