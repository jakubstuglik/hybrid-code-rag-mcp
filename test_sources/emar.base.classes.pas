function TEmar_ReportEvent_32.IsDuplicated: LongBool;
  function _IsWrong33EventMonthTicketSave(AEvent33: IEmar_ReportEvent; AEvent32: IEmar_ReportEvent): Boolean;
  begin
    Result :=
      Assigned(AEvent33)
      and(AEvent33.Kind = 33)
      and Assigned(AEvent32)
      and(AEvent32.Kind = 32)
      and(AEvent33.AsEvent_33.CardNumber = AEvent32.AsEvent_32.CardNumber)
      and(AEvent33.AsEvent_33.ErrorCode = 67{" BŁĄD ZAPISU EM-KARTY"})
      ;
  end;
var
  EMAR205, bWasWrong33MonthTicketSave: Boolean;
  i:   Integer;
  rel: IEmar_ReportEvent;
begin
  EMAR205 := False;
  for i := 0 to Pred(Self.IndexInReportsList) do
  begin
    rel := Self.Owner.ReportEventList[i];
    case rel.Kind of
      1: // Zmiana bileterki – identyfikacja bileterki
        begin
          EMAR205 := EMAR205 and Self.Owner.IsTicketRegisterEmar205(rel.AsEvent_01.TicketRegister);
        end;
{$REGION '41 - Identyfikacja bileterki EMAR-205'}
      41:
        begin
          EMAR205 := True;
        end;
    end;
  end;

  bWasWrong33MonthTicketSave := False;
  i := Pred(Self.IndexInReportsList);
  while i >= 0 do begin
    rel := Self.Owner.ReportEventList[i];
    if not bWasWrong33MonthTicketSave then
      bWasWrong33MonthTicketSave := _IsWrong33EventMonthTicketSave(rel, Self);
    if (rel.Kind = 32)
      and(not rel.IsError(reErrorPartMissing2 or reErrorCheckSum2)) // rekord #2 jest poprawny
      and(not rel.IsError(reErrorPartMissing3 or reErrorCheckSum3)) // rekord #3 jest poprawny
      and(rel.AsEvent_32.CardNumber = Self.CardNumber)
      and(AnsiCompareStr(string(rel.AsEvent_32.CardTicketNumber), string(Self.CardTicketNumber)) = 0)
      and(rel.AsEvent_32.ExtCount = Self.ExtCount)
      and(rel.AsEvent_32._TicketNumberUsedHighPart = Self._TicketNumberUsedHighPart)
      // sprawdzenie dla Emar-205: czy bilet został zapisany do pamięci fiskalnej
      and((not EMAR205)or(rel.AsEvent_32._ControlCode_Decoded = '')) then
    begin
      if not bWasWrong33MonthTicketSave then
        Break
      else
      begin // if there was a wrong month ticket saving after a "candidate" to be those event #32 duplicate
        bWasWrong33MonthTicketSave := False; // erase a flag
        Dec(i); // and continue of backward browsing to find another "candidate"
      end;
    end
    else
      Dec(i);
  end;
  Result := i >= 0; // został znaleziony
end;

