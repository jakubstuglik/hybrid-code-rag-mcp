function TEmar_DriverSalePrefSet.GetCardStatus(ix: TEmar205_DriverSaleStatusBytes): byte;
begin
  Result := 0;
  case ix of
  1: begin
      if not fRideBusStopNumberFromOne then Result := Result or $80;
      if not fGroupTicketAllowed then Result := Result or $40;
      if not fCanBackwardAfterTicketSold then Result := Result or $20;
      if not fPrintControlTicketAllowed then Result := Result or $10;
      if not fDriverTaskReportAllowed then Result := Result or $08;
      if not fNoLimitPrintTaskReport then Result := Result or $04;
      if not fAdditionalFeesAllowed then Result := Result or $02;
      if not fChangeClockSettingAllowed then Result := Result or $01;
    end;
  2: begin
      if not fPeriodicReportsAllowed then Result := Result or $80;
      if not fRideReportAllowed then Result := Result or $40;
      if not fShowPassengerNameOnTicketControl then Result := Result or $20;
      if not fTicketRegisterChangeAllowed then Result := Result or $10; // T34152
      if not fChangeMenuAccessCodeAllowed then Result := Result or $08;
      if not fFullFillCardWorkMode then Result := Result or $04;
      if fCheckingControlNumbers then Result := Result or $02;
      if not fChoiceRideBeyondCalendar then Result := Result or $01;
    end;
  3: begin
      if fStarKeySwitchSaleMode then Result := Result or $80;
      if not fBusSideNumberEntering then Result := Result or $40;
      if fOptionalBusSideNumberEntering then Result := Result or $20;
      if not fHintBusSideNumberStoredInTicketRegister then Result := Result or $10;
      if not fRemaindPrintMonthFiscalReport then Result := Result or $08;
      if not fForcePrintMonthFiscalReport then Result := Result or $04;
      if not fPayInForeignCurrencyAllowed then Result := Result or $02;
      if not fPrintSideNumberOnTicket then Result := Result or $01;
    end;
  4: begin
      if fCashOnlyPayment then Result := Result or $80;  // zadanie 66588 !!!
      if fShowBilanceAllowed then Result := Result or $40;
      if fChoiceReliefWithouEnteringNumber then Result := Result or $20;
      if fChoiceRideBeyondTaskAllowed then Result := Result or $10;
      if fSaveRideInfoToCardWithoutPrint then Result := Result or $08;
      if not fNextTicketPeriodSaleAllowed then Result := Result or $04;
      if fPrintBillRestForeignCurrency then Result := Result or $02;
      if not fPrintLineData then Result := Result or $01;
    end;
  end;
end;

