procedure TEmar_DriverList.WriteToJson(jtw: TJsonTextWriter);
var
  ix: integer;
begin
  if Count > 0 then begin
    jtw.WriteStartObject;
    jtw.WritePropertyName(jStruct);
    jtw.WriteStartObject; // structure
    jtw.WritePropertyName(jID);
    jtw.WriteValue(Id);
    jtw.WritePropertyName(jCount);
    jtw.WriteValue(Count);
    GetItem(0).WriteStructToJson(jtw);
    jtw.WriteEndObject; // structure
    jtw.WritePropertyName(jRecords);
    jtw.WriteStartArray; // records
    for ix := 0 to Count - 1 do GetItem(ix).WriteToJson(jtw);
    jtw.WriteEndArray; // records
    jtw.WriteEndObject;
  end;
end;

