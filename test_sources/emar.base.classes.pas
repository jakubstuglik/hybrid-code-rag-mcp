end;

function TEmar_RideTariffList._add_list(aList: IEmar_RideTariffList; var ix_list, ix_add: integer): boolean;
var
  i, j, e, ix: integer;
  bOk:         boolean;
begin
  Result := (Count > 0) and (aList.Count > 0);
  if Result then begin
    e := Count;
    for i := 0 to e - 1 do
      if IsEqualTariff(Items[i], aList[0]) then begin
        bOk := true;
        for j := 1 to aList.Count - 1 do begin
          ix := i + j;
          if (ix < e) then begin
            if not IsEqualTariff(Items[ix], aList[j]) then begin
              bOk := false;
              Break;
            end
            else ix_add := j + 1;
          end else begin
            ix_add := j;
            Break;
          end;
        end;
        if bOk then begin
          ix_list := i;
          Exit;
        end;
      end;
    Result := false;
  end;
end;

