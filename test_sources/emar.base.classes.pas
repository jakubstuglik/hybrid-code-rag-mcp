// AT: Działa jak AnRap105.ZgodneKody
function TEmar_ReportEvent_17._GetIsCompatibleControlCodes: PBoolean;
var
  i, j, k:          Integer;
  aCardControlCode: array [0 .. 3] of Byte;
  aControlCode:     array [0 .. 4] of Byte;
begin
  Result := PBoolean(False);
  HexToArray(aCardControlCode, Length(aCardControlCode), fCardControlCode);
  HexToArray(aControlCode, Length(aControlCode), fControlCode);

  i := 0;
  j := 1;
  k := 4;
  // dla 29 oraz 34 bajtów (dla bajtu 34 ignorujemy starszy bit bajtu 34)
  if aCardControlCode[i] = (aControlCode[j] and $0F) then begin // reszta muszą całkiem się zgadzać
    repeat
      Inc(i);
      Inc(j);
      Dec(k);
    until (k = 0) or (aCardControlCode[i] <> aControlCode[j]);
    if k = 0 then Result := PBoolean(True);
  end;
end;

