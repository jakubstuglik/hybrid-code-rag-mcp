procedure TEmar_Dir.LoadFromBuffer(aStream: TStream; aVer: byte);
var
  iEntry: IEmar_DirEntry;
  id:     byte;
  ps:     int64;
begin
  fItems.Clear;
  case Owner.FileType of
    EMAR_FILE_TYPE_CKM:
      begin

      end;
    else
      begin
        aStream.Seek(FLASH_528 * fPageNr, soFromBeginning);
        ps := aStream.Position;
        repeat
          aStream.Read(id, 1);
          if id <> $FF then begin
            aStream.Seek( - 1, soFromCurrent);
            iEntry := AddItem(id);
            TEmar_DirEntry(iEntry).LoadFromBuffer(aStream);
          end
          else
            if Owner.IsEmar205OnlineReport() and(not Self.IsCorrect) then
              Owner.TryToRepairDIR(TMemoryStream(aStream));
        until id = $FF;
        aStream.Seek(LongInt(ps + FLASH_528), soFromBeginning);
      end;
  end;
end;

procedure TEmar_Dir.SaveToBuffer(aStream: TStream; aVer: byte);
var
  ms: TMemoryStream;
  i:  integer;
begin
  case Owner.FileType of
    EMAR_FILE_TYPE_DUOBUS:
      begin

      end;
    else
      begin
        ms := TMemoryStream.Create;
        try
          for i := 0 to fItems.Count - 1 do GetObject(i).SaveToBuffer(ms);
          FillChar(fPage, FLASH_528, $FF);
          ms.Position := 0;
          ms.Read(fPage, ms.Size);
          FillPageCtrlBytes(fPage, Id, fPageNr, $FFFF, $FFFF);
          aStream.Position := fPageNr * FLASH_528;
          aStream.Write(fPage, FLASH_528);
        finally
          ms.Free;
        end;
      end;
  end;
end;

procedure TEmar_Dir.SetNr(const Value: integer);
begin
  if Owner.FileType <> EMAR_FILE_TYPE_DUOBUS then begin
    if fNr <> Value then begin
      if not ((Value < 1) or (Value > 2)) then begin
        fNr := Value;
        case Owner.FileType of
          EMAR_FILE_TYPE_EMAR105:
            if fNr = 1 then
            begin
              Id := 5;
              fPageNr := 9;
            end
            else
            begin
              Id := 6;
              fPageNr := 4086;
            end;
          EMAR_FILE_TYPE_EMAR205:
            if fNr = 1 then
            begin
              Id := 5;
              fPageNr := 5;
            end
            else
            begin
              Id := 6;
              fPageNr := 2042;
            end;
          EMAR_FILE_TYPE_CKM: // there is not OIK2 page in CKM, there is just 1 page of OIKCONSTDIR
            begin
              Id := 3;
              fPageNr := 8;
            end;
        end;
      end;
    end
  end else begin
    Id := 6;
    fNr := 1;
    fPageNr := 0;
  end;
end;

