function TEmar_Tariff.OblCenKm(const ADistance: Integer; APriceKm: PInteger): Cardinal;
var
  c:    IEmar_Price; // TRLCen;
  i:    integer;
  odlc: integer;
begin
  Result := ERR_NO_ERROR;

  APriceKm^ := 0;
  i := 1;
  odlc := 0;
  while i <= PriceCount{ tar.LiczbaCen } do begin
    c := Self.Owner.PricesList[IndexOfPrice{ - 1 } + i - 1]; // DajRLCen(Ace,(tar.NrPCeny-1+i-1)*DRe.CE,RE,WyswRL);
    if c.Increase{ c.Przyrost=1 } then Break;
    APriceKm^ := c.Price;           // c.Cena;
    if Kind = 6 then odlc := c.Zone // c.Strefa;
    else odlc := c.Distance;        // c.Strefa;
    if (odlc >= ADistance{ odl }) and (odlc > 0) then Break;
    Inc(i);
  end;
  if (c.Increase{ c.Przyrost=1 }) and (odlc < ADistance{ odl }) then begin
    if Kind = 6 then begin
      i := (ADistance{ odl } - odlc) div c.Zone;    // c.Strefa;
      odlc := (ADistance{ odl } - odlc) mod c.Zone; // c.Strefa;
    end else begin
      i := (ADistance{ odl } - odlc) div c.Distance;    // c.Strefa;
      odlc := (ADistance{ odl } - odlc) mod c.Distance; // c.Strefa;
    end;
    if odlc <> 0 then Inc(i);
    APriceKm^ := APriceKm^ + c.Price{ c.Cena } * i;
  end;
end;

