function TEmar_Dir.RecordIndex(const aTableId, aPage, aOffset: Integer): Integer;
var
  i:      Integer;
  _dir:   IEmar_DirEntry;
  rpp, t: integer;
begin
  Result := -1;
  i := Owner.Dir.IndexOf(aTableId);
  if i > -1 then
  begin
    _dir := Owner.Dir[i];
    rpp := 512 div _dir.RecLength;
    Result := (aPage - _dir.FirstPage) * rpp;
    t := 0;
    while t < aOffset do begin
      Inc(t, _dir.RecLength);
      Inc(Result);
    end;
  end;
end;

