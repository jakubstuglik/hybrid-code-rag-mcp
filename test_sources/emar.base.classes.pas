begin
  Result := inherited AddItem as IEmar_RideMonthTariff;
end;

function TEmar_RideMonthTariffList.AddList(aList: IEmar_RideMonthTariffList): integer;
var
  ix_list, ix_add: integer;
begin
  if _add_list(aList, ix_list, ix_add) then begin
    Result := ix_list;
    if ix_add >= aList.Count then Exit;
  end else begin
    Result := Count;
    ix_add := 0;
  end;
  for ix_list := ix_add to aList.Count - 1 do CopyMonthTariff(AddItem, aList.Items[ix_list]);
end;

procedure TEmar_RideMonthTariffList.SortRideMonthTariff;
begin
  _Sort(CompareRideMonthTariffs);
end;

function TEmar_RideMonthTariffList.GetItems(index: integer): IEmar_RideMonthTariff;
begin
  Result := fItems[index] as IEmar_RideMonthTariff;
end;

function TEmar_RideMonthTariffList.CompareRideMonthTariffs(
  List: TEmar_InterfaceList; Index1, Index2: Integer): Integer;
var
  i, iLTopIndex, iLBottomIndex, iRTopIndex, iRBottomIndex: Integer;
  l:      TEmar_RideMonthTariffList;
  iL, iR: IEmar_RideMonthTariff;
begin
  l := TEmar_RideMonthTariffList(List);
  iL := l.Items[Index1];
  iR := l.Items[Index2];
  // at this moment, sort works inside the interchange tariffs only; uses in DuoBus
  if
    // one of the tariffs is not an interchange
    (iL.IndexOfChangeBusStop < 0)
    or(iR.IndexOfChangeBusStop < 0)
    // is not 'kilometrowa'
    or(iL.FirstPriceIndex < 0)
    or(iR.FirstPriceIndex < 0)
    // assigned with the different rides
    or(iL.IndexOfFirstBusStopInRoute <> iR.IndexOfFirstBusStopInRoute)
    or(iL.IndexOfLastBusStopInRoute <> iR.IndexOfLastBusStopInRoute)
  then
    Result := Index1 - Index2
  else
  begin
{$REGION '    L item: find the ride tariffs range where the sorting have to be working'}
    iLTopIndex := Index1;
    iLBottomIndex := Index1;
    for i := Pred(Index1) downto 0 do
      if Owner.RideMonthTariffList[i].IndexOfChangeBusStop < 0 then
      begin
        iLTopIndex := i;
        Break;
      end;
    if iLTopIndex = Index1 then
      iLTopIndex := 0;
    for i := Succ(Index1) to Pred(Owner.RideMonthTariffList.Count) do
      if Owner.RideMonthTariffList[i].IndexOfChangeBusStop < 0 then
      begin
        iLBottomIndex := i;
        Break;
      end;
    if iLBottomIndex = Index1 then
      iLBottomIndex := Pred(Owner.RideMonthTariffList.Count);
{$ENDREGION}

{$REGION '    R item: find the ride tariffs range where the sorting have to be working'}
    iRTopIndex := Index2;
    iRBottomIndex := Index2;
    for i := Pred(Index2) downto 0 do
      if Owner.RideMonthTariffList[i].IndexOfChangeBusStop < 0 then
      begin
        iRTopIndex := i;
        Break;
      end;
    if iRTopIndex = Index2 then
      iRTopIndex := 0;
    for i := Succ(Index2) to Pred(Owner.RideMonthTariffList.Count) do
      if Owner.RideMonthTariffList[i].IndexOfChangeBusStop < 0 then
      begin
        iRBottomIndex := i;
        Break;
      end;
    if iRBottomIndex = Index2 then
      iRBottomIndex := Pred(Owner.RideMonthTariffList.Count);
{$ENDREGION}

    // #0 - check if they are inside the same ride tariffs range (assigned to the same ride)
    if (iLTopIndex <> iRTopIndex)or(iLBottomIndex <> iRBottomIndex) then
      Result := Index1 - Index2
    else
    begin // inside
      // #1 - ASC - wg numerów kursów po przesiadce - dla jednego kursu
      Result := Owner.RideList[iL.IndexOfRide].Number - Owner.RideList[iR.IndexOfRide].Number;
      if Result = 0 then
      begin
        // #2 - DESC - wg ważności taryfy (malejącej wartości pola TCK_FarePriceList.ValidFrom) - dla jednej taryfy
        Result := CompareStr(iR.ValidFrom, iL.ValidFrom);
        if Result = 0 then
        begin
          // #3 - ASC - wg rosnącej wartości pola FarePriceScaleNumber - dla jednej taryfy
          Result := Owner.TariffList[iL.IndexOfTariff].Number - Owner.TariffList[iR.IndexOfTariff].Number;
          if Result = 0 then
          begin
            // #4 - DESC - wg rodzajów biletów (malejącej wartości pola FarePriceTableNumber)
            Result := Owner.TariffList[iR.IndexOfTariff].Table - Owner.TariffList[iL.IndexOfTariff].Table; // !!!
          end;
        end;
      end;
    end;
  end;
end;

function TEmar_RideMonthTariffList.New: IEmar_RideMonthTariffList;
begin
  Result := _New;
end;

function TEmar_RideMonthTariffList._add_list(aList: IEmar_RideMonthTariffList; var ix_list, ix_add: integer): boolean;
var
  i, j, e, ix: integer;
  bOk:         boolean;
begin
  Result := (Count > 0) and (aList.Count > 0);
  if Result then begin
    e := Count;
    for i := 0 to e - 1 do
      if IsEqualMonthTariff(Items[i], aList[0]) then begin
        bOk := true;
        for j := 1 to aList.Count - 1 do begin
          ix := i + j;
          if (ix < e) then begin
            if not IsEqualMonthTariff(Items[ix], aList[j]) then begin
              bOk := false;
              Break;
            end
            else ix_add := j + 1;
          end else begin
            ix_add := j;
            Break;
          end;
        end;
        if bOk then begin
          ix_list := i;
          Exit;
        end;
      end;
    Result := false;
  end;
end;

{ TEmar_CommunicationKindList }

function TEmar_CommunicationKindList.Add(aNumber: integer; aName: pchar): integer;
var
  n:  string;
  i:  integer;
  it: IEmar_CommunicationKind;
begin
  n := IntToStr(aNumber);
  Result := - 1;
  for i := 0 to Count - 1 do
    if n = Items[i].Number then begin
      Result := i;
      Break;
    end;
  if Result < 0 then begin
    Result := Count;
    it := AddItem;
    it.Number := pchar(n);
    it.Name := aName;
  end;
end;

