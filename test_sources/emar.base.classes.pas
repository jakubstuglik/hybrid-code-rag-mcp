procedure TEmar_DirEntry.LoadFromBuffer(aStream: TStream; aVer: byte);
begin
  aStream.Read(fEntry, SizeOf(fEntry));
  if Owner.BigEndian then begin
    fEntry.FirstPage := Swap(fEntry.FirstPage);
    fEntry.RecCount := Swap32(fEntry.RecCount);
  end;
  fId := fEntry.Id;
end;

function TEmar_DirEntry.RecordLength(aVer: byte): integer;
begin
  Result := SizeOf(TEmar_DirEntry);
end;

procedure TEmar_DirEntry.SaveToBuffer(aStream: TStream; aVer: byte);
begin
  if Owner.BigEndian then begin
    fEntry.FirstPage := Swap(fEntry.FirstPage);
    fEntry.RecCount := Swap32(fEntry.RecCount);
  end;
  CalculateCheckSum;
  aStream.Write(fEntry, SizeOf(fEntry));
  if Owner.BigEndian then begin
    fEntry.FirstPage := Swap(fEntry.FirstPage);
    fEntry.RecCount := Swap32(fEntry.RecCount);
  end;
end;

