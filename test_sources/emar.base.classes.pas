function TEmar_ReportEvent.EventKindToText: pchar;
var
  sEventText: String;
begin
  if (fKind > - 1) and (fKind < Length(Anag)) then sEventText := Anag[fKind]
  else sEventText := 'Nierozpoznane zdarzenie raportu';

  Result := pchar(sEventText);
end;

function TEmar_ReportEvent.EventKindAsString: pchar;
var
  sEventKindAsString: String;
begin
  if (fKind > - 1) and (fKind < Length(Anag)) then
    sEventKindAsString := IntToStr(fKind)
  else
    if (fKind >= DUOBUS_REPORT_EVENT_START) and (fKind <= DUOBUS_REPORT_EVENT_END) then
    begin
      case fKind of
        DUOBUS_REPORT_EVENT_N: sEventKindAsString := 'N';
        DUOBUS_REPORT_EVENT_I: sEventKindAsString := 'I';
        DUOBUS_REPORT_EVENT_O: sEventKindAsString := 'O';
        DUOBUS_REPORT_EVENT_B: sEventKindAsString := 'B';
        DUOBUS_REPORT_EVENT_A: sEventKindAsString := 'A';
        DUOBUS_REPORT_EVENT_D: sEventKindAsString := 'D';
        DUOBUS_REPORT_EVENT_E: sEventKindAsString := 'E';
        DUOBUS_REPORT_EVENT_G: sEventKindAsString := 'G';
        DUOBUS_REPORT_EVENT_X: sEventKindAsString := 'X';
        DUOBUS_REPORT_EVENT_Y: sEventKindAsString := 'Y';
        DUOBUS_REPORT_EVENT_C: sEventKindAsString := 'C';
        DUOBUS_REPORT_EVENT_J: sEventKindAsString := 'J';
        DUOBUS_REPORT_EVENT_M: sEventKindAsString := 'M';
        DUOBUS_REPORT_EVENT_P: sEventKindAsString := 'P';
        DUOBUS_REPORT_EVENT_F: sEventKindAsString := 'F';
        DUOBUS_REPORT_EVENT_S: sEventKindAsString := 'S';
        DUOBUS_REPORT_EVENT_K: sEventKindAsString := 'K';
        DUOBUS_REPORT_EVENT_R: sEventKindAsString := 'R';
        DUOBUS_REPORT_EVENT_H: sEventKindAsString := 'H';
        DUOBUS_REPORT_EVENT_Z: sEventKindAsString := 'Z';
      else
        sEventKindAsString := '';
      end;
    end
    else
      sEventKindAsString := 'Nierozpoznane zdarzenie raportu';

  Result := pchar(sEventKindAsString);
end;

