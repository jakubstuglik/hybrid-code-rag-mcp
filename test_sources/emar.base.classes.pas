function TEmar_PA_File.LoadChunkFromStream(aStream: TStream; var s: ansistring): integer;
var
  l:    integer;
  iPos: int64;
  ch:   ansichar;
  str:  ansistring;
begin
  Result := - 1;
  iPos := aStream.Position;
  if aStream.Read(ch, 1) = 0 then begin
    Result := 0;
    Exit;
  end;
  case ch of
  'W', 'B': l := 3;
else aStream.Position := iPos;
  Exit;
  end;
  str := ansistring(StringOfChar('0', l));
  if aStream.Read(str[1], l) <> l then Exit;
  l := AnsiStrToIntDef(str, 0);
  if l = 0 then Exit;
  aStream.Position := iPos;
  SetLength(s, l);
  aStream.Read(s[1], l);
  case ch of
  'W': Result := PA_FILE_HEADER;
  'B': REsult := PA_FILE_TICKET;
  end;
end;

function TEmar_PA_File.LoadFromFile(aFileName: pchar): longword;
var
  fs: TFileStream;
begin
  if FileExists(aFileName) then begin
    fs := TFileStream.Create(aFileName, fmOpenRead or fmShareDenyWrite);
    try
      fVerifyCheckSum := true;
      try
        Result := LoadFromStream(fs);
      finally
        fVerifyCheckSum := false;
      end;
    finally
      fs.Free;
    end;
  end
  else Result := ERR_FILE_NOT_FOUND;
end;

function TEmar_PA_File.LoadFromStream(aStream: TStream): longword;
var
  s:       ansistring;
  recKind: integer;
  p:       PAnsiChar;
  t:       IEmar_PA_File_Ticket;
begin
  Result := ERR_INCORRECT_FILE;
  Clear;
  repeat
    s := '';
    recKind := LoadChunkFromStream(aStream, s);
    if (recKind > 0) and (Length(s) < 5) then Exit;
    case recKind of
    PA_FILE_HEADER: begin
        p := @s[5];
        fProgramName := CopyPStr(p, 6);
        Inc(p, 6);
        fProgramVersion := CopyPStr(p, 7);
        Inc(p, 7);
        fDataVersion := CopyPStr(p, 6);
        Inc(p, 6);
        fPrepareDate := DuobusDateToString(CopyL(p, 10));
        Inc(p, 10);
        fPrepareTime := CopyPStr(p, 8);
        Inc(p, 8);
        fPersonIDNumber := IntL(p, 6);
        Inc(p, 6);
        fFirstName := DuobusStringToString(CopyL(p, 20));
        Inc(p, 20);
        fLastName := DuobusStringToString(CopyL(p, 30));
        Inc(p, 30);
        fINumber := IntL(p, 4);
        Inc(p, 4);
        fFileName := CopyPStr(p, 12);
        Inc(p, 12);
        fTicketCount := IntL(p, 5);
        Inc(p, 5);
        fFileSize := IntL(p, 8);
      end;
    PA_FILE_TICKET: begin
        p := @s[5];
        t := TicketList.AddItem;
        t.NumberBM := CopyPStr(p, 10);
        Inc(p, 10);
        t.SaleDate := DuobusDateToPChar(CopyL(p, 10));
        Inc(p, 10);
        t.SaleTime := CopyPStr(p, 8);
        Inc(p, 8);
        t.EmCardNumber := CardinalL(p, 10);
        Inc(p, 10);
        t.TicketGenre := IntL(p, 1);
        Inc(p);
        t.ReductionType := IntL(p, 1);
        Inc(p);
        t.ReductionCode := IntL(p, 3);
        Inc(p, 3);
        t.ReductionPercentage := IntL(p, 3);
        Inc(p, 3);
        t.TicketAbroad := p^ = '1';
        Inc(p);
        t.VatCode1 := IntL(p, 1);
        Inc(p);
        t.VatRate1 := IntL(p, 5);
        Inc(p, 5);
        t.Brutto1 := IntL(p, 9);
        Inc(p, 9);
        t.ReductionAmount1 := IntL(p, 9);
        Inc(p, 9);
        t.VatCode2 := IntL(p, 1);
        Inc(p);
        t.VatRate2 := IntL(p, 5);
        Inc(p, 5);
        t.Brutto2 := IntL(p, 9);
        Inc(p, 9);
        t.ReductionAmount2 := IntL(p, 9);
        Inc(p, 9);
        t.RideNumbersDays := IntL(p, 2);
        Inc(p, 2);
        t.ValidDayCount := IntL(p, 3);
        Inc(p, 3);
        t.NewValidFrom := DuobusDateToPChar(CopyL(p, 10));
        Inc(p, 10);
        t.NewValidTo := DuobusDateToPChar(CopyL(p, 10));
        Inc(p, 10);
        t.ContinueCount := IntL(p, 2);
        Inc(p, 2);
        t.Removed := p^ = 'U';
      end;
    end;
  until recKind <= 0;
  Result := ERR_NO_ERROR;
end;

