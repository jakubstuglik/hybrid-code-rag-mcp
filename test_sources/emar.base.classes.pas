procedure TEmar_InterfacedObject.FillPageCtrlBytes(var aPage: TEmarPage528; aId: byte; aCurr, aPrev, aNext: word);
var
  bx, bl: byte;
begin
  aPage.rCtrlBytes.bId := aId;
  aPage.rCtrlBytes.bLRCSum := EmarLRCSum(aPage.aContent[0], SizeOf(aPage.aContent));
  aPage.rCtrlBytes.bXORSum := EmarXORSum(aPage.aContent[0], SizeOf(aPage.aContent));
  aPage.rCtrlBytes.wCurrPage := CalcWord(aCurr);
  aPage.rCtrlBytes.wPrevPage := CalcWord(aPrev);
  aPage.rCtrlBytes.wNextPage := CalcWord(aNext);
  FillChar(aPage.rCtrlBytes.aEmpty, SizeOf(aPage.rCtrlBytes.aEmpty), $FF);
  aPage.rCtrlBytes.bCtrlLRCSum := 0;
  aPage.rCtrlBytes.bCtrlXORSum := 0;
  aPage.rCtrlBytes.b55 := $55;
  aPage.rCtrlBytes.bAA := $AA;
  bl := EmarLRCSum(aPage.rCtrlBytes.bId, SizeOf(aPage.rCtrlBytes));
  bx := EmarXORSum(aPage.rCtrlBytes.bId, SizeOf(aPage.rCtrlBytes));
  aPage.rCtrlBytes.bCtrlLRCSum := bl;
  aPage.rCtrlBytes.bCtrlXORSum := bx;
end;

