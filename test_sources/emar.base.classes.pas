function TEmar_CalendarList.AddList(List: IEmar_CalendarList): integer;
var
  i, j: Integer;
begin
  if ((FCalendarLength > 0) and (List.Count <> FCalendarLength)) or (List.Count = 0) then
      raise Exception.Create('All calendars must have the same length and isn`t be empty!');
  if Count <> 0 then
    for i := 1 to Count div FCalendarLength do begin
      j := 0;
      while j < FCalendarLength do begin
        if Items[(i - 1) * FCalendarLength + j].Month <> List.Items[j].Month then break;
        Inc(j);
      end;
      if j = FCalendarLength then begin
        Result := (i - 1) * FCalendarLength;
        Exit;
      end;
    end
  else FCalendarLength := List.Count;
  Result := Count;
  for i := 0 to List.Count - 1 do _Items.Add(List.Items[i]);
end;

function TEmar_CalendarList.New: IEmar_CalendarList;
begin
  Result := _New;
end;

function TEmar_CalendarList.New(aFrom, aTo: pchar): IEmar_CalendarList;
var
  dOd, dDo, d: TDate;
  i, cnt:      integer;
begin
  dOd := StrToDate(aFrom);
  dDo := StrToDate(aTo);
  cnt := MonthsCount(dOd, dDo) + 1;
  if cnt > 0 then begin
    d := dOd;
    Result := _New;
    for i := 1 to cnt do begin
      Result.AddItem(getFullMonth(d));
      d := IncMonth(d);
    end;
    cnt := DayOf(dOd) - 1;
    Result.Items[0].Month := (Result.Items[0].Month shr cnt) shl cnt;
    cnt := 32 - DayOf(dDo);
    Result.Items[Result.Count - 1].Month := (Result.Items[Result.Count - 1].Month shl cnt) shr cnt;
  end
  else Result := nil;
end;

function TEmar_CalendarList.New(aFrom, aTo, aValidFrom, aValidTo: pchar): IEmar_CalendarList;
var
  l:       IEmar_CalendarList;
  i, c, m: integer;
begin
  Result := New(aFrom, aTo);
  if (aFrom <> aValidFrom) or (aTo <> aValidTo) then begin
    l := New(aValidFrom, aValidTo);

    { ważność poza kalendarza }
    c := MonthsCount(StrToDate(aFrom), StrToDate(aValidTo));
    m := MonthsCount(StrToDate(aValidFrom), StrToDate(aTo));

    if (c < 0) or (m < 0) then begin
      for i := 0 to Result.Count - 1 do Result[i].Month := 0;
      Exit;
    end;

    { ważność ma wspólnią część z kalendarzem }
    c := MonthsCount(StrToDate(aFrom), StrToDate(aValidFrom));
    if c >= 0 then begin
      for i := 0 to c - 1 do Result[i].Month := 0;
      Result[c].Month := l[0].Month;
    end;
    c := MonthsCount(StrToDate(aValidTo), StrToDate(aTo));
    if c >= 0 then begin
      Result[Result.Count - 1 - c].Month := l[l.Count - 1].Month;
      Dec(c);
      while c >= 0 do begin
        Result[Result.Count - 1 - c].Month := 0;
        Dec(c);
      end;
    end;

    l := nil;
  end;
end;

function TEmar_CalendarList.NewEmpty(aFrom, aTo: pchar): IEmar_CalendarList;
var
  dOd, dDo, d: TDate;
  i, cnt:      integer;
begin
  dOd := StrToDate(string(aFrom));
  dDo := StrToDate(string(aTo));
  cnt := MonthsCount(dOd, dDo) + 1;
  if cnt > 0 then begin
    d := dOd;
    Result := _New;
    for i := 1 to cnt do begin
      Result.AddItem(0);
      d := IncMonth(d);
    end;
  end
  else Result := nil;
end;

procedure TEmar_CalendarList.OperateList(aKind: TEmarDesignationKind; aList: IEmar_CalendarList;
  aStartIndex: integer = - 1; aLength: integer = - 1);
var
  i, l, s: integer;
begin
  if aLength > 0 then l := aLength
  else if aList.Count < Count then l := aList.Count
  else l := Count;
  if aStartIndex < 0 then s := 0
  else s := aStartIndex;
  case aKind of
  edkNone: Exit;
  edkAND: begin
      for i := s to s + l - 1 do Items[i].Month := Items[i].Month and aList.Items[i].Month;
    end;
  edkOR: begin
      for i := 0 to s + l - 1 do Items[i].Month := Items[i].Month or aList.Items[i].Month;
    end;
  end;
end;

