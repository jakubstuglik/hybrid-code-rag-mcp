  if fIsInit then Exit;
  FJsonProperties.Clear;
  FIsNameSorted := false;
  FIsIndexSorted := false;
  T := fCTX.GetType(ClassType);
  ixProp := 0;
  for P in T.GetProperties do begin
    for A in P.GetAttributes do
      if A is TEmarJsonCustomProperty then begin
        TEmarJsonCustomProperty(A).RttiPropertyIndex := ixProp;
        FJsonProperties.Add(TEmarJsonCustomProperty(A));
