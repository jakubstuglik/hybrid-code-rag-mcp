  sFloat := StringReplace(sFloat, '.', ds, []);
  sFloat := StringReplace(sFloat, ',', ds, []);
  fs.DecimalSeparator := ds;
  fs.ThousandSeparator := #0;
  Result := StrToFloat(sFloat, fs);
end;

function TEmar_InterfacedObject.DuobusFloatToInteger(s: ansistring; mul: integer): integer;
