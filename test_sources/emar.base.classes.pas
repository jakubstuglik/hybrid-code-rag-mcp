  sFloat := String(s);
  sFloat := StringReplace(sFloat, '.', ds, []);
  sFloat := StringReplace(sFloat, ',', ds, []);
  fs.DecimalSeparator := ds;
  fs.ThousandSeparator := #0;
  Result := Round(StrToFloat(sFloat, fs) * mul);
end;

function TEmar_InterfacedObject.DuobusStringToString(s: ansistring; aTrim: boolean): pchar;
var
  i:   integer;
  str: string;
  b:   boolean;
begin
  str := string(s);
  if aTrim then begin
    i := Length(str);
    b := false;
    while (i > 0) and (str[i] = ' ') do begin
      b := true;
      dec(i);
    end;
    if i > 0 then begin
      if b then SetLength(str, i);
    end
    else str := '';
  end;
  for i := low(s) to high(s) do
    case s[i] of
    #$A4: str[i] := 'Ą';
    #$8F: str[i] := 'Ć';
    #$A8: str[i] := 'Ę';
    #$9D: str[i] := 'Ł';
    #$E3: str[i] := 'Ń';
    #$E0: str[i] := 'Ó';
    #$97: str[i] := 'Ś';
    #$8D: str[i] := 'Ź';
    #$BD: str[i] := 'Ż';
    #$A5: str[i] := 'ą';
    #$86: str[i] := 'ć';
    #$A9: str[i] := 'ę';
    #$88: str[i] := 'ł';
    #$E4: str[i] := 'ń';
    #$A2: str[i] := 'ó';
    #$98: str[i] := 'ś';
    #$AB: str[i] := 'ź';
    #$BE: str[i] := 'ż';
    end;
  Result := pchar(str);
end;

