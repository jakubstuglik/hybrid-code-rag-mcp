procedure TEmar_ReportEvent.SetToData;
var
  p: PEmar105_ReportEvent_Begin;
begin
  if Assigned(pData) then begin
    ClearData;
    p := pData;
    p^.ID := 101;
    // w zależności od zdarzenia, ustawić w override liczbę rekordów
    p^.Count := 1;
    p^.Index := 1;
    p^.EventID := fKind;
    DateToEmarDate(p^.EventDate, fEventDate);
    TimeToEmarTime(p^.EventTime, fEventTime);
  end
  else AddError(reErrorNoMemoryAllocated);
end;

