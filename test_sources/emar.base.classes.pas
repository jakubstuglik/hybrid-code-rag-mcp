function TEmar_BaseFile._LoadFileToStream(aFileName: string): longword;
{$IFDEF ZIP}
var
  isZIP: boolean;
  zip:   TAbUnZipper;
  m:     TFileStream;
  i:     integer;
{$ENDIF}
begin
  fFileName := aFileName;
  if (aFileName <> '') and FileExists(aFileName) then begin
    fStream.Clear;
{$IFDEF ZIP}
    m := TFileStream.Create(aFileName, fmOpenRead or fmShareDenyWrite);
    try
      if m.Read(i, 4) = 4 then isZIP := (i = $04034B50)
      else Exit;
    finally
      m.Free;
    end;
    if isZIP then begin
      zip := TAbUnZipper.Create(nil);
      try
        zip.FileName := aFileName;
        if zip.Count <= 0 then begin
          Result := ERR_INCORRECT_FILE;
          Exit;
        end;
        zip.ExtractToStream(zip.Items[0].FileName, fStream);
        fStream.Position := 0;
      finally
        zip.Free;
      end;
    end
    else
{$ENDIF}
        fStream.LoadFromFile(aFileName);
    Result := ERR_NO_ERROR;
  end
  else Result := ERR_FILE_NOT_FOUND;
end;

