function TEmar_RideBonusList.AddList(aList: IEmar_RideBonusList): integer;
var
  ix_list, ix_add: integer;
begin
  if _add_list(aList, ix_list, ix_add) then begin
    Result := ix_list;
    if ix_add >= aList.Count then Exit;
  end else begin
    Result := Count;
    ix_add := 0;
  end;
  for ix_list := ix_add to aList.Count - 1 do CopyTariff(AddItem, aList.Items[ix_list]);
end;

