function TEmar_BaseFile.GetRideRouteIndexFromBusStopRideNo(const aRideIndex, aBusStopNo: Integer;
  ARideRouteIndex: PInteger): Cardinal;
begin
  if (aRideIndex < 0) or (aRideIndex >= fRideList.Count) then Result := ERR_LIST_OUT_OF_RANGE
  else begin
    Result := ERR_NO_ERROR;
    ARideRouteIndex^ := fRideList[aRideIndex].IndexOfRoute + aBusStopNo - 1;
  end;
end;

function TEmar_BaseFile.IsTicketRegisterEmar105(aTicketRegister: PChar): LongBool;
var
  i:               Integer;
  sTicketRegister: string;
begin
  sTicketRegister := string(aTicketRegister);
  Result := (Length(sTicketRegister) in [12, 14]) and (sTicketRegister[4] = ' '); // czwarty(!) symbol - spacja
  if Result then begin
    i := 0;
    while i <= high(Logo105) do begin
      if Copy(sTicketRegister, 1, 3) = Logo105[i] then Break;
      Inc(i);
    end;
    Result := i <= high(Logo105);
  end;
  if Result then begin
    for i := 5 to Length(sTicketRegister) do
      if not CharInSet(sTicketRegister[i], ['0' .. '9']) then begin
        Result := False;
        Break;
      end;
  end;
end;

function TEmar_BaseFile.IsTicketRegisterEmar205(aTicketRegister: PChar): LongBool;
var
  i:               Integer;
  sTicketRegister: string;
begin
  sTicketRegister := string(aTicketRegister);
  Result := (Length(sTicketRegister) = 14) and (sTicketRegister[4] = ' '); // czwarty(!) symbol - spacja
  if Result then begin
    i := 0;
    while i <= high(LogoPrintoLineB) do begin
      if Copy(sTicketRegister, 1, 3) = LogoPrintoLineB[i] then Break;
      Inc(i);
    end;
    Result := i <= high(LogoPrintoLineB);
  end;
  if Result then begin
    for i := 5 to Length(sTicketRegister) do
      if not CharInSet(sTicketRegister[i], ['0' .. '9']) then begin
        Result := False;
        Break;
      end;
  end;
end;

function TEmar_BaseFile.IsEmar205OnlineReport(): LongBool;
var
  sFileName: String;
begin
  sFileName := String(ExtractFileName(fFileName));
  Result := (sFileName.Length > 1)and((Copy(sFileName, 1, 2).ToUpper = 'CE'));
end;

function TEmar_BaseFile.IsEmar205OnlineDD0(): LongBool;
var
  sFileName: String;
begin
  sFileName := String(ExtractFileName(fFileName));
  Result := (sFileName.Length > 3)and(Copy(sFileName, 1, 4).ToUpper = 'DD0_');
end;

function TEmar_BaseFile.SaveToStream(aStream: TStream; aVersion: integer): longword;
var
  mStream: TMemoryStream;
  ev_00: IEmar_ReportEvent_00;
  dNow: TDateTime;
{$IFDEF ZIP}
  zip: TAbZipper;
{$ENDIF}
begin
  if SaveMode = EMAR_SAVEMODE_PROGRAMMING then mStream := TMemoryStream(aStream)
  else mStream := TMemoryStream.Create;
  try
    fVersion := aVersion;
    fAtPageNumber := 0;
    Result := ERR_USER_TERMINATE;
    fReferenceRideList.Clear;
    if IsRequired(fFat) then begin
      Fat.Clear;
      if SaveMode = EMAR_SAVEMODE_PROGRAMMING then begin
        Fat.PageId[4095] := 2; // FAT 2
        Fat.PageId[4094] := 2; // FAT 2
        Fat.PageId[4093] := 2; // FAT 2
        Fat.PageId[4092] := 2; // FAT 2
        Fat.PageId[4091] := 2; // FAT 2
        Fat.PageId[4090] := 2; // FAT 2
        Fat.PageId[4089] := 2; // FAT 2
        Fat.PageId[4088] := 2; // FAT 2
        Fat.PageId[4087] := 4; // OIK 2
        Fat.PageId[4086] := 6; // DIR 2
      end;
      Fat.Nr := 1;
      Fat.SaveToBuffer(mStream, aVersion);
      if fBreak then Exit;
      Inc(fAtPageNumber, Fat.PageCount div 512);
    end;
    if IsRequired(fOik) then begin
      GetOikAsClass.Nr := 1;
      GetOikAsClass.SaveToBuffer(mStream, aVersion);
      if fBreak then Exit;
      Inc(fAtPageNumber);
    end;
    if IsRequired(fDir) then begin
      GetDirAsClass.Clear;
      GetDirAsClass.Nr := 1;
      GetDirAsClass.SaveToBuffer(mStream, aVersion);
      if fBreak then Exit;
      Inc(fAtPageNumber);
    end;
    if IsRequired(fConsts) then begin
      GetConstsAsClass.SaveToBuffer(mStream, aVersion);
      if fBreak then Exit;
      Inc(fAtPageNumber);
    end;

    if not(SaveMode in [EMAR_SAVEMODE_REPORT_ONLY, EMAR_SAVEMODE_FILE_DD0_EXPORT]) then begin
      // $11 = 17 - Ceny
      if IsRequired(fPriceList) then begin
        SaveList(fPriceList, mStream);
        if fBreak then Exit;
      end;
      // $D = 13 - Ulgi kursów
      if IsRequired(fRideReductionList) then begin
        SaveList(fRideReductionList, mStream);
        if fBreak then Exit;
      end;
      // $A = 10 - Kursy
      if IsRequired(fRideList) then begin
        SaveList(fRideList, mStream);
        if fBreak then Exit;
      end;
      // $8 = 08 - Firmy
      if IsRequired(fCompanyList) then begin
        SaveList(fCompanyList, mStream);
        if fBreak then Exit;
      end;
      // $9 = 09 - Przystanki
      if IsRequired(fBusStopList) then begin
        SaveList(fBusStopList, mStream);
        if fBreak then Exit;
      end;
      // $2F = 47 - Słupki przystanków
      if IsRequired(fBusStopStandList) then begin
        SaveList(fBusStopStandList, mStream);
        if fBreak then Exit;
      end;
      // $B = 11 - Trasy kursów
      if IsRequired(fRideRouteList) then begin
        SaveList(fRideRouteList, mStream);
        if fBreak then Exit;
      end;
      // $C = 12 - Taryfy kursów
      if IsRequired(fRideTariffList) then begin
        SaveList(fRideTariffList, mStream);
        if fBreak then Exit;
      end;
      // $E = 14 - Kalendarz
      if IsRequired(fCalendarList) then begin
        SaveList(fCalendarList, mStream);
        if fBreak then Exit;
      end;
      // $F = 15 - Oznaczenia kursów
      if IsRequired(fRideDesignationList) then begin
        SaveList(fRideDesignationList, mStream);
        if fBreak then Exit;
      end;
      // $10 = 16 - Taryfy
      if IsRequired(fTariffList) then begin
        SaveList(fTariffList, mStream);
        if fBreak then Exit;
      end;
      // $12 = 18 - Indeksy cen dla cenników tabelowych typu 1 (max 15 cen w taryfie)
      if IsRequired(fPriceIndexes1) then begin
        // if TEmar_PriceIndexes(fPriceIndexes1).Required then begin
        TEmar_PriceIndexes(fPriceIndexes1).SaveToBuffer(mStream, aVersion);
        if fBreak then Exit;
      end;
      // $13 = 19 - Indeksy cen dla cenników tabelowych typu 2 (max 255 cen w taryfie) (to samo co TEmar_PriceIndexes (18))
      if IsRequired(fPriceIndexes2) then begin
        // if TEmar_PriceIndexes(fPriceIndexes2).Required then begin
        TEmar_PriceIndexes(fPriceIndexes2).SaveToBuffer(mStream, aVersion);
        if fBreak then Exit;
      end;
      // $14 = 20 - Numery stref dla taryf strefowych
      if IsRequired(fFarePriceScaleZoneNumbers) then begin
        // if TEmar_FarePriceScaleZoneNumber(fFarePriceScaleZoneNumbers).Required then begin
        TEmar_FarePriceScaleZoneNumber(fFarePriceScaleZoneNumbers).SaveToBuffer(mStream, aVersion);
        if fBreak then Exit;
      end;
      // $16 = 22 - Sposoby zapłaty
      if IsRequired(fPaymentTypeList) then begin
        SaveList(fPaymentTypeList, mStream);
        if fBreak then Exit;
      end;
      // $17 = 23 - Ulgi
      if IsRequired(fFarePriceReductionList) then begin
        SaveList(fFarePriceReductionList, mStream);
        if fBreak then Exit;
      end;
      // $1A = 26 - Linie
      if IsRequired(fLineList) then begin
        SaveList(fLineList, mStream);
        if fBreak then Exit;
      end;
      // $33 = 51 - Numery linii
      if IsRequired(fLineNumberList) then begin
        SaveList(fLineNumberList, mStream);
        if fBreak then Exit;
      end;
      // $1B = 27 - Bonifikaty kursów
      if IsRequired(fRideBonusList) then begin
        SaveList(fRideBonusList, mStream);
        if fBreak then Exit;
      end;
      // $1C = 28 - Opłaty manipulacyjne kursów
      if IsRequired(fRideHandlingFeeList) then begin
        SaveList(fRideHandlingFeeList, mStream);
        if fBreak then Exit;
      end;
      // $1D = 29 - Opłaty dodatkowe
      if IsRequired(fAdditionalFeeList) then begin
        SaveList(fAdditionalFeeList, mStream);
        if fBreak then Exit;
      end;
      // $1E = 30 - Taryfy bagażowe kursów
      if IsRequired(fLuggageTariffList) then begin
        SaveList(fLuggageTariffList, mStream);
        if fBreak then Exit;
      end;
      // 35 - taryfy miejskie
      if IsRequired(fRidesCityFarePriceScaleList) then begin
        SaveList(fRidesCityFarePriceScaleList, mStream);
        if fBreak then Exit;
      end;
      // 36 - ceny taryf miejskich
      if IsRequired(fPriceCityFarePriceScaleList) then begin
        SaveList(fPriceCityFarePriceScaleList, mStream);
        if fBreak then Exit;
      end;
      // $25 = 37 - Trasy linii
      if IsRequired(fLineRouteList) then begin
        SaveList(fLineRouteList, mStream);
        if fBreak then Exit;
      end;
      // $26 = 38 - Litery numerów bocznych autobusów
      if IsRequired(fLettersBusStopSideNumberList) then begin
        SaveList(fLettersBusStopSideNumberList, mStream);
        if fBreak then Exit;
      end;
      // $2B = 43 - Wykaz stref biletowych
      if IsRequired(fZoneNumberList) then begin
        SaveList(fZoneNumberList, mStream);
        if fBreak then Exit;
      end;
      // $2C = 44 - Ulgi BM (jak 23 - Ulgi)
      if IsRequired(fMonthTicketReductionList) then begin
        SaveList(fMonthTicketReductionList, mStream);
        if fBreak then Exit;
      end;
      // 44 - Duo/Printo Bus - Cennik strefowy biletów miesięcznych (BM, BMU) z przesiadką w strefie
      if IsRequired(fBMZonePriceList) then begin
        SaveList(fBMZonePriceList, mStream);
        if fBreak then Exit;
      end;
      // $2D = 45 - Taryfa doładowań EM-karty - realizacja odłożona
      if IsRequired(fChargingTariffList) then begin
        SaveList(fChargingTariffList, mStream);
        if fBreak then Exit;
      end;
      // $2E = 46 - Ceny doładowań EM-karty - realizacja odłożona
      if IsRequired(fChargingTariffPriceList) then begin
        SaveList(fChargingTariffPriceList, mStream);
        if fBreak then Exit;
      end;
      // $1F = 31 - Skorowidz kursów
      if IsRequired(fReferenceRideList) then begin
        fReferenceRideList.Sort;
        SaveList(fReferenceRideList, mStream);
        if fBreak then Exit;
      end;
    end;

    if fFileType = EMAR_FILE_TYPE_CKM then begin
      // $20 = 32 - Wykaz firm rozliczających przewozy pasażerów z biletami miesięcznymi – dane dodatkowe
      if IsRequired(fAcceptedTicketOwnerList) then begin
        SaveList(fAcceptedTicketOwnerList, mStream);
        if fBreak then Exit;
      end;
      // $22 = 34 - Wykaz zastrzeżonych kart MIFARE – dane dodatkowe
      if IsRequired(fProprietaryMIFAREcardList) then begin
        SaveList(fProprietaryMIFAREcardList, mStream);
        if fBreak then Exit;
      end;
      // $27 = CKM100 39 - Przewoźnicy u których można kontrolować bilety
      if IsRequired(fInspectedCompanyList) then begin
        SaveList(fInspectedCompanyList, mStream);
        if fBreak then Exit;
      end;
      // $23 = 35 - Wykaz kontrolerów
      if IsRequired(fDriverList) then begin
        SaveList(fDriverList, mStream);
        if fBreak then Exit;
      end;
    end
    else
      // dane dodatkowe
      if not(SaveMode in [EMAR_SAVEMODE_FILE_A, EMAR_SAVEMODE_FILE_A80_EXPORT]) then begin
        // $15 = 21 - Przeliczniki walut – dane dodatkowe
        if IsRequired(fCurrencyExchangeList) then begin
          SaveList(fCurrencyExchangeList, mStream);
          if fBreak then Exit;
        end;
        // $18 = 24 - Zadania – dane dodatkowe
        if IsRequired(fTaskList) then begin
          SaveList(fTaskList, mStream);
          if fBreak then Exit;
        end;
        // $19 = 25 - Pozycje zadań – dane dodatkowe
        if IsRequired(fTaskPositionList) then begin
          SaveList(fTaskPositionList, mStream);
          if fBreak then Exit;
        end;
        // $20 = 32 - Wykaz firm rozliczających przewozy pasażerów z biletami miesięcznymi – dane dodatkowe
        if IsRequired(fAcceptedTicketOwnerList) then begin
          SaveList(fAcceptedTicketOwnerList, mStream);
          if fBreak then Exit;
        end;
        // $21 = 33 - Wykaz firm wydających akceptowane przez bileterkę karty pasażerów z ulgą handlową – dane dodatkowe
        if IsRequired(fAcceptedTradeReliefCardOwnerList) then begin
          SaveList(fAcceptedTradeReliefCardOwnerList, mStream);
          if fBreak then Exit;
        end;
        // $22 = 34 - Wykaz zastrzeżonych kart MIFARE – dane dodatkowe
        if IsRequired(fProprietaryMIFAREcardList) then begin
          SaveList(fProprietaryMIFAREcardList, mStream);
          if fBreak then Exit;
        end;
        // $27 = EMAR105/205 39 - Przeliczniki walut po zmianie waluty cennika
        if IsRequired(fExchangeRateAfterChangeCurrencyList) then begin
          SaveList(fExchangeRateAfterChangeCurrencyList, mStream);
          if fBreak then Exit;
        end;
        // $28 = 40 - Wykaz kart MIFARE z biletami do przedłużenia / sprzedaży na następny okres – dane dodatkowe
        if IsRequired(fTicketNextPeriodList) then begin
          SaveList(fTicketNextPeriodList, mStream);
          if fBreak then Exit;
        end;
        // $29 = 41 - Wykaz skrótów klawiszowych do funkcji bileterki – dane dodatkowe
        if IsRequired(fShortcutList) then begin
          SaveList(fShortcutList, mStream);
          if fBreak then Exit;
        end;
        // $2A = 42 - Wykaz firm wydających akceptowane przez bileterkę karty kontrolerów – dane dodatkowe
        if IsRequired(fAcceptedInspectorsCompanyList) then begin
          SaveList(fAcceptedInspectorsCompanyList, mStream);
          if fBreak then Exit;
        end;
        if SaveMode in [EMAR_SAVEMODE_FILE_DD0_EXPORT] then
        begin
          // $30 = 48 - Kierowcy (solobus)
          if IsRequired(fDriverList) then begin
            SaveList(fDriverList, mStream);
            if fBreak then
              Exit;
          end;
        end;
        if IsRequired(fEmar205TextsList) then begin
          SaveList(fEmar205TextsList, mStream);
          if fBreak then Exit;
        end;
        if IsRequired(fEmar205WifiList) then begin
          SaveList(fEmar205WifiList, mStream);
          if fBreak then Exit;
        end;
      end;

    // strona 100
    if IsRequired(fReportStartedRides)
      and not(SaveMode in [EMAR_SAVEMODE_FILE_A, {EMAR_SAVEMODE_FILE_A80_EXPORT,} EMAR_SAVEMODE_FILE_DD0_EXPORT]) then begin
      // od początku nowego sektora w pamięci (EMAR-105, EMAR-205 ??, ..)
      if SaveMode = EMAR_SAVEMODE_PROGRAMMING then fAtPageNumber := (fAtPageNumber shr 8 + 1) shl 8;
      SaveList(fReportStartedRides, mStream);
      if fBreak then Exit;
    end;

    // strona 101
    if IsRequired(fReportList)
      and not(SaveMode in [EMAR_SAVEMODE_FILE_A, {EMAR_SAVEMODE_FILE_A80_EXPORT,} EMAR_SAVEMODE_FILE_DD0_EXPORT]) then
    begin
      if SaveMode = EMAR_SAVEMODE_FILE_A80_EXPORT then
      begin
        fReportList.Clear;         // strona 101
        ev_00 := fReportList.addItem(0) as IEmar_ReportEvent_00;
        dNow := Now();
        ev_00.EventDate := PChar(DateToStr(dNow));
        ev_00.EventTime := PChar(TimeToStr(dNow));
        ev_00.ReportCode := '0000';
        // tax rates are read from the CONST
        ev_00.TaxRates[1] := (Self.fConsts as IEmar105_Consts).RatePTU1_A;
        ev_00.TaxRates[2] := (Self.fConsts as IEmar105_Consts).RatePTU1_B;
        ev_00.TaxRates[3] := (Self.fConsts as IEmar105_Consts).RatePTU1_C;
        ev_00.TaxRates[4] := (Self.fConsts as IEmar105_Consts).RatePTU1_D;
        ev_00.TaxRates[5] := (Self.fConsts as IEmar105_Consts).RatePTU1_E;
        ev_00.TaxRates[6] := (Self.fConsts as IEmar105_Consts).RatePTU1_F;
        ev_00.TaxRates[7] := (Self.fConsts as IEmar105_Consts).RatePTU1_G;
      end;
      TEmar_ReportEventList(fReportList).SaveToStream(mStream, fAtPageNumber);
    end;

    Fat.Nr := 1;
    Fat.SaveToBuffer(mStream);
    if fBreak then Exit;
    if FileType = EMAR_FILE_TYPE_CKM then GetConstsAsClass.SaveToBuffer(mStream, aVersion)
    else begin
      Dir.Nr := 1;
      Dir.SaveToBuffer(mStream);
    end;
    if fBreak then Exit;
    if (SaveMode <> EMAR_SAVEMODE_PROGRAMMING) then begin
      mStream.Position := 0;
{$IFDEF ZIP}
      zip := TAbZipper.Create(nil);
      try
        zip.ArchiveType := atZip;
        zip.ForceType := true;
        zip.FileName := LastSavedFileName + '.zip';
        zip.AddFromStream(AFileName, mStream);
        zip.Save;
      finally
        zip.Free;
      end;
      if FileExists(LastSavedFileName) then DeleteFile(LastSavedFileName);
      RenameFile(LastSavedFileName + '.zip', LastSavedFileName);
{$ELSE}
      aStream.Position := 0;
      aStream.CopyFrom(mStream, mStream.Size);
{$ENDIF}
    end;

    Result := ERR_NO_ERROR;
  finally
    if SaveMode <> EMAR_SAVEMODE_PROGRAMMING then mStream.Free;
  end;
end;

