function TEmar_InterfacedObject.StringToDuobusString(s: string): ansistring;
var
  i: integer;
begin
  Result := ansistring(s);
  for i := low(Result) to high(Result) do
    case s[i] of
    'Ą': Result[i] := #$A4;
    'Ć': Result[i] := #$8F;
    'Ę': Result[i] := #$A8;
    'Ł': Result[i] := #$9D;
    'Ń': Result[i] := #$E3;
    'Ó': Result[i] := #$E0;
    'Ś': Result[i] := #$97;
    'Ź': Result[i] := #$8D;
    'Ż': Result[i] := #$BD;
    'ą': Result[i] := #$A5;
    'ć': Result[i] := #$86;
    'ę': Result[i] := #$A9;
    'ł': Result[i] := #$88;
    'ń': Result[i] := #$E4;
    'ó': Result[i] := #$A2;
    'ś': Result[i] := #$98;
    'ź': Result[i] := #$AB;
    'ż': Result[i] := #$BE;
    end;
end;

procedure TEmar_InterfacedObject.StrPLCopy(Dest: PAnsiChar; const Source: AnsiString; MaxLen: Cardinal;
  AddZero: boolean; FillChar: AnsiChar);
var
  i, iLen: Cardinal;
begin
  iLen := Length(Source);
  for i := 1 to MaxLen do begin
    if i <= iLen then Dest^ := Source[i]
    else Dest^ := FillChar;
    Inc(Dest);
  end;
  if AddZero then Dest^ := #0;
end;

